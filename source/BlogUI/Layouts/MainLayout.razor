@*
    MainLayout.razor
    Purpose: Default layout for public TechieBlog pages — sticky header, content
    column with the blog sidebar, and the site footer.

    REQ-UI-048 — rebuilt on TrBlazeUI. Carries the two root-layout requirements:
      <ToastProvider /> — destination for ToastService notifications
      <PortalHost />    — required by every overlay (Dialog, Sheet, Popover,
                          DropdownMenu, Tooltip, Select)

    BRD-93 — the public shell exposes no login link and no user menu.
*@

@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col bg-background text-foreground">

    <Header />

    <div class="site-container flex flex-1 flex-col gap-8 py-8 lg:flex-row">
        <main class="min-w-0 flex-1" data-testid="main-content">
            @Body
        </main>

        <div class="w-full shrink-0 lg:w-80">
            <BlogSidebar />
        </div>
    </div>

    <Footer />
</div>

<ToastProvider Position="ToastPosition.BottomRight" />
<PortalHost />

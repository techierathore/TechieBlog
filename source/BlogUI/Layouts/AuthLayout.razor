@*
    AuthLayout.razor
    Purpose: Bare centered layout for the authentication screens (sign in, forgot
    password, reset password, access denied).

    REQ-UI-001 / BRD-93 — reached by direct URL only: a centered brand mark above
    a single card, a fixed theme toggle, and NO site navigation, so no public
    page ever links into the admin surface.

    REQ-UI-048 — carries the mandatory <ToastProvider /> and <PortalHost />.
*@

@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col items-center justify-center bg-background px-4 py-12 text-foreground">

    @* Fixed theme toggle, top-right *@
    <div class="fixed right-4 top-4 z-50">
        <ThemeToggle />
    </div>

    @* Brand mark *@
    <a href="/"
       class="mb-8 flex items-center gap-2 text-lg font-semibold text-foreground no-underline"
       data-testid="brand-link">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground">
            <LucideIcon Name="code" Size="18" />
        </span>
        <span>TechieBlog</span>
    </a>

    <main class="w-full max-w-[420px]" data-testid="auth-content">
        @Body
    </main>
</div>

<ToastProvider Position="ToastPosition.BottomRight" />
<PortalHost />

@*
    FullWidthLayout.razor
    Purpose: Public layout without the blog sidebar, for content-focused pages
    (post view, series view, resume).

    REQ-UI-048 — rebuilt on TrBlazeUI, including the mandatory
    <ToastProvider /> and <PortalHost /> root-layout hosts.
*@

@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col bg-background text-foreground">

    <Header />

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6" data-testid="main-content">
        @Body
    </main>

    <Footer />
</div>

<ToastProvider Position="ToastPosition.BottomRight" />
<PortalHost />

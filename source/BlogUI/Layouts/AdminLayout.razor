@*
    AdminLayout.razor
    Purpose: Layout for administrative pages with navigation sidebar and header.
    Provides Fluent UI-based navigation menu, user profile dropdown, and main content area.
    Uses CSS custom properties from theme files for consistent styling.
    Role-based menu visibility using AuthorizeView.

    Usage: Applied to all admin pages (Dashboard, BlogsList, Users, etc.)
    Dependencies: Microsoft.FluentUI.AspNetCore.Components, ThemeService, Authorization
*@
@using BlogModels.Models
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<FluentLayout Style="background-color: var(--color-background); color: var(--color-neutral);">
    <FluentStack Orientation="Orientation.Horizontal" Style="height: 100vh;">
        @* Sidebar Navigation *@
        <FluentNavMenu Width="250" Collapsible="true" Title="TechieBlog Admin" Style="background-color: var(--color-surface); border-right: 1px solid var(--color-border);">
            <FluentNavLink Href="/" Match="NavLinkMatch.All">
                TechieBlog
            </FluentNavLink>
            <FluentNavLink Href="/admin">
                Dashboard
            </FluentNavLink>
            <FluentNavGroup Title="Blog Management">
                <FluentNavLink Href="/BlogsList">Blog Posts</FluentNavLink>
                @* Tags link only visible to Admins *@
                <AuthorizeView Policy="AdminOnly">
                    <Authorized>
                        <FluentNavLink Href="/tags">Tags</FluentNavLink>
                    </Authorized>
                </AuthorizeView>
                <FluentNavLink Href="/comments">Comments</FluentNavLink>
            </FluentNavGroup>
            @* Users link only visible to Admins *@
            <AuthorizeView Policy="AdminOnly">
                <Authorized>
                    <FluentNavLink Href="/users">
                        Users
                    </FluentNavLink>
                </Authorized>
            </AuthorizeView>
        </FluentNavMenu>

        @* Main Content Area *@
        <FluentStack Orientation="Orientation.Vertical" Style="flex: 1; overflow: hidden;">
            @* Top Header Bar *@
            <FluentHeader Style="height: var(--header-height, 50px); padding: 0 var(--spacing-md, 16px); background-color: var(--color-surface); border-bottom: 1px solid var(--color-border);">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="width: 100%;">
                    <FluentMenu>
                        <FluentMenuButton Appearance="Appearance.Stealth">
                            <span style="margin-left: var(--spacing-sm, 8px);">@CurrentUserName</span>
                            <FluentBadge Appearance="Appearance.Accent" Style="margin-left: 8px;">@CurrentUserRole</FluentBadge>
                        </FluentMenuButton>
                        <FluentMenuItem Href="/profile">Profile</FluentMenuItem>
                        <AuthorizeView Policy="AdminOnly">
                            <Authorized>
                                <FluentMenuItem Href="/analytics">Analytics</FluentMenuItem>
                                <FluentMenuItem Href="/settings">Settings</FluentMenuItem>
                            </Authorized>
                        </AuthorizeView>
                        <FluentMenuItem Href="/help">Help</FluentMenuItem>
                        <FluentMenuItem OnClick="@LogoutAsync">Sign out</FluentMenuItem>
                    </FluentMenu>
                </FluentStack>
            </FluentHeader>

            @* Main Body Content *@
            <FluentBodyContent Style="padding: var(--spacing-md, 16px); overflow: auto; background-color: var(--color-background);">
                @Body
            </FluentBodyContent>
        </FluentStack>
    </FluentStack>
</FluentLayout>

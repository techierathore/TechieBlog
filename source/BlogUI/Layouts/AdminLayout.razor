@*
    AdminLayout.razor
    Purpose: Administration shell for every /admin surface.

    REQ-UI-048 / docs/TechieBlog-UIDesign.md §Design system — the TrBlazeUI
    Sidebar inset shell:
      - grouped navigation: Content . Taxonomy . Media . Resume . Audience . System
      - topbar with a collapse trigger (icon-rail mode), breadcrumb slot and theme toggle
      - the signed-in identity lives in the TOPBAR as a DropdownMenu on the avatar
        (My Profile / Log Out) - a real popover with focus trap, Escape-to-close and
        click-outside dismissal. The sidebar deliberately has no footer identity block.

    Every navigation entry is gated by the same policy that guards its page, so the
    menu never offers a destination that would bounce the user to /access-denied.
*@

@inherits LayoutComponentBase

<SidebarProvider DefaultOpen="true" HeightClass="min-h-screen">

    <Sidebar Collapsible="true" data-testid="admin-sidebar">

        <SidebarHeader>
            <SidebarHeaderContent>
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                    <LucideIcon Name="code" Size="16" />
                </div>
                <SidebarHeaderInfo>
                    <span class="truncate font-semibold">TechieBlog</span>
                    <span class="truncate text-xs text-muted-foreground">Admin</span>
                </SidebarHeaderInfo>
            </SidebarHeaderContent>
        </SidebarHeader>

        <SidebarContent>

            @* Dashboard sits above the groups - it is the shell's home, not a category. *@
            <SidebarGroup>
                <SidebarGroupContent>
                    <SidebarMenu>
                        @* /admin is guarded by EditorOrAbove (BRD §F-ADMIN). Offering it to an
                           Author put an access-denied bounce in the menu. *@
                        <AuthorizeView Policy="@AppPolicies.EditorOrAbove">
                            <Authorized>
                                <SidebarMenuItem>
                                    <SidebarMenuButton Href="/admin"
                                                       Match="NavLinkMatch.All"
                                                       Tooltip="Dashboard"
                                                       data-testid="nav-dashboard">
                                        <LucideIcon Name="layout-dashboard" Size="16" />
                                        <span>Dashboard</span>
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            </Authorized>
                        </AuthorizeView>
                    </SidebarMenu>
                </SidebarGroupContent>
            </SidebarGroup>

            @* VisibleGroups drops any group whose entries the role cannot open, so no empty
               group heading is rendered (REQ-FN-009 / BRD-9). *@
            @foreach (var group in VisibleGroups)
            {
                <SidebarGroup>
                    <SidebarGroupLabel>@group.Label</SidebarGroupLabel>
                    <SidebarGroupContent>
                        <SidebarMenu>
                            @foreach (var entry in group.Entries)
                            {
                                <AuthorizeView Policy="@entry.Policy">
                                    <Authorized>
                                        <SidebarMenuItem>
                                            <SidebarMenuButton Href="@entry.Href"
                                                               Tooltip="@entry.Label"
                                                               data-testid="@entry.TestId">
                                                <LucideIcon Name="@entry.Icon" Size="16" />
                                                <span>@entry.Label</span>
                                            </SidebarMenuButton>
                                        </SidebarMenuItem>
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </SidebarMenu>
                    </SidebarGroupContent>
                </SidebarGroup>
            }

        </SidebarContent>

        <SidebarRail />
    </Sidebar>

    <SidebarInset>

        @* --- Topbar --------------------------------------------------------- *@
        <header class="flex h-16 shrink-0 items-center gap-3 border-b border-border bg-background px-4"
                data-testid="admin-topbar">

            <SidebarTrigger data-testid="sidebar-collapse-trigger" />

            <Separator Orientation="SeparatorOrientation.Vertical" Class="h-6" />

            <Breadcrumb Class="hidden sm:flex">
                <BreadcrumbList>
                    <BreadcrumbItem>
                        <BreadcrumbLink Href="/admin">Admin</BreadcrumbLink>
                    </BreadcrumbItem>
                </BreadcrumbList>
            </Breadcrumb>

            <div class="flex-1"></div>

            @* [REQ-NFR-007] WCAG 4.1.2 / 2.4.4 — the label below is `hidden sm:inline`, so below
               640 px this collapses to an icon-only link with NO accessible name at all: axe
               `link-name` (serious) on every admin page at 390 px. The aria-label carries the name
               at every width; the visible text still reads it out for sighted users on desktop. *@
            <Button Href="/"
                    Target="_blank"
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Small"
                    AriaLabel="View site"
                    title="View site"
                    data-testid="view-site">
                <LucideIcon Name="external-link" Size="16" />
                <span class="ml-2 hidden sm:inline">View site</span>
            </Button>

            <ThemeToggle />

            @* Signed-in identity: avatar trigger -> My Profile / Log Out. *@
            <DropdownMenu>
                <DropdownMenuTrigger AsChild>
                    <Button Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Icon"
                            Class="rounded-full"
                            AriaLabel="Account menu"
                            data-testid="account-menu-trigger">
                        <Avatar Size="AvatarSize.Small">
                            <AvatarFallback>@CurrentUserInitials</AvatarFallback>
                        </Avatar>
                    </Button>
                </DropdownMenuTrigger>
                @*
                    TrBlazeUI gap TR-040: DropdownMenuContent / DropdownMenuItem / DropdownMenuLabel
                    declare NO CaptureUnmatchedValues parameter, so passing data-testid to them threw
                    "does not have a property matching the name 'data-testid'" and took the whole
                    admin shell down. Every test id therefore rides on a plain inner element.
                *@
                <DropdownMenuContent Class="w-56" Align="PopoverAlign.End">
                    <div data-testid="account-menu">
                        <DropdownMenuLabel>
                            <div class="flex flex-col">
                                <span class="truncate text-sm font-medium" data-testid="account-name">@CurrentUserName</span>
                                <span class="truncate text-xs font-normal text-muted-foreground" data-testid="account-role">@CurrentUserRole</span>
                            </div>
                        </DropdownMenuLabel>
                        <DropdownMenuSeparator />
                        <DropdownMenuItem OnClick="NavigateToProfile">
                            <span class="flex items-center" data-testid="account-profile">
                                <LucideIcon Name="user" Size="16" />
                                <span class="ml-2">My Profile</span>
                            </span>
                        </DropdownMenuItem>
                        <DropdownMenuSeparator />
                        <DropdownMenuItem OnClick="LogoutAsync">
                            <span class="flex items-center" data-testid="account-logout">
                                <LucideIcon Name="log-out" Size="16" />
                                <span class="ml-2">Log Out</span>
                            </span>
                        </DropdownMenuItem>
                    </div>
                </DropdownMenuContent>
            </DropdownMenu>
        </header>

        @* --- Page body ------------------------------------------------------ *@
        <div class="flex-1 overflow-auto p-4 md:p-6" data-testid="admin-content">
            @Body
        </div>

    </SidebarInset>
</SidebarProvider>

<ToastProvider Position="ToastPosition.BottomRight" />
<PortalHost />

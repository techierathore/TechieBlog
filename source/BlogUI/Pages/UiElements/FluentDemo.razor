@*
    FluentDemo.razor
    Purpose: Demonstrates Microsoft Fluent UI Blazor components for TechieBlog.
    Serves as a reference for using Fluent UI components in the application.

    Usage: Navigate to /fluent-demo to view component examples.
    Dependencies: Microsoft.FluentUI.AspNetCore.Components
*@
@page "/fluent-demo"
@layout AdminLayout

<FluentStack Orientation="Orientation.Vertical" Style="gap: 24px;">
    <h1>Fluent UI Component Demo</h1>
    <p>This page demonstrates various Microsoft Fluent UI Blazor components.</p>

    @* Button Section *@
    <FluentCard>
        <h2>Buttons</h2>
        <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px; flex-wrap: wrap;">
            <FluentButton Appearance="Appearance.Accent">Primary Button</FluentButton>
            <FluentButton Appearance="Appearance.Neutral">Secondary Button</FluentButton>
            <FluentButton Appearance="Appearance.Outline">Outline Button</FluentButton>
            <FluentButton Appearance="Appearance.Stealth">Stealth Button</FluentButton>
            <FluentButton Appearance="Appearance.Accent" Disabled="true">Disabled</FluentButton>
        </FluentStack>
    </FluentCard>

    @* Text Input Section *@
    <FluentCard>
        <h2>Text Inputs</h2>
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px; max-width: 400px;">
            <FluentTextField Label="Username" Placeholder="Enter your username" @bind-Value="username" />
            <FluentTextField Label="Email" Placeholder="email@example.com" @bind-Value="email" TextFieldType="TextFieldType.Email" />
            <FluentTextField Label="Password" Placeholder="Enter password" @bind-Value="password" TextFieldType="TextFieldType.Password" />
            <FluentTextArea Label="Description" Placeholder="Enter a description..." Rows="4" @bind-Value="description" />
        </FluentStack>
    </FluentCard>

    @* Card Section *@
    <FluentCard>
        <h2>Cards</h2>
        <FluentStack Orientation="Orientation.Horizontal" Style="gap: 16px; flex-wrap: wrap;">
            <FluentCard Style="width: 300px;">
                <h3>Sample Card 1</h3>
                <p>This is a sample card with Fluent UI styling. Cards are useful for grouping related content.</p>
                <FluentButton Appearance="Appearance.Accent">Learn More</FluentButton>
            </FluentCard>
            <FluentCard Style="width: 300px;">
                <h3>Sample Card 2</h3>
                <p>Another card demonstrating the consistent styling and spacing provided by Fluent UI components.</p>
                <FluentButton Appearance="Appearance.Outline">View Details</FluentButton>
            </FluentCard>
        </FluentStack>
    </FluentCard>

    @* Data Grid Section *@
    <FluentCard>
        <h2>Data Grid</h2>
        <FluentDataGrid Items="@sampleData" Style="height: 300px;">
            <PropertyColumn Property="@(p => p.Id)" Title="ID" Sortable="true" />
            <PropertyColumn Property="@(p => p.Title)" Title="Title" Sortable="true" />
            <PropertyColumn Property="@(p => p.Author)" Title="Author" Sortable="true" />
            <PropertyColumn Property="@(p => p.Status)" Title="Status" />
            <TemplateColumn Title="Actions">
                <FluentButton Appearance="Appearance.Stealth">Edit</FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
    </FluentCard>

    @* Message Bar Section *@
    <FluentCard>
        <h2>Message Bars</h2>
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
            <FluentMessageBar Title="Information" Intent="MessageIntent.Info">
                This is an informational message bar.
            </FluentMessageBar>
            <FluentMessageBar Title="Success" Intent="MessageIntent.Success">
                Operation completed successfully!
            </FluentMessageBar>
            <FluentMessageBar Title="Warning" Intent="MessageIntent.Warning">
                Please review before proceeding.
            </FluentMessageBar>
            <FluentMessageBar Title="Error" Intent="MessageIntent.Error">
                An error occurred. Please try again.
            </FluentMessageBar>
        </FluentStack>
    </FluentCard>
</FluentStack>

@code {
    /// <summary>
    /// Sample username for text field demo.
    /// </summary>
    private string username = "";

    /// <summary>
    /// Sample email for text field demo.
    /// </summary>
    private string email = "";

    /// <summary>
    /// Sample password for text field demo.
    /// </summary>
    private string password = "";

    /// <summary>
    /// Sample description for text area demo.
    /// </summary>
    private string description = "";

    /// <summary>
    /// Sample data for DataGrid demonstration.
    /// </summary>
    private IQueryable<SamplePost> sampleData = new List<SamplePost>
    {
        new SamplePost { Id = 1, Title = "Getting Started with Blazor", Author = "John Doe", Status = "Published" },
        new SamplePost { Id = 2, Title = "Fluent UI Components Guide", Author = "Jane Smith", Status = "Published" },
        new SamplePost { Id = 3, Title = "Building Modern Web Apps", Author = "Bob Wilson", Status = "Draft" },
        new SamplePost { Id = 4, Title = "C# Best Practices", Author = "Alice Brown", Status = "Published" },
        new SamplePost { Id = 5, Title = "Database Optimization Tips", Author = "Charlie Davis", Status = "Review" }
    }.AsQueryable();

    /// <summary>
    /// Sample post model for DataGrid demonstration.
    /// </summary>
    private class SamplePost
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Author { get; set; } = "";
        public string Status { get; set; } = "";
    }
}

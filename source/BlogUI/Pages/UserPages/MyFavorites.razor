@*
    MyFavorites.razor
    Purpose: Displays user's favorited/bookmarked blog posts.
    Allows users to view and manage their saved posts.

    Dependencies: MainLayout, FavoriteSvc, PostCard, Pagination, AuthenticationStateProvider
    Authorization: Authenticated users only
    Story: FIX-014 - Favorites/Bookmarks Implementation (Epic 4, FR17)
*@

@page "/my-favorites"
@attribute [Authorize]
@layout MainLayout
@inject BlogEngine.Services.FavoriteSvc FavoriteService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>My Favorites - TechieBlog</PageTitle>

<Breadcrumb Items="@breadcrumbItems" />

<section class="favorites-page">
    <div class="favorites-header">
        <h1>My Favorites</h1>
        @if (!isLoading && totalCount > 0)
        {
            <span class="favorites-count">@totalCount @(totalCount == 1 ? "post" : "posts") saved</span>
        }
    </div>

    @if (isLoading)
    {
        <div class="loading-container" style="display: flex; justify-content: center; padding: 48px;">
            <FluentProgressRing />
            <span style="margin-left: 12px;">Loading favorites...</span>
        </div>
    }
    else if (!isAuthenticated)
    {
        <div class="empty-state" style="text-align: center; padding: 48px;">
            <FluentIcon Value="@(new Icons.Regular.Size48.HeartBroken())" Color="Color.Neutral" />
            <h2>Please Log In</h2>
            <p>You need to be logged in to view your favorites.</p>
            <FluentAnchor Href="/admin/login" Appearance="Appearance.Accent" Style="margin-top: 16px;">
                Go to Login
            </FluentAnchor>
        </div>
    }
    else if (favorites == null || favorites.Count == 0)
    {
        <div class="empty-state" style="text-align: center; padding: 48px;">
            <FluentIcon Value="@(new Icons.Regular.Size48.Heart())" Color="Color.Neutral" />
            <h2>No Favorites Yet</h2>
            <p>You haven't saved any posts to your favorites.</p>
            <p style="color: var(--neutral-foreground-hint); margin-top: 8px;">
                Click the heart icon on any post to save it here.
            </p>
            <FluentAnchor Href="/" Appearance="Appearance.Accent" Style="margin-top: 16px;">
                Browse Posts
            </FluentAnchor>
        </div>
    }
    else
    {
        <div class="post-grid">
            @foreach (var favorite in favorites)
            {
                @if (favorite.Post != null)
                {
                    <article class="card">
                        <div class="card__image @(string.IsNullOrEmpty(favorite.Post.FeaturedImage) ? "placeholder-image" : "")">
                            @if (!string.IsNullOrEmpty(favorite.Post.FeaturedImage))
                            {
                                <img src="@favorite.Post.FeaturedImage"
                                     alt="@favorite.Post.Title"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.onerror=null; this.style.display='none'; this.parentElement.classList.add('placeholder-image'); this.parentElement.innerHTML='<span>Image</span>';" />
                            }
                            else
                            {
                                <span>Image</span>
                            }
                        </div>
                        <div class="card__body">
                            <div class="card__top-row">
                                <span class="card__category">@GetCategory(favorite.Post.Tags)</span>
                                <FavoriteToggle PostId="@favorite.Post.PostID"
                                               IsFavorited="true"
                                               IsLoggedIn="true"
                                               UserId="@currentUserId"
                                               OnToggle="@((isFav) => HandleFavoriteToggle(favorite, isFav))" />
                            </div>
                            <h3 class="card__title">
                                <a href="/post/@favorite.Post.Slug">@favorite.Post.Title</a>
                            </h3>
                            <p class="card__excerpt">
                                @(string.IsNullOrEmpty(favorite.Post.Abstract) ? GetExcerpt(favorite.Post.PostContent) : favorite.Post.Abstract)
                            </p>
                            <div class="card__meta">
                                <div class="card__author">
                                    <div class="card__avatar"></div>
                                    <span>@(string.IsNullOrEmpty(favorite.Post.BlogWriter) ? "Unknown" : favorite.Post.BlogWriter)</span>
                                </div>
                                <span>@favorite.Post.CreatedOn.ToString("MMM dd")</span>
                                <span class="saved-date" title="Saved on @favorite.CreatedOn.ToString("MMMM dd, yyyy")">
                                    Saved @GetRelativeDate(favorite.CreatedOn)
                                </span>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>

        @* Pagination *@
        @if (totalPages > 1)
        {
            <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" OnPageChanged="HandlePageChanged" />
        }
    }
</section>

<style>
    .favorites-page {
        max-width: 100%;
    }
    
    .favorites-header {
        display: flex;
        align-items: baseline;
        gap: 16px;
        margin-bottom: 24px;
    }
    
    .favorites-header h1 {
        margin: 0;
        font-size: 1.75rem;
    }
    
    .favorites-count {
        color: var(--neutral-foreground-hint);
        font-size: 0.9rem;
    }
    
    .card__top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }
    
    .saved-date {
        font-size: 0.8rem;
        color: var(--neutral-foreground-hint);
    }
    
    .empty-state {
        background: var(--neutral-layer-2);
        border-radius: 8px;
        border: 1px dashed var(--neutral-stroke-rest);
    }
    
    .empty-state h2 {
        margin: 16px 0 8px 0;
        font-size: 1.25rem;
    }
    
    .empty-state p {
        margin: 0;
        color: var(--neutral-foreground-hint);
    }
</style>

@code {
    private List<BlogModels.UserFavorite> favorites = new();
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private const int PageSize = 9;
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private long currentUserId = 0;
    
    private List<Breadcrumb.BreadcrumbItem> breadcrumbItems = new()
    {
        new Breadcrumb.BreadcrumbItem { Label = "Home", Url = "/" },
        new Breadcrumb.BreadcrumbItem { Label = "My Favorites", Url = "" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAndFavorites();
    }

    private async Task LoadUserAndFavorites()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Get current user
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            if (user.Identity?.IsAuthenticated == true)
            {
                isAuthenticated = true;
                var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (long.TryParse(userIdClaim, out var userId))
                {
                    currentUserId = userId;
                    await LoadFavorites();
                }
            }
            else
            {
                isAuthenticated = false;
            }
        }
        catch
        {
            isAuthenticated = false;
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadFavorites()
    {
        if (currentUserId <= 0)
            return;

        try
        {
            // Get total count
            totalCount = FavoriteService.GetUserFavoriteCount(currentUserId);
            totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));

            // Get favorites for current page
            var offset = (currentPage - 1) * PageSize;
            favorites = FavoriteService.GetUserFavorites(currentUserId, PageSize, offset).ToList();
        }
        catch
        {
            favorites = new List<BlogModels.UserFavorite>();
            totalCount = 0;
            totalPages = 1;
        }
    }

    private async Task HandlePageChanged(int page)
    {
        currentPage = page;
        isLoading = true;
        StateHasChanged();
        
        await LoadFavorites();
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleFavoriteToggle(BlogModels.UserFavorite favorite, bool isFavorited)
    {
        if (!isFavorited)
        {
            // Remove from local list immediately for responsive UI
            favorites.Remove(favorite);
            totalCount = Math.Max(0, totalCount - 1);
            
            // Recalculate total pages
            totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
            
            // If current page is now empty and not the first page, go to previous page
            if (favorites.Count == 0 && currentPage > 1)
            {
                currentPage--;
                await LoadFavorites();
            }
            
            StateHasChanged();
        }
    }

    /// <summary>
    /// Gets the first tag as category, or "General".
    /// </summary>
    private string GetCategory(string? tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return "General";

        var firstTag = tags.Split(',').FirstOrDefault()?.Trim();
        return string.IsNullOrEmpty(firstTag) ? "General" : firstTag;
    }

    /// <summary>
    /// Gets a short excerpt from content.
    /// </summary>
    private string GetExcerpt(string? content, int maxLength = 120)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;

        // Strip markdown/HTML basic
        var text = content
            .Replace("#", "")
            .Replace("*", "")
            .Replace("_", "")
            .Replace("`", "")
            .Trim();

        if (text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength).TrimEnd() + "...";
    }

    /// <summary>
    /// Gets a relative date string (e.g., "2 days ago").
    /// </summary>
    private string GetRelativeDate(DateTime date)
    {
        var diff = DateTime.UtcNow - date;
        
        if (diff.TotalMinutes < 1)
            return "just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays}d ago";
        if (diff.TotalDays < 30)
            return $"{(int)(diff.TotalDays / 7)}w ago";
        
        return date.ToString("MMM dd");
    }
}

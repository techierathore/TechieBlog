@*
    AccessDenied.razor
    Purpose: Shown when an authenticated user reaches a page their role cannot open.

    REQ-UI-048 — rebuilt on TrBlazeUI; the previous <style> block is gone and the
    surface is now token-driven, so it is readable in dark mode (REQ-UI-033).
    Layout: AuthLayout (bare centered card, per the UI design spec).
*@

@page "/access-denied"
@layout BlogUI.Layouts.AuthLayout
@using System.Security.Claims

<PageTitle>Access denied - TechieBlog</PageTitle>

<Card data-testid="access-denied">
    <CardHeader Class="items-center text-center">
        <div class="mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-destructive/10 text-destructive">
            <LucideIcon Name="shield-alert" Size="24" />
        </div>
        <CardTitle>Access Denied</CardTitle>
        <CardDescription>You don't have permission to access this page.</CardDescription>
    </CardHeader>

    <CardContent>
        <p class="m-0 text-center text-sm text-muted-foreground">
            If you believe this is an error, please contact an administrator.
        </p>
    </CardContent>

    <CardFooter Class="flex-col gap-2 sm:flex-row">
        <Button Href="/" Class="w-full" data-testid="access-denied-home">
            Go to Home
        </Button>
        @if (HasStaffLanding)
        {
            <Button Href="@LandingRoute"
                    Variant="ButtonVariant.Outline"
                    Class="w-full"
                    data-testid="access-denied-dashboard">
                Go to Dashboard
            </Button>
        }
    </CardFooter>
</Card>

@code {
    /// <summary>
    /// Cascading authentication state used to read the signed-in user's role.
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>The route this user's role is allowed to land on.</summary>
    private string LandingRoute { get; set; } = RoleLandingRoutes.PublicHome;

    /// <summary>
    /// True when the role has a staff surface, so the second button is worth offering.
    /// </summary>
    /// <remarks>
    /// REQ-UI-001: the button used to hardcode <c>/admin</c>, which for an Author or a
    /// Contributor denied them again from the very page telling them they were denied.
    /// </remarks>
    private bool HasStaffLanding => LandingRoute != RoleLandingRoutes.PublicHome;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
        {
            return;
        }

        var authState = await AuthStateTask;
        var role = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
        LandingRoute = RoleLandingRoutes.ResolveFor(role);
    }
}

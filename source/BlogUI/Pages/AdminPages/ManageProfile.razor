@*
    ManageProfile.razor
    Purpose: Self-service profile management page for authors/admins.
    Allows users to update their profile information, social links, and resume settings.

    Usage: Navigate to /admin/profile
    Dependencies: AdminLayout, UserRepo, AuthSvc, ImagePicker, TrBlazeUI (REQ-UI-040 / REQ-UI-048)
    Authorization: AuthorOrAbove policy (any logged in user)
*@
@page "/admin/profile"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout
@using BlogUI.Components

<PageTitle>My Profile - TechieBlog</PageTitle>

<div class="mx-auto flex max-w-4xl flex-col gap-6" data-testid="manage-profile-page">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">My Profile</h1>
        <Button OnClick="@SaveProfile" Disabled="@IsSaving" data-testid="save-profile">
            @if (IsSaving)
            {
                <Spinner Size="SpinnerSize.Small" />
                <span>Saving...</span>
            }
            else
            {
                <LucideIcon Name="save" Size="16" />
                <span>Save</span>
            }
        </Button>
    </div>

    @if (IsLoading)
    {
        <div class="flex items-center justify-center gap-3 py-12" data-testid="profile-loading">
            <Spinner />
            <span class="text-muted-foreground">Loading profile...</span>
        </div>
    }
    else if (CurrentUser is null)
    {
        <Alert Variant="AlertVariant.Danger" data-testid="profile-load-error">
            <LucideIcon Name="circle-alert" Size="16" />
            <AlertTitle>Profile unavailable</AlertTitle>
            <AlertDescription>Unable to load profile. Please try logging in again.</AlertDescription>
        </Alert>
        <div>
            <Button Href="/admin/login" data-testid="go-to-login">Go to Login</Button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)" data-testid="profile-status">
                <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
                <AlertTitle>@(IsError ? "Something went wrong" : "Saved")</AlertTitle>
                <AlertDescription>@StatusMessage</AlertDescription>
            </Alert>
        }

        <EditForm Model="@ProfileModel" OnValidSubmit="@SaveProfile">
            <DataAnnotationsValidator />

            <div class="flex flex-col gap-6">

                @* ---------- Basic info ---------- *@
                <Card data-testid="basic-info-card">
                    <CardHeader>
                        <CardTitle>Basic info</CardTitle>
                        <CardDescription>How you appear across the blog and your public resume.</CardDescription>
                    </CardHeader>
                    <CardContent Class="flex flex-col gap-5">

                        <Field>
                            <FieldLabel>Avatar</FieldLabel>
                            <FieldContent>
                                <ImagePicker Category="profiles"
                                             @bind-SelectedImagePath="ProfileModel.ProfileImagePath"
                                             UserId="@CurrentUserId" />
                            </FieldContent>
                        </Field>

                        <div class="grid gap-5 sm:grid-cols-2">
                            <Field>
                                <FieldLabel For="first-name">First Name</FieldLabel>
                                <FieldContent>
                                    <Input Id="first-name"
                                           @bind-Value="ProfileModel.FirstName"
                                           Required="true"
                                           Disabled="@IsSaving"
                                           data-testid="first-name-input" />
                                </FieldContent>
                            </Field>

                            <Field>
                                <FieldLabel For="last-name">Last Name</FieldLabel>
                                <FieldContent>
                                    <Input Id="last-name"
                                           @bind-Value="ProfileModel.LastName"
                                           Required="true"
                                           Disabled="@IsSaving"
                                           data-testid="last-name-input" />
                                </FieldContent>
                            </Field>
                        </div>

                        <Field IsInvalid="@(!IsUsernameValid)">
                            <FieldLabel For="username">Username</FieldLabel>
                            <FieldContent>
                                <Input Id="username"
                                       Value="@ProfileModel.Username"
                                       ValueChanged="@OnUsernameChangedAsync"
                                       Placeholder="e.g., john-doe"
                                       Disabled="@IsSaving"
                                       Class="font-mono"
                                       data-testid="username-input" />
                                <FieldDescription>URL-safe: letters, numbers, and hyphens only</FieldDescription>
                                @if (!string.IsNullOrEmpty(UsernameValidationMessage))
                                {
                                    @if (IsUsernameValid)
                                    {
                                        <FieldDescription data-testid="username-hint">@UsernameValidationMessage</FieldDescription>
                                    }
                                    else
                                    {
                                        <FieldError data-testid="username-hint">@UsernameValidationMessage</FieldError>
                                    }
                                }
                            </FieldContent>
                        </Field>

                        <div class="grid gap-5 sm:grid-cols-2">
                            <Field>
                                <FieldLabel For="title">Title</FieldLabel>
                                <FieldContent>
                                    <Input Id="title"
                                           @bind-Value="ProfileModel.Title"
                                           Placeholder="e.g., Senior Software Engineer"
                                           Disabled="@IsSaving"
                                           data-testid="title-input" />
                                </FieldContent>
                            </Field>

                            <Field>
                                <FieldLabel For="tagline">Tagline</FieldLabel>
                                <FieldContent>
                                    <Input Id="tagline"
                                           @bind-Value="ProfileModel.Tagline"
                                           Placeholder="e.g., Building the future, one line at a time"
                                           Disabled="@IsSaving"
                                           data-testid="tagline-input" />
                                </FieldContent>
                            </Field>
                        </div>

                        <Field>
                            <FieldLabel For="bio">Bio</FieldLabel>
                            <FieldContent>
                                <Textarea Id="bio"
                                          @bind-Value="ProfileModel.ProfileDescription"
                                          Placeholder="Tell us about yourself..."
                                          Disabled="@IsSaving"
                                          Class="min-h-28"
                                          data-testid="bio-input" />
                            </FieldContent>
                        </Field>

                    </CardContent>
                </Card>

                @* ---------- Social links ---------- *@
                <Card data-testid="social-links-card">
                    <CardHeader>
                        <CardTitle>Social links</CardTitle>
                        <CardDescription>Leave a field blank to hide that icon on the public site.</CardDescription>
                    </CardHeader>
                    <CardContent Class="grid gap-5 sm:grid-cols-2">

                        <Field>
                            <FieldLabel For="linkedin">LinkedIn</FieldLabel>
                            <FieldContent>
                                <Input Id="linkedin"
                                       Type="InputType.Url"
                                       @bind-Value="ProfileModel.LinkedInUrl"
                                       Placeholder="https://linkedin.com/in/username"
                                       Disabled="@IsSaving"
                                       Class="font-mono"
                                       data-testid="linkedin-input" />
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="github">GitHub</FieldLabel>
                            <FieldContent>
                                <Input Id="github"
                                       Type="InputType.Url"
                                       @bind-Value="ProfileModel.GitHubUrl"
                                       Placeholder="https://github.com/username"
                                       Disabled="@IsSaving"
                                       Class="font-mono"
                                       data-testid="github-input" />
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="twitter">Twitter</FieldLabel>
                            <FieldContent>
                                <Input Id="twitter"
                                       Type="InputType.Url"
                                       @bind-Value="ProfileModel.TwitterUrl"
                                       Placeholder="https://twitter.com/username"
                                       Disabled="@IsSaving"
                                       Class="font-mono"
                                       data-testid="twitter-input" />
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="instagram">Instagram</FieldLabel>
                            <FieldContent>
                                <Input Id="instagram"
                                       Type="InputType.Url"
                                       @bind-Value="ProfileModel.InstagramUrl"
                                       Placeholder="https://instagram.com/username"
                                       Disabled="@IsSaving"
                                       Class="font-mono"
                                       data-testid="instagram-input" />
                            </FieldContent>
                        </Field>

                    </CardContent>
                </Card>

                @* ---------- Resume settings ---------- *@
                <Card data-testid="resume-settings-card">
                    <CardHeader>
                        <CardTitle>Resume settings</CardTitle>
                        <CardDescription>Controls the public resume page at /resume/{username}.</CardDescription>
                    </CardHeader>
                    <CardContent Class="flex flex-col gap-5">

                        <div class="flex items-center gap-3">
                            <Checkbox Id="resume-enabled"
                                      @bind-Checked="ProfileModel.ResumeEnabled"
                                      Disabled="@IsSaving"
                                      data-testid="resume-enabled-checkbox" />
                            <Label For="resume-enabled">Show resume on profile</Label>
                        </div>

                        <div class="grid gap-5 sm:grid-cols-2">
                            <Field>
                                <FieldLabel For="phone">Phone</FieldLabel>
                                <FieldContent>
                                    <Input Id="phone"
                                           Type="InputType.Tel"
                                           @bind-Value="ProfileModel.PhoneNumber"
                                           Placeholder="+1 (555) 123-4567"
                                           Disabled="@IsSaving"
                                           data-testid="phone-input" />
                                </FieldContent>
                            </Field>

                            <Field>
                                <FieldLabel For="location">Location</FieldLabel>
                                <FieldContent>
                                    <Input Id="location"
                                           @bind-Value="ProfileModel.Location"
                                           Placeholder="e.g., San Francisco, CA"
                                           Disabled="@IsSaving"
                                           data-testid="location-input" />
                                </FieldContent>
                            </Field>
                        </div>

                        <Field>
                            <FieldLabel>CV</FieldLabel>
                            <FieldContent>
                                <ImagePicker Category="cv"
                                             @bind-SelectedImagePath="ProfileModel.CVFilePath"
                                             UserId="@CurrentUserId" />
                            </FieldContent>
                        </Field>

                    </CardContent>
                </Card>

                @* ---------- Quick links ---------- *@
                <Card data-testid="quick-links-card">
                    <CardHeader>
                        <CardTitle>Quick links</CardTitle>
                        <CardDescription>Manage the sections that make up your resume.</CardDescription>
                    </CardHeader>
                    <CardContent Class="flex flex-wrap gap-3">
                        <Button Href="/admin/experience" Variant="ButtonVariant.Outline" data-testid="manage-experience-link">
                            <LucideIcon Name="briefcase" Size="16" />
                            Manage Experience
                            <LucideIcon Name="arrow-right" Size="16" />
                        </Button>
                        <Button Href="/admin/skills" Variant="ButtonVariant.Outline" data-testid="manage-skills-link">
                            <LucideIcon Name="code" Size="16" />
                            Manage Skills
                            <LucideIcon Name="arrow-right" Size="16" />
                        </Button>
                        <Button Href="/admin/awards" Variant="ButtonVariant.Outline" data-testid="manage-awards-link">
                            <LucideIcon Name="award" Size="16" />
                            Manage Awards
                            <LucideIcon Name="arrow-right" Size="16" />
                        </Button>
                        <Button Href="/admin/stats" Variant="ButtonVariant.Outline" data-testid="manage-stats-link">
                            <LucideIcon Name="trending-up" Size="16" />
                            Manage Statistics
                            <LucideIcon Name="arrow-right" Size="16" />
                        </Button>
                    </CardContent>
                </Card>

            </div>
        </EditForm>
    }
</div>

@*
    BlogsList.razor
    Purpose: Displays a list of blog posts for administration.
    Provides editing and deletion capabilities for blog post management.

    Usage: Navigate to /BlogsList
    Dependencies: TrBlazeUI.Components (REQ-UI-048)
    Authorization: AuthorOrAbove policy required (REQ-UI-017 / BRD-14) — the post
                   editor is AuthorOrAbove, so the post LIST must be reachable by an
                   Author too. Row scoping is enforced server-side: BlogSvc.GetAllPosts
                   returns only the caller's own posts unless they are Editor or Admin.
*@
@page "/BlogsList"
@attribute [Authorize(Policy = AppPolicies.AuthorOrAbove)]
@layout BlogUI.Layouts.AdminLayout

@* [REQ-NFR-007] WCAG 2.4.2 Page Titled (Level A) — without this the page inherits the
   shell title and every admin screen announces itself as just the site name. *@
<SiteBrandTitle Page="Posts" />

<div class="mx-auto max-w-[1400px] space-y-6">

    @* ---- Page header --------------------------------------------------- *@
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-foreground">All Posts</h1>
            <p class="text-sm text-muted-foreground">
                @PageDescription
            </p>
        </div>
        <Button Href="/ManagePost" data-testid="new-post">
            <LucideIcon Name="plus" Size="16" />
            New Post
        </Button>
    </div>

    @* ---- Status message ------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
               data-testid="posts-status-message">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* ---- Filter row ---------------------------------------------------- *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        @*
            Each trigger's test hook sits on <TabsTrigger> itself. Up to TrBlazeUI 2.0.1
            TabsList/TabsTrigger declared no CaptureUnmatchedValues, so a data-testid on either
            threw at render and the ErrorBoundary swallowed the whole page behind an HTTP 200 —
            this page was unreachable, and every hook had to ride on a span this page owned
            (TR-030/TR-046). 2.0.2 splats on all 344 components, so the spans are gone.
        *@
        @*
            [REQ-UI-017] 2026-08-09 — the four triggers measure ~411px, so on a 390px phone the
            "Scheduled (n)" tab used to be CLIPPED: TabsList is `inline-flex` (content-sized) and
            nothing on the page scrolls horizontally, so the overflowing 21px were simply
            unreachable and the count digit was cut in half. This wrapper caps the row at the
            viewport width and makes the overflow SCROLLABLE instead of clipped; at 1280px the
            row fits and no scrollbar appears. `w-full sm:w-auto` keeps the tabs and the search
            box side by side on desktop and stacked on a phone.
        *@
        <div class="w-full min-w-0 overflow-x-auto sm:w-auto" data-testid="posts-status-tabs-scroller">
            <Tabs Value="@StatusFilter"
                  ValueChanged="@((string value) => SetFilter(value))"
                  data-testid="posts-status-tabs">
                <TabsList Class="w-max">
                    <TabsTrigger Value="all" data-testid="posts-tab-all">All (@(ObjectList?.Count ?? 0))</TabsTrigger>
                    <TabsTrigger Value="published" data-testid="posts-tab-published">Published (@PublishedCount)</TabsTrigger>
                    <TabsTrigger Value="draft" data-testid="posts-tab-draft">Drafts (@DraftCount)</TabsTrigger>
                    <TabsTrigger Value="scheduled" data-testid="posts-tab-scheduled">Scheduled (@ScheduledCount)</TabsTrigger>
                </TabsList>
            </Tabs>
        </div>

        <div class="flex items-center gap-2">
            <LucideIcon Name="search" Size="16" Class="text-muted-foreground" />
            <Input Type="InputType.Search"
                   @bind-Value="SearchTerm"
                   @bind-Value:after="ApplyFilter"
                   Placeholder="Search posts..."
                   Class="min-w-[200px]"
                   AriaLabel="Search posts"
                   data-testid="posts-search" />
        </div>
    </div>

    @* ---- Posts table --------------------------------------------------- *@
    @if (ObjectList == null)
    {
        <div class="flex flex-col items-center gap-2 py-8" data-testid="posts-loading">
            <Spinner />
            <span class="text-sm text-muted-foreground">Loading...</span>
        </div>
    }
    else if (FilteredList == null || FilteredList.Count == 0)
    {
        <Empty Title="@EmptyTitle" Description="@EmptyDescription" data-testid="posts-empty">
            <Icon><LucideIcon Name="inbox" Size="48" /></Icon>
            <ChildContent>
                @if (HasActiveFilters)
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="ClearFilters" data-testid="posts-clear-filters">
                        Clear Filters
                    </Button>
                }
                else
                {
                    <Button Href="/ManagePost" data-testid="posts-empty-new-post">New Post</Button>
                }
            </ChildContent>
        </Empty>
    }
    else
    {
        <DataTable TData="BlogPost"
                   Data="@FilteredList"
                   InitialPageSize="20"
                   AriaLabel="Posts"
                   data-testid="posts-grid">
            <Columns>
                <DataTableColumn TData="BlogPost" TValue="bool" Property="@(p => p.IsSelected)" Header="" Width="48px">
                    <CellTemplate Context="row">
                        <Checkbox @bind-Checked="row.IsSelected"
                                  AriaLabel="Select post"
                                  data-testid="post-row-select" />
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogPost" TValue="string" Property="@(p => p.Title)" Header="Title" Sortable Filterable>
                    <CellTemplate Context="row">
                        <a href="/ManagePost/@row.PostID"
                           class="font-semibold text-foreground hover:text-primary hover:underline"
                           data-testid="post-row-title">@row.Title</a>
                        @if (!string.IsNullOrEmpty(row.Slug))
                        {
                            <div class="text-xs text-muted-foreground" data-testid="post-row-slug">/@row.Slug</div>
                        }
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogPost" TValue="string" Property="@(p => p.BlogWriter)" Header="Author" Sortable>
                    <CellTemplate Context="row">
                        <span data-testid="post-row-author">@(row.BlogWriter ?? "Unknown")</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogPost" TValue="bool" Property="@(p => p.Published)" Header="Status" Sortable>
                    <CellTemplate Context="row">
                        @if (row.Published)
                        {
                            <Badge data-testid="post-row-status">Published</Badge>
                        }
                        else if (row.IsScheduled)
                        {
                            <Badge Variant="BadgeVariant.Outline" data-testid="post-row-status">
                                @(row.ScheduledPublishOn?.ToLocalTime().ToString("MMM dd") ?? "Scheduled")
                            </Badge>
                        }
                        else
                        {
                            <Badge Variant="BadgeVariant.Secondary" data-testid="post-row-status">Draft</Badge>
                        }
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogPost" TValue="DateTime" Property="@(p => p.CreatedOn)" Header="Date" Sortable>
                    <CellTemplate Context="row">
                        <span data-testid="post-row-date">
                            @((row.Published && row.PublishedOn.HasValue
                                ? row.PublishedOn.Value
                                : row.CreatedOn).ToString("MMM dd, yyyy"))
                        </span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogPost" TValue="long" Property="@(p => p.PostID)" Header="Actions" Width="180px">
                    <CellTemplate Context="row">
                        <div class="flex flex-nowrap items-center gap-1">
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    OnClick="@(() => NavigateToPreviewAsync(row))"
                                    AriaLabel="Preview post"
                                    data-testid="post-preview">
                                <LucideIcon Name="eye" Size="16" />
                            </Button>

                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Href="@($"/ManagePost/{row.PostID}")"
                                    AriaLabel="Edit post"
                                    data-testid="post-edit">
                                <LucideIcon Name="pencil" Size="16" />
                            </Button>

                            @if (row.IsScheduled)
                            {
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => QuickPublishAsync(row))"
                                        Disabled="@IsProcessing"
                                        AriaLabel="Publish now"
                                        data-testid="post-publish">
                                    <LucideIcon Name="send" Size="16" />
                                </Button>
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => CancelScheduleAsync(row))"
                                        Disabled="@IsProcessing"
                                        AriaLabel="Cancel schedule"
                                        data-testid="post-cancel-schedule">
                                    <LucideIcon Name="calendar-x" Size="16" />
                                </Button>
                            }
                            else if (!row.Published)
                            {
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => QuickPublishAsync(row))"
                                        Disabled="@IsProcessing"
                                        AriaLabel="Publish post"
                                        data-testid="post-publish">
                                    <LucideIcon Name="send" Size="16" />
                                </Button>
                            }
                            else
                            {
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => QuickUnpublishAsync(row))"
                                        Disabled="@IsProcessing"
                                        AriaLabel="Unpublish post"
                                        data-testid="post-unpublish">
                                    <LucideIcon Name="undo-2" Size="16" />
                                </Button>
                            }

                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Class="text-destructive"
                                    OnClick="@(() => ShowDeleteDialog(row))"
                                    AriaLabel="Delete post"
                                    data-testid="post-delete">
                                <LucideIcon Name="trash-2" Size="16" />
                            </Button>
                        </div>
                    </CellTemplate>
                </DataTableColumn>
            </Columns>
        </DataTable>

        @* ---- Bulk actions footer --------------------------------------- *@
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <Checkbox Id="posts-select-all"
                              Checked="@SelectAll"
                              CheckedChanged="@OnSelectAllChanged"
                              data-testid="posts-select-all" />
                    <Label For="posts-select-all">Select all</Label>
                </div>

                <Select TValue="string" @bind-Value="BulkAction" Class="w-[170px]">
                    <SelectTrigger data-testid="posts-bulk-action">
                        <SelectValue Placeholder="Bulk Actions" />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectItem TValue="string" Value="@("publish")" Text="Publish">Publish</SelectItem>
                        <SelectItem TValue="string" Value="@("unpublish")" Text="Unpublish">Unpublish</SelectItem>
                        <SelectItem TValue="string" Value="@("delete")" Text="Delete">Delete</SelectItem>
                    </SelectContent>
                </Select>

                <Button Variant="ButtonVariant.Outline"
                        OnClick="ApplyBulkActionAsync"
                        Disabled="@(string.IsNullOrEmpty(BulkAction) || !HasSelectedPosts)"
                        data-testid="posts-bulk-apply">
                    Apply
                </Button>
            </div>

            <span class="text-sm text-muted-foreground" data-testid="posts-count">
                Showing @FilteredList.Count of @(ObjectList?.Count ?? 0) posts
            </span>
        </div>
    }
</div>

@* ---- Delete confirmation ------------------------------------------------ *@
<Dialog @bind-Open="ShowDeleteConfirm">
    <DialogContent data-testid="post-delete-dialog">
        <DialogHeader>
            <DialogTitle>Confirm Delete</DialogTitle>
            <DialogDescription>This action cannot be undone.</DialogDescription>
        </DialogHeader>
        <p class="text-sm text-foreground">
            Are you sure you want to delete the post "<strong data-testid="post-delete-title">@PostToDelete?.Title</strong>"?
        </p>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CancelDelete" data-testid="post-delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="@ConfirmDeleteAsync" data-testid="post-delete-confirm">
                Delete
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>


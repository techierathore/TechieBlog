@*
    ChangePasswordPage.razor
    Purpose: Lets a signed-in user replace their password, and is the screen a
             MustChangePassword account is held on until it does so.

    REQ-NFR-023 / BRD-79 — "hash the seeded admin credential AND require a password
    change on first login". The hashing half was already done in 003-SeedData.sql;
    this page is the missing second half. Every seeded and admin-created account is
    flagged MustChangePassword, but before this page existed there was no
    change-password route anywhere in BlogUI, so the flag was stored and ignored and
    the well-known bootstrap password stayed live.

    REQ-FN-006 — the replacement is validated by PasswordValidator inside
    AuthSvc.ChangePasswordAsync, so the strength rules cannot be bypassed here.

    Layout: AuthLayout (centered card, no site nav) — a user who has not yet changed
    their password should not be offered the site's navigation.
*@

@layout BlogUI.Layouts.AuthLayout
@page "/change-password"
@attribute [Authorize]
@inject BlogEngine.Services.AuthSvc AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Change password - TechieBlog</PageTitle>

<Card data-testid="change-password-card">
    <CardHeader>
        <CardTitle>Change password</CardTitle>
        <CardDescription>
            @if (isForced)
            {
                <span data-testid="change-password-forced">
                    This account still uses the password it was created with. Choose your own
                    password to continue.
                </span>
            }
            else
            {
                <span>Enter your current password and choose a new one.</span>
            }
        </CardDescription>
    </CardHeader>

    <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
        <CardContent Class="flex flex-col gap-4">

            @if (!string.IsNullOrEmpty(message))
            {
                <Alert Variant="@(isSuccess ? AlertVariant.Success : AlertVariant.Danger)"
                       data-testid="change-password-message">
                    <AlertDescription>@message</AlertDescription>
                </Alert>
            }

            <Field>
                <FieldLabel For="current-password">Current password</FieldLabel>
                <FieldContent>
                    <Input Id="current-password"
                           Type="InputType.Password"
                           Placeholder="Enter current password"
                           Required="true"
                           Disabled="@isSubmitting"
                           @bind-Value="model.CurrentPassword"
                           data-testid="change-password-current" />
                </FieldContent>
            </Field>

            <Field>
                <FieldLabel For="new-password">New password</FieldLabel>
                <FieldContent>
                    <Input Id="new-password"
                           Type="InputType.Password"
                           Placeholder="Enter new password"
                           Required="true"
                           Disabled="@isSubmitting"
                           @bind-Value="model.NewPassword"
                           data-testid="change-password-new" />
                    <FieldDescription>
                        Minimum 8 characters, including uppercase, lowercase and a number.
                    </FieldDescription>
                </FieldContent>
            </Field>

            <Field>
                <FieldLabel For="confirm-password">Confirm new password</FieldLabel>
                <FieldContent>
                    <Input Id="confirm-password"
                           Type="InputType.Password"
                           Placeholder="Confirm new password"
                           Required="true"
                           Disabled="@isSubmitting"
                           @bind-Value="model.ConfirmPassword"
                           data-testid="change-password-confirm" />
                </FieldContent>
            </Field>
        </CardContent>

        <CardFooter Class="flex-col gap-3">
            <Button Type="ButtonType.Submit"
                    Class="w-full"
                    Disabled="@isSubmitting"
                    data-testid="change-password-submit">
                @if (isSubmitting)
                {
                    <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                    <span>Changing...</span>
                }
                else
                {
                    <span>Change Password</span>
                }
            </Button>
        </CardFooter>
    </EditForm>
</Card>

@code {
    private readonly ChangePasswordModel model = new();
    private string message = string.Empty;
    private bool isSuccess;
    private bool isSubmitting;
    private bool isForced;
    private long signedInUserId;
    private string signedInRole = string.Empty;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;

        isForced = string.Equals(
            user.FindFirst(CustomAuthStateProvider.MustChangePasswordClaim)?.Value,
            "true",
            StringComparison.OrdinalIgnoreCase);

        signedInRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
        _ = long.TryParse(
            user.FindFirst(System.Security.Claims.ClaimTypes.PrimarySid)?.Value, out signedInUserId);
    }

    /// <summary>
    /// Rotates the password and, on success, releases the user from the forced-change screen.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> the confirmation match is checked here because it is a form
    /// concern; everything that matters to security — the current password, the strength rules and
    /// the clearing of the MustChangePassword flag — is checked and applied inside
    /// <c>AuthSvc.ChangePasswordAsync</c>, so this page cannot weaken any of it.</para>
    /// <para><b>Flow:</b> confirm match → change → refresh the principal → navigate to the role's
    /// landing route.</para>
    /// <para><b>Side Effects:</b> Rotates the stored hash and clears the forced-change flag.</para>
    /// </remarks>
    private async Task HandleSubmit()
    {
        if (isSubmitting)
        {
            return;
        }

        message = string.Empty;

        if (model.NewPassword != model.ConfirmPassword)
        {
            isSuccess = false;
            message = "Passwords do not match.";
            return;
        }

        isSubmitting = true;

        try
        {
            var result = await AuthService.ChangePasswordAsync(
                signedInUserId, model.CurrentPassword, model.NewPassword);

            isSuccess = result.IsSuccess;
            message = result.IsSuccess
                ? "Your password has been changed. Redirecting..."
                : result.ErrorMessage;

            if (!result.IsSuccess)
            {
                return;
            }

            model.CurrentPassword = string.Empty;
            model.NewPassword = string.Empty;
            model.ConfirmPassword = string.Empty;
            isForced = false;

            // Rebuild the principal from the database so the now-cleared flag reaches the router,
            // otherwise the guard would keep bouncing the user straight back to this screen.
            await ((CustomAuthStateProvider)AuthStateProvider).RefreshAuthenticationStateAsync();

            StateHasChanged();
            await Task.Delay(1200);
            Navigation.NavigateTo(RoleLandingRoutes.ResolveFor(signedInRole));
        }
        catch (Exception)
        {
            isSuccess = false;
            message = "An error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    /// <summary>
    /// Form model backing the three password fields.
    /// </summary>
    private sealed class ChangePasswordModel
    {
        /// <summary>The password currently in force, for confirmation.</summary>
        public string CurrentPassword { get; set; } = string.Empty;

        /// <summary>The replacement password.</summary>
        public string NewPassword { get; set; } = string.Empty;

        /// <summary>Confirmation copy of the replacement password.</summary>
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

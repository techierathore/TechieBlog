@*
    SeriesList.razor
    Purpose: Displays a list of blog series for administration.
    Provides editing and deletion capabilities for series management.

    Usage: Navigate to /admin/series
    Dependencies: TrBlazeUI.Components (REQ-UI-048)
    Authorization: AuthorOrAbove policy required
*@
@page "/admin/series"
@page "/SeriesList"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.SeriesSvc SeriesService
@inject NavigationManager Navigation

<div class="mx-auto max-w-[1400px] space-y-6">

    @* ---- Page header --------------------------------------------------- *@
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-foreground">Series Management</h1>
            <p class="text-sm text-muted-foreground">Multi-part collections of related posts.</p>
        </div>
        <Button Href="/admin/series/new" data-testid="new-series">
            <LucideIcon Name="plus" Size="16" />
            Add New Series
        </Button>
    </div>

    @* ---- Status message ------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
               data-testid="series-status-message">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* ---- Filter row ---------------------------------------------------- *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        @*
            Each trigger's test hook sits on <TabsTrigger> itself. Up to TrBlazeUI 2.0.1
            TabsList/TabsTrigger declared no CaptureUnmatchedValues, so a data-testid on either
            threw at render and the ErrorBoundary swallowed the whole page behind an HTTP 200 —
            this page was unreachable, and every hook had to ride on a span this page owned
            (TR-030/TR-046). 2.0.2 splats on all 344 components, so the spans are gone.
        *@
        <Tabs Value="@StatusFilter"
              ValueChanged="@((string value) => SetFilter(value))"
              data-testid="series-status-tabs">
            <TabsList>
                <TabsTrigger Value="all" data-testid="series-tab-all">All (@(ObjectList?.Count ?? 0))</TabsTrigger>
                <TabsTrigger Value="inprogress" data-testid="series-tab-inprogress">@SeriesStatus.InProgress (@InProgressCount)</TabsTrigger>
                <TabsTrigger Value="complete" data-testid="series-tab-complete">@SeriesStatus.Completed (@CompleteCount)</TabsTrigger>
            </TabsList>
        </Tabs>

        <div class="flex items-center gap-2">
            <LucideIcon Name="search" Size="16" Class="text-muted-foreground" />
            <Input Type="InputType.Search"
                   @bind-Value="SearchTerm"
                   @bind-Value:after="ApplyFilter"
                   Placeholder="Search series..."
                   Class="min-w-[200px]"
                   AriaLabel="Search series"
                   data-testid="series-search" />
        </div>
    </div>

    @* ---- Series table --------------------------------------------------- *@
    @if (ObjectList == null)
    {
        <div class="flex flex-col items-center gap-2 py-8" data-testid="series-loading">
            <Spinner />
            <span class="text-sm text-muted-foreground">Loading...</span>
        </div>
    }
    else if (FilteredList == null || !FilteredList.Any())
    {
        <Empty Title="@EmptyTitle" Description="@EmptyDescription" data-testid="series-empty">
            <Icon><LucideIcon Name="layers" Size="48" /></Icon>
            <ChildContent>
                @if (HasActiveFilters)
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="ClearFilters" data-testid="series-clear-filters">
                        Clear Filters
                    </Button>
                }
                else
                {
                    <Button Href="/admin/series/new" data-testid="series-empty-new">Add New Series</Button>
                }
            </ChildContent>
        </Empty>
    }
    else
    {
        <DataTable TData="BlogSeries"
                   Data="@FilteredList"
                   InitialPageSize="20"
                   AriaLabel="Series"
                   data-testid="series-grid">
            <Columns>
                <DataTableColumn TData="BlogSeries" TValue="string" Property="@(s => s.Name)" Header="Series Name" Sortable Filterable>
                    <CellTemplate Context="row">
                        <span class="font-semibold text-foreground" data-testid="series-row-name">@row.Name</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogSeries" TValue="string" Property="@(s => s.Slug)" Header="Slug" Sortable>
                    <CellTemplate Context="row">
                        <span class="text-xs text-muted-foreground" data-testid="series-row-slug">/@row.Slug</span>
                    </CellTemplate>
                </DataTableColumn>

                @* 150px, not 130: "In Progress" wrapped onto two lines inside the badge at the
                   narrower width once the label became the stored literal (REQ-UI-024). *@
                <DataTableColumn TData="BlogSeries" TValue="bool" Property="@(s => s.IsComplete)" Header="Status" Sortable Width="150px">
                    <CellTemplate Context="row">
                        @* Labels are the stored literals themselves (SeriesStatus), so the grid can
                           never claim a status the database does not hold — REQ-UI-024. *@
                        @if (row.IsComplete)
                        {
                            <Badge data-testid="series-row-status">@SeriesStatus.Completed</Badge>
                        }
                        else
                        {
                            <Badge Variant="BadgeVariant.Outline" data-testid="series-row-status">@SeriesStatus.InProgress</Badge>
                        }
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogSeries" TValue="int" Property="@(s => s.PostCount)" Header="Posts" Sortable Width="100px">
                    <CellTemplate Context="row">
                        <Badge Variant="BadgeVariant.Secondary" data-testid="series-row-postcount">@row.PostCount</Badge>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogSeries" TValue="string" Property="@(s => s.AuthorName)" Header="Author" Sortable Width="160px">
                    <CellTemplate Context="row">
                        <span data-testid="series-row-author">@(string.IsNullOrEmpty(row.AuthorName) ? "Unknown" : row.AuthorName)</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogSeries" TValue="long" Property="@(s => s.SeriesId)" Header="Actions" Width="150px">
                    <CellTemplate Context="row">
                        <div class="flex flex-nowrap items-center gap-1">
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Href="@($"/series/{row.Slug}")"
                                    Target="_blank"
                                    AriaLabel="View series"
                                    data-testid="series-view">
                                <LucideIcon Name="eye" Size="16" />
                            </Button>
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Href="@($"/admin/series/{row.SeriesId}")"
                                    AriaLabel="Edit series"
                                    data-testid="series-edit">
                                <LucideIcon Name="pencil" Size="16" />
                            </Button>
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Class="text-destructive"
                                    OnClick="@(() => ConfirmDelete(row))"
                                    AriaLabel="Delete series"
                                    data-testid="series-delete">
                                <LucideIcon Name="trash-2" Size="16" />
                            </Button>
                        </div>
                    </CellTemplate>
                </DataTableColumn>
            </Columns>
        </DataTable>
    }
</div>

@* ---- Delete confirmation ------------------------------------------------ *@
<Dialog Open="@(!HideDeleteDialog)" OpenChanged="@OnDeleteDialogOpenChanged">
    <DialogContent data-testid="series-delete-dialog">
        <DialogHeader>
            <DialogTitle>Confirm Delete</DialogTitle>
            <DialogDescription>This action cannot be undone.</DialogDescription>
        </DialogHeader>
        <p class="text-sm text-foreground">
            Are you sure you want to delete the series
            "<strong data-testid="series-delete-name">@SeriesToDelete?.Name</strong>"?
        </p>
        @if (SeriesToDelete?.PostCount > 0)
        {
            <Alert Variant="AlertVariant.Warning" data-testid="series-delete-warning">
                <LucideIcon Name="triangle-alert" Size="16" />
                <AlertDescription>
                    This series has @SeriesToDelete.PostCount post(s). They will be removed from the series but not deleted.
                </AlertDescription>
            </Alert>
        }
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="CancelDelete" data-testid="series-delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="DeleteSeriesAsync" data-testid="series-delete-confirm">
                Delete
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@code {
    private List<BlogSeries> ObjectList;
    private List<BlogSeries> FilteredList;
    private BlogSeries SeriesToDelete;
    private bool HideDeleteDialog = true;
    private string StatusMessage = string.Empty;
    private bool IsError = false;
    private string SearchTerm = string.Empty;
    private string StatusFilter = "all";

    // Computed counts
    private int InProgressCount => ObjectList?.Count(s => !s.IsComplete) ?? 0;
    private int CompleteCount => ObjectList?.Count(s => s.IsComplete) ?? 0;
    private bool HasActiveFilters => StatusFilter != "all" || !string.IsNullOrEmpty(SearchTerm);

    private string EmptyTitle => HasActiveFilters ? "No series match your filters" : "No series yet";

    private string EmptyDescription => HasActiveFilters
        ? "Try a different status tab or clear the search term."
        : "Create your first series to group related posts together.";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadSeriesAsync();
    }

    /// <summary>Keeps the legacy hide-flag in sync with the dialog open state.</summary>
    /// <param name="isOpen">True when the dialog is open.</param>
    private void OnDeleteDialogOpenChanged(bool isOpen)
    {
        HideDeleteDialog = !isOpen;
        if (!isOpen)
        {
            SeriesToDelete = null;
        }
    }

    private async Task LoadSeriesAsync()
    {
        try
        {
            ObjectList = (await SeriesService.GetAllWithCountsAsync()).ToList();
            ApplyFilter();
        }
        catch
        {
            ObjectList = new List<BlogSeries>();
            FilteredList = new List<BlogSeries>();
            StatusMessage = "Failed to load series.";
            IsError = true;
        }
    }

    private void SetFilter(string filter)
    {
        StatusFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (ObjectList == null)
        {
            FilteredList = new List<BlogSeries>();
            return;
        }

        // Apply status filter
        var filtered = StatusFilter switch
        {
            "inprogress" => ObjectList.Where(s => !s.IsComplete),
            "complete" => ObjectList.Where(s => s.IsComplete),
            _ => ObjectList.AsEnumerable()
        };

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var searchLower = SearchTerm.ToLower();
            filtered = filtered.Where(s =>
                (s.Name?.ToLower().Contains(searchLower) ?? false) ||
                (s.Slug?.ToLower().Contains(searchLower) ?? false) ||
                (s.AuthorName?.ToLower().Contains(searchLower) ?? false));
        }

        FilteredList = filtered.ToList();
    }

    private void ClearFilters()
    {
        StatusFilter = "all";
        SearchTerm = string.Empty;
        ApplyFilter();
    }

    private void ConfirmDelete(BlogSeries series)
    {
        SeriesToDelete = series;
        HideDeleteDialog = false;
    }

    private void CancelDelete()
    {
        SeriesToDelete = null;
        HideDeleteDialog = true;
    }

    private async Task DeleteSeriesAsync()
    {
        if (SeriesToDelete == null) return;

        var result = await SeriesService.DeleteSeriesAsync(SeriesToDelete.SeriesId);
        if (result.IsSuccess)
        {
            StatusMessage = $"Series '{SeriesToDelete.Name}' deleted successfully.";
            IsError = false;
            await LoadSeriesAsync();
        }
        else
        {
            StatusMessage = result.ErrorMessage;
            IsError = true;
        }

        SeriesToDelete = null;
        HideDeleteDialog = true;
    }
}

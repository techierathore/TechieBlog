@*
    ForgotPasswordPage.razor
    Purpose: Forgot password page for password reset requests.
    Displays email input with instructions for password reset.

    Dependencies: AuthLayout, Fluent UI form components, AuthSvc
    Layout: Uses AuthLayout (centered card)
*@

@layout BlogUI.Layouts.AuthLayout
@page "/forgot-password"
@inject BlogEngine.Services.AuthSvc AuthService
@inject NavigationManager Navigation

<div class="auth-card__header">
    <h1 class="auth-card__title">Forgot Password?</h1>
    <p class="auth-card__subtitle">
        Enter your email address and we'll send you a link to reset your password.
    </p>
</div>

<EditForm Model="@model" OnValidSubmit="@HandleSubmit">
    <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <FluentTextField Id="email"
                         TextFieldType="TextFieldType.Email"
                         Placeholder="your@email.com"
                         Required="true"
                         Style="width: 100%;"
                         Disabled="@isSubmitting"
                         @bind-Value="model.Email" />
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <FluentMessageBar Intent="@(isSuccess ? MessageIntent.Success : MessageIntent.Error)"
                          Style="margin: 16px 0;">
            @message
        </FluentMessageBar>
    }

    <FluentButton Type="ButtonType.Submit"
                  Appearance="Appearance.Accent"
                  Style="width: 100%; margin-top: var(--spacing-md, 16px);"
                  Disabled="@isSubmitting">
        @if (isSubmitting)
        {
            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
            <span>Sending...</span>
        }
        else
        {
            <span>Send Reset Link</span>
        }
    </FluentButton>
</EditForm>

<div class="auth-card__footer">
    Remember your password? <a href="/admin/login" class="auth-link">Sign in</a>
</div>

@code {
    private ForgotPasswordModel model = new();
    private string message = string.Empty;
    private bool isSuccess = false;
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        isSubmitting = true;
        message = string.Empty;

        try
        {
            // Get base URL for building reset link
            var baseUrl = Navigation.BaseUri.TrimEnd('/');

            var result = await AuthService.RequestPasswordReset(model.Email, baseUrl);

            // Always show success message to avoid revealing if email exists
            isSuccess = true;
            message = "If an account exists with this email, you will receive a password reset link. Check your console/logs for the reset URL (dev mode).";
        }
        catch (Exception)
        {
            isSuccess = false;
            message = "An error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class ForgotPasswordModel
    {
        public string Email { get; set; } = string.Empty;
    }
}

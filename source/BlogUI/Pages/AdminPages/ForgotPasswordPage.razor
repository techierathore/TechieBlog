@*
    ForgotPasswordPage.razor
    Purpose: Requests a password-reset link for a staff account.

    REQ-UI-003 / BRD-4. REQ-UI-048 — rebuilt on TrBlazeUI.
    Also fixes a dead link: "Sign in" pointed at /admin/login, which is not a
    route in this application. The sign-in route is /login.
    Layout: AuthLayout (centered card, no site nav).
*@

@layout BlogUI.Layouts.AuthLayout
@page "/forgot-password"
@inject BlogEngine.Services.AuthSvc AuthService
@inject NavigationManager Navigation

<PageTitle>Forgot password - TechieBlog</PageTitle>

<Card data-testid="forgot-password-card">
    <CardHeader>
        <CardTitle>Forgot password?</CardTitle>
        <CardDescription>
            Enter your email address and we'll send you a link to reset your password.
        </CardDescription>
    </CardHeader>

    <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
        <CardContent Class="flex flex-col gap-4">

            @if (!string.IsNullOrEmpty(message))
            {
                <Alert Variant="@(isSuccess ? AlertVariant.Success : AlertVariant.Danger)"
                       data-testid="forgot-password-message">
                    <AlertDescription>@message</AlertDescription>
                </Alert>
            }

            <Field>
                <FieldLabel For="forgot-email">Email</FieldLabel>
                <FieldContent>
                    <Input Id="forgot-email"
                           Type="InputType.Email"
                           Placeholder="your@email.com"
                           Required="true"
                           Disabled="@isSubmitting"
                           @bind-Value="model.Email"
                           data-testid="forgot-email" />
                </FieldContent>
            </Field>
        </CardContent>

        <CardFooter Class="flex-col gap-3">
            <Button Type="ButtonType.Submit"
                    Class="w-full"
                    Disabled="@isSubmitting"
                    data-testid="forgot-submit">
                @if (isSubmitting)
                {
                    <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                    <span>Sending...</span>
                }
                else
                {
                    <span>Send Reset Link</span>
                }
            </Button>

            <p class="m-0 text-center text-sm text-muted-foreground">
                Remember your password?
                @* [REQ-NFR-007] WCAG 1.4.1 — a link inside a sentence cannot be identified by
                   colour alone, so it is underlined at rest, not only on hover. *@
                <a href="/login" class="text-primary underline" data-testid="forgot-signin">Sign in</a>
            </p>
        </CardFooter>
    </EditForm>
</Card>

@code {
    private readonly ForgotPasswordModel model = new();
    private string message = string.Empty;
    private bool isSuccess;
    private bool isSubmitting;

    /// <summary>
    /// Requests a reset link for the supplied address.
    /// </summary>
    /// <remarks>
    /// The outcome message is deliberately identical whether or not the address
    /// exists, so the form cannot be used to enumerate accounts.
    /// </remarks>
    private async Task HandleSubmit()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        message = string.Empty;

        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            await AuthService.RequestPasswordResetAsync(model.Email, baseUrl);

            isSuccess = true;
            message = "If an account exists with this email, you will receive a password reset link.";
        }
        catch (Exception)
        {
            isSuccess = false;
            message = "An error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    /// <summary>
    /// Form model backing the reset-request field.
    /// </summary>
    private sealed class ForgotPasswordModel
    {
        /// <summary>Email address to send the reset link to.</summary>
        public string Email { get; set; } = string.Empty;
    }
}

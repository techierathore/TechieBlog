@*
    ManageSeries.razor
    Purpose: Create and edit blog series.
    Provides form for series management with validation.

    Usage: Navigate to /admin/series/new or /admin/series/{PageId}
    Dependencies: TrBlazeUI (REQ-UI-048)
    Authorization: AuthorOrAbove policy required
*@
@page "/admin/series/new"
@page "/admin/series/{PageId:long}"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout

@* [REQ-NFR-007] WCAG 2.4.2 Page Titled (Level A) — without this the page inherits the
   shell title and every admin screen announces itself as just the site name. *@
<PageTitle>Series - TechieBlog</PageTitle>

<ContentPanel PanelTitle="@PageHeader">
    <RightSection></RightSection>
    <PanelContent>
        <div class="max-w-lg">
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
                       Class="mb-4"
                       data-testid="series-status-message">
                    <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
                    <AlertDescription>@StatusMessage</AlertDescription>
                </Alert>
            }

            @if (PageObj == null)
            {
                <div class="flex items-center gap-3 py-6" data-testid="series-loading">
                    <Spinner />
                    <span class="text-muted-foreground">Loading...</span>
                </div>
            }
            else
            {
                <EditForm Model="@PageObj" OnValidSubmit="@SaveDataAsync">
                    <DataAnnotationsValidator />
                    <div class="flex flex-col gap-4">

                        <Field>
                            <FieldLabel For="series-name">Series Name</FieldLabel>
                            <FieldContent>
                                <Input Id="series-name"
                                       @bind-Value="PageObj.Name"
                                       Placeholder="Enter series name"
                                       Required="true"
                                       data-testid="series-name-input" />
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="series-slug">Slug (URL-friendly name)</FieldLabel>
                            <FieldContent>
                                <Input Id="series-slug"
                                       @bind-Value="PageObj.Slug"
                                       Placeholder="auto-generated from name"
                                       data-testid="series-slug-input" />
                                <FieldDescription>Leave blank to auto-generate from series name</FieldDescription>
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="series-description">Description</FieldLabel>
                            <FieldContent>
                                <Textarea Id="series-description"
                                          @bind-Value="PageObj.Description"
                                          Placeholder="Description of this series shown on the series page"
                                          data-testid="series-description-input" />
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel>Status</FieldLabel>
                            <FieldContent>
                                <Select TValue="string" @bind-Value="PageObj.Status" Class="w-full">
                                    <SelectTrigger data-testid="series-status-select">
                                        <SelectValue Placeholder="Select status" />
                                    </SelectTrigger>
                                    <SelectContent>
                                        @* Values come from SeriesStatus so the picker cannot drift from
                                           what the database stores or what the list page filters on
                                           (REQ-UI-024). Never type the literal here. *@
                                        <SelectItem TValue="string" Value="@SeriesStatus.InProgress" Text="@SeriesStatus.InProgress">@SeriesStatus.InProgress</SelectItem>
                                        <SelectItem TValue="string" Value="@SeriesStatus.Completed" Text="@SeriesStatus.Completed">@SeriesStatus.Completed</SelectItem>
                                    </SelectContent>
                                </Select>
                                <FieldDescription>Mark as completed when all parts have been published</FieldDescription>
                            </FieldContent>
                        </Field>

                        @* Show posts in series if editing *@
                        @if (PageId > 0 && SeriesPosts != null && SeriesPosts.Count > 0)
                        {
                            <Card Class="mt-2" data-testid="series-posts-card">
                                <CardHeader>
                                    <CardTitle Class="text-base">Posts in this Series (@SeriesPosts.Count)</CardTitle>
                                </CardHeader>
                                <CardContent Class="flex flex-col gap-1">
                                    @foreach (var post in SeriesPosts.OrderBy(p => p.SeriesPartNumber))
                                    {
                                        <div class="flex items-center gap-2 py-1" data-testid="series-post-row">
                                            <span class="font-medium">Part @post.SeriesPartNumber:</span>
                                            <Button Href="@($"/ManagePost/{post.PostID}")"
                                                    Variant="ButtonVariant.Link"
                                                    Class="flex-1 justify-start px-1"
                                                    data-testid="series-post-title">
                                                @post.Title
                                            </Button>
                                            @if (post.Published)
                                            {
                                                <Badge Class="text-xs" data-testid="series-post-status">Published</Badge>
                                            }
                                            else
                                            {
                                                <Badge Variant="BadgeVariant.Secondary" Class="text-xs" data-testid="series-post-status">Draft</Badge>
                                            }
                                        </div>
                                    }
                                </CardContent>
                            </Card>
                        }

                        <div class="flex flex-wrap items-center gap-2 pt-2">
                            <Button Type="ButtonType.Submit" data-testid="save-series">
                                <LucideIcon Name="save" Size="16" />
                                Save
                            </Button>
                            <Button Href="/admin/series" Variant="ButtonVariant.Outline" data-testid="cancel-series">
                                Cancel
                            </Button>
                            @if (PageId > 0)
                            {
                                <Button Href="@($"/series/{PageObj.Slug}")"
                                        Target="_blank"
                                        Variant="ButtonVariant.Outline"
                                        data-testid="view-series">
                                    <LucideIcon Name="eye" Size="16" />
                                    View Series
                                </Button>
                            }
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </PanelContent>
</ContentPanel>

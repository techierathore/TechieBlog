@*
    LoginPage.razor
    Purpose: Credential sign-in for staff accounts.

    REQ-UI-001 / BRD-2 / BRD-93 — reached by direct URL only; no public page links
    here. Public self-service registration is retired (BRD-1), so there is no
    "Sign up" footer link any more.

    Layout: AuthLayout (centered card, fixed theme toggle, no site nav).
*@

@layout BlogUI.Layouts.AuthLayout
@page "/login"
@page "/LoginPage"
@page "/LoginPage/{PageCode}"

<SiteBrandTitle Page="Sign in" />

<Card data-testid="login-card">
    <CardHeader>
        <CardTitle>Welcome back</CardTitle>
        <CardDescription>Sign in to continue to your dashboard.</CardDescription>
    </CardHeader>

    <EditForm Model="@LoginDetails" OnValidSubmit="@ValidateUser">
        <CardContent Class="flex flex-col gap-4">

            @if (!string.IsNullOrEmpty(LoginMesssage))
            {
                <Alert Variant="AlertVariant.Danger" AccentBorder="true" data-testid="login-error">
                    <LucideIcon Name="circle-alert" Size="16" />
                    <AlertTitle>Sign-in failed</AlertTitle>
                    <AlertDescription>@LoginMesssage</AlertDescription>
                </Alert>
            }

            <Field>
                <FieldLabel For="login-email">Email</FieldLabel>
                <FieldContent>
                    <Input Id="login-email"
                           Type="InputType.Email"
                           Placeholder="your@email.com"
                           Required="true"
                           autofocus
                           @bind-Value="LoginDetails.LoginEmail"
                           data-testid="login-email" />
                </FieldContent>
            </Field>

            <Field>
                <FieldLabel For="login-password">Password</FieldLabel>
                <FieldContent>
                    <Input Id="login-password"
                           Type="InputType.Password"
                           Placeholder="Enter your password"
                           Required="true"
                           @bind-Value="LoginDetails.LoginPass"
                           data-testid="login-password" />
                </FieldContent>
            </Field>

            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <Checkbox Id="remember-me" @bind-Checked="rememberMe" data-testid="login-remember" />
                    <Label For="remember-me" Class="text-sm font-normal">Remember me</Label>
                </div>
                <a href="/forgot-password"
                   class="text-sm text-primary no-underline hover:underline"
                   data-testid="login-forgot">
                    Forgot password?
                </a>
            </div>
        </CardContent>

        <CardFooter>
            <Button Type="ButtonType.Submit"
                    Class="w-full"
                    Disabled="@isSubmitting"
                    data-testid="login-submit">
                @if (isSubmitting)
                {
                    <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </Button>
        </CardFooter>
    </EditForm>
</Card>

@code {
    private bool rememberMe;
}

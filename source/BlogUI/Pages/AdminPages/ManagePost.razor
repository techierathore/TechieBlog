@*
    ManagePost.razor
    Purpose: Create and edit blog posts.
    Provides form for post management with title, abstract, content, slug, and publish fields.

    Usage: Navigate to /ManagePost or /ManagePost/{PageId}
    Dependencies: Microsoft.FluentUI.AspNetCore.Components
    Authorization: AuthorOrAbove policy required
*@
@page "/ManagePost"
@page "/ManagePost/{PageId:long}"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout

<ContentPanel PanelTitle="@PageHeader">
    <RightSection></RightSection>
    <PanelContent>
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <FluentMessageBar Intent="@(IsError ? MessageIntent.Error : MessageIntent.Success)"
                              Style="margin-bottom: 16px;">
                @StatusMessage
            </FluentMessageBar>
        }

        @if (PageObj != null)
        {
            <EditForm Model="@PageObj" OnValidSubmit="@SaveData">
                <DataAnnotationsValidator />
                <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px; max-width: 800px;">
                    <FluentTextField Label="Blog Title"
                                     Value="@PageObj.Title"
                                     ValueChanged="@OnTitleChanged"
                                     Placeholder="Enter your blog title"
                                     Required="true"
                                     Style="width: 100%;" />

                    <FluentTextField Label="URL Slug"
                                     @bind-Value="PageObj.Slug"
                                     Placeholder="auto-generated-from-title"
                                     Style="width: 100%;">
                        <FluentLabel Slot="end" Style="color: var(--neutral-foreground-hint);">
                            @if (!string.IsNullOrEmpty(SlugPreview))
                            {
                                <span>/blog/@SlugPreview</span>
                            }
                        </FluentLabel>
                    </FluentTextField>

                    <FluentTextField Label="Blog Abstract"
                                     @bind-Value="PageObj.Abstract"
                                     Placeholder="Brief summary shown in post listings"
                                     Style="width: 100%;" />

                    <div>
                        <label style="display: block; margin-bottom: 4px;">Post Content (Markdown)</label>
                        <MarkdownEditor @bind-Value="AnswerDetail" />
                    </div>

                    <FluentTextField Label="Featured Image URL"
                                     @bind-Value="PageObj.FeaturedImage"
                                     Placeholder="https://example.com/image.jpg"
                                     Style="width: 100%;" />

                    <div>
                        <label style="display: block; margin-bottom: 4px;">Tags</label>
                        @* Display selected tags as chips *@
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; min-height: 32px;">
                            @foreach (var tag in SelectedTags)
                            {
                                <FluentBadge Appearance="Appearance.Accent" Style="padding: 4px 8px; display: inline-flex; align-items: center; gap: 4px;">
                                    @tag.TagName
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Style="padding: 0; min-width: 16px; height: 16px;"
                                                  OnClick="@(() => RemoveTag(tag))">
                                        <FluentIcon Value="@(new Icons.Regular.Size12.Dismiss())" />
                                    </FluentButton>
                                </FluentBadge>
                            }
                        </div>
                        @* Add new tag input *@
                        <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px;">
                            <FluentTextField @bind-Value="NewTagInput"
                                             Placeholder="Add a tag..."
                                             Style="flex: 1;"
                                             @onkeydown="@(e => { if (e.Key == "Enter") { AddNewTag(); } })" />
                            <FluentButton Appearance="Appearance.Outline"
                                          OnClick="AddNewTag"
                                          Disabled="@string.IsNullOrWhiteSpace(NewTagInput)">
                                + Add
                            </FluentButton>
                        </FluentStack>
                        @* Quick select from existing tags *@
                        @if (GetUnselectedTags().Any())
                        {
                            <div style="margin-top: 8px;">
                                <span style="font-size: 0.85rem; color: var(--neutral-foreground-hint);">Quick add:</span>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px;">
                                    @foreach (var tag in GetUnselectedTags().Take(8))
                                    {
                                        <FluentButton Appearance="Appearance.Lightweight"
                                                      Style="font-size: 0.85rem; padding: 2px 8px;"
                                                      OnClick="@(() => AddExistingTag(tag))">
                                            +@tag.TagName
                                        </FluentButton>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 4px;">Category</label>
                        <FluentSelect TOption="string"
                                      @bind-Value="SelectedCategoryId"
                                      Style="width: 100%;">
                            <FluentOption TOption="string" Value="@("0")">-- Select Category --</FluentOption>
                            @foreach (var category in Categories)
                            {
                                <FluentOption TOption="string" Value="@category.CategoryId.ToString()">@category.CategoryName</FluentOption>
                            }
                        </FluentSelect>
                    </div>

                    <div>
                        <label style="display: block; margin-bottom: 4px;">Series (optional)</label>
                        <FluentSelect TOption="string"
                                      @bind-Value="SelectedSeriesId"
                                      Style="width: 100%;">
                            <FluentOption TOption="string" Value="@("0")">-- Not part of a series --</FluentOption>
                            @foreach (var series in AvailableSeries)
                            {
                                <FluentOption TOption="string" Value="@series.SeriesId.ToString()">
                                    @series.Name (@series.PostCount parts)
                                </FluentOption>
                            }
                        </FluentSelect>
                        <small style="color: var(--neutral-foreground-hint);">
                            Add this post to a multi-part series for sequential reading.
                            @if (long.TryParse(SelectedSeriesId, out long sid) && sid > 0)
                            {
                                <span>Part number will be auto-assigned.</span>
                            }
                        </small>
                        @if (PageObj.SeriesPartNumber.HasValue && PageObj.SeriesPartNumber > 0)
                        {
                            <div style="margin-top: 4px;">
                                <FluentBadge Appearance="Appearance.Accent" Style="font-size: 0.85rem;">
                                    Part @PageObj.SeriesPartNumber
                                </FluentBadge>
                            </div>
                        }
                    </div>

                    @* Status indicator *@
                    <div style="padding: 12px; background: var(--neutral-layer-2); border-radius: 4px;">
                        <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; align-items: center;">
                            <span style="font-weight: 500;">Status:</span>
                            @if (PageObj.Published)
                            {
                                <FluentBadge Appearance="Appearance.Accent" Style="background-color: #107c10;">
                                    Published
                                </FluentBadge>
                                @if (PageObj.PublishedOn.HasValue)
                                {
                                    <span style="color: var(--neutral-foreground-hint); font-size: 0.85rem;">
                                        on @PageObj.PublishedOn.Value.ToString("MMM dd, yyyy")
                                    </span>
                                }
                            }
                            else if (PageObj.IsScheduled)
                            {
                                <FluentBadge Appearance="Appearance.Accent" Style="background-color: #005a9e;">
                                    Scheduled
                                </FluentBadge>
                                <span style="color: var(--neutral-foreground-hint); font-size: 0.85rem;">
                                    for @PageObj.ScheduledPublishOn?.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                                </span>
                            }
                            else
                            {
                                <FluentBadge Appearance="Appearance.Neutral">
                                    Draft
                                </FluentBadge>
                            }
                        </FluentStack>
                    </div>

                    @* Scheduling section - only for unpublished posts *@
                    @if (!PageObj.Published)
                    {
                        <FluentCard Style="padding: 16px;">
                            <h4 style="margin-top: 0; margin-bottom: 8px;">Schedule Publication</h4>
                            <p style="font-size: 0.85rem; color: var(--neutral-foreground-hint); margin-bottom: 12px;">
                                Set a date and time to automatically publish this post.
                            </p>
                            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 12px; flex-wrap: wrap;">
                                <div style="flex: 1; min-width: 150px;">
                                    <FluentDatePicker Label="Publish Date"
                                                      @bind-Value="ScheduledDate"
                                                      Style="width: 100%;" />
                                </div>
                                <div style="flex: 1; min-width: 150px;">
                                    <FluentTimePicker Label="Publish Time"
                                                      @bind-Value="ScheduledTime"
                                                      Style="width: 100%;" />
                                </div>
                            </FluentStack>
                            @if (ScheduledDate.HasValue)
                            {
                                <p style="margin-top: 8px; font-size: 0.9rem;">
                                    Post will be published on <strong>@GetScheduledDateTime()?.ToString("dddd, MMMM dd, yyyy 'at' h:mm tt")</strong>
                                </p>
                            }
                        </FluentCard>
                    }

                    @* Action buttons - differ based on published state *@
                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; margin-top: 16px; flex-wrap: wrap;">
                        @if (PageId == 0 || !PageObj.Published)
                        {
                            @* Draft mode: Save Draft + Schedule/Publish *@
                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="@HandleSaveDraft"
                                          Disabled="@IsSaving">
                                @if (IsSaving && SaveAction == "draft")
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Save())" />
                                    <span>Save Draft</span>
                                }
                            </FluentButton>

                            @if (ScheduledDate.HasValue)
                            {
                                @* Schedule button when date is set *@
                                <FluentButton Appearance="Appearance.Accent"
                                              OnClick="@HandleSchedule"
                                              Disabled="@IsSaving">
                                    @if (IsSaving && SaveAction == "schedule")
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                                        <span>Scheduling...</span>
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.CalendarClock())" />
                                        <span>Schedule</span>
                                    }
                                </FluentButton>
                            }
                            else
                            {
                                @* Publish Now when no schedule date *@
                                <FluentButton Appearance="Appearance.Accent"
                                              OnClick="@HandlePublish"
                                              Disabled="@IsSaving">
                                    @if (IsSaving && SaveAction == "publish")
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                                        <span>Publishing...</span>
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Send())" />
                                        <span>Publish Now</span>
                                    }
                                </FluentButton>
                            }

                            @* Cancel Schedule button for scheduled posts *@
                            @if (PageObj.IsScheduled)
                            {
                                <FluentButton Appearance="Appearance.Outline"
                                              OnClick="@HandleCancelSchedule"
                                              Disabled="@IsSaving">
                                    @if (IsSaving && SaveAction == "cancelschedule")
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                                        <span>Canceling...</span>
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size16.CalendarCancel())" />
                                        <span>Cancel Schedule</span>
                                    }
                                </FluentButton>
                            }
                        }
                        else
                        {
                            @* Published mode: Save Changes + Unpublish *@
                            <FluentButton Appearance="Appearance.Accent"
                                          OnClick="@HandleSaveChanges"
                                          Disabled="@IsSaving">
                                @if (IsSaving && SaveAction == "save")
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Save())" />
                                    <span>Save Changes</span>
                                }
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="@HandleUnpublish"
                                          Disabled="@IsSaving">
                                @if (IsSaving && SaveAction == "unpublish")
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                                    <span>Unpublishing...</span>
                                }
                                else
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowUndo())" />
                                    <span>Unpublish</span>
                                }
                            </FluentButton>
                        }
                        @if (PageId > 0)
                        {
                            <FluentAnchor Href="@($"/admin/preview/{PageId}")" Appearance="Appearance.Outline">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Eye())" />
                                <span>Preview</span>
                            </FluentAnchor>
                        }
                        <FluentAnchor Href="/BlogsList" Appearance="Appearance.Outline">
                            Cancel
                        </FluentAnchor>
                    </FluentStack>
                </FluentStack>
            </EditForm>
        }
    </PanelContent>
</ContentPanel>

@*
    ManagePost.razor
    Purpose: Create and edit blog posts.
    Two-column post editor per docs/TechieBlog-UIDesign.md "Screen: Post editor" — a main
    column (title, slug, excerpt, markdown body) beside a rail of Publish / Organise /
    Featured image cards, with a sticky action bar.

    Usage: Navigate to /ManagePost or /ManagePost/{PageId}
    Dependencies: TrBlazeUI (REQ-UI-048)
    Authorization: AuthorOrAbove policy required
*@
@page "/ManagePost"
@page "/ManagePost/{PageId:long}"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout
@* TrBlazeUI.Components.TimePicker is not in the shared _Imports.razor. *@
@using TrBlazeUI.Components.TimePicker

<SiteBrandTitle Page="Edit post" />

<ContentPanel PanelTitle="@PageHeader">
    <RightSection></RightSection>
    <PanelContent>
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
                   Class="mb-4"
                   data-testid="post-status-message">
                <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
                <AlertDescription>@StatusMessage</AlertDescription>
            </Alert>
        }

        @if (PageObj != null)
        {
            <EditForm Model="@PageObj" OnValidSubmit="@SaveData">
                <DataAnnotationsValidator />

                <div class="flex flex-col gap-4 sm:flex-row">

                    @* ------------------------------------------------ main column *@
                    <div class="flex min-w-0 flex-1 flex-col gap-4">

                        <Field>
                            <FieldLabel For="post-title">Blog Title</FieldLabel>
                            <FieldContent>
                                <Input Id="post-title"
                                       Value="@PageObj.Title"
                                       ValueChanged="@OnTitleChanged"
                                       Placeholder="Enter your blog title"
                                       Required="true"
                                       maxlength="@BlogPost.TitleMaxLength"
                                       data-testid="post-title-input" />
                                <FieldDescription Class="@TitleCharCountClass" data-testid="post-title-char-count">
                                    @TitleCharCountLabel
                                </FieldDescription>
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="post-slug">URL Slug</FieldLabel>
                            <FieldContent>
                                <Input Id="post-slug"
                                       @bind-Value="PageObj.Slug"
                                       Class="font-mono"
                                       Placeholder="auto-generated-from-title"
                                       data-testid="post-slug-input" />
                                @if (!string.IsNullOrEmpty(SlugPreview))
                                {
                                    <FieldDescription data-testid="post-slug-preview">/blog/@SlugPreview</FieldDescription>
                                }
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="post-excerpt">Blog Abstract</FieldLabel>
                            <FieldContent>
                                <Textarea Id="post-excerpt"
                                          @bind-Value="PageObj.Abstract"
                                          Placeholder="Brief summary shown in post listings"
                                          MaxLength="@BlogPost.AbstractMaxLength"
                                          data-testid="post-excerpt-input" />
                                <FieldDescription Class="@AbstractCharCountClass" data-testid="post-abstract-char-count">
                                    @AbstractCharCountLabel
                                </FieldDescription>
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel>Post Content (Markdown)</FieldLabel>
                            <FieldContent>
                                @*
                                    ResetKey identifies the post in the editor. The editor ignores
                                    values arriving after the first keystroke (TR-057); without a
                                    key change on a post switch, post A's body would stay in the
                                    textarea under post B's URL. See ManagePost.razor.cs.
                                *@
                                <PostMarkdownEditor @bind-Value="AnswerDetail"
                                                    ResetKey="@EditorResetKey" />
                            </FieldContent>
                        </Field>
                    </div>

                    @* -------------------------------------------------- right rail *@
                    <div class="flex w-full flex-col gap-4 sm:w-72">

                        @* --- Publish --- *@
                        <Card data-testid="publish-card">
                            <CardHeader>
                                <CardTitle Class="text-base">Publish</CardTitle>
                            </CardHeader>
                            <CardContent Class="flex flex-col gap-3">

                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-medium">Status:</span>
                                    @if (PageObj.Published)
                                    {
                                        <Badge data-testid="post-status-badge">Published</Badge>
                                        @if (PageObj.PublishedOn.HasValue)
                                        {
                                            <span class="text-xs text-muted-foreground" data-testid="post-published-on">
                                                on @PageObj.PublishedOn.Value.ToString("MMM dd, yyyy")
                                            </span>
                                        }
                                    }
                                    else if (PageObj.IsScheduled)
                                    {
                                        <Badge Variant="BadgeVariant.Outline" data-testid="post-status-badge">Scheduled</Badge>
                                        <span class="text-xs text-muted-foreground" data-testid="post-scheduled-for">
                                            for @PageObj.ScheduledPublishOn?.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                                        </span>
                                    }
                                    else
                                    {
                                        <Badge Variant="BadgeVariant.Secondary" data-testid="post-status-badge">Draft</Badge>
                                    }
                                </div>

                                @* Scheduling - only for unpublished posts *@
                                @if (!PageObj.Published)
                                {
                                    <Separator />

                                    <div class="flex flex-col gap-2" data-testid="schedule-section">
                                        <span class="text-sm text-muted-foreground">
                                            Set a date and time to automatically publish this post.
                                        </span>

                                        @*
                                            TR-072 (TrBlazeUI 2.0.2): DatePicker and TimePicker accepted a
                                            splatted data-testid and never rendered it, so both hooks rode on
                                            <span> wrappers. 2.0.3 forwards unmatched attributes to the visible
                                            trigger button — re-measured live on this page after the upgrade
                                            (2026-08-25), so the hooks sit on the components again.
                                        *@
                                        <Field>
                                            <FieldLabel>Publish Date</FieldLabel>
                                            <FieldContent>
                                                <DatePicker @bind-Value="ScheduledDate"
                                                            Placeholder="Pick a date"
                                                            Class="w-full"
                                                            data-testid="publish-date-picker" />
                                            </FieldContent>
                                        </Field>

                                        <Field>
                                            <FieldLabel>Publish Time</FieldLabel>
                                            <FieldContent>
                                                <TimePicker @bind-Value="ScheduledTime"
                                                            Placeholder="Pick a time"
                                                            Class="w-full"
                                                            data-testid="publish-time-picker" />
                                            </FieldContent>
                                        </Field>

                                        @if (ScheduledDate.HasValue)
                                        {
                                            <span class="text-sm" data-testid="scheduled-summary">
                                                Post will be published on
                                                <strong>@GetScheduledDateTime()?.ToString("dddd, MMMM dd, yyyy 'at' h:mm tt")</strong>
                                            </span>
                                        }
                                    </div>
                                }
                            </CardContent>
                        </Card>

                        @* --- Organise --- *@
                        <Card data-testid="organise-card">
                            <CardHeader>
                                <CardTitle Class="text-base">Organise</CardTitle>
                            </CardHeader>
                            <CardContent Class="flex flex-col gap-4">

                                <Field>
                                    <FieldLabel>Category</FieldLabel>
                                    <FieldContent>
                                        <Select TValue="string" @bind-Value="SelectedCategoryId" Class="w-full">
                                            <SelectTrigger data-testid="category-select">
                                                <SelectValue Placeholder="-- Select Category --" />
                                            </SelectTrigger>
                                            <SelectContent>
                                                <SelectItem TValue="string" Value="@("0")" Text="-- Select Category --">-- Select Category --</SelectItem>
                                                @foreach (var category in Categories)
                                                {
                                                    <SelectItem TValue="string"
                                                                Value="@category.CategoryId.ToString()"
                                                                Text="@category.CategoryName">
                                                        @category.CategoryName
                                                    </SelectItem>
                                                }
                                            </SelectContent>
                                        </Select>
                                    </FieldContent>
                                </Field>

                                <Field>
                                    <FieldLabel For="post-tag-input">Tags</FieldLabel>
                                    <FieldContent>
                                        @* Selected tags as chips *@
                                        <div class="flex flex-wrap gap-2" data-testid="selected-tags">
                                            @foreach (var tag in SelectedTags)
                                            {
                                                <Badge Class="gap-1" data-testid="selected-tag">
                                                    @tag.TagName
                                                    <Button Variant="ButtonVariant.Ghost"
                                                            Size="ButtonSize.IconSmall"
                                                            Class="h-4 w-4 p-0"
                                                            AriaLabel="@($"Remove tag {tag.TagName}")"
                                                            OnClick="@(() => RemoveTag(tag))"
                                                            data-testid="remove-tag">
                                                        <LucideIcon Name="x" Size="12" />
                                                    </Button>
                                                </Badge>
                                            }
                                        </div>

                                        @* Add new tag *@
                                        <div class="flex items-center gap-2">
                                            <Input Id="post-tag-input"
                                                   @bind-Value="NewTagInput"
                                                   Placeholder="Add a tag..."
                                                   Class="flex-1"
                                                   @onkeydown="@(async e => { if (e.Key == "Enter") { await AddNewTagAsync(); } })"
                                                   data-testid="tag-input" />
                                            <Button Variant="ButtonVariant.Outline"
                                                    Size="ButtonSize.Small"
                                                    OnClick="AddNewTagAsync"
                                                    Disabled="@string.IsNullOrWhiteSpace(NewTagInput)"
                                                    data-testid="add-tag">
                                                <LucideIcon Name="plus" Size="16" />
                                                Add
                                            </Button>
                                        </div>

                                        @* Quick select from existing tags *@
                                        @if (GetUnselectedTags().Any())
                                        {
                                            <FieldDescription>Quick add:</FieldDescription>
                                            <div class="flex flex-wrap gap-1" data-testid="quick-add-tags">
                                                @foreach (var tag in GetUnselectedTags().Take(8))
                                                {
                                                    <Button Variant="ButtonVariant.Ghost"
                                                            Size="ButtonSize.Small"
                                                            OnClick="@(() => AddExistingTag(tag))"
                                                            data-testid="quick-add-tag">
                                                        +@tag.TagName
                                                    </Button>
                                                }
                                            </div>
                                        }
                                    </FieldContent>
                                </Field>

                                <Field>
                                    <FieldLabel>Series (optional)</FieldLabel>
                                    <FieldContent>
                                        <Select TValue="string" @bind-Value="SelectedSeriesId" Class="w-full">
                                            <SelectTrigger data-testid="series-select">
                                                <SelectValue Placeholder="-- Not part of a series --" />
                                            </SelectTrigger>
                                            <SelectContent>
                                                <SelectItem TValue="string" Value="@("0")" Text="-- Not part of a series --">-- Not part of a series --</SelectItem>
                                                @foreach (var series in AvailableSeries)
                                                {
                                                    <SelectItem TValue="string"
                                                                Value="@series.SeriesId.ToString()"
                                                                Text="@($"{series.Name} ({series.PostCount} parts)")">
                                                        @series.Name (@series.PostCount parts)
                                                    </SelectItem>
                                                }
                                            </SelectContent>
                                        </Select>
                                        <FieldDescription>
                                            Add this post to a multi-part series for sequential reading.
                                            @if (long.TryParse(SelectedSeriesId, out long seriesId) && seriesId > 0)
                                            {
                                                <span>Part number will be auto-assigned.</span>
                                            }
                                        </FieldDescription>
                                        @if (PageObj.SeriesPartNumber.HasValue && PageObj.SeriesPartNumber > 0)
                                        {
                                            <div class="mt-1">
                                                <Badge Variant="BadgeVariant.Outline" data-testid="series-part-badge">
                                                    Part @PageObj.SeriesPartNumber
                                                </Badge>
                                            </div>
                                        }
                                    </FieldContent>
                                </Field>
                            </CardContent>
                        </Card>

                        @* --- Featured image --- *@
                        <Card data-testid="featured-image-card">
                            <CardHeader>
                                <CardTitle Class="text-base">Featured image</CardTitle>
                            </CardHeader>
                            <CardContent>
                                <ImagePicker Category="blog"
                                             UserId="@CurrentUserId"
                                             @bind-SelectedImagePath="PageObj.FeaturedImage" />
                            </CardContent>
                        </Card>
                    </div>
                </div>

                @* ----------------------------------------------- sticky action bar *@
                <div class="sticky bottom-0 z-10 mt-4 flex flex-wrap items-center gap-2 border-t border-border bg-background py-3"
                     data-testid="post-action-bar">
                    @if (PageId == 0 || !PageObj.Published)
                    {
                        @* Draft mode: Save Draft + Schedule/Publish *@
                        <Button Variant="ButtonVariant.Secondary"
                                OnClick="@HandleSaveDraft"
                                Disabled="@IsSaving"
                                data-testid="save-draft">
                            @if (IsSaving && SaveAction == "draft")
                            {
                                <Spinner Size="SpinnerSize.Small" />
                                <span>Saving...</span>
                            }
                            else
                            {
                                <LucideIcon Name="save" Size="16" />
                                <span>Save Draft</span>
                            }
                        </Button>

                        @if (ScheduledDate.HasValue)
                        {
                            <Button OnClick="@HandleSchedule" Disabled="@IsSaving" data-testid="schedule-post">
                                @if (IsSaving && SaveAction == "schedule")
                                {
                                    <Spinner Size="SpinnerSize.Small" />
                                    <span>Scheduling...</span>
                                }
                                else
                                {
                                    <LucideIcon Name="calendar-clock" Size="16" />
                                    <span>Schedule</span>
                                }
                            </Button>
                        }
                        else
                        {
                            <Button OnClick="@HandlePublish" Disabled="@IsSaving" data-testid="publish-post">
                                @if (IsSaving && SaveAction == "publish")
                                {
                                    <Spinner Size="SpinnerSize.Small" />
                                    <span>Publishing...</span>
                                }
                                else
                                {
                                    <LucideIcon Name="send" Size="16" />
                                    <span>Publish Now</span>
                                }
                            </Button>
                        }

                        @if (PageObj.IsScheduled)
                        {
                            <Button Variant="ButtonVariant.Outline"
                                    OnClick="@HandleCancelSchedule"
                                    Disabled="@IsSaving"
                                    data-testid="cancel-schedule">
                                @if (IsSaving && SaveAction == "cancelschedule")
                                {
                                    <Spinner Size="SpinnerSize.Small" />
                                    <span>Canceling...</span>
                                }
                                else
                                {
                                    <LucideIcon Name="calendar-x" Size="16" />
                                    <span>Cancel Schedule</span>
                                }
                            </Button>
                        }
                    }
                    else
                    {
                        @* Published mode: Save Changes + Unpublish *@
                        <Button OnClick="@HandleSaveChanges" Disabled="@IsSaving" data-testid="save-post">
                            @if (IsSaving && SaveAction == "save")
                            {
                                <Spinner Size="SpinnerSize.Small" />
                                <span>Saving...</span>
                            }
                            else
                            {
                                <LucideIcon Name="save" Size="16" />
                                <span>Save Changes</span>
                            }
                        </Button>
                        <Button Variant="ButtonVariant.Secondary"
                                OnClick="@HandleUnpublish"
                                Disabled="@IsSaving"
                                data-testid="unpublish-post">
                            @if (IsSaving && SaveAction == "unpublish")
                            {
                                <Spinner Size="SpinnerSize.Small" />
                                <span>Unpublishing...</span>
                            }
                            else
                            {
                                <LucideIcon Name="undo-2" Size="16" />
                                <span>Unpublish</span>
                            }
                        </Button>
                    }

                    @if (PageId > 0)
                    {
                        <Button Href="@($"/admin/preview/{PageId}")"
                                Variant="ButtonVariant.Outline"
                                data-testid="preview-post">
                            <LucideIcon Name="eye" Size="16" />
                            <span>Preview</span>
                        </Button>
                    }
                    <Button Href="/BlogsList" Variant="ButtonVariant.Outline" data-testid="cancel-post">
                        Cancel
                    </Button>
                </div>
            </EditForm>
        }
    </PanelContent>
</ContentPanel>

@*
    ManageExperience.razor
    Purpose: Manage work experience entries for user resume/portfolio.
    Provides list view, add, edit, delete, and display-order control.

    Usage: Navigate to /admin/experience or /admin/experience/{EventId}
    Dependencies: TrBlazeUI (REQ-UI-037 / REQ-UI-048)
    Authorization: AuthorOrAbove policy - authors can manage their own experience
*@
@page "/admin/experience"
@page "/admin/experience/{EventId:long}"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout

<PageTitle>Manage Experience - TechieBlog Admin</PageTitle>

<div class="mx-auto flex max-w-5xl flex-col gap-6" data-testid="manage-experience-page">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">@PageTitle</h1>
        @if (!IsEditMode)
        {
            <Button OnClick="@ShowAddForm" data-testid="add-experience">
                <LucideIcon Name="plus" Size="16" />
                Add Experience
            </Button>
        }
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)" data-testid="experience-status">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertTitle>@(IsError ? "Something went wrong" : "Done")</AlertTitle>
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* Admin-only: pick whose experience to manage. *@
    @if (IsAdmin && !IsEditMode)
    {
        <div class="flex flex-wrap items-center gap-3">
            <span class="text-sm font-medium">View experience for user:</span>
            <Select TValue="string"
                    Value="@(SelectedUserId?.ToString() ?? string.Empty)"
                    ValueChanged="@OnSelectedUserChanged"
                    Class="w-72">
                <SelectTrigger data-testid="experience-user-select">
                    <SelectValue Placeholder="-- My Experience --" />
                </SelectTrigger>
                <SelectContent>
                    <SelectItem TValue="string" Value="@string.Empty" Text="-- My Experience --">-- My Experience --</SelectItem>
                    @if (AllUsers is not null)
                    {
                        @foreach (var user in AllUsers)
                        {
                            var label = $"{user.FirstName} {user.LastName} ({user.EmailId})";
                            <SelectItem TValue="string" Value="@user.UserId.ToString()" Text="@label">@label</SelectItem>
                        }
                    }
                </SelectContent>
            </Select>
        </div>
    }

    @if (IsLoading)
    {
        <div class="flex items-center justify-center gap-3 py-12" data-testid="experience-loading">
            <Spinner />
            <span class="text-muted-foreground">Loading...</span>
        </div>
    }
    else if (ExperienceList is null || !ExperienceList.Any())
    {
        <Empty Title="No experience yet"
               Description="Add your first role to start building the resume timeline."
               data-testid="experience-empty">
            <Icon><LucideIcon Name="briefcase" Size="48" /></Icon>
            <ChildContent>
                <Button OnClick="@ShowAddForm" data-testid="add-first-experience">
                    <LucideIcon Name="plus" Size="16" />
                    Add Experience
                </Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        <div class="flex flex-col gap-4" data-testid="experience-list">
            @foreach (var exp in ExperienceList)
            {
                var entry = exp;
                <Card data-testid="experience-card">
                    <CardContent Class="flex flex-col gap-3 pt-6">
                        <div class="flex items-start gap-4">

                            @if (!string.IsNullOrEmpty(entry.LogoIconPath))
                            {
                                <img src="@entry.LogoIconPath"
                                     alt="@entry.EventTitle"
                                     class="h-12 w-12 rounded object-contain" />
                            }
                            else
                            {
                                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded bg-muted text-muted-foreground">
                                    <LucideIcon Name="briefcase" Size="24" />
                                </div>
                            }

                            <div class="min-w-0 flex-1">
                                <h3 class="text-lg font-semibold" data-testid="experience-role">@entry.SessionTitle</h3>
                                <div class="text-sm text-muted-foreground" data-testid="experience-company">@entry.EventTitle</div>
                                <div class="text-xs text-muted-foreground" data-testid="experience-dates">
                                    @FormatDateRange(entry.StartDate, entry.EventDate, entry.IsCurrent)
                                </div>
                            </div>

                            <div class="flex shrink-0 items-center gap-1">
                                @if (entry.IsCurrent)
                                {
                                    <Badge Variant="BadgeVariant.Secondary" data-testid="experience-current-badge">Current</Badge>
                                }
                                <Badge Variant="BadgeVariant.Outline"
                                       title="Display order"
                                       data-testid="experience-order">@entry.DisplayOrder</Badge>
                                <Button Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.IconSmall"
                                        AriaLabel="Edit experience"
                                        OnClick="@(() => EditExperience(entry.EventID))"
                                        data-testid="edit-experience">
                                    <LucideIcon Name="pencil" Size="16" />
                                </Button>
                                <Button Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.IconSmall"
                                        Class="text-destructive"
                                        AriaLabel="Delete experience"
                                        OnClick="@(() => ConfirmDelete(entry))"
                                        data-testid="delete-experience">
                                    <LucideIcon Name="trash-2" Size="16" />
                                </Button>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(entry.Description))
                        {
                            <div class="border-t border-border pt-3 text-sm leading-relaxed"
                                 data-testid="experience-description">
                                @((MarkupString)FormatDescription(entry.Description))
                            </div>
                        }
                    </CardContent>
                </Card>
            }
        </div>
    }
</div>

@* Add/Edit dialog - closed on load, opened by "Add Experience" or a row's Edit action. *@
<Dialog Open="@ShowForm" OpenChanged="@OnFormOpenChanged">
    <DialogContent Class="max-w-2xl" data-testid="experience-dialog">
        <DialogHeader>
            <DialogTitle>@(IsEditMode ? "Edit Experience" : "Add New Experience")</DialogTitle>
            <DialogDescription>Roles appear on the public resume ordered by display order.</DialogDescription>
        </DialogHeader>

        <EditForm Model="@CurrentEvent" OnValidSubmit="@SaveExperience">
            <DataAnnotationsValidator />

            <div class="flex max-h-[65vh] flex-col gap-5 overflow-y-auto p-1">

                <Field>
                    <FieldLabel For="experience-role">Role / Position</FieldLabel>
                    <FieldContent>
                        <Input Id="experience-role"
                               @bind-Value="CurrentEvent.SessionTitle"
                               Placeholder="e.g., Senior Software Engineer"
                               Required="true"
                               data-testid="experience-role-input" />
                    </FieldContent>
                </Field>

                <Field>
                    <FieldLabel For="experience-company">Company Name</FieldLabel>
                    <FieldContent>
                        <Input Id="experience-company"
                               @bind-Value="CurrentEvent.EventTitle"
                               Placeholder="e.g., Acme Corporation"
                               Required="true"
                               data-testid="experience-company-input" />
                    </FieldContent>
                </Field>

                <Field>
                    <FieldLabel For="experience-logo">Company Logo Path</FieldLabel>
                    <FieldContent>
                        <Input Id="experience-logo"
                               @bind-Value="CurrentEvent.LogoIconPath"
                               Placeholder="/images/logos/company-logo.png"
                               Class="font-mono"
                               data-testid="experience-logo-input" />
                        <FieldDescription>Path to the company logo image (optional).</FieldDescription>
                    </FieldContent>
                </Field>

                <div class="grid gap-5 sm:grid-cols-2">
                    <Field>
                        <FieldLabel>Start Date</FieldLabel>
                        <FieldContent>
                            <DatePicker @bind-Value="StartDateValue"
                                        Placeholder="Pick a start date"
                                        data-testid="experience-start-date" />
                        </FieldContent>
                    </Field>

                    <Field>
                        <FieldLabel>End Date</FieldLabel>
                        <FieldContent>
                            <DatePicker @bind-Value="EndDateValue"
                                        Placeholder="Pick an end date"
                                        Disabled="@CurrentEvent.IsCurrent"
                                        data-testid="experience-end-date" />
                        </FieldContent>
                    </Field>
                </div>

                <div class="flex items-center gap-3">
                    <Checkbox Id="experience-current"
                              @bind-Checked="CurrentEvent.IsCurrent"
                              data-testid="experience-current-checkbox" />
                    <Label For="experience-current">I currently work here</Label>
                </div>

                <Field>
                    <FieldLabel For="experience-desc">Description</FieldLabel>
                    <FieldContent>
                        <Textarea Id="experience-desc"
                                  @bind-Value="CurrentEvent.Description"
                                  Placeholder="Describe your responsibilities and achievements (Markdown supported)"
                                  Class="min-h-36"
                                  data-testid="experience-description-input" />
                        <FieldDescription>Use bullet points to list key responsibilities and achievements.</FieldDescription>
                    </FieldContent>
                </Field>

                <Field>
                    <FieldLabel For="experience-order">Display Order</FieldLabel>
                    <FieldContent>
                        <Input Id="experience-order"
                               Type="InputType.Number"
                               @bind-Value="DisplayOrderText"
                               Class="w-40"
                               data-testid="experience-order-input" />
                        <FieldDescription>Lower numbers appear first.</FieldDescription>
                    </FieldContent>
                </Field>

            </div>

            <DialogFooter>
                <Button Variant="ButtonVariant.Outline"
                        Type="ButtonType.Button"
                        OnClick="@CancelEdit"
                        data-testid="cancel-experience">
                    Cancel
                </Button>
                <Button Type="ButtonType.Submit" Disabled="@IsSaving" data-testid="save-experience">
                    @if (IsSaving)
                    {
                        <Spinner Size="SpinnerSize.Small" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <LucideIcon Name="save" Size="16" />
                        <span>Save</span>
                    }
                </Button>
            </DialogFooter>
        </EditForm>
    </DialogContent>
</Dialog>

@* Delete confirmation - closed on load, opened by a row's Delete action. *@
<AlertDialog Open="@ShowDeleteDialog" OpenChanged="@OnDeleteOpenChanged">
    <AlertDialogContent data-testid="experience-delete-dialog">
        <AlertDialogHeader>
            <AlertDialogTitle>Confirm delete</AlertDialogTitle>
            <AlertDialogDescription>
                Are you sure you want to delete
                <strong>@EventToDelete?.SessionTitle</strong> at <strong>@EventToDelete?.EventTitle</strong>?
                This action cannot be undone.
            </AlertDialogDescription>
        </AlertDialogHeader>
        <AlertDialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CancelDelete" data-testid="delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="@DeleteExperience" data-testid="delete-confirm">
                Delete
            </Button>
        </AlertDialogFooter>
    </AlertDialogContent>
</AlertDialog>

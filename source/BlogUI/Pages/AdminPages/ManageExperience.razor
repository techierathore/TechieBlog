@*
    ManageExperience.razor
    Purpose: Manage work experience entries for user resume/portfolio.
    Provides list view, add, edit, delete, and reorder functionality.

    Usage: Navigate to /admin/experience or /admin/experience/{EventId}
    Dependencies: Microsoft.FluentUI.AspNetCore.Components
    Authorization: AuthorOrAbove policy - authors can manage their own experience
*@
@page "/admin/experience"
@page "/admin/experience/{EventId:long}"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout

<PageTitle>Manage Experience - TechieBlog Admin</PageTitle>

<ContentPanel PanelTitle="@PageTitle">
    <RightSection>
        @if (!IsEditMode)
        {
            <FluentButton Appearance="Appearance.Accent" OnClick="@ShowAddForm">
                <FluentIcon Value="@(new Icons.Regular.Size16.Add())" />
                <span>Add Experience</span>
            </FluentButton>
        }
    </RightSection>
    <PanelContent>
        @* Status Messages *@
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <FluentMessageBar Intent="@(IsError ? MessageIntent.Error : MessageIntent.Success)"
                              Style="margin-bottom: 16px;">
                @StatusMessage
            </FluentMessageBar>
        }

        @* Admin User Selector *@
        @if (IsAdmin && !IsEditMode)
        {
            <div style="margin-bottom: 16px;">
                <FluentSelect TOption="string"
                              Label="View experience for user:"
                              Value="@(SelectedUserId?.ToString() ?? "")"
                              ValueChanged="@(async val => { SelectedUserId = string.IsNullOrEmpty(val) ? null : long.Parse(val); await OnUserChanged(); })"
                              Style="min-width: 250px;">
                    <FluentOption TOption="string" Value="">-- My Experience --</FluentOption>
                    @if (AllUsers != null)
                    {
                        @foreach (var user in AllUsers)
                        {
                            <FluentOption TOption="string" Value="@user.UserId.ToString()">
                                @user.FirstName @user.LastName (@user.EmailId)
                            </FluentOption>
                        }
                    }
                </FluentSelect>
            </div>
        }

        @if (IsLoading)
        {
            <div style="display: flex; justify-content: center; padding: 48px;">
                <FluentProgressRing />
                <span style="margin-left: 12px;">Loading...</span>
            </div>
        }
        else if (IsEditMode || ShowForm)
        {
            @* Add/Edit Form *@
            <div style="max-width: 800px;">
                <h3 style="margin-top: 0; margin-bottom: 20px; font-size: 1.1rem; font-weight: 600;">
                    @(IsEditMode ? "Edit Experience" : "Add New Experience")
                </h3>

                <EditForm Model="@CurrentEvent" OnValidSubmit="@SaveExperience">
                    <DataAnnotationsValidator />
                    <FluentStack Orientation="Orientation.Vertical" Style="gap: 20px;">
                        @* Role/Position *@
                        <div>
                            <FluentTextField Label="Role / Position"
                                             @bind-Value="CurrentEvent.SessionTitle"
                                             Placeholder="e.g., Senior Software Engineer"
                                             Required="true"
                                             Style="width: 100%;" />
                        </div>

                        @* Company Name *@
                        <div>
                            <FluentTextField Label="Company Name"
                                             @bind-Value="CurrentEvent.EventTitle"
                                             Placeholder="e.g., Acme Corporation"
                                             Required="true"
                                             Style="width: 100%;" />
                        </div>

                        @* Company Logo Path *@
                        <div>
                            <FluentTextField Label="Company Logo Path"
                                             @bind-Value="CurrentEvent.LogoIconPath"
                                             Placeholder="/images/logos/company-logo.png"
                                             Style="width: 100%;" />
                            <small style="color: var(--neutral-foreground-hint);">
                                Path to company logo image (optional)
                            </small>
                        </div>

                        @* Date Range *@
                        <FluentStack Orientation="Orientation.Horizontal" Style="gap: 16px;">
                            <div style="flex: 1;">
                                <FluentDatePicker Label="Start Date"
                                                  @bind-Value="StartDateValue"
                                                  Style="width: 100%;" />
                            </div>
                            <div style="flex: 1;">
                                <FluentDatePicker Label="End Date"
                                                  @bind-Value="EndDateValue"
                                                  Disabled="@CurrentEvent.IsCurrent"
                                                  Style="width: 100%;" />
                            </div>
                        </FluentStack>

                        @* Current Position Checkbox *@
                        <div>
                            <FluentCheckbox @bind-Value="CurrentEvent.IsCurrent"
                                            Label="I currently work here" />
                        </div>

                        @* Description *@
                        <div>
                            <FluentTextArea Label="Description"
                                            @bind-Value="CurrentEvent.Description"
                                            Placeholder="Describe your responsibilities and achievements (Markdown supported)"
                                            Rows="6"
                                            Style="width: 100%;" />
                            <small style="color: var(--neutral-foreground-hint);">
                                Use bullet points to list key responsibilities and achievements
                            </small>
                        </div>

                        @* Display Order *@
                        <div>
                            <FluentNumberField Label="Display Order"
                                               @bind-Value="CurrentEvent.DisplayOrder"
                                               Min="0"
                                               Style="width: 150px;" />
                            <small style="color: var(--neutral-foreground-hint);">
                                Lower numbers appear first
                            </small>
                        </div>

                        @* Form Actions *@
                        <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; margin-top: 16px;">
                            <FluentButton Type="ButtonType.Submit"
                                          Appearance="Appearance.Accent"
                                          Disabled="@IsSaving">
                                @if (IsSaving)
                                {
                                    <FluentProgressRing Style="width: 16px; height: 16px;" />
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Save())" />
                                    <span>Save</span>
                                }
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline" OnClick="@CancelEdit">
                                Cancel
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                </EditForm>
            </div>
        }
        else
        {
            @* Experience List *@
            @if (ExperienceList == null || !ExperienceList.Any())
            {
                <div style="padding: 32px; text-align: center; color: var(--neutral-foreground-hint);">
                    <FluentIcon Value="@(new Icons.Regular.Size48.Briefcase())" Color="Color.Neutral" />
                    <p style="margin-top: 16px;">No experience entries found.</p>
                    <p>Click "Add Experience" to create your first entry.</p>
                </div>
            }
            else
            {
                <div class="experience-list">
                    @foreach (var exp in ExperienceList)
                    {
                        <div class="experience-card">
                            <div class="experience-header">
                                @if (!string.IsNullOrEmpty(exp.LogoIconPath))
                                {
                                    <img src="@exp.LogoIconPath" alt="@exp.EventTitle" class="company-logo" />
                                }
                                else
                                {
                                    <div class="company-logo-placeholder">
                                        <FluentIcon Value="@(new Icons.Regular.Size24.Building())" Color="Color.Neutral" />
                                    </div>
                                }
                                <div class="experience-info">
                                    <h4 class="role-title">@exp.SessionTitle</h4>
                                    <div class="company-name">@exp.EventTitle</div>
                                    <div class="date-range">
                                        @FormatDateRange(exp.StartDate, exp.EventDate, exp.IsCurrent)
                                    </div>
                                </div>
                                <div class="experience-actions">
                                    <span class="display-order-badge" title="Display Order">@exp.DisplayOrder</span>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  OnClick="@(() => EditExperience(exp.EventID))"
                                                  Title="Edit">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" />
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  OnClick="@(() => ConfirmDelete(exp))"
                                                  Title="Delete">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error" />
                                    </FluentButton>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(exp.Description))
                            {
                                <div class="experience-description">
                                    @((MarkupString)FormatDescription(exp.Description))
                                </div>
                            }
                            @if (exp.IsCurrent)
                            {
                                <span class="current-badge">Current</span>
                            }
                        </div>
                    }
                </div>
            }
        }

        @* Delete Confirmation Dialog *@
        @if (ShowDeleteDialog)
        {
            <FluentDialog Hidden="false" Modal="true" TrapFocus="true">
                <FluentDialogHeader>
                    <div style="padding: 16px 24px;">
                        <FluentLabel Typo="Typography.PaneHeader">Confirm Delete</FluentLabel>
                    </div>
                </FluentDialogHeader>
                <FluentDialogBody>
                    <div style="padding: 0 24px 16px 24px;">
                        <p style="margin: 0 0 8px 0;">Are you sure you want to delete this experience entry?</p>
                        <p style="margin: 0;"><strong>@EventToDelete?.SessionTitle</strong> at <strong>@EventToDelete?.EventTitle</strong></p>
                    </div>
                </FluentDialogBody>
                <FluentDialogFooter>
                    <div style="padding: 16px 24px; display: flex; justify-content: flex-end; gap: 12px;">
                        <FluentButton Appearance="Appearance.Neutral" OnClick="@CancelDelete">
                            Cancel
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Accent"
                                      OnClick="@DeleteExperience"
                                      Style="background-color: var(--color-error, #D13438);">
                            Delete
                        </FluentButton>
                    </div>
                </FluentDialogFooter>
            </FluentDialog>
        }
    </PanelContent>
</ContentPanel>

<style>
    .experience-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .experience-card {
        position: relative;
        padding: 16px;
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 8px;
        background-color: var(--neutral-layer-card-container);
    }

    .experience-card:hover {
        border-color: var(--accent-fill-rest);
    }

    .experience-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .company-logo {
        width: 48px;
        height: 48px;
        object-fit: contain;
        border-radius: 4px;
    }

    .company-logo-placeholder {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--neutral-layer-2);
        border-radius: 4px;
    }

    .experience-info {
        flex: 1;
    }

    .role-title {
        margin: 0 0 4px 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--neutral-foreground-rest);
    }

    .company-name {
        font-size: 0.95rem;
        color: var(--neutral-foreground-hint);
        margin-bottom: 4px;
    }

    .date-range {
        font-size: 0.85rem;
        color: var(--neutral-foreground-hint);
    }

    .experience-actions {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .display-order-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 24px;
        padding: 0 6px;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 12px;
        background-color: var(--neutral-layer-2);
        color: var(--neutral-foreground-hint);
        margin-right: 8px;
    }

    .experience-description {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--neutral-stroke-rest);
        font-size: 0.9rem;
        color: var(--neutral-foreground-rest);
        line-height: 1.5;
    }

    .experience-description ul {
        margin: 8px 0;
        padding-left: 20px;
    }

    .experience-description li {
        margin-bottom: 4px;
    }

    .current-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 2px 8px;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 4px;
        background-color: var(--accent-fill-rest);
        color: var(--accent-foreground-rest);
    }
</style>

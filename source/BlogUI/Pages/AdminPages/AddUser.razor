@*
    AddUser.razor
    Purpose: Form to add a new user to the system.
    Admins can create new users with specified roles.

    Usage: Navigate to /AddUser
    Dependencies: TrBlazeUI.Components (REQ-UI-048), AuthSvc
    Authorization: AdminOnly policy required

    REQ-NFR-002 / REQ-FN-006 (BRD-10, BRD-79) — 2026-08-07: this page used to hash the
    password itself with a bare, unsalted SHA256 and accept anything six characters long,
    bypassing both PasswordHasher and PasswordValidator. Accounts created that way could
    never sign in, because no verifier recognises that hash shape. It now delegates the
    whole operation to AuthSvc.CreateStaffAccount, which enforces password strength,
    stores a PBKDF2-HMAC-SHA256 hash and flags the account MustChangePassword.
*@
@page "/AddUser"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.AuthSvc AuthService
@inject NavigationManager Navigation

@* [REQ-NFR-007] WCAG 2.4.2 Page Titled (Level A) — without this the page inherits the
   shell title and every admin screen announces itself as just the site name. *@
<PageTitle>Add user - TechieBlog</PageTitle>

<div class="mx-auto max-w-[800px] space-y-6">

    @* ---- Page header --------------------------------------------------- *@
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-foreground">Add New User</h1>
            <p class="text-sm text-muted-foreground">Create a new user account.</p>
        </div>
        <Button Href="/users" Variant="ButtonVariant.Outline" data-testid="back-to-users">
            <LucideIcon Name="arrow-left" Size="16" />
            Back to Users
        </Button>
    </div>

    @* ---- Status message ------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
               data-testid="add-user-status-message">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* ---- User form ------------------------------------------------------ *@
    <Card>
        <CardContent Class="pt-6">
            <EditForm Model="@NewUser" OnValidSubmit="HandleSubmit" data-testid="add-user-form">
                <DataAnnotationsValidator />

                <div class="grid gap-4 sm:grid-cols-2">
                    <Field>
                        <FieldLabel For="user-first-name">First Name *</FieldLabel>
                        <FieldContent>
                            <Input Id="user-first-name"
                                   @bind-Value="NewUser.FirstName"
                                   Placeholder="Enter first name"
                                   Required="true"
                                   Class="w-full"
                                   data-testid="user-first-name" />
                            <ValidationMessage For="@(() => NewUser.FirstName)" />
                        </FieldContent>
                    </Field>

                    <Field>
                        <FieldLabel For="user-last-name">Last Name *</FieldLabel>
                        <FieldContent>
                            <Input Id="user-last-name"
                                   @bind-Value="NewUser.LastName"
                                   Placeholder="Enter last name"
                                   Required="true"
                                   Class="w-full"
                                   data-testid="user-last-name" />
                            <ValidationMessage For="@(() => NewUser.LastName)" />
                        </FieldContent>
                    </Field>
                </div>

                <Field Class="mt-4">
                    <FieldLabel For="user-email">Email Address *</FieldLabel>
                    <FieldContent>
                        <Input Id="user-email"
                               Type="InputType.Email"
                               @bind-Value="NewUser.EmailId"
                               Placeholder="user@example.com"
                               Required="true"
                               Class="w-full"
                               data-testid="user-email" />
                        <ValidationMessage For="@(() => NewUser.EmailId)" />
                    </FieldContent>
                </Field>

                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    <Field>
                        <FieldLabel For="user-password">Password *</FieldLabel>
                        <FieldContent>
                            <Input Id="user-password"
                                   Type="InputType.Password"
                                   @bind-Value="Password"
                                   Placeholder="Enter password"
                                   Required="true"
                                   Class="w-full"
                                   data-testid="user-password" />
                            <FieldDescription>
                                Minimum 8 characters, including uppercase, lowercase and a number.
                                The user must change it at first sign-in.
                            </FieldDescription>
                        </FieldContent>
                    </Field>

                    <Field>
                        <FieldLabel For="user-confirm-password">Confirm Password *</FieldLabel>
                        <FieldContent>
                            <Input Id="user-confirm-password"
                                   Type="InputType.Password"
                                   @bind-Value="ConfirmPassword"
                                   Placeholder="Confirm password"
                                   Required="true"
                                   Class="w-full"
                                   data-testid="user-confirm-password" />
                        </FieldContent>
                    </Field>
                </div>

                <Field Class="mt-4">
                    <FieldLabel For="user-role">Role *</FieldLabel>
                    <FieldContent>
                        <Select TValue="string" @bind-Value="NewUser.UserRole" Class="w-full">
                            <SelectTrigger data-testid="user-role">
                                <SelectValue Placeholder="Select a role" />
                            </SelectTrigger>
                            <SelectContent>
                                <SelectItem TValue="string" Value="@("Admin")" Text="Admin">Admin</SelectItem>
                                <SelectItem TValue="string" Value="@("Editor")" Text="Editor">Editor</SelectItem>
                                <SelectItem TValue="string" Value="@("Author")" Text="Author">Author</SelectItem>
                                <SelectItem TValue="string" Value="@("Contributor")" Text="Contributor">Contributor</SelectItem>
                                <SelectItem TValue="string" Value="@("Reader")" Text="Reader">Reader</SelectItem>
                            </SelectContent>
                        </Select>
                    </FieldContent>
                </Field>

                <div class="mt-6 flex justify-end gap-3 border-t border-border pt-6">
                    <Button Variant="ButtonVariant.Outline"
                            Type="ButtonType.Button"
                            OnClick="Cancel"
                            data-testid="add-user-cancel">
                        Cancel
                    </Button>
                    <Button Type="ButtonType.Submit"
                            Disabled="@IsProcessing"
                            data-testid="add-user-submit">
                        @if (IsProcessing)
                        {
                            <Spinner Size="SpinnerSize.Small" />
                        }
                        Create User
                    </Button>
                </div>
            </EditForm>
        </CardContent>
    </Card>
</div>

@code {
    private BlogModels.Models.AppUser NewUser = new()
    {
        UserRole = "Reader",
        CreatedOn = DateTime.UtcNow,
        IsConfirmed = true
    };

    private string Password = "";
    private string ConfirmPassword = "";
    private string StatusMessage = "";
    private bool IsError = false;
    private bool IsProcessing = false;

    /// <summary>
    /// Creates the staff account through the authentication service.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> Only the confirm-password match is checked here, because it
    /// is a UI-only concern. Password strength (BRD-3), email uniqueness, hashing and the
    /// forced-first-change flag all belong to <c>AuthSvc.CreateStaffAccount</c>, so this page and
    /// the reset flow cannot drift apart (REQ-FN-006, REQ-NFR-002).</para>
    /// <para><b>Flow:</b> confirm match → call the service → show the returned message → redirect
    /// on success.</para>
    /// <para><b>Side Effects:</b> Inserts one user; navigates to /users on success.</para>
    /// </remarks>
    private async Task HandleSubmit()
    {
        if (Password != ConfirmPassword)
        {
            StatusMessage = "Passwords do not match.";
            IsError = true;
            return;
        }

        try
        {
            IsProcessing = true;
            StateHasChanged();

            var displayName = $"{NewUser.FirstName} {NewUser.LastName}".Trim();
            var result = await AuthService.CreateStaffAccountAsync(
                displayName, NewUser.EmailId, Password, NewUser.UserRole);

            if (!result.IsSuccess)
            {
                StatusMessage = result.ErrorMessage ?? "Account creation failed. Please try again.";
                IsError = true;
                return;
            }

            StatusMessage = $"User '{displayName}' created successfully! "
                + "They must change this password at first sign-in.";
            IsError = false;

            await Task.Delay(1500);
            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error creating user: {ex.Message}";
            IsError = true;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/users");
    }
}

@*
    ManageTag.razor
    Purpose: Create and edit tags for blog posts.
    Provides form for tag management with validation.

    Usage: Navigate to /ManageTag or /ManageTag/{PageId}
    Dependencies: TrBlazeUI (REQ-UI-048), TagSvc
    Authorization: AdminOnly policy required
*@
@page "/ManageTag"
@page "/ManageTag/{PageId:long}"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.TagSvc TagService
@inject NavigationManager Navigation

@* [REQ-NFR-007] WCAG 2.4.2 Page Titled (Level A) — without this the page inherits the
   shell title and every admin screen announces itself as just the site name. *@
<SiteBrandTitle Page="Tag" />

<ContentPanel PanelTitle="@pageHeader">
    <RightSection></RightSection>
    <PanelContent>
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <Alert Variant="@(isError ? AlertVariant.Danger : AlertVariant.Success)"
                   Class="mb-4"
                   data-testid="tag-status-message">
                <LucideIcon Name="@(isError ? "circle-alert" : "circle-check")" Size="16" />
                <AlertDescription>@statusMessage</AlertDescription>
            </Alert>
        }

        @if (pageObj == null)
        {
            <div class="flex items-center gap-3 py-6" data-testid="tag-loading">
                <Spinner />
                <span class="text-muted-foreground">Loading...</span>
            </div>
        }
        else
        {
            <EditForm Model="@pageObj" OnValidSubmit="@SaveDataAsync">
                <DataAnnotationsValidator />
                <div class="flex max-w-lg flex-col gap-4">

                    <Field>
                        <FieldLabel For="tag-name">Tag Name</FieldLabel>
                        <FieldContent>
                            <Input Id="tag-name"
                                   Value="@pageObj.TagName"
                                   ValueChanged="@OnNameChanged"
                                   Placeholder="Enter tag name"
                                   Required="true"
                                   data-testid="tag-name-input" />
                        </FieldContent>
                    </Field>

                    <Field>
                        <FieldLabel For="tag-slug">URL Slug</FieldLabel>
                        <FieldContent>
                            <Input Id="tag-slug"
                                   @bind-Value="pageObj.Slug"
                                   Placeholder="auto-generated-from-name"
                                   data-testid="tag-slug-input" />
                            @if (!string.IsNullOrEmpty(slugPreview))
                            {
                                <FieldDescription data-testid="tag-slug-preview">/tag/@slugPreview</FieldDescription>
                            }
                        </FieldContent>
                    </Field>

                    <div class="flex flex-wrap items-center gap-3 pt-2">
                        <Button Type="ButtonType.Submit" Disabled="@isSaving" data-testid="save-tag">
                            @if (isSaving)
                            {
                                <Spinner Size="SpinnerSize.Small" />
                                <span>Saving...</span>
                            }
                            else
                            {
                                <LucideIcon Name="save" Size="16" />
                                <span>@(PageId > 0 ? "Update Tag" : "Create Tag")</span>
                            }
                        </Button>
                        <Button Href="/TagsList" Variant="ButtonVariant.Outline" data-testid="cancel-tag">
                            Cancel
                        </Button>
                    </div>
                </div>
            </EditForm>
        }
    </PanelContent>
</ContentPanel>

@code {
    /// <summary>
    /// Identifier of the tag being edited. Zero creates a new tag.
    /// </summary>
    [Parameter]
    public long PageId { get; set; }

    private BlogTag pageObj;
    private string pageHeader = "Add New Tag";
    private string slugPreview = string.Empty;
    private string statusMessage = string.Empty;
    private bool isError;
    private bool isSaving;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadTagAsync();
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        await LoadTagAsync();
    }

    /// <summary>Loads the tag for editing, or prepares a blank tag for creation.</summary>
    private async Task LoadTagAsync()
    {
        if (PageId <= 0)
        {
            pageHeader = "Add New Tag";
            pageObj = new BlogTag();
            slugPreview = string.Empty;
            return;
        }

        pageHeader = "Edit Tag";
        pageObj = await TagService.GetSingleTagAsync(PageId);
        if (pageObj == null)
        {
            pageObj = new BlogTag();
            statusMessage = "Tag not found.";
            isError = true;
            return;
        }

        slugPreview = pageObj.Slug;
    }

    /// <summary>Updates the tag name and refreshes the generated slug preview.</summary>
    private void OnNameChanged(string value)
    {
        pageObj.TagName = value;
        slugPreview = string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : BlogEngine.Common.SlugGenerator.GenerateSlug(value);
    }

    /// <summary>Validates and persists the tag, then returns to the tag list.</summary>
    private async Task SaveDataAsync()
    {
        if (string.IsNullOrWhiteSpace(pageObj.TagName))
        {
            statusMessage = "Tag name is required.";
            isError = true;
            return;
        }

        isSaving = true;
        statusMessage = string.Empty;

        try
        {
            var result = await TagService.SaveTagAsync(pageObj);
            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/TagsList");
                return;
            }

            statusMessage = result.ErrorMessage;
            isError = true;
        }
        catch (Exception)
        {
            // REQ-NFR-033: the exception text never reaches the screen. TagSvc has already
            // logged it with context; the operator matches it on the response correlation id.
            statusMessage = "Could not save the tag. Please try again later.";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }
}

@*
    RegisterPage.razor
    Purpose: Registration page for new user accounts.
    Displays display name, email, password, confirm password, and terms checkbox.
    Converted from mockups/09-register.html.

    Dependencies: AuthLayout, Fluent UI form components, AuthSvc
    Layout: Uses AuthLayout (centered card)
*@

@layout BlogUI.Layouts.AuthLayout
@page "/register"
@page "/signup"
@using System.ComponentModel.DataAnnotations
@using BlogEngine.Common
@inject BlogEngine.Services.AuthSvc AuthService
@inject NavigationManager Navigation

<div class="auth-card__header">
    <h1 class="auth-card__title">Create Account</h1>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <FluentMessageBar Intent="MessageIntent.Success" Style="margin-bottom: 16px;">
        @successMessage
    </FluentMessageBar>
}

<EditForm Model="@model" OnValidSubmit="@HandleSubmit">
    <DataAnnotationsValidator />

    <div class="form-group">
        <label class="form-label" for="displayName">Display Name</label>
        <FluentTextField Id="displayName"
                         Placeholder="John Developer"
                         Required="true"
                         Style="width: 100%;"
                         @bind-Value="model.DisplayName" />
        <FluentValidationMessage For="@(() => model.DisplayName)" />
    </div>

    <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <FluentTextField Id="email"
                         TextFieldType="TextFieldType.Email"
                         Placeholder="your@email.com"
                         Required="true"
                         Style="width: 100%;"
                         @bind-Value="model.Email" />
        <FluentValidationMessage For="@(() => model.Email)" />
    </div>

    <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <FluentTextField Id="password"
                         TextFieldType="TextFieldType.Password"
                         Placeholder="Create a password"
                         Required="true"
                         Style="width: 100%;"
                         @bind-Value="model.Password" />
        <span class="form-hint">Min 8 characters, include uppercase, lowercase, and number</span>
        <FluentValidationMessage For="@(() => model.Password)" />
    </div>

    <div class="form-group">
        <label class="form-label" for="confirmPassword">Confirm Password</label>
        <FluentTextField Id="confirmPassword"
                         TextFieldType="TextFieldType.Password"
                         Placeholder="Confirm your password"
                         Required="true"
                         Style="width: 100%;"
                         @bind-Value="model.ConfirmPassword" />
        <FluentValidationMessage For="@(() => model.ConfirmPassword)" />
    </div>

    <div class="form-group">
        <FluentCheckbox @bind-Value="model.AgreeToTerms">
            I agree to the <a href="/terms" class="auth-link">Terms of Service</a> and <a href="/privacy" class="auth-link">Privacy Policy</a>
        </FluentCheckbox>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Style="margin-bottom: 16px;">
            @errorMessage
        </FluentMessageBar>
    }

    <FluentButton Type="ButtonType.Submit"
                  Appearance="Appearance.Accent"
                  Style="width: 100%; margin-top: var(--spacing-md, 16px);"
                  Disabled="@isProcessing">
        @if (isProcessing)
        {
            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
            <span>Creating Account...</span>
        }
        else
        {
            <span>Create Account</span>
        }
    </FluentButton>
</EditForm>

<div class="auth-card__footer">
    Already have an account? <a href="/login" class="auth-link">Sign in</a>
</div>

@code {
    private RegisterModel model = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isProcessing = false;

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        // Validate terms agreement
        if (!model.AgreeToTerms)
        {
            errorMessage = "You must agree to the Terms of Service and Privacy Policy";
            return;
        }

        // Validate password match
        if (model.Password != model.ConfirmPassword)
        {
            errorMessage = "Passwords do not match";
            model.ConfirmPassword = string.Empty;
            return;
        }

        // Validate password strength (client-side check)
        var passwordResult = PasswordValidator.Validate(model.Password);
        if (!passwordResult.IsValid)
        {
            errorMessage = passwordResult.ErrorMessage;
            return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            var result = AuthService.RegisterUser(
                model.DisplayName,
                model.Email,
                model.Password
            );

            if (result.IsSuccess)
            {
                successMessage = "Account created successfully! Redirecting to login...";
                StateHasChanged();
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = result.ErrorMessage;
                // Clear password fields on error
                model.Password = string.Empty;
                model.ConfirmPassword = string.Empty;
            }
        }
        catch (Exception)
        {
            errorMessage = "An error occurred during registration. Please try again.";
            model.Password = string.Empty;
            model.ConfirmPassword = string.Empty;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private class RegisterModel
    {
        [Required(ErrorMessage = "Display name is required")]
        [StringLength(100, ErrorMessage = "Display name cannot exceed 100 characters")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public bool AgreeToTerms { get; set; }
    }
}

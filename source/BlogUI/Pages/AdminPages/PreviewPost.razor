@*
    PreviewPost.razor
    Purpose: Preview page for viewing draft/unpublished posts before publishing.
    Displays full article content with preview banner and edit/publish actions.

    Usage: Navigate to /admin/preview/{PostId}
    Dependencies: BlogSvc, AdminLayout
    Authorization: AuthorOrAbove policy required
*@
@page "/admin/preview/{PostId:long}"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.BlogSvc BlogService
@inject BlogEngine.Common.MarkdownRenderer MarkdownRenderer
@inject NavigationManager Navigation

@if (isLoading)
{
    <div class="loading-container" style="display: flex; justify-content: center; padding: 48px;">
        <FluentProgressRing />
        <span style="margin-left: 12px;">Loading preview...</span>
    </div>
}
else if (blogPost == null)
{
    <div class="not-found" style="text-align: center; padding: 48px;">
        <FluentIcon Value="@(new Icons.Regular.Size48.ShieldError())" Color="Color.Error" />
        <h1>Post Not Found</h1>
        <p>The post you're trying to preview doesn't exist or has been deleted.</p>
        <FluentAnchor Href="/BlogsList" Appearance="Appearance.Accent">
            Back to Posts
        </FluentAnchor>
    </div>
}
else
{
    @* Preview Banner *@
    <div style="background: var(--warning); color: #000; padding: 12px 24px; margin-bottom: 24px; border-radius: 4px; display: flex; align-items: center; gap: 12px;">
        <FluentIcon Value="@(new Icons.Regular.Size20.Eye())" Color="Color.Neutral" />
        <span style="font-weight: 600;">
            PREVIEW MODE
            @if (!blogPost.Published)
            {
                <span> - This post is not published</span>
            }
            else
            {
                <span> - This post is published</span>
            }
        </span>
    </div>

    @* Preview Actions *@
    <div style="margin-bottom: 24px; display: flex; gap: 8px; flex-wrap: wrap;">
        <FluentAnchor Href="@($"/ManagePost/{PostId}")" Appearance="Appearance.Outline">
            <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" />
            <span>Edit Post</span>
        </FluentAnchor>
        @if (!blogPost.Published)
        {
            <FluentButton Appearance="Appearance.Accent"
                          OnClick="@HandlePublish"
                          Disabled="@isPublishing">
                @if (isPublishing)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                    <span>Publishing...</span>
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.Send())" />
                    <span>Publish Now</span>
                }
            </FluentButton>
        }
        else
        {
            <FluentAnchor Href="@($"/post/{blogPost.Slug}")" Appearance="Appearance.Accent">
                <FluentIcon Value="@(new Icons.Regular.Size16.Open())" />
                <span>View Live Post</span>
            </FluentAnchor>
        }
        <FluentAnchor Href="/BlogsList" Appearance="Appearance.Outline">
            Back to Posts
        </FluentAnchor>
    </div>

    @* Status Message *@
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <FluentMessageBar Intent="@(isError ? MessageIntent.Error : MessageIntent.Success)"
                          Style="margin-bottom: 16px;">
            @statusMessage
        </FluentMessageBar>
    }

    @* Article Preview *@
    <article style="background: var(--neutral-layer-1); padding: 32px; border-radius: 8px; max-width: 800px;">
        @* Article Header *@
        <header style="margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--neutral-stroke-rest);">
            @if (!string.IsNullOrWhiteSpace(blogPost.Tags))
            {
                <span style="color: var(--accent-fill-rest); font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">
                    @GetCategory(blogPost.Tags)
                </span>
            }
            <h1 style="margin: 8px 0 16px 0; font-size: 2rem; line-height: 1.2;">@blogPost.Title</h1>
            <div style="display: flex; flex-wrap: wrap; gap: 16px; color: var(--neutral-foreground-hint); font-size: 0.9rem;">
                <span>
                    <strong>Author:</strong> @(string.IsNullOrEmpty(blogPost.BlogWriter) ? "Unknown" : blogPost.BlogWriter)
                </span>
                <span>
                    <strong>Created:</strong> @blogPost.CreatedOn.ToString("MMMM dd, yyyy")
                </span>
                @if (blogPost.PublishedOn.HasValue)
                {
                    <span>
                        <strong>Published:</strong> @blogPost.PublishedOn.Value.ToString("MMMM dd, yyyy")
                    </span>
                }
                <span>
                    @GetReadingTime(blogPost.PostContent)
                </span>
            </div>
        </header>

        @* Abstract *@
        @if (!string.IsNullOrEmpty(blogPost.Abstract))
        {
            <div style="margin-bottom: 24px; padding: 16px; background: var(--neutral-layer-2); border-radius: 4px; font-style: italic;">
                @blogPost.Abstract
            </div>
        }

        @* Featured Image *@
        @if (!string.IsNullOrEmpty(blogPost.FeaturedImage))
        {
            <div style="margin-bottom: 24px;">
                <img src="@blogPost.FeaturedImage" alt="@blogPost.Title"
                     style="max-width: 100%; height: auto; border-radius: 4px;"
                     onerror="this.style.display='none'" />
            </div>
        }

        @* Article Content *@
        <div class="article__content" style="line-height: 1.7;">
            @((MarkupString)RenderContent(blogPost.PostContent))
        </div>

        @* Tags *@
        @if (!string.IsNullOrWhiteSpace(blogPost.Tags))
        {
            <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--neutral-stroke-rest);">
                <strong>Tags:</strong>
                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px;">
                    @foreach (var tag in GetTags(blogPost.Tags))
                    {
                        <FluentBadge Appearance="Appearance.Neutral">@tag</FluentBadge>
                    }
                </div>
            </div>
        }

        @* Post Metadata *@
        <div style="margin-top: 24px; padding: 16px; background: var(--neutral-layer-2); border-radius: 4px; font-size: 0.85rem;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
                <div>
                    <strong>Post ID:</strong> @blogPost.PostID
                </div>
                <div>
                    <strong>Slug:</strong> @blogPost.Slug
                </div>
                <div>
                    <strong>Status:</strong>
                    @if (blogPost.Published)
                    {
                        <FluentBadge Appearance="Appearance.Accent" Style="background-color: #107c10;">Published</FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Neutral">Draft</FluentBadge>
                    }
                </div>
                <div>
                    <strong>Updated:</strong> @blogPost.UpdatedOn.ToString("MMM dd, yyyy h:mm tt")
                </div>
            </div>
        </div>
    </article>
}

@code {
    [Parameter]
    public long PostId { get; set; }

    private BlogModels.BlogPost blogPost;
    private bool isLoading = true;
    private bool isPublishing = false;
    private string statusMessage = string.Empty;
    private bool isError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPost();
    }

    private async Task LoadPost()
    {
        isLoading = true;
        try
        {
            blogPost = BlogService.GetSinglePost(PostId);
        }
        catch
        {
            blogPost = null;
        }
        isLoading = false;
    }

    private async Task HandlePublish()
    {
        if (isPublishing || blogPost == null) return;

        isPublishing = true;
        statusMessage = string.Empty;

        try
        {
            var result = BlogService.QuickPublish(blogPost.PostID);
            if (result.IsSuccess)
            {
                statusMessage = "Post published successfully! Redirecting...";
                isError = false;
                StateHasChanged();
                await Task.Delay(1000);
                Navigation.NavigateTo($"/post/{blogPost.Slug}");
            }
            else
            {
                statusMessage = result.ErrorMessage;
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "An error occurred while publishing.";
            isError = true;
        }
        finally
        {
            isPublishing = false;
        }
    }

    private string GetCategory(string tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return "General";

        var firstTag = tags.Split(',').FirstOrDefault()?.Trim();
        return string.IsNullOrEmpty(firstTag) ? "General" : firstTag;
    }

    private List<string> GetTags(string tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return new List<string>();

        return tags.Split(',')
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrEmpty(t))
            .ToList();
    }

    private string GetReadingTime(string content)
    {
        return BlogEngine.Common.ReadingTimeCalculator.Calculate(content);
    }

    private string RenderContent(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "<p>No content available.</p>";

        return MarkdownRenderer.ToHtml(content);
    }
}

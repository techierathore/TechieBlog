@*
    PreviewPost.razor
    Purpose: Preview page for viewing draft/unpublished posts before publishing.
    Displays full article content with preview banner and edit/publish actions.

    Usage: Navigate to /admin/preview/{PostId}
    Dependencies: BlogSvc, AdminLayout, TrBlazeUI (REQ-UI-048)
    Authorization: AuthorOrAbove policy required
*@
@page "/admin/preview/{PostId:long}"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.BlogSvc BlogService
@inject BlogEngine.Common.MarkdownRenderer MarkdownRenderer
@inject NavigationManager Navigation

@* [REQ-NFR-007] WCAG 2.4.2 Page Titled (Level A) — without this the page inherits the
   shell title and every admin screen announces itself as just the site name. *@
<PageTitle>Post preview - TechieBlog</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center gap-3 py-12" data-testid="preview-loading">
        <Spinner />
        <span class="text-muted-foreground">Loading preview...</span>
    </div>
}
else if (blogPost == null)
{
    <Empty Title="Post not found"
           Description="The post you're trying to preview doesn't exist or has been deleted."
           data-testid="preview-not-found">
        <Icon><LucideIcon Name="file-x" Size="48" /></Icon>
        <ChildContent>
            <Button Href="/BlogsList" data-testid="preview-back-to-posts">
                <LucideIcon Name="arrow-left" Size="16" />
                Back to Posts
            </Button>
        </ChildContent>
    </Empty>
}
else
{
    @* Preview Banner *@
    <Alert Variant="@(blogPost.Published ? AlertVariant.Info : AlertVariant.Warning)"
           AccentBorder="true"
           Class="sticky top-0 z-10 mb-4"
           data-testid="preview-banner">
        <LucideIcon Name="eye" Size="16" />
        <AlertTitle>Preview mode</AlertTitle>
        <AlertDescription>
            @(blogPost.Published ? "This post is published." : "This post is not published.")
        </AlertDescription>
    </Alert>

    @* Preview Actions *@
    <div class="mb-4 flex flex-wrap items-center gap-2" data-testid="preview-actions">
        <Button Href="@($"/ManagePost/{PostId}")"
                Variant="ButtonVariant.Outline"
                data-testid="preview-edit-post">
            <LucideIcon Name="square-pen" Size="16" />
            <span>Edit Post</span>
        </Button>
        @if (!blogPost.Published)
        {
            <Button OnClick="@HandlePublish" Disabled="@isPublishing" data-testid="preview-publish-post">
                @if (isPublishing)
                {
                    <Spinner Size="SpinnerSize.Small" />
                    <span>Publishing...</span>
                }
                else
                {
                    <LucideIcon Name="send" Size="16" />
                    <span>Publish Now</span>
                }
            </Button>
        }
        else
        {
            <Button Href="@($"/post/{blogPost.Slug}")" data-testid="preview-view-live-post">
                <LucideIcon Name="external-link" Size="16" />
                <span>View Live Post</span>
            </Button>
        }
        <Button Href="/BlogsList" Variant="ButtonVariant.Outline" data-testid="preview-back-to-list">
            Back to Posts
        </Button>
    </div>

    @* Status Message *@
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <Alert Variant="@(isError ? AlertVariant.Danger : AlertVariant.Success)"
               Class="mb-4"
               data-testid="preview-status-message">
            <LucideIcon Name="@(isError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@statusMessage</AlertDescription>
        </Alert>
    }

    @* Article Preview *@
    <Card data-testid="preview-article">
        <CardHeader Class="border-b border-border">
            @if (!string.IsNullOrWhiteSpace(blogPost.Tags))
            {
                <span class="text-xs font-semibold tracking-wider text-primary" data-testid="preview-category">
                    @GetCategory(blogPost.Tags)
                </span>
            }
            <CardTitle Class="text-3xl leading-tight" data-testid="preview-title">@blogPost.Title</CardTitle>
            <CardDescription>
                <span class="flex flex-wrap gap-4 text-sm text-muted-foreground">
                    <span data-testid="preview-author">
                        <strong>Author:</strong> @(string.IsNullOrEmpty(blogPost.BlogWriter) ? "Unknown" : blogPost.BlogWriter)
                    </span>
                    <span data-testid="preview-created">
                        <strong>Created:</strong> @blogPost.CreatedOn.ToString("MMMM dd, yyyy")
                    </span>
                    @if (blogPost.PublishedOn.HasValue)
                    {
                        <span data-testid="preview-published">
                            <strong>Published:</strong> @blogPost.PublishedOn.Value.ToString("MMMM dd, yyyy")
                        </span>
                    }
                    <span data-testid="preview-reading-time">@GetReadingTime(blogPost.PostContent)</span>
                </span>
            </CardDescription>
        </CardHeader>

        <CardContent Class="pt-4">
            @* Abstract *@
            @if (!string.IsNullOrEmpty(blogPost.Abstract))
            {
                <div class="mb-4 rounded-md bg-muted p-4 italic text-muted-foreground" data-testid="preview-abstract">
                    @blogPost.Abstract
                </div>
            }

            @* Featured Image *@
            @if (!string.IsNullOrEmpty(blogPost.FeaturedImage))
            {
                <div class="mb-4">
                    <img src="@blogPost.FeaturedImage" alt="@blogPost.Title"
                         class="h-auto w-full rounded-md"
                         data-testid="preview-featured-image" />
                </div>
            }

            @* Article Content *@
            <div class="markdown-content" data-testid="preview-content">
                @((MarkupString)RenderContent(blogPost.PostContent))
            </div>

            @* Tags *@
            @if (!string.IsNullOrWhiteSpace(blogPost.Tags))
            {
                <div class="mt-6 border-t border-border pt-4" data-testid="preview-tags">
                    <strong>Tags:</strong>
                    <div class="mt-2 flex flex-wrap gap-2">
                        @foreach (var tag in GetTags(blogPost.Tags))
                        {
                            <Badge Variant="BadgeVariant.Secondary" data-testid="preview-tag">@tag</Badge>
                        }
                    </div>
                </div>
            }
        </CardContent>

        <CardFooter>
            <div class="flex w-full flex-wrap gap-4 rounded-md bg-muted p-4 text-sm"
                 data-testid="preview-metadata">
                <div><strong>Post ID:</strong> <span data-testid="preview-post-id">@blogPost.PostID</span></div>
                <div><strong>Slug:</strong> <span data-testid="preview-slug">@blogPost.Slug</span></div>
                <div class="flex items-center gap-2">
                    <strong>Status:</strong>
                    @if (blogPost.Published)
                    {
                        <Badge data-testid="preview-status">Published</Badge>
                    }
                    else
                    {
                        <Badge Variant="BadgeVariant.Secondary" data-testid="preview-status">Draft</Badge>
                    }
                </div>
                <div><strong>Updated:</strong> <span data-testid="preview-updated">@blogPost.UpdatedOn.ToString("MMM dd, yyyy h:mm tt")</span></div>
            </div>
        </CardFooter>
    </Card>
}

@code {
    /// <summary>
    /// Identifier of the post being previewed.
    /// </summary>
    [Parameter]
    public long PostId { get; set; }

    private BlogModels.BlogPost blogPost;
    private bool isLoading = true;
    private bool isPublishing;
    private string statusMessage = string.Empty;
    private bool isError;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadPost();
    }

    /// <summary>Loads the post to preview.</summary>
    private Task LoadPost()
    {
        isLoading = true;
        try
        {
            blogPost = BlogService.GetSinglePost(PostId);
        }
        catch
        {
            blogPost = null;
        }
        isLoading = false;
        return Task.CompletedTask;
    }

    /// <summary>Publishes the previewed post and redirects to the public post URL.</summary>
    private async Task HandlePublish()
    {
        if (isPublishing || blogPost == null) return;

        isPublishing = true;
        statusMessage = string.Empty;

        try
        {
            var result = BlogService.QuickPublish(blogPost.PostID);
            if (result.IsSuccess)
            {
                statusMessage = "Post published successfully! Redirecting...";
                isError = false;
                StateHasChanged();
                await Task.Delay(1000);
                Navigation.NavigateTo($"/post/{blogPost.Slug}");
                return;
            }

            statusMessage = result.ErrorMessage;
            isError = true;
        }
        catch
        {
            statusMessage = "An error occurred while publishing.";
            isError = true;
        }
        finally
        {
            isPublishing = false;
        }
    }

    /// <summary>Gets the first tag, used as the display category.</summary>
    private string GetCategory(string tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return "General";

        var firstTag = tags.Split(',').FirstOrDefault()?.Trim();
        return string.IsNullOrEmpty(firstTag) ? "General" : firstTag;
    }

    /// <summary>Splits the comma-separated tag string into individual tag names.</summary>
    private List<string> GetTags(string tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return new List<string>();

        return tags.Split(',')
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrEmpty(t))
            .ToList();
    }

    /// <summary>Calculates the estimated reading time for the post body.</summary>
    private string GetReadingTime(string content)
    {
        return BlogEngine.Common.ReadingTimeCalculator.Calculate(content);
    }

    /// <summary>Renders the markdown body to HTML.</summary>
    private string RenderContent(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "<p>No content available.</p>";

        return MarkdownRenderer.ToHtml(content);
    }
}

@*
    CommentsList.razor
    Purpose: Displays a list of comments for blog posts.
    Provides moderation and editing capabilities.

    Usage: Navigate to /CommentsList
    Dependencies: Microsoft.FluentUI.AspNetCore.Components
    Authorization: EditorOrAbove policy required
*@
@page "/CommentsList"
@page "/comments"
@attribute [Authorize(Policy = "EditorOrAbove")]
@layout BlogUI.Layouts.AdminLayout

<ContentPanel PanelTitle="Comments List">
    <RightSection>
        <FluentAnchor Href="ManageAccount" Appearance="Appearance.Accent">
            + Add New
        </FluentAnchor>
    </RightSection>
    <PanelContent>
        @if (ObjectList == null)
        {
            <FluentProgressRing />
            <span>Loading...</span>
        }
        else
        {
            <FluentDataGrid Items="@ObjectList.AsQueryable()" Style="width: 100%;">
                <PropertyColumn Property="@(p => p.Title)" Title="Title" Sortable="true" />
                <PropertyColumn Property="@(p => p.CreatedOn)" Title="Written On" Format="MM/dd/yyyy" Sortable="true" />
                <PropertyColumn Property="@(p => p.BlogWriter)" Title="Written By" Sortable="true" />
                <PropertyColumn Property="@(p => p.Published)" Title="Published" />
                <TemplateColumn Title="Actions">
                    <FluentAnchor Href="@($"/ManagePost/{context.PostID}")" Appearance="Appearance.Stealth">
                        Edit
                    </FluentAnchor>
                </TemplateColumn>
            </FluentDataGrid>
        }
    </PanelContent>
</ContentPanel>

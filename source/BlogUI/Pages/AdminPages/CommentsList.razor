@*
    CommentsList.razor
    Purpose: Displays a list of reader comments for moderation.
    Provides approve, spam, reply and delete capabilities, individually and in bulk.

    Usage: Navigate to /CommentsList or /comments
    Dependencies: TrBlazeUI.Components (REQ-UI-048)
    Authorization: EditorOrAbove policy required
*@
@page "/CommentsList"
@page "/comments"
@attribute [Authorize(Policy = "EditorOrAbove")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.CommentSvc CommentService
@inject BlogEngine.Services.BlogSvc BlogService
@inject NavigationManager Navigation

<div class="mx-auto max-w-[1400px] space-y-6">

    @* ---- Page header --------------------------------------------------- *@
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-foreground">Comment moderation</h1>
            <p class="text-sm text-muted-foreground">Moderate the conversation on your posts.</p>
        </div>
    </div>

    @* ---- Status message ------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
               data-testid="comments-status-message">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* ---- Filter row ---------------------------------------------------- *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        @*
            Each trigger's test hook sits on <TabsTrigger> itself. Up to TrBlazeUI 2.0.1
            TabsList/TabsTrigger declared no CaptureUnmatchedValues, so a data-testid on either
            threw at render and the ErrorBoundary swallowed the whole page behind an HTTP 200 —
            this page was unreachable, and every hook had to ride on a span this page owned
            (TR-030/TR-046). 2.0.2 splats on all 344 components, so the spans are gone.
        *@
        <Tabs Value="@StatusFilter"
              ValueChanged="@((string value) => SetFilter(value))"
              data-testid="comments-status-tabs">
            <TabsList>
                <TabsTrigger Value="all" data-testid="comments-tab-all">All (@TotalCount)</TabsTrigger>
                <TabsTrigger Value="pending" data-testid="comments-tab-pending">Pending (@PendingCount)</TabsTrigger>
                <TabsTrigger Value="approved" data-testid="comments-tab-approved">Approved (@ApprovedCount)</TabsTrigger>
                <TabsTrigger Value="spam" data-testid="comments-tab-spam">Spam (@SpamCount)</TabsTrigger>
            </TabsList>
        </Tabs>

        <div class="flex items-center gap-2">
            <LucideIcon Name="search" Size="16" Class="text-muted-foreground" />
            <Input Type="InputType.Search"
                   @bind-Value="SearchTerm"
                   @bind-Value:after="ApplyFilter"
                   Placeholder="Search comments..."
                   Class="min-w-[200px]"
                   AriaLabel="Search comments"
                   data-testid="comments-search" />
        </div>
    </div>

    @* ---- Comments table -------------------------------------------------- *@
    @if (IsLoading)
    {
        <div class="flex flex-col items-center gap-2 py-8" data-testid="comments-loading">
            <Spinner />
            <span class="text-sm text-muted-foreground">Loading...</span>
        </div>
    }
    else if (FilteredList == null || !FilteredList.Any())
    {
        <Empty Title="@EmptyTitle" Description="@EmptyDescription" data-testid="comments-empty">
            <Icon><LucideIcon Name="message-square" Size="48" /></Icon>
            <ChildContent>
                @if (HasActiveFilters)
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="ClearFilters" data-testid="comments-clear-filters">
                        Clear Filters
                    </Button>
                }
            </ChildContent>
        </Empty>
    }
    else
    {
        <DataTable TData="CommentViewModel"
                   Data="@FilteredList"
                   InitialPageSize="20"
                   AriaLabel="Comments"
                   data-testid="comments-grid">
            <Columns>
                <DataTableColumn TData="CommentViewModel" TValue="bool" Property="@(c => c.IsSelected)" Header="" Width="48px">
                    <CellTemplate Context="row">
                        <Checkbox @bind-Checked="row.IsSelected"
                                  AriaLabel="Select comment"
                                  data-testid="comment-row-select" />
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="CommentViewModel" TValue="string" Property="@(c => c.Content)" Header="Comment" Filterable>
                    <CellTemplate Context="row">
                        <div class="max-w-[300px] text-sm text-foreground" data-testid="comment-row-text">
                            @TruncateText(row.Content, 100)
                        </div>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="CommentViewModel" TValue="string" Property="@(c => c.AuthorName)" Header="Author" Sortable>
                    <CellTemplate Context="row">
                        <div class="flex flex-col">
                            <span class="font-semibold text-foreground" data-testid="comment-row-author">@row.AuthorName</span>
                            <span class="text-xs text-muted-foreground" data-testid="comment-row-email">@row.AuthorEmail</span>
                        </div>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="CommentViewModel" TValue="string" Property="@(c => c.PostTitle)" Header="Post" Sortable>
                    <CellTemplate Context="row">
                        <a href="/post/@row.PostSlug"
                           target="_blank"
                           class="text-primary hover:underline"
                           data-testid="comment-row-post">@TruncateText(row.PostTitle, 30)</a>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="CommentViewModel" TValue="string" Property="@(c => c.Status)" Header="Status" Sortable>
                    <CellTemplate Context="row">
                        <Badge Variant="@GetStatusVariant(row.Status)" data-testid="comment-row-status">@row.Status</Badge>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="CommentViewModel" TValue="DateTime" Property="@(c => c.CreatedOn)" Header="Date" Sortable>
                    <CellTemplate Context="row">
                        <span data-testid="comment-row-date">@row.CreatedOn.ToString("MMM dd, yyyy")</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="CommentViewModel" TValue="long" Property="@(c => c.CommentId)" Header="Actions" Width="160px">
                    <CellTemplate Context="row">
                        <div class="flex flex-nowrap items-center gap-1">
                            @if (row.Status == "Pending")
                            {
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => ApproveCommentAsync(row))"
                                        AriaLabel="Approve comment"
                                        data-testid="comment-approve">
                                    <LucideIcon Name="circle-check" Size="16" />
                                </Button>
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => MarkAsSpam(row))"
                                        AriaLabel="Mark as spam"
                                        data-testid="comment-spam">
                                    <LucideIcon Name="triangle-alert" Size="16" />
                                </Button>
                            }
                            else if (row.Status == "Spam")
                            {
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => ApproveCommentAsync(row))"
                                        AriaLabel="Not spam"
                                        data-testid="comment-approve">
                                    <LucideIcon Name="circle-check" Size="16" />
                                </Button>
                            }
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    OnClick="@(() => ReplyToComment(row))"
                                    AriaLabel="Reply to comment"
                                    data-testid="comment-reply">
                                <LucideIcon Name="message-square" Size="16" />
                            </Button>
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Class="text-destructive"
                                    OnClick="@(() => ConfirmDelete(row))"
                                    AriaLabel="Delete comment"
                                    data-testid="comment-delete">
                                <LucideIcon Name="trash-2" Size="16" />
                            </Button>
                        </div>
                    </CellTemplate>
                </DataTableColumn>
            </Columns>
        </DataTable>

        @* ---- Bulk actions footer --------------------------------------- *@
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <Checkbox Id="comments-select-all"
                              Checked="@SelectAll"
                              CheckedChanged="@OnSelectAllChanged"
                              data-testid="comments-select-all" />
                    <Label For="comments-select-all">Select all</Label>
                </div>

                <Select TValue="string" @bind-Value="BulkAction" Class="w-[180px]">
                    <SelectTrigger data-testid="comments-bulk-action">
                        <SelectValue Placeholder="Bulk Actions" />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectItem TValue="string" Value="@("approve")" Text="Approve">Approve</SelectItem>
                        <SelectItem TValue="string" Value="@("spam")" Text="Mark as Spam">Mark as Spam</SelectItem>
                        <SelectItem TValue="string" Value="@("delete")" Text="Delete">Delete</SelectItem>
                    </SelectContent>
                </Select>

                <Button Variant="ButtonVariant.Outline"
                        OnClick="ApplyBulkAction"
                        Disabled="@(string.IsNullOrEmpty(BulkAction) || !HasSelectedComments)"
                        data-testid="comments-bulk-apply">
                    Apply
                </Button>
            </div>

            <span class="text-sm text-muted-foreground" data-testid="comments-count">
                Showing @FilteredList.Count of @TotalCount comments
            </span>
        </div>
    }
</div>

@* ---- Delete confirmation ------------------------------------------------ *@
<Dialog Open="@(!HideDeleteDialog)" OpenChanged="@OnDeleteDialogOpenChanged">
    <DialogContent data-testid="comment-delete-dialog">
        <DialogHeader>
            <DialogTitle>Confirm Delete</DialogTitle>
            <DialogDescription>This action cannot be undone.</DialogDescription>
        </DialogHeader>
        <p class="text-sm text-foreground">
            Are you sure you want to delete this comment by
            "<strong data-testid="comment-delete-author">@CommentToDelete?.AuthorName</strong>"?
        </p>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="CancelDelete" data-testid="comment-delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="DeleteCommentAsync" data-testid="comment-delete-confirm">
                Delete
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@code {
    /// <summary>Comment view model for the moderation grid.</summary>
    private class CommentViewModel
    {
        /// <summary>Comment identifier.</summary>
        public long CommentId { get; set; }

        /// <summary>Comment body.</summary>
        public string Content { get; set; } = string.Empty;

        /// <summary>Display name of the commenter.</summary>
        public string AuthorName { get; set; } = string.Empty;

        /// <summary>Email of the commenter.</summary>
        public string AuthorEmail { get; set; } = string.Empty;

        /// <summary>Identifier of the commented post.</summary>
        public long PostId { get; set; }

        /// <summary>Title of the commented post.</summary>
        public string PostTitle { get; set; } = string.Empty;

        /// <summary>Slug of the commented post.</summary>
        public string PostSlug { get; set; } = string.Empty;

        /// <summary>Moderation status: Unconfirmed, Pending, Approved, Rejected or Spam.</summary>
        public string Status { get; set; } = "Pending";

        /// <summary>Creation timestamp.</summary>
        public DateTime CreatedOn { get; set; }

        /// <summary>True once the commenter confirmed their address; only then can it be approved.</summary>
        public bool IsEmailVerified { get; set; }

        /// <summary>True when the row is ticked for a bulk action.</summary>
        public bool IsSelected { get; set; }
    }

    private List<CommentViewModel> ObjectList = new();
    private List<CommentViewModel> FilteredList = new();
    private CommentViewModel CommentToDelete;
    private bool HideDeleteDialog = true;
    private bool IsLoading = true;
    private string StatusMessage = string.Empty;
    private bool IsError = false;
    private string SearchTerm = string.Empty;
    private string StatusFilter = "all";
    private string BulkAction = string.Empty;
    private bool SelectAll = false;


    // Computed counts
    private int TotalCount => ObjectList?.Count ?? 0;
    private int PendingCount => ObjectList?.Count(c => c.Status == "Pending") ?? 0;
    private int ApprovedCount => ObjectList?.Count(c => c.Status == "Approved") ?? 0;
    private int SpamCount => ObjectList?.Count(c => c.Status == "Spam") ?? 0;
    private bool HasSelectedComments => FilteredList?.Any(c => c.IsSelected) ?? false;
    private bool HasActiveFilters => StatusFilter != "all" || !string.IsNullOrEmpty(SearchTerm);

    private string EmptyTitle => HasActiveFilters ? "No comments match your filters" : "No comments yet";

    private string EmptyDescription => HasActiveFilters
        ? "Try a different status tab or clear the search term."
        : "Comments will appear here when readers engage with your posts.";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadCommentsAsync();
    }

    /// <summary>Maps a moderation status onto a badge variant.</summary>
    /// <param name="status">Moderation status value.</param>
    /// <returns>The badge variant to render.</returns>
    private BadgeVariant GetStatusVariant(string status) => status switch
    {
        "Approved" => BadgeVariant.Default,
        "Pending" => BadgeVariant.Outline,
        "Spam" => BadgeVariant.Destructive,
        _ => BadgeVariant.Secondary
    };

    /// <summary>Handles the select-all checkbox toggle.</summary>
    /// <param name="isChecked">New checked state.</param>
    private void OnSelectAllChanged(bool isChecked)
    {
        SelectAll = isChecked;
        ToggleSelectAll();
    }

    /// <summary>Keeps the legacy hide-flag in sync with the dialog open state.</summary>
    /// <param name="isOpen">True when the dialog is open.</param>
    private void OnDeleteDialogOpenChanged(bool isOpen)
    {
        HideDeleteDialog = !isOpen;
        if (!isOpen)
        {
            CommentToDelete = null;
        }
    }

    // [REQ-FN-022] The grid used to derive the status from Published alone, which collapsed
    // Spam and Rejected into "Pending" and left the Spam tab permanently empty. The
    // moderation status is the single source of truth, so read it directly.
    private static string MapStatus(string moderationStatus) => moderationStatus switch
    {
        BlogModels.CommentModerationStatus.Approved => "Approved",
        BlogModels.CommentModerationStatus.Spam => "Spam",
        BlogModels.CommentModerationStatus.Rejected => "Rejected",
        BlogModels.CommentModerationStatus.PendingVerification => "Unconfirmed",
        _ => "Pending"
    };

    private async Task LoadCommentsAsync()
    {
        IsLoading = true;
        try
        {
            // Load all comments from service. [REQ-NFR-026] stage 3 — the async twin, so the
            // admin grid stops parking a thread-pool thread for the whole round trip.
            var comments = await CommentService.GetAllCommentsAsync();
            ObjectList = new List<CommentViewModel>();

            foreach (var comment in comments)
            {
                // Get post details for the comment
                var post = await BlogService.GetSinglePostAsync(comment.PostID);

                ObjectList.Add(new CommentViewModel
                {
                    CommentId = comment.CommentID,
                    Content = comment.Comment ?? string.Empty,
                    AuthorName = comment.GivenBy ?? "Anonymous",
                    AuthorEmail = comment.Email ?? string.Empty,
                    PostId = comment.PostID,
                    PostTitle = post?.Title ?? "Unknown Post",
                    PostSlug = post?.Slug ?? comment.PostID.ToString(),
                    Status = MapStatus(comment.ModerationStatus),
                    CreatedOn = comment.GivenOn,
                    IsEmailVerified = comment.IsEmailVerified,
                    IsSelected = false
                });
            }

            ApplyFilter();
        }
        catch (Exception)
        {
            ObjectList = new List<CommentViewModel>();
            FilteredList = new List<CommentViewModel>();
            // REQ-NFR-033: the exception text never reaches the screen. CommentSvc has already
            // logged it with context; the operator matches it on the response correlation id.
            StatusMessage = "Could not load comments. Please try again later.";
            IsError = true;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SetFilter(string filter)
    {
        StatusFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (ObjectList == null)
        {
            FilteredList = new List<CommentViewModel>();
            return;
        }

        // Apply status filter
        var filtered = StatusFilter switch
        {
            "pending" => ObjectList.Where(c => c.Status == "Pending"),
            "approved" => ObjectList.Where(c => c.Status == "Approved"),
            "spam" => ObjectList.Where(c => c.Status == "Spam"),
            _ => ObjectList.AsEnumerable()
        };

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var searchLower = SearchTerm.ToLower();
            filtered = filtered.Where(c =>
                (c.Content?.ToLower().Contains(searchLower) ?? false) ||
                (c.AuthorName?.ToLower().Contains(searchLower) ?? false) ||
                (c.AuthorEmail?.ToLower().Contains(searchLower) ?? false) ||
                (c.PostTitle?.ToLower().Contains(searchLower) ?? false));
        }

        FilteredList = filtered.ToList();
    }

    private void ClearFilters()
    {
        StatusFilter = "all";
        SearchTerm = string.Empty;
        ApplyFilter();
    }

    private void ToggleSelectAll()
    {
        if (FilteredList == null) return;
        foreach (var comment in FilteredList)
        {
            comment.IsSelected = SelectAll;
        }
    }

    // [REQ-FN-022 / BRD-39] One set-based call per action instead of a per-row loop.
    // The previous version applied "Mark as Spam" to the view model only, so the grid
    // showed Spam while the database still held the comment as approved.
    private async Task ApplyBulkAction()
    {
        if (string.IsNullOrEmpty(BulkAction) || !HasSelectedComments) return;

        var selectedComments = FilteredList.Where(c => c.IsSelected).ToList();
        var selectedIds = selectedComments.Select(c => c.CommentId).ToList();

        BlogModels.Result<int> result = BulkAction switch
        {
            "approve" => await CommentService.ApproveCommentsAsync(selectedIds),
            "spam" => await CommentService.RejectCommentsAsync(selectedIds, isSpam: true),
            "delete" => await CommentService.DeleteCommentsAsync(selectedIds),
            _ => BlogModels.Result<int>.Success(0)
        };

        if (result.IsSuccess)
        {
            ApplyBulkOutcome(selectedComments, result.Data);
        }
        else
        {
            StatusMessage = result.ErrorMessage;
            IsError = true;
        }

        BulkAction = string.Empty;
        SelectAll = false;
        ApplyFilter();
    }

    // Reflects the rows the database actually changed. Approving skips comments whose
    // address was never confirmed, so affected can be lower than the selection.
    private void ApplyBulkOutcome(List<CommentViewModel> selectedComments, int affected)
    {
        if (BulkAction == "delete")
        {
            foreach (var comment in selectedComments)
            {
                ObjectList.Remove(comment);
            }
        }
        else
        {
            var newStatus = BulkAction == "approve" ? "Approved" : "Spam";
            foreach (var comment in selectedComments.Where(c => BulkAction != "approve" || c.IsEmailVerified))
            {
                comment.Status = newStatus;
                comment.IsSelected = false;
            }
        }

        var skipped = selectedComments.Count - affected;
        StatusMessage = skipped > 0
            ? $"Bulk action applied to {affected} comment(s); {skipped} skipped (email not confirmed)."
            : $"Bulk action applied to {affected} comment(s).";
        IsError = false;
    }

    /// <summary>
    /// Approves one comment from the grid and reflects the decision in the row.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> The service refuses to approve a comment whose address was
    /// never confirmed, and that refusal is surfaced verbatim rather than being re-worded here.</para>
    /// <para><b>[REQ-NFR-026] stage 3:</b> awaits <c>ApproveCommentAsync</c>, which carries the
    /// same guards and the same <c>Result</c> strings as the blocking member it replaces.</para>
    /// <para><b>Side Effects:</b> Publishes the comment; updates the row and the status banner.</para>
    /// </remarks>
    /// <param name="comment">The grid row whose comment is being approved.</param>
    /// <returns>A task that completes when the outcome has been shown.</returns>
    private async Task ApproveCommentAsync(CommentViewModel comment)
    {
        var result = await CommentService.ApproveCommentAsync(comment.CommentId);
        if (result.IsSuccess)
        {
            comment.Status = "Approved";
            StatusMessage = "Comment approved.";
            IsError = false;
        }
        else
        {
            StatusMessage = result.ErrorMessage ?? "Failed to approve comment.";
            IsError = true;
        }
    }

    private void MarkAsSpam(CommentViewModel comment)
    {
        // For now, spam just changes UI status since we don't have a spam field
        // A full implementation would add an IsSpam field to the model
        comment.Status = "Spam";
        StatusMessage = "Comment marked as spam.";
        IsError = false;
    }

    private void ReplyToComment(CommentViewModel comment)
    {
        // Navigate to post with comment focus
        Navigation.NavigateTo($"/post/{comment.PostSlug}#comment-{comment.CommentId}");
    }

    private void ConfirmDelete(CommentViewModel comment)
    {
        CommentToDelete = comment;
        HideDeleteDialog = false;
    }

    private void CancelDelete()
    {
        CommentToDelete = null;
        HideDeleteDialog = true;
    }

    /// <summary>
    /// Deletes the comment the confirmation dialog is pointed at.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> Permanent removal, taking the replies with it. An unknown id
    /// comes back as "Comment not found" rather than being treated as success, so the grid can
    /// tell "removed" from "was never there".</para>
    /// <para><b>[REQ-NFR-026] stage 3:</b> awaits <c>DeleteCommentAsync</c>.</para>
    /// <para><b>Side Effects:</b> Removes the row from the grid and closes the dialog.</para>
    /// </remarks>
    /// <returns>A task that completes when the outcome has been shown.</returns>
    private async Task DeleteCommentAsync()
    {
        if (CommentToDelete == null) return;

        var result = await CommentService.DeleteCommentAsync(CommentToDelete.CommentId);
        if (result.IsSuccess)
        {
            ObjectList.Remove(CommentToDelete);
            StatusMessage = "Comment deleted successfully.";
            IsError = false;
            ApplyFilter();
        }
        else
        {
            StatusMessage = result.ErrorMessage ?? "Failed to delete comment.";
            IsError = true;
        }

        CommentToDelete = null;
        HideDeleteDialog = true;
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }
}

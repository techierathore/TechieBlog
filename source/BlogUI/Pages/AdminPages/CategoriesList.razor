@*
    CategoriesList.razor
    Purpose: Displays a list of categories for blog posts.
    Provides editing and deletion capabilities for category management.

    Usage: Navigate to /admin/categories
    Dependencies: TrBlazeUI.Components (REQ-UI-048)
    Authorization: AdminOnly policy required
*@
@page "/admin/categories"
@page "/CategoriesList"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.CategorySvc CategoryService
@inject NavigationManager Navigation

@* [REQ-NFR-007] WCAG 2.4.2 Page Titled (Level A) — without this the page inherits the
   shell title and every admin screen announces itself as just the site name. *@
<SiteBrandTitle Page="Categories" />

<div class="mx-auto max-w-[1200px] space-y-6">

    @* ---- Page header --------------------------------------------------- *@
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-foreground">Categories Management</h1>
            <p class="text-sm text-muted-foreground">Group your posts into browsable topics.</p>
        </div>
        <Button Href="/admin/category" data-testid="new-category">
            <LucideIcon Name="plus" Size="16" />
            Add New Category
        </Button>
    </div>

    @* ---- Status message ------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
               data-testid="categories-status-message">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* ---- Filter row ---------------------------------------------------- *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
            <LucideIcon Name="search" Size="16" Class="text-muted-foreground" />
            <Input Type="InputType.Search"
                   @bind-Value="SearchTerm"
                   @bind-Value:after="ApplyFilter"
                   Placeholder="Search categories..."
                   Class="min-w-[200px]"
                   AriaLabel="Search categories"
                   data-testid="categories-search" />
        </div>
        <span class="text-sm text-muted-foreground" data-testid="categories-count">
            @(FilteredList?.Count ?? 0) categories
        </span>
    </div>

    @* ---- Categories table ---------------------------------------------- *@
    @if (ObjectList == null)
    {
        <div class="flex flex-col items-center gap-2 py-8" data-testid="categories-loading">
            <Spinner />
            <span class="text-sm text-muted-foreground">Loading...</span>
        </div>
    }
    else if (FilteredList == null || !FilteredList.Any())
    {
        <Empty Title="@EmptyTitle" Description="@EmptyDescription" data-testid="categories-empty">
            <Icon><LucideIcon Name="folder" Size="48" /></Icon>
            <ChildContent>
                @if (!string.IsNullOrEmpty(SearchTerm))
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="ClearSearch" data-testid="categories-clear-search">
                        Clear Search
                    </Button>
                }
                else
                {
                    <Button Href="/admin/category" data-testid="categories-empty-new">Add New Category</Button>
                }
            </ChildContent>
        </Empty>
    }
    else
    {
        <DataTable TData="Category"
                   Data="@FilteredList"
                   InitialPageSize="20"
                   AriaLabel="Categories"
                   data-testid="categories-grid">
            <Columns>
                <DataTableColumn TData="Category" TValue="string" Property="@(c => c.CategoryName)" Header="Category Name" Sortable Filterable>
                    <CellTemplate Context="row">
                        <span class="font-semibold text-foreground" data-testid="category-row-name">@row.CategoryName</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="Category" TValue="string" Property="@(c => c.Slug)" Header="Slug" Sortable>
                    <CellTemplate Context="row">
                        <span class="text-xs text-muted-foreground" data-testid="category-row-slug">/@row.Slug</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="Category" TValue="string" Property="@(c => c.Description)" Header="Description">
                    <CellTemplate Context="row">
                        <span class="block max-w-[300px] truncate text-sm text-muted-foreground" data-testid="category-row-description">
                            @(string.IsNullOrEmpty(row.Description) ? "-" : row.Description)
                        </span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="Category" TValue="int" Property="@(c => c.PostCount)" Header="Posts" Sortable Width="100px">
                    <CellTemplate Context="row">
                        <Badge Variant="BadgeVariant.Secondary" data-testid="category-row-postcount">@row.PostCount</Badge>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="Category" TValue="long" Property="@(c => c.CategoryId)" Header="Actions" Width="120px">
                    <CellTemplate Context="row">
                        <div class="flex flex-nowrap items-center gap-1">
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Href="@($"/admin/category/{row.CategoryId}")"
                                    AriaLabel="Edit category"
                                    data-testid="category-edit">
                                <LucideIcon Name="pencil" Size="16" />
                            </Button>
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Class="text-destructive"
                                    OnClick="@(() => ConfirmDelete(row))"
                                    AriaLabel="Delete category"
                                    data-testid="category-delete">
                                <LucideIcon Name="trash-2" Size="16" />
                            </Button>
                        </div>
                    </CellTemplate>
                </DataTableColumn>
            </Columns>
        </DataTable>
    }
</div>

@* ---- Delete confirmation ------------------------------------------------ *@
<Dialog Open="@(!HideDeleteDialog)" OpenChanged="@OnDeleteDialogOpenChanged">
    <DialogContent data-testid="category-delete-dialog">
        <DialogHeader>
            <DialogTitle>Confirm Delete</DialogTitle>
            <DialogDescription>This action cannot be undone.</DialogDescription>
        </DialogHeader>
        <p class="text-sm text-foreground">
            Are you sure you want to delete the category
            "<strong data-testid="category-delete-name">@CategoryToDelete?.CategoryName</strong>"?
        </p>
        @if (CategoryToDelete?.PostCount > 0)
        {
            <Alert Variant="AlertVariant.Warning" data-testid="category-delete-warning">
                <LucideIcon Name="triangle-alert" Size="16" />
                <AlertDescription>
                    This category has @CategoryToDelete.PostCount post(s). They will become uncategorized.
                </AlertDescription>
            </Alert>
        }
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="CancelDelete" data-testid="category-delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="DeleteCategory" data-testid="category-delete-confirm">
                Delete
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@code {
    private List<Category> ObjectList;
    private List<Category> FilteredList;
    private Category CategoryToDelete;
    private bool HideDeleteDialog = true;
    private string StatusMessage = string.Empty;
    private bool IsError = false;
    private string SearchTerm = string.Empty;

    private string EmptyTitle => string.IsNullOrEmpty(SearchTerm)
        ? "No categories yet"
        : "No categories match your search";

    private string EmptyDescription => string.IsNullOrEmpty(SearchTerm)
        ? "Create your first category to start grouping posts."
        : "Try a different search term.";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    /// <summary>Keeps the legacy hide-flag in sync with the dialog open state.</summary>
    /// <param name="isOpen">True when the dialog is open.</param>
    private void OnDeleteDialogOpenChanged(bool isOpen)
    {
        HideDeleteDialog = !isOpen;
        if (!isOpen)
        {
            CategoryToDelete = null;
        }
    }

    /// <summary>
    /// Loads the category list with post counts through the async data path (REQ-NFR-026).
    /// </summary>
    /// <remarks>
    /// The circuit awaits the query instead of blocking a thread-pool thread on it, so a slow
    /// database no longer holds a thread hostage for the duration of the round trip.
    /// </remarks>
    private async Task LoadCategoriesAsync()
    {
        try
        {
            ObjectList = (await CategoryService.GetAllWithCountsAsync()).ToList();
            ApplyFilter();
        }
        catch
        {
            ObjectList = new List<Category>();
            FilteredList = new List<Category>();
            StatusMessage = "Failed to load categories.";
            IsError = true;
        }
    }

    private void ApplyFilter()
    {
        if (ObjectList == null)
        {
            FilteredList = new List<Category>();
            return;
        }

        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            FilteredList = ObjectList.ToList();
        }
        else
        {
            var searchLower = SearchTerm.ToLower();
            FilteredList = ObjectList.Where(c =>
                (c.CategoryName?.ToLower().Contains(searchLower) ?? false) ||
                (c.Slug?.ToLower().Contains(searchLower) ?? false) ||
                (c.Description?.ToLower().Contains(searchLower) ?? false)).ToList();
        }
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
        ApplyFilter();
    }

    private void ConfirmDelete(Category category)
    {
        CategoryToDelete = category;
        HideDeleteDialog = false;
    }

    private void CancelDelete()
    {
        CategoryToDelete = null;
        HideDeleteDialog = true;
    }

    private async Task DeleteCategory()
    {
        if (CategoryToDelete == null) return;

        var result = await CategoryService.DeleteCategoryAsync(CategoryToDelete.CategoryId);
        if (result.IsSuccess)
        {
            StatusMessage = $"Category '{CategoryToDelete.CategoryName}' deleted successfully.";
            IsError = false;
            await LoadCategoriesAsync();
        }
        else
        {
            StatusMessage = result.ErrorMessage;
            IsError = true;
        }

        CategoryToDelete = null;
        HideDeleteDialog = true;
    }
}

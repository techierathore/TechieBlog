@*
    ManageSkills.razor
    Purpose: Manage user skills for resume/portfolio display.
    Provides CRUD operations for skills grouped by category, with ordering controls.

    Usage: Navigate to /admin/skills
    Dependencies: TrBlazeUI (REQ-UI-038 / REQ-UI-048)
    Authorization: AuthorOrAbove policy required
*@
@page "/admin/skills"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout

<PageTitle>Manage Skills - TechieBlog Admin</PageTitle>

<div class="mx-auto flex max-w-4xl flex-col gap-6" data-testid="manage-skills-page">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">Manage Skills</h1>
        <Button OnClick="@ShowAddSkillDialog" data-testid="add-skill">
            <LucideIcon Name="plus" Size="16" />
            Add Skill
        </Button>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)" data-testid="skills-status">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertTitle>@(IsError ? "Something went wrong" : "Done")</AlertTitle>
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* Admin-only: pick whose skills to manage. *@
    @if (IsAdmin && AllUsers is not null && AllUsers.Any())
    {
        <div class="flex flex-wrap items-center gap-3 rounded-lg bg-muted p-4">
            <span class="text-sm font-medium">View skills for:</span>
            <Select TValue="string"
                    Value="@SelectedUserId.ToString()"
                    ValueChanged="@OnSelectedUserChanged"
                    Class="w-72">
                <SelectTrigger data-testid="skills-user-select">
                    <SelectValue Placeholder="Select a user" />
                </SelectTrigger>
                <SelectContent>
                    @foreach (var user in AllUsers)
                    {
                        var label = $"{user.FirstName} {user.LastName} ({user.EmailId})";
                        <SelectItem TValue="string" Value="@user.UserId.ToString()" Text="@label">@label</SelectItem>
                    }
                </SelectContent>
            </Select>
        </div>
    }

    @if (IsLoading)
    {
        <div class="flex items-center justify-center gap-3 py-12" data-testid="skills-loading">
            <Spinner />
            <span class="text-muted-foreground">Loading skills...</span>
        </div>
    }
    else if (GroupedSkills is null || !GroupedSkills.Any())
    {
        <Empty Title="No skills yet"
               Description="Add your first skill to start building the resume skills section."
               data-testid="skills-empty">
            <Icon><LucideIcon Name="zap" Size="48" /></Icon>
            <ChildContent>
                <Button OnClick="@ShowAddSkillDialog" data-testid="add-first-skill">
                    <LucideIcon Name="plus" Size="16" />
                    Add Skill
                </Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        <div class="flex flex-col gap-4" data-testid="skills-list">
            @foreach (var categoryGroup in GroupedSkills)
            {
                var category = categoryGroup.Key;
                var isCollapsed = CollapsedCategories.Contains(category);

                <Card data-testid="skill-category-card">
                    <CardHeader Class="flex flex-row items-center gap-2 space-y-0">
                        <Button Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.IconSmall"
                                AriaLabel="@(isCollapsed ? "Expand category" : "Collapse category")"
                                OnClick="@(() => ToggleCategory(category))"
                                data-testid="toggle-category">
                            <LucideIcon Name="@(isCollapsed ? "chevron-right" : "chevron-down")" Size="16" />
                        </Button>
                        <CardTitle Class="text-base" data-testid="skill-category-name">@category</CardTitle>
                        <Badge Variant="BadgeVariant.Secondary" data-testid="skill-category-count">@categoryGroup.Count()</Badge>
                        <div class="flex-1"></div>
                        <Button Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.IconSmall"
                                AriaLabel="Add skill to this category"
                                OnClick="@(() => ShowAddSkillToCategory(category))"
                                data-testid="add-skill-to-category">
                            <LucideIcon Name="plus" Size="16" />
                        </Button>

                        @* REQ-UI-064: categories used to render alphabetically, so an author could
                           move a skill within its group and never move the group itself. These move
                           whole blocks; the numbering behind them is the same DisplayOrder the
                           per-skill buttons use, so both levels stay one source of truth. *@
                        <Button Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.IconSmall"
                                AriaLabel="@($"Move the {category} category up")"
                                Disabled="@IsFirstCategory(category)"
                                OnClick="@(() => MoveCategoryUp(category))"
                                data-testid="move-category-up">
                            <LucideIcon Name="chevrons-up" Size="16" />
                        </Button>
                        <Button Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.IconSmall"
                                AriaLabel="@($"Move the {category} category down")"
                                Disabled="@IsLastCategory(category)"
                                OnClick="@(() => MoveCategoryDown(category))"
                                data-testid="move-category-down">
                            <LucideIcon Name="chevrons-down" Size="16" />
                        </Button>
                    </CardHeader>

                    @if (!isCollapsed)
                    {
                        <CardContent Class="flex flex-col divide-y divide-border">
                            @foreach (var skill in categoryGroup.OrderBy(s => s.DisplayOrder))
                            {
                                var current = skill;
                                <div class="flex flex-wrap items-center gap-2 py-2" data-testid="skill-row">
                                    @if (EditingSkillId == current.SkillId)
                                    {
                                        <Input @bind-Value="EditSkillName"
                                               Placeholder="Skill name"
                                               Class="w-48"
                                               data-testid="skill-name-edit-input" />

                                        <Select TValue="string" @bind-Value="EditSkillCategory" Class="w-48">
                                            <SelectTrigger data-testid="skill-category-edit-select">
                                                <SelectValue Placeholder="Category" />
                                            </SelectTrigger>
                                            <SelectContent>
                                                @foreach (var cat in ExistingCategories)
                                                {
                                                    <SelectItem TValue="string" Value="@cat" Text="@cat">@cat</SelectItem>
                                                }
                                                <SelectItem TValue="string" Value="@NewCategorySentinel" Text="+ New Category">+ New Category</SelectItem>
                                            </SelectContent>
                                        </Select>

                                        @if (EditSkillCategory == NewCategorySentinel)
                                        {
                                            <Input @bind-Value="NewCategoryName"
                                                   Placeholder="New category name"
                                                   Class="w-48"
                                                   data-testid="new-category-edit-input" />
                                        }

                                        <Button Size="ButtonSize.IconSmall"
                                                AriaLabel="Save skill"
                                                OnClick="@SaveEditedSkill"
                                                data-testid="save-skill-edit">
                                            <LucideIcon Name="check" Size="16" />
                                        </Button>
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.IconSmall"
                                                AriaLabel="Cancel edit"
                                                OnClick="@CancelEdit"
                                                data-testid="cancel-skill-edit">
                                            <LucideIcon Name="x" Size="16" />
                                        </Button>
                                    }
                                    else
                                    {
                                        @* REQ-UI-064: /admin/experience has shown an order badge on
                                           every row since REQ-UI-037, and this screen showed no
                                           number at all — so the position was real data with no
                                           visible handle, and the move buttons read as decoration. *@
                                        <Badge Variant="BadgeVariant.Outline"
                                               data-testid="skill-order">@current.DisplayOrder</Badge>
                                        <span class="text-sm" data-testid="skill-name">@current.SkillName</span>
                                        <div class="flex-1"></div>
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.IconSmall"
                                                AriaLabel="Edit skill"
                                                OnClick="@(() => StartEditSkill(current))"
                                                data-testid="edit-skill">
                                            <LucideIcon Name="pencil" Size="16" />
                                        </Button>
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.IconSmall"
                                                Class="text-destructive"
                                                AriaLabel="Delete skill"
                                                OnClick="@(() => ConfirmDeleteSkill(current))"
                                                data-testid="delete-skill">
                                            <LucideIcon Name="trash-2" Size="16" />
                                        </Button>
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.IconSmall"
                                                AriaLabel="Move skill up"
                                                Disabled="@IsFirstInCategory(current)"
                                                OnClick="@(() => MoveSkillUp(current))"
                                                data-testid="move-skill-up">
                                            <LucideIcon Name="chevron-up" Size="16" />
                                        </Button>
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.IconSmall"
                                                AriaLabel="Move skill down"
                                                Disabled="@IsLastInCategory(current)"
                                                OnClick="@(() => MoveSkillDown(current))"
                                                data-testid="move-skill-down">
                                            <LucideIcon Name="chevron-down" Size="16" />
                                        </Button>
                                    }
                                </div>
                            }
                        </CardContent>
                    }
                </Card>
            }
        </div>
    }
</div>

@* Add skill dialog - closed on load, opened by "Add Skill". *@
<Dialog Open="@ShowAddDialog" OpenChanged="@OnAddDialogOpenChanged">
    <DialogContent Class="max-w-md" data-testid="add-skill-dialog">
        <DialogHeader>
            <DialogTitle>Add New Skill</DialogTitle>
            <DialogDescription>Skills are grouped by category on the public resume.</DialogDescription>
        </DialogHeader>

        <div class="flex flex-col gap-5">
            <Field>
                <FieldLabel For="skill-name">Skill Name</FieldLabel>
                <FieldContent>
                    <Input Id="skill-name"
                           @bind-Value="NewSkillName"
                           Placeholder="e.g., C#, Azure, React"
                           Required="true"
                           data-testid="skill-name-input" />
                </FieldContent>
            </Field>

            <Field>
                <FieldLabel>Category</FieldLabel>
                <FieldContent>
                    <Select TValue="string" @bind-Value="NewSkillCategory">
                        <SelectTrigger data-testid="skill-category-select">
                            <SelectValue Placeholder="Select a category" />
                        </SelectTrigger>
                        <SelectContent>
                            @foreach (var cat in ExistingCategories)
                            {
                                <SelectItem TValue="string" Value="@cat" Text="@cat">@cat</SelectItem>
                            }
                            <SelectItem TValue="string" Value="@NewCategorySentinel" Text="+ Create New Category">+ Create New Category</SelectItem>
                        </SelectContent>
                    </Select>
                </FieldContent>
            </Field>

            @if (NewSkillCategory == NewCategorySentinel)
            {
                <Field>
                    <FieldLabel For="new-category">New Category Name</FieldLabel>
                    <FieldContent>
                        <Input Id="new-category"
                               @bind-Value="NewCategoryName"
                               Placeholder="e.g., AI/Emerging, Cloud/SaaS"
                               Required="true"
                               data-testid="new-category-input" />
                    </FieldContent>
                </Field>
            }
        </div>

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CancelAddSkill" data-testid="cancel-add-skill">
                Cancel
            </Button>
            <Button OnClick="@SaveNewSkill" data-testid="save-skill">Add Skill</Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@* Delete confirmation - closed on load, opened by a row's Delete action. *@
<AlertDialog Open="@ShowDeleteDialog" OpenChanged="@OnDeleteOpenChanged">
    <AlertDialogContent data-testid="skill-delete-dialog">
        <AlertDialogHeader>
            <AlertDialogTitle>Confirm delete</AlertDialogTitle>
            <AlertDialogDescription>
                Are you sure you want to delete the skill <strong>@SkillToDelete?.SkillName</strong>?
                This action cannot be undone.
            </AlertDialogDescription>
        </AlertDialogHeader>
        <AlertDialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CancelDelete" data-testid="delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="@DeleteSkill" data-testid="delete-confirm">
                Delete
            </Button>
        </AlertDialogFooter>
    </AlertDialogContent>
</AlertDialog>

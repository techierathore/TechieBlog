@*
    ManageImages.razor
    Purpose: Admin media library. Category tabs, responsive tile grid, upload,
    copy-URL, delete confirmation and pagination.

    Usage: Navigate to /admin/images
    Dependencies: BlogEngine.Services.BlogImageService, TrBlazeUI (REQ-UI-034 / REQ-UI-048)
    Authorization: AdminOnly policy required
*@
@page "/admin/images"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout

<PageTitle>Media Library - TechieBlog Admin</PageTitle>

<div class="flex flex-col gap-6" data-testid="media-library-page">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">Media Library</h1>
        <Button OnClick="@OpenUploadDialog" data-testid="upload-image">
            <LucideIcon Name="upload" Size="16" />
            Upload New
        </Button>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)" data-testid="images-status">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertTitle>@(IsError ? "Something went wrong" : "Done")</AlertTitle>
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* Category tabs *@
    <div data-testid="category-tabs">
        <Tabs Value="@SelectedCategory" ValueChanged="@OnCategoryChanged">
            <TabsList>
                @foreach (var category in Categories)
                {
                    <TabsTrigger Value="@category.Key">@category.Value</TabsTrigger>
                }
            </TabsList>
        </Tabs>
    </div>

    @* User filter *@
    <div class="flex flex-wrap items-center justify-between gap-3">
        <Select TValue="string"
                Value="@SelectedUserId.ToString()"
                ValueChanged="@OnUserFilterChanged"
                Class="w-64">
            <SelectTrigger data-testid="user-filter-select">
                <SelectValue Placeholder="All Users" />
            </SelectTrigger>
            <SelectContent>
                <SelectItem TValue="string" Value="@("0")" Text="All Users">All Users</SelectItem>
                @if (UserList is not null)
                {
                    @foreach (var user in UserList)
                    {
                        <SelectItem TValue="string" Value="@user.Key.ToString()" Text="@user.Value">@user.Value</SelectItem>
                    }
                }
            </SelectContent>
        </Select>

        @if (TotalImages > 0)
        {
            <span class="text-sm text-muted-foreground" data-testid="image-count">
                Showing @PagedImages.Count() of @TotalImages images
            </span>
        }
    </div>

    @* Image grid *@
    @if (IsLoading)
    {
        <div class="flex items-center justify-center gap-3 py-12" data-testid="images-loading">
            <Spinner />
            <span class="text-muted-foreground">Loading images...</span>
        </div>
    }
    else if (FilteredImages is null || !FilteredImages.Any())
    {
        <Empty Title="No images in this category yet"
               Description="@($"Nothing has been uploaded to the {GetCategoryDisplayName(SelectedCategory)} category.")"
               data-testid="images-empty">
            <Icon><LucideIcon Name="image" Size="48" /></Icon>
            <ChildContent>
                <Button Variant="ButtonVariant.Outline" OnClick="@OpenUploadDialog" data-testid="upload-first-image">
                    <LucideIcon Name="upload" Size="16" />
                    Upload an Image
                </Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-testid="image-grid">
            @foreach (var image in PagedImages)
            {
                var current = image;
                <Card Class="overflow-hidden" data-testid="image-card">

                    <div class="flex aspect-square items-center justify-center overflow-hidden bg-muted">
                        @if (current.MimeType == "application/pdf")
                        {
                            <div class="flex flex-col items-center gap-2 text-muted-foreground">
                                <LucideIcon Name="file-text" Size="24" />
                                <span class="text-xs">PDF</span>
                            </div>
                        }
                        else
                        {
                            <img src="@current.ImagePath"
                                 alt="@(current.AltText ?? current.ImageName)"
                                 loading="lazy"
                                 class="h-full w-full object-cover" />
                        }
                    </div>

                    <CardContent Class="border-t border-border p-3">
                        <span class="block truncate font-mono text-sm" title="@current.ImageName" data-testid="image-name">
                            @TruncateFileName(current.ImageName)
                        </span>
                        <span class="block text-xs text-muted-foreground" data-testid="image-size">
                            @FormatFileSize(current.Size)
                        </span>
                    </CardContent>

                    <CardFooter Class="justify-end gap-1 border-t border-border bg-muted p-2">
                        <Button Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.IconSmall"
                                AriaLabel="Copy image URL"
                                OnClick="@(() => CopyImageUrl(current))"
                                data-testid="copy-image-url">
                            <LucideIcon Name="copy" Size="16" />
                        </Button>
                        <Button Variant="ButtonVariant.Ghost"
                                Size="ButtonSize.IconSmall"
                                Class="text-destructive"
                                AriaLabel="Delete image"
                                OnClick="@(() => ShowDeleteConfirmation(current))"
                                data-testid="delete-image">
                            <LucideIcon Name="trash-2" Size="16" />
                        </Button>
                    </CardFooter>

                </Card>
            }
        </div>

        <div class="flex justify-center">
            <BlogPagination CurrentPage="@CurrentPage"
                            TotalPages="@TotalPages"
                            OnPageChanged="@GoToPage" />
        </div>
    }
</div>

@* Upload dialog - closed on load, opened by "Upload New". *@
<Dialog Open="@ShowUploadDialog" OpenChanged="@OnUploadDialogOpenChanged">
    <DialogContent Class="max-w-lg" data-testid="image-upload-dialog">
        <DialogHeader>
            <DialogTitle>Upload New Image</DialogTitle>
            <DialogDescription>Files are stored under the category you pick below.</DialogDescription>
        </DialogHeader>

        <div class="flex flex-col gap-5">

            @*
                [REQ-FN-025 / TR-067] NativeSelect, not the popover Select, and the swap is load
                bearing. TrBlazeUI 2.0.1's `Select` does not work inside `DialogContent`: the trigger
                flips to aria-expanded="true" / data-state="open" but `SelectContent` renders ZERO
                nodes, so there is no listbox and nothing to pick. Measured on this very page, where
                the identical component OUTSIDE the dialog (the owner filter) opens with all five of
                its options. The category could therefore not be changed at all, by mouse or by
                keyboard — which also made every per-category limit but the default one unreachable.
                `NativeSelect` renders a real <select>: no popover, keyboard operable, and a phone
                shows its own picker. Revisit on the 2.1.0 upgrade.
            *@
            <Field>
                <FieldLabel For="upload-category-select">Category</FieldLabel>
                <FieldContent>
                    <NativeSelect TValue="string"
                                  Value="@UploadCategory"
                                  ValueChanged="@OnUploadCategoryChanged"
                                  Disabled="@IsUploading"
                                  id="upload-category-select"
                                  aria-label="Upload category"
                                  data-testid="upload-category-select">
                        @foreach (var category in Categories)
                        {
                            <option value="@category.Key">@category.Value</option>
                        }
                    </NativeSelect>
                    <FieldDescription data-testid="upload-category-constraints">@GetCategoryConstraintsText(UploadCategory)</FieldDescription>
                </FieldContent>
            </Field>

            @* [REQ-FN-025] MaxFileSize is NOT optional here. Left unset the dropzone keeps its own
               10 MB component default and prints "Max size: 10 MB" directly beneath a caption that
               says "Max 2 MB" — two limits for one upload, with the larger one accepting files the
               server then rejects. Every value below comes from the rule the service enforces. *@
            <div data-testid="upload-dropzone">
                <FileUpload Files="@PendingFiles"
                            FilesChanged="@OnFilesChanged"
                            Accept="@GetAcceptedFileTypes(UploadCategory)"
                            MaxFileSize="@GetMaxUploadSize(UploadCategory)"
                            OnValidationError="@OnDropzoneValidationError"
                            Multiple="false"
                            Disabled="@IsUploading" />
            </div>

            @if (SelectedFile is not null)
            {
                <p class="rounded-md bg-muted p-3 text-sm" data-testid="upload-selected-file">
                    <strong>Selected:</strong> @SelectedFile.Name (@FormatFileSize(SelectedFile.Size))
                </p>
            }

            @* [REQ-FN-026] Alt text is captured at upload time so BlogImage.AltText carries a real
               description rather than a NULL, which REQ-NFR-007 (WCAG 1.1.1) depends on. *@
            <Field>
                <FieldLabel For="upload-alt-text">Alt text</FieldLabel>
                <FieldContent>
                    <Input Id="upload-alt-text"
                           @bind-Value="UploadAltText"
                           Placeholder="Describe the image for screen readers"
                           maxlength="255"
                           Disabled="@IsUploading"
                           data-testid="upload-alt-text-input" />
                    <FieldDescription>
                        Leave blank to derive one from the file name. A real description is always better.
                    </FieldDescription>
                </FieldContent>
            </Field>

            @if (!string.IsNullOrEmpty(UploadError))
            {
                <Alert Variant="AlertVariant.Danger" data-testid="upload-error">
                    <LucideIcon Name="circle-alert" Size="16" />
                    <AlertTitle>Upload failed</AlertTitle>
                    <AlertDescription>@UploadError</AlertDescription>
                </Alert>
            }

            @if (IsUploading)
            {
                <div class="flex items-center gap-3" data-testid="upload-progress">
                    <Spinner Size="SpinnerSize.Small" />
                    <span class="text-sm text-muted-foreground">Uploading...</span>
                </div>
            }
        </div>

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline"
                    OnClick="@CloseUploadDialog"
                    Disabled="@IsUploading"
                    data-testid="upload-cancel">
                Cancel
            </Button>
            <Button OnClick="@UploadFile"
                    Disabled="@(SelectedFile is null || IsUploading)"
                    data-testid="upload-confirm">
                <LucideIcon Name="upload" Size="16" />
                @(IsUploading ? "Uploading..." : "Upload")
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@* Delete confirmation - closed on load, opened by a tile's Delete action. *@
<AlertDialog Open="@ShowDeleteDialog" OpenChanged="@OnDeleteOpenChanged">
    <AlertDialogContent data-testid="image-delete-dialog">
        <AlertDialogHeader>
            <AlertDialogTitle>Confirm delete</AlertDialogTitle>
            <AlertDialogDescription>
                Are you sure you want to delete <strong>@ImageToDelete?.ImageName</strong>?
                This action cannot be undone.
            </AlertDialogDescription>
        </AlertDialogHeader>
        <AlertDialogFooter>
            <Button Variant="ButtonVariant.Outline"
                    OnClick="@CancelDelete"
                    Disabled="@IsDeleting"
                    data-testid="delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive"
                    OnClick="@ConfirmDelete"
                    Disabled="@IsDeleting"
                    data-testid="delete-confirm">
                @(IsDeleting ? "Deleting..." : "Delete")
            </Button>
        </AlertDialogFooter>
    </AlertDialogContent>
</AlertDialog>

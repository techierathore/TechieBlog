@*
    AdminDashboard.razor
    Purpose: Landing surface of the admin console — headline counters, quick
    actions, items needing attention, recent activity and popular posts.

    REQ-UI-048 — rebuilt on TrBlazeUI; the previous <style> block is gone and every
    surface is token-driven, so it reads correctly in dark mode (REQ-UI-033).
    Authorization: EditorOrAbove (Authors land on /BlogsList instead — REQ-UI-001).
*@

@page "/AdminDashboard"
@page "/admin"
@attribute [Authorize(Policy = "EditorOrAbove")]
@layout BlogUI.Layouts.AdminLayout

<SiteBrandTitle Page="Dashboard" />

<div class="flex flex-col gap-6" data-testid="admin-dashboard">

    <div>
        <h1 class="m-0 text-2xl font-semibold tracking-tight">Dashboard</h1>
        <p class="mt-1 text-sm text-muted-foreground">An overview of your site's content and audience.</p>
    </div>

    @* --- Headline counters --------------------------------------------------- *@
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" data-testid="dashboard-stats">

        <Card data-testid="stat-posts">
            <CardHeader Class="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle Class="text-sm font-medium text-muted-foreground">Total Posts</CardTitle>
                <LucideIcon Name="file-text" Size="16" Class="text-muted-foreground" />
            </CardHeader>
            <CardContent>
                <div class="text-3xl font-semibold" data-testid="stat-posts-value">@TotalPosts.ToString("N0")</div>
                <p class="mt-1 text-xs text-muted-foreground">+@PostsThisMonth this month</p>
            </CardContent>
        </Card>

        <Card data-testid="stat-users">
            <CardHeader Class="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle Class="text-sm font-medium text-muted-foreground">Total Users</CardTitle>
                <LucideIcon Name="users" Size="16" Class="text-muted-foreground" />
            </CardHeader>
            <CardContent>
                <div class="text-3xl font-semibold" data-testid="stat-users-value">@TotalUsers.ToString("N0")</div>
                <p class="mt-1 text-xs text-muted-foreground">+@UsersThisMonth this month</p>
            </CardContent>
        </Card>

        <Card data-testid="stat-comments">
            <CardHeader Class="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle Class="text-sm font-medium text-muted-foreground">Comments</CardTitle>
                <LucideIcon Name="message-square" Size="16" Class="text-muted-foreground" />
            </CardHeader>
            <CardContent>
                <div class="text-3xl font-semibold" data-testid="stat-comments-value">@TotalComments.ToString("N0")</div>
                @if (PendingComments > 0)
                {
                    <p class="mt-1 text-xs font-medium text-[var(--alert-warning)]">@PendingComments pending</p>
                }
                else
                {
                    <p class="mt-1 text-xs text-muted-foreground">All reviewed</p>
                }
            </CardContent>
        </Card>

        <Card data-testid="stat-subscribers">
            <CardHeader Class="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle Class="text-sm font-medium text-muted-foreground">Subscribers</CardTitle>
                <LucideIcon Name="mail" Size="16" Class="text-muted-foreground" />
            </CardHeader>
            <CardContent>
                <div class="text-3xl font-semibold" data-testid="stat-subscribers-value">@TotalSubscribers.ToString("N0")</div>
                <p class="mt-1 text-xs text-muted-foreground">+@SubscribersThisMonth this month</p>
            </CardContent>
        </Card>
    </div>

    @* --- Quick actions + needs attention ------------------------------------- *@
    <div class="grid gap-6 lg:grid-cols-2">

        <Card data-testid="quick-actions">
            <CardHeader>
                <CardTitle>Quick Actions</CardTitle>
                <CardDescription>Jump straight to the things you do most.</CardDescription>
            </CardHeader>
            @*
                Each action is gated by the SAME policy as the page it opens, so an action is never
                offered to a role that would then be bounced to /access-denied. The gate is an
                <AuthorizeView> against the registered policy rather than a second copy of the
                role table — a duplicated policy map is what let this drift in the first place.

                /ManagePost is AuthorOrAbove and /comments is EditorOrAbove; this page already
                requires EditorOrAbove, so both are satisfied by everyone who can see it and need
                no gate. /users and /admin/newsletter are AdminOnly and do need one.
            *@
            <CardContent Class="flex flex-wrap gap-2">
                <Button Href="/ManagePost" data-testid="action-new-post">
                    <LucideIcon Name="plus" Size="16" />
                    <span class="ml-2">New Post</span>
                </Button>
                <Button Href="/comments" Variant="ButtonVariant.Outline" data-testid="action-moderate-comments">
                    <LucideIcon Name="message-square" Size="16" />
                    <span class="ml-2">Moderate Comments</span>
                </Button>
                <AuthorizeView Policy="@AppPolicies.AdminOnly">
                    <Authorized>
                        <Button Href="/admin/newsletter" Variant="ButtonVariant.Outline" data-testid="action-send-newsletter">
                            <LucideIcon Name="send" Size="16" />
                            <span class="ml-2">Send Newsletter</span>
                        </Button>
                        <Button Href="/users" Variant="ButtonVariant.Outline" data-testid="action-manage-users">
                            <LucideIcon Name="users" Size="16" />
                            <span class="ml-2">Manage Users</span>
                        </Button>
                    </Authorized>
                </AuthorizeView>
            </CardContent>
        </Card>

        <Card data-testid="needs-attention">
            <CardHeader>
                <CardTitle>Needs Attention</CardTitle>
                <CardDescription>Work waiting on you.</CardDescription>
            </CardHeader>
            <CardContent Class="flex flex-col">
                <a href="/comments"
                   class="flex items-center justify-between border-b border-border py-2.5 text-sm text-foreground no-underline hover:text-primary"
                   data-testid="attention-pending-comments">
                    <span>Pending Comments</span>
                    <Badge Variant="@(PendingComments > 0 ? BadgeVariant.Default : BadgeVariant.Secondary)">
                        @PendingComments
                    </Badge>
                </a>
                <a href="/BlogsList"
                   class="flex items-center justify-between border-b border-border py-2.5 text-sm text-foreground no-underline hover:text-primary"
                   data-testid="attention-scheduled-posts">
                    <span>Scheduled Posts</span>
                    <Badge Variant="BadgeVariant.Secondary">@ScheduledPosts</Badge>
                </a>
                <a href="/BlogsList"
                   class="flex items-center justify-between py-2.5 text-sm text-foreground no-underline hover:text-primary"
                   data-testid="attention-draft-posts">
                    <span>Draft Posts</span>
                    <Badge Variant="BadgeVariant.Secondary">@DraftPosts</Badge>
                </a>
            </CardContent>
        </Card>
    </div>

    @* --- Recent activity + popular posts ------------------------------------- *@
    <div class="grid gap-6 lg:grid-cols-2">

        <Card data-testid="recent-activity">
            <CardHeader>
                <CardTitle>Recent Activity</CardTitle>
            </CardHeader>
            <CardContent>
                @if (RecentActivities is null || RecentActivities.Count == 0)
                {
                    <Empty Title="No recent activity"
                           Description="Publish a post and it will show up here."
                           Size="EmptySize.Small"
                           data-testid="recent-activity-empty">
                        <Icon><LucideIcon Name="inbox" Size="32" /></Icon>
                    </Empty>
                }
                else
                {
                    @* [REQ-NFR-007] 2026-08-11 — back on TrBlazeUI's own ItemGroup/Item.

                       This block was a hand-rolled <ul>/<li> because 2.0.1's ItemGroup emitted
                       `<div role="list">` while Item emitted `<div data-slot="item">` with no
                       `role="listitem"` — the activity feed declared itself a list and then
                       declared it EMPTY, so a screen-reader user was told "list, 0 items" on the
                       admin landing page (axe `aria-required-children`, critical). TR-061 fixes
                       exactly that: Item now takes `role="listitem"` whenever it is inside an
                       ItemGroup, and ItemSeparator leaves the accessibility tree.

                       `recent-activity-list` and `recent-activity-item` are carried onto the
                       library components, which splat since TR-048, so the verification suite's
                       element ids are unchanged. *@
                    <ItemGroup Class="gap-0.5" data-testid="recent-activity-list">
                        @foreach (var activity in RecentActivities.Take(5))
                        {
                            <Item data-testid="recent-activity-item">
                                <ItemMedia Variant="ItemMediaVariant.Icon">
                                    <LucideIcon Name="@GetActivityIcon(activity.Type)" Size="16" />
                                </ItemMedia>
                                @* min-w-0: `ItemContent` is a flex child with the default
                                   `min-width:auto`, so its min-content width — the longest
                                   unbreakable run in the activity title — becomes a hard floor
                                   and pushes the whole card past the viewport. Measured at 390px
                                   before this class was added: the card ran to x=455 inside a
                                   390px pane. The hand-rolled markup this replaced carried
                                   `min-w-0` for the same reason. Logged upstream as TR-071. *@
                                <ItemContent Class="min-w-0">
                                    <ItemTitle>@activity.Title</ItemTitle>
                                    <ItemDescription>@activity.Detail</ItemDescription>
                                </ItemContent>
                                <ItemActions>
                                    <span class="whitespace-nowrap text-xs text-muted-foreground">
                                        @GetTimeAgo(activity.Timestamp)
                                    </span>
                                </ItemActions>
                            </Item>
                        }
                    </ItemGroup>
                }
            </CardContent>
        </Card>

        <Card data-testid="popular-posts">
            <CardHeader>
                <CardTitle>Popular Posts</CardTitle>
                <CardDescription>Ranked by views · last 30 days</CardDescription>
            </CardHeader>
            <CardContent>
                @if (PopularPosts is null || PopularPosts.Count == 0)
                {
                    <Empty Title="No posts yet"
                           Description="Your published posts will be ranked here."
                           Size="EmptySize.Small"
                           data-testid="popular-posts-empty">
                        <Icon><LucideIcon Name="file-text" Size="32" /></Icon>
                    </Empty>
                }
                else
                {
                    <div class="flex flex-col" data-testid="popular-posts-list">
                        <div class="flex items-center justify-between border-b border-border pb-2 text-xs font-medium text-muted-foreground">
                            <span>Title</span>
                            <span>Views</span>
                        </div>
                        @foreach (var post in PopularPosts.Take(5))
                        {
                            <div class="flex items-center justify-between gap-4 border-b border-border py-2.5 text-sm last:border-b-0"
                                 data-testid="popular-post-row">
                                @* [REQ-NFR-010] `w-0 flex-1`, not `min-w-0`. `truncate` sets
                                   white-space:nowrap, so this box's MIN-CONTENT size is the whole
                                   untruncated title — and a grid track sized `auto` is floored by
                                   its items' min-content contributions, which `min-w-0` does not
                                   reduce (it only lets flexbox shrink the item after the track is
                                   already that wide). A definite `width:0` plus `flex-1` makes the
                                   contribution 0 and lets the row grow into whatever space there
                                   is. Measured at 390px: the admin pane's scrollWidth went 435 ->
                                   390 and off-viewport elements 38 -> 0, with this card's own
                                   min-content dropping from 419px to inside the 358px available.
                                   Both dashboard cards share a grid column, which is why the
                                   untouched sibling looked equally guilty. *@
                                <span class="w-0 flex-1 truncate" data-testid="popular-post-title">@post.Title</span>
                                <span class="shrink-0 tabular-nums text-muted-foreground" data-testid="popular-post-views">@post.TotalViews.ToString("N0")</span>
                            </div>
                        }
                    </div>
                }
            </CardContent>
        </Card>
    </div>
</div>

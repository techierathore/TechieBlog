@*
    SubscribersList.razor
    Purpose: Displays a list of newsletter subscribers for administration.
    Provides filtering, searching, status toggle, and CSV export capabilities.

    Usage: Navigate to /admin/subscribers
    Dependencies: TrBlazeUI.Components (REQ-UI-048), SubscriberSvc
    Authorization: AdminOnly policy required
*@
@page "/admin/subscribers"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.SubscriberSvc SubscriberService
@inject IJSRuntime JSRuntime

<div class="mx-auto max-w-[1200px] space-y-6">

    @* ---- Page header --------------------------------------------------- *@
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-foreground">Subscribers</h1>
            <p class="text-sm text-muted-foreground" data-testid="subscribers-summary">
                @TotalCount total (@ActiveCount active)
            </p>
        </div>
        <Button OnClick="ExportToCsv" data-testid="subscribers-export">
            <LucideIcon Name="download" Size="16" />
            Export CSV
        </Button>
    </div>

    @* ---- Status message ------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
               data-testid="subscribers-status-message">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* ---- Filter row ---------------------------------------------------- *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        @*
            TrBlazeUI's TabsList and TabsTrigger declare no CaptureUnmatchedValues, so a
            data-testid on either throws at render and the ErrorBoundary swallowed the whole
            page behind an HTTP 200 — this page was unreachable. Tabs itself does splat, so the
            container hook lives there and each trigger's hook lives on a span this page owns.
            Library gap TR-030/TR-046; do not put test hooks back on the
            TabsList/TabsTrigger elements.
        *@
        <Tabs Value="@StatusFilter"
              ValueChanged="@((string value) => SetFilter(value))"
              data-testid="subscribers-status-tabs">
            <TabsList>
                <TabsTrigger Value="all"><span data-testid="subscribers-tab-all">All (@TotalCount)</span></TabsTrigger>
                <TabsTrigger Value="active"><span data-testid="subscribers-tab-active">Active (@ActiveCount)</span></TabsTrigger>
                <TabsTrigger Value="inactive"><span data-testid="subscribers-tab-inactive">Inactive (@InactiveCount)</span></TabsTrigger>
            </TabsList>
        </Tabs>

        <div class="flex items-center gap-2">
            <LucideIcon Name="search" Size="16" Class="text-muted-foreground" />
            <Input Type="InputType.Search"
                   @bind-Value="SearchTerm"
                   @bind-Value:after="ApplyFilter"
                   Placeholder="Search by email..."
                   Class="min-w-[200px]"
                   AriaLabel="Search subscribers"
                   data-testid="subscribers-search" />
        </div>
    </div>

    @* ---- Subscribers table ---------------------------------------------- *@
    @if (SubscriberList == null)
    {
        <div class="flex flex-col items-center gap-2 py-8" data-testid="subscribers-loading">
            <Spinner />
            <span class="text-sm text-muted-foreground">Loading...</span>
        </div>
    }
    else if (FilteredList == null || !FilteredList.Any())
    {
        <Empty Title="@EmptyTitle" Description="@EmptyDescription" data-testid="subscribers-empty">
            <Icon><LucideIcon Name="mail" Size="48" /></Icon>
            <ChildContent>
                @if (HasActiveFilters)
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="ClearFilters" data-testid="subscribers-clear-filters">
                        Clear Filters
                    </Button>
                }
            </ChildContent>
        </Empty>
    }
    else
    {
        <DataTable TData="Subscriber"
                   Data="@FilteredList"
                   InitialPageSize="20"
                   AriaLabel="Subscribers"
                   data-testid="subscribers-grid">
            <Columns>
                <DataTableColumn TData="Subscriber" TValue="string" Property="@(s => s.Email)" Header="Email" Sortable Filterable>
                    <CellTemplate Context="row">
                        <span class="font-semibold text-foreground" data-testid="subscriber-row-email">@row.Email</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="Subscriber" TValue="string" Property="@(s => s.Name)" Header="Name" Sortable Width="180px">
                    <CellTemplate Context="row">
                        <span data-testid="subscriber-row-name">@row.Name</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="Subscriber" TValue="DateTime" Property="@(s => s.SubscribedOn)" Header="Subscribed On" Sortable Width="160px">
                    <CellTemplate Context="row">
                        <span data-testid="subscriber-row-date">@row.SubscribedOn.ToString("MMM dd, yyyy")</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="Subscriber" TValue="bool" Property="@(s => s.IsActive)" Header="Status" Sortable Width="110px">
                    <CellTemplate Context="row">
                        @if (row.IsActive)
                        {
                            <Badge data-testid="subscriber-row-status">Active</Badge>
                        }
                        else
                        {
                            <Badge Variant="BadgeVariant.Outline" data-testid="subscriber-row-status">Inactive</Badge>
                        }
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="Subscriber" TValue="long" Property="@(s => s.SubscriberId)" Header="Actions" Width="120px">
                    <CellTemplate Context="row">
                        <div class="flex flex-nowrap items-center gap-1">
                            @if (row.IsActive)
                            {
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => ToggleStatus(row, false))"
                                        AriaLabel="Deactivate subscriber"
                                        data-testid="subscriber-deactivate">
                                    <LucideIcon Name="user-minus" Size="16" />
                                </Button>
                            }
                            else
                            {
                                <Button Size="ButtonSize.IconSmall"
                                        Variant="ButtonVariant.Ghost"
                                        OnClick="@(() => ToggleStatus(row, true))"
                                        AriaLabel="Activate subscriber"
                                        data-testid="subscriber-activate">
                                    <LucideIcon Name="user-plus" Size="16" />
                                </Button>
                            }
                        </div>
                    </CellTemplate>
                </DataTableColumn>
            </Columns>
        </DataTable>
    }
</div>

@code {
    private List<Subscriber> SubscriberList;
    private List<Subscriber> FilteredList;
    private string StatusMessage = string.Empty;
    private bool IsError = false;
    private string SearchTerm = string.Empty;
    private string StatusFilter = "all";

    // Computed counts
    private int TotalCount => SubscriberList?.Count ?? 0;
    private int ActiveCount => SubscriberList?.Count(s => s.IsActive) ?? 0;
    private int InactiveCount => SubscriberList?.Count(s => !s.IsActive) ?? 0;
    private bool HasActiveFilters => StatusFilter != "all" || !string.IsNullOrEmpty(SearchTerm);

    private string EmptyTitle => HasActiveFilters ? "No subscribers match your filters" : "No subscribers yet";

    private string EmptyDescription => HasActiveFilters
        ? "Try a different status tab or clear the search term."
        : "Subscribers will appear here when readers sign up.";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        LoadSubscribers();
    }

    private void LoadSubscribers()
    {
        try
        {
            SubscriberList = SubscriberService.GetAllSubscribers().ToList();
            ApplyFilter();
        }
        catch
        {
            SubscriberList = new List<Subscriber>();
            FilteredList = new List<Subscriber>();
            StatusMessage = "Failed to load subscribers.";
            IsError = true;
        }
    }

    private void SetFilter(string filter)
    {
        StatusFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (SubscriberList == null)
        {
            FilteredList = new List<Subscriber>();
            return;
        }

        // Apply status filter
        var filtered = StatusFilter switch
        {
            "active" => SubscriberList.Where(s => s.IsActive),
            "inactive" => SubscriberList.Where(s => !s.IsActive),
            _ => SubscriberList.AsEnumerable()
        };

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var searchLower = SearchTerm.ToLower();
            filtered = filtered.Where(s =>
                (s.Email?.ToLower().Contains(searchLower) ?? false) ||
                (s.Name?.ToLower().Contains(searchLower) ?? false));
        }

        FilteredList = filtered.ToList();
    }

    private void ClearFilters()
    {
        StatusFilter = "all";
        SearchTerm = string.Empty;
        ApplyFilter();
    }

    private void ToggleStatus(Subscriber subscriber, bool newStatus)
    {
        var result = SubscriberService.UpdateSubscriberStatus(subscriber.SubscriberId, newStatus);
        if (result.IsSuccess)
        {
            subscriber.IsActive = newStatus;
            StatusMessage = $"Subscriber {(newStatus ? "activated" : "deactivated")} successfully.";
            IsError = false;
            ApplyFilter(); // Refresh the filtered list
        }
        else
        {
            StatusMessage = result.ErrorMessage;
            IsError = true;
        }
    }

    private async Task ExportToCsv()
    {
        try
        {
            var subscribers = SubscriberService.GetSubscribersForExport();
            var csv = "Email,Name,SubscribedOn,Status\n";
            foreach (var s in subscribers)
            {
                // Escape commas in fields
                var name = s.Name?.Replace("\"", "\"\"") ?? "";
                csv += $"\"{s.Email}\",\"{name}\",{s.SubscribedOn:yyyy-MM-dd},{(s.IsActive ? "Active" : "Inactive")}\n";
            }

            // Download file using JS interop
            var fileName = $"subscribers-{DateTime.Now:yyyyMMdd}.csv";
            await JSRuntime.InvokeVoidAsync("downloadCsv", fileName, csv);

            StatusMessage = $"Exported {subscribers.Count()} subscribers.";
            IsError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Export failed: {ex.Message}";
            IsError = true;
        }
    }
}

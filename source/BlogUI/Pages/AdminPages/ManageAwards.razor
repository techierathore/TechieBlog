@*
    ManageAwards.razor
    Purpose: Manage user awards for resume/portfolio display.
    Provides CRUD operations for awards with badge images and ordering controls.

    Usage: Navigate to /admin/awards
    Dependencies: TrBlazeUI (REQ-UI-039 / REQ-UI-048)
    Authorization: AuthorOrAbove policy required
*@
@page "/admin/awards"
@attribute [Authorize(Policy = "AuthorOrAbove")]
@layout BlogUI.Layouts.AdminLayout

<PageTitle>Manage Awards - TechieBlog Admin</PageTitle>

<div class="mx-auto flex max-w-4xl flex-col gap-6" data-testid="manage-awards-page">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">Manage Awards</h1>
        <Button OnClick="@ShowAddAwardDialog" data-testid="add-award">
            <LucideIcon Name="plus" Size="16" />
            Add Award
        </Button>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)" data-testid="awards-status">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertTitle>@(IsError ? "Something went wrong" : "Done")</AlertTitle>
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* Admin-only: pick whose awards to manage. *@
    @if (IsAdmin && AllUsers is not null && AllUsers.Any())
    {
        <div class="flex flex-wrap items-center gap-3 rounded-lg bg-muted p-4">
            <span class="text-sm font-medium">View awards for:</span>
            <Select TValue="string"
                    Value="@SelectedUserId.ToString()"
                    ValueChanged="@OnSelectedUserChanged"
                    Class="w-72">
                <SelectTrigger data-testid="awards-user-select">
                    <SelectValue Placeholder="Select a user" />
                </SelectTrigger>
                <SelectContent>
                    @foreach (var user in AllUsers)
                    {
                        var label = $"{user.FirstName} {user.LastName} ({user.EmailId})";
                        <SelectItem TValue="string" Value="@user.UserId.ToString()" Text="@label">@label</SelectItem>
                    }
                </SelectContent>
            </Select>
        </div>
    }

    @if (IsLoading)
    {
        <div class="flex items-center justify-center gap-3 py-12" data-testid="awards-loading">
            <Spinner />
            <span class="text-muted-foreground">Loading awards...</span>
        </div>
    }
    else if (AllAwards is null || !AllAwards.Any())
    {
        <Empty Title="No awards yet"
               Description="Add your first award to show it on the public resume."
               data-testid="awards-empty">
            <Icon><LucideIcon Name="award" Size="48" /></Icon>
            <ChildContent>
                <Button OnClick="@ShowAddAwardDialog" data-testid="add-first-award">
                    <LucideIcon Name="plus" Size="16" />
                    Add Award
                </Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        <div class="flex flex-col gap-3" data-testid="awards-list">
            @foreach (var award in AllAwards.OrderBy(a => a.DisplayOrder))
            {
                var current = award;
                <Card data-testid="award-card">
                    <CardContent Class="flex items-start gap-4 pt-6">

                        <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded bg-muted text-muted-foreground">
                            @if (!string.IsNullOrEmpty(current.BadgeImagePath))
                            {
                                <img src="@current.BadgeImagePath"
                                     alt="@($"{current.AwardTitle} badge")"
                                     class="h-full w-full object-contain" />
                            }
                            else
                            {
                                <LucideIcon Name="award" Size="24" />
                            }
                        </div>

                        <div class="min-w-0 flex-1">
                            <div class="font-semibold" data-testid="award-title">
                                @if (!string.IsNullOrEmpty(current.AwardUrl))
                                {
                                    <a href="@current.AwardUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="text-primary hover:underline">@current.AwardTitle</a>
                                }
                                else
                                {
                                    @current.AwardTitle
                                }
                                <span class="ml-2 text-sm font-normal text-muted-foreground" data-testid="award-year">
                                    (@FormatYearRange(current.AwardYear))
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(current.AwardDescription))
                            {
                                <div class="mt-1 text-sm text-muted-foreground" data-testid="award-description">
                                    @current.AwardDescription
                                </div>
                            }
                        </div>

                        <div class="flex shrink-0 items-center gap-1">
                            <Button Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconSmall"
                                    AriaLabel="Edit award"
                                    OnClick="@(() => StartEditAward(current))"
                                    data-testid="edit-award">
                                <LucideIcon Name="pencil" Size="16" />
                            </Button>
                            <Button Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconSmall"
                                    Class="text-destructive"
                                    AriaLabel="Delete award"
                                    OnClick="@(() => ConfirmDeleteAward(current))"
                                    data-testid="delete-award">
                                <LucideIcon Name="trash-2" Size="16" />
                            </Button>
                            <Button Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconSmall"
                                    AriaLabel="Move award up"
                                    Disabled="@IsFirstAward(current)"
                                    OnClick="@(() => MoveAwardUp(current))"
                                    data-testid="move-award-up">
                                <LucideIcon Name="chevron-up" Size="16" />
                            </Button>
                            <Button Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.IconSmall"
                                    AriaLabel="Move award down"
                                    Disabled="@IsLastAward(current)"
                                    OnClick="@(() => MoveAwardDown(current))"
                                    data-testid="move-award-down">
                                <LucideIcon Name="chevron-down" Size="16" />
                            </Button>
                        </div>

                    </CardContent>
                </Card>
            }
        </div>
    }
</div>

@* Add/Edit dialog - closed on load, opened by "Add Award" or a row's Edit action. *@
<Dialog Open="@ShowAwardDialog" OpenChanged="@OnAwardDialogOpenChanged">
    <DialogContent Class="max-w-lg" data-testid="award-dialog">
        <DialogHeader>
            <DialogTitle>@(IsEditMode ? "Edit Award" : "Add New Award")</DialogTitle>
            <DialogDescription>Awards appear on the public resume ordered by display order.</DialogDescription>
        </DialogHeader>

        <div class="flex max-h-[65vh] flex-col gap-5 overflow-y-auto p-1">

            <Field>
                <FieldLabel For="award-title">Award Title</FieldLabel>
                <FieldContent>
                    <Input Id="award-title"
                           @bind-Value="FormAwardTitle"
                           Placeholder="e.g., Microsoft MVP"
                           Required="true"
                           data-testid="award-title-input" />
                </FieldContent>
            </Field>

            <Field>
                <FieldLabel For="award-description">Description (optional)</FieldLabel>
                <FieldContent>
                    <Textarea Id="award-description"
                              @bind-Value="FormDescription"
                              Placeholder="Brief description of the award..."
                              Class="min-h-24"
                              data-testid="award-description-input" />
                </FieldContent>
            </Field>

            <Field>
                <FieldLabel For="award-badge">Badge Image URL (optional)</FieldLabel>
                <FieldContent>
                    <Input Id="award-badge"
                           @bind-Value="FormBadgeImagePath"
                           Placeholder="/images/awards/mvp-badge.png"
                           Class="font-mono"
                           data-testid="award-badge-input" />
                    <FieldDescription>Path to the badge image. Upload images via the media library.</FieldDescription>
                </FieldContent>
            </Field>

            <Field>
                <FieldLabel For="award-url">Award URL (optional)</FieldLabel>
                <FieldContent>
                    <Input Id="award-url"
                           Type="InputType.Url"
                           @bind-Value="FormAwardUrl"
                           Placeholder="https://mvp.microsoft.com/en-US/..."
                           Class="font-mono"
                           data-testid="award-url-input" />
                    <FieldDescription>Link to the official award page or verification.</FieldDescription>
                </FieldContent>
            </Field>

            <div class="grid gap-5 sm:grid-cols-2">
                <Field>
                    <FieldLabel For="award-year-start">Year Received</FieldLabel>
                    <FieldContent>
                        <Input Id="award-year-start"
                               @bind-Value="FormYearReceivedText"
                               Placeholder="e.g., 2015"
                               data-testid="award-year-input" />
                    </FieldContent>
                </Field>

                <Field>
                    <FieldLabel For="award-year-end">Year End (optional)</FieldLabel>
                    <FieldContent>
                        <Input Id="award-year-end"
                               @bind-Value="FormYearEndText"
                               Placeholder="Leave empty if ongoing"
                               data-testid="award-year-end-input" />
                        <FieldDescription>Leave empty if currently active.</FieldDescription>
                    </FieldContent>
                </Field>
            </div>

        </div>

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CancelAwardDialog" data-testid="cancel-award">
                Cancel
            </Button>
            <Button OnClick="@SaveAward" data-testid="save-award">
                @(IsEditMode ? "Save Changes" : "Add Award")
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@* Delete confirmation - closed on load, opened by a row's Delete action. *@
<AlertDialog Open="@ShowDeleteDialog" OpenChanged="@OnDeleteOpenChanged">
    <AlertDialogContent data-testid="award-delete-dialog">
        <AlertDialogHeader>
            <AlertDialogTitle>Confirm delete</AlertDialogTitle>
            <AlertDialogDescription>
                Are you sure you want to delete the award <strong>@AwardToDelete?.AwardTitle</strong>?
                This action cannot be undone.
            </AlertDialogDescription>
        </AlertDialogHeader>
        <AlertDialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CancelDelete" data-testid="delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="@DeleteAward" data-testid="delete-confirm">
                Delete
            </Button>
        </AlertDialogFooter>
    </AlertDialogContent>
</AlertDialog>

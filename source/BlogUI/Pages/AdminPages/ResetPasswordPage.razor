@*
    ResetPasswordPage.razor
    Purpose: Sets a new password from a emailed reset token.

    REQ-UI-004 / BRD-5. REQ-UI-048 — rebuilt on TrBlazeUI.
    Also fixes dead links: "Sign in" pointed at /admin/login, which is not a route
    in this application. The sign-in route is /login.
    Layout: AuthLayout (centered card, no site nav).
*@

@layout BlogUI.Layouts.AuthLayout
@page "/reset-password"
@page "/reset-password/{Token}"
@inject BlogEngine.Services.AuthSvc AuthService
@inject NavigationManager Navigation

<SiteBrandTitle Page="Reset password" />

@if (tokenInvalid)
{
    <Card data-testid="reset-token-invalid">
        <CardHeader Class="items-center text-center">
            <div class="mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-destructive/10 text-destructive">
                <LucideIcon Name="shield-alert" Size="24" />
            </div>
            <CardTitle>Invalid reset link</CardTitle>
            <CardDescription>@tokenErrorMessage</CardDescription>
        </CardHeader>

        <CardFooter Class="flex-col gap-3">
            <Button Href="/forgot-password" Class="w-full" data-testid="reset-request-new">
                Request New Reset Link
            </Button>
            <p class="m-0 text-center text-sm text-muted-foreground">
                Remember your password?
                @* [REQ-NFR-007] WCAG 1.4.1 — underlined at rest: colour alone must not identify
                   a link that sits inside a sentence. *@
                <a href="/login" class="text-primary underline" data-testid="reset-signin">Sign in</a>
            </p>
        </CardFooter>
    </Card>
}
else
{
    <Card data-testid="reset-password-card">
        <CardHeader>
            <CardTitle>Reset password</CardTitle>
            <CardDescription>Enter your new password below.</CardDescription>
        </CardHeader>

        <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
            <CardContent Class="flex flex-col gap-4">

                @if (!string.IsNullOrEmpty(message))
                {
                    <Alert Variant="@(isSuccess ? AlertVariant.Success : AlertVariant.Danger)"
                           data-testid="reset-password-message">
                        <AlertDescription>@message</AlertDescription>
                    </Alert>
                }

                <Field>
                    <FieldLabel For="new-password">New password</FieldLabel>
                    <FieldContent>
                        <Input Id="new-password"
                               Type="InputType.Password"
                               Placeholder="Enter new password"
                               Required="true"
                               Disabled="@isSubmitting"
                               @bind-Value="model.Password"
                               data-testid="reset-password-new" />
                        <FieldDescription>
                            Minimum 8 characters, including uppercase, lowercase and a number.
                        </FieldDescription>
                    </FieldContent>
                </Field>

                <Field>
                    <FieldLabel For="confirm-password">Confirm new password</FieldLabel>
                    <FieldContent>
                        <Input Id="confirm-password"
                               Type="InputType.Password"
                               Placeholder="Confirm new password"
                               Required="true"
                               Disabled="@isSubmitting"
                               @bind-Value="model.ConfirmPassword"
                               data-testid="reset-password-confirm" />
                    </FieldContent>
                </Field>
            </CardContent>

            <CardFooter Class="flex-col gap-3">
                <Button Type="ButtonType.Submit"
                        Class="w-full"
                        Disabled="@isSubmitting"
                        data-testid="reset-submit">
                    @if (isSubmitting)
                    {
                        <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                        <span>Resetting...</span>
                    }
                    else
                    {
                        <span>Reset Password</span>
                    }
                </Button>

                <p class="m-0 text-center text-sm text-muted-foreground">
                    Remember your password?
                    @* [REQ-NFR-007] WCAG 1.4.1 — underlined at rest: colour alone must not identify a link
                       that sits inside a sentence. *@
                    <a href="/login" class="text-primary underline" data-testid="reset-signin">Sign in</a>
                </p>
            </CardFooter>
        </EditForm>
    </Card>
}

@code {
    /// <summary>
    /// Single-use reset token supplied by the emailed link.
    /// </summary>
    [Parameter]
    public string Token { get; set; }

    private readonly ResetPasswordModel model = new();
    private string message = string.Empty;
    private bool isSuccess;
    private bool isSubmitting;
    private bool tokenInvalid;
    private string tokenErrorMessage = string.Empty;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Token))
        {
            tokenInvalid = true;
            tokenErrorMessage = "No reset token provided. Please request a new password reset link.";
            return;
        }

        var validationResult = await AuthService.ValidateResetTokenAsync(Token);
        if (!validationResult.IsSuccess)
        {
            tokenInvalid = true;
            tokenErrorMessage = validationResult.ErrorMessage;
        }
    }

    /// <summary>
    /// Applies the new password and returns the user to sign-in on success.
    /// </summary>
    private async Task HandleSubmit()
    {
        if (isSubmitting)
        {
            return;
        }

        message = string.Empty;

        if (model.Password != model.ConfirmPassword)
        {
            isSuccess = false;
            message = "Passwords do not match.";
            return;
        }

        isSubmitting = true;

        try
        {
            var result = await AuthService.ResetPasswordAsync(Token, model.Password);

            isSuccess = result.IsSuccess;
            message = result.IsSuccess
                ? "Your password has been reset successfully. Redirecting to sign in..."
                : result.ErrorMessage;

            if (!result.IsSuccess)
            {
                return;
            }

            StateHasChanged();
            await Task.Delay(2000);
            Navigation.NavigateTo("/login?message=password-reset");
        }
        catch (Exception)
        {
            isSuccess = false;
            message = "An error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    /// <summary>
    /// Form model backing the two password fields.
    /// </summary>
    private sealed class ResetPasswordModel
    {
        /// <summary>The new password.</summary>
        public string Password { get; set; } = string.Empty;

        /// <summary>Confirmation copy of the new password.</summary>
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

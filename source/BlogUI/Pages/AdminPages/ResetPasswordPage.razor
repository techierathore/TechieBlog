@*
    ResetPasswordPage.razor
    Purpose: Reset password page for setting new password.
    Displays new password and confirm password form with requirements.

    Dependencies: AuthLayout, Fluent UI form components, AuthSvc
    Layout: Uses AuthLayout (centered card)
*@

@layout BlogUI.Layouts.AuthLayout
@page "/reset-password"
@page "/reset-password/{Token}"
@inject BlogEngine.Services.AuthSvc AuthService
@inject NavigationManager Navigation

@if (tokenInvalid)
{
    <div class="auth-card__header">
        <FluentIcon Value="@(new Icons.Regular.Size48.ShieldError())" Color="Color.Error" />
        <h1 class="auth-card__title" style="color: var(--error);">Invalid Reset Link</h1>
        <p class="auth-card__subtitle">
            @tokenErrorMessage
        </p>
    </div>

    <FluentAnchor Href="/forgot-password"
                  Appearance="Appearance.Accent"
                  Style="width: 100%; text-align: center; margin-top: 16px;">
        Request New Reset Link
    </FluentAnchor>

    <div class="auth-card__footer">
        Remember your password? <a href="/admin/login" class="auth-link">Sign in</a>
    </div>
}
else
{
    <div class="auth-card__header">
        <h1 class="auth-card__title">Reset Password</h1>
        <p class="auth-card__subtitle">
            Enter your new password below.
        </p>
    </div>

    <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
        <div class="form-group">
            <label class="form-label" for="password">New Password</label>
            <FluentTextField Id="password"
                             TextFieldType="TextFieldType.Password"
                             Placeholder="Enter new password"
                             Required="true"
                             Style="width: 100%;"
                             Disabled="@isSubmitting"
                             @bind-Value="model.Password" />
            <span class="form-hint">Min 8 characters, include uppercase, lowercase, and number</span>
        </div>

        <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirm New Password</label>
            <FluentTextField Id="confirmPassword"
                             TextFieldType="TextFieldType.Password"
                             Placeholder="Confirm new password"
                             Required="true"
                             Style="width: 100%;"
                             Disabled="@isSubmitting"
                             @bind-Value="model.ConfirmPassword" />
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <FluentMessageBar Intent="@(isSuccess ? MessageIntent.Success : MessageIntent.Error)"
                              Style="margin: 16px 0;">
                @message
            </FluentMessageBar>
        }

        <FluentButton Type="ButtonType.Submit"
                      Appearance="Appearance.Accent"
                      Style="width: 100%; margin-top: var(--spacing-md, 16px);"
                      Disabled="@isSubmitting">
            @if (isSubmitting)
            {
                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                <span>Resetting...</span>
            }
            else
            {
                <span>Reset Password</span>
            }
        </FluentButton>
    </EditForm>

    <div class="auth-card__footer">
        Remember your password? <a href="/admin/login" class="auth-link">Sign in</a>
    </div>
}

@code {
    [Parameter]
    public string? Token { get; set; }

    private ResetPasswordModel model = new();
    private string message = string.Empty;
    private bool isSuccess = false;
    private bool isSubmitting = false;
    private bool tokenInvalid = false;
    private string tokenErrorMessage = string.Empty;

    protected override void OnInitialized()
    {
        // Validate token on page load
        if (string.IsNullOrEmpty(Token))
        {
            tokenInvalid = true;
            tokenErrorMessage = "No reset token provided. Please request a new password reset link.";
            return;
        }

        var validationResult = AuthService.ValidateResetToken(Token);
        if (!validationResult.IsSuccess)
        {
            tokenInvalid = true;
            tokenErrorMessage = validationResult.ErrorMessage;
        }
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        message = string.Empty;

        // Validate passwords match
        if (model.Password != model.ConfirmPassword)
        {
            isSuccess = false;
            message = "Passwords do not match.";
            return;
        }

        isSubmitting = true;

        try
        {
            var result = AuthService.ResetPassword(Token!, model.Password);

            if (result.IsSuccess)
            {
                isSuccess = true;
                message = "Your password has been reset successfully! Redirecting to login...";
                StateHasChanged();
                await Task.Delay(2000);
                Navigation.NavigateTo("/admin/login?message=password-reset");
            }
            else
            {
                isSuccess = false;
                message = result.ErrorMessage;
            }
        }
        catch (Exception)
        {
            isSuccess = false;
            message = "An error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class ResetPasswordModel
    {
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

@*
    AnalyticsDashboard.razor
    Purpose: Traffic and engagement reporting for the whole blog — headline stat
             tiles, a daily views trend, the popular-post ranking and the share of
             readership each category attracted.

    Route: /admin/analytics
    REQ:   REQ-UI-044 (BRD-60, BRD-61) — mockup docs/mockups/34-analytics-dashboard.html
    Authorization: EditorOrAbove policy required.

    Every panel reads from the SAME date range, so moving the range moves the whole
    page. The range is a closed pair of date inputs plus quick presets; TrBlazeUI has
    a DateRangePicker (gap TR-042), but it cannot carry a
    data-testid (gap TR-040), so the pair is composed from two date inputs.

    Dependencies: TrBlazeUI.Components (Chart/Card/DataTable/Progress), ApexCharts
                  series types re-exported through TrBlazeUI's chart wrappers,
                  IAnalyticsService for every figure on the page.
*@
@page "/admin/analytics"
@attribute [Authorize(Policy = AppPolicies.EditorOrAbove)]
@layout BlogUI.Layouts.AdminLayout
@using ApexCharts
@using BlogModels.Interfaces

<PageTitle>Analytics · TechieBlog Admin</PageTitle>

<div class="mx-auto max-w-[1400px] space-y-6">

    @* ---- Page header ----------------------------------------------------- *@
    <div>
        <h1 class="text-2xl font-semibold tracking-tight text-foreground">Analytics</h1>
        <p class="text-sm text-muted-foreground">Traffic and engagement (BRD-60, BRD-61).</p>
    </div>

    @* ---- Date range ------------------------------------------------------ *@
    <Card data-testid="analytics-range-card">
        <CardContent Class="pt-6">
            <div class="flex flex-wrap items-end gap-4">
                <div class="space-y-2">
                    <Label For="analytics-from">From</Label>
                    <Input Id="analytics-from"
                           Type="InputType.Date"
                           @bind-Value="FromDateText"
                           AriaLabel="Range start date"
                           data-testid="analytics-from" />
                </div>
                <div class="space-y-2">
                    <Label For="analytics-to">To</Label>
                    <Input Id="analytics-to"
                           Type="InputType.Date"
                           @bind-Value="ToDateText"
                           AriaLabel="Range end date"
                           data-testid="analytics-to" />
                </div>
                <Button OnClick="ApplyRangeAsync" Disabled="@IsLoading" data-testid="analytics-apply">
                    <LucideIcon Name="filter" Size="16" />
                    <span class="ml-2">Apply</span>
                </Button>

                <div class="flex flex-wrap items-center gap-2">
                    <Button Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Small"
                            OnClick="@(() => ApplyPresetAsync(7))"
                            data-testid="analytics-preset-7">Last 7 days</Button>
                    <Button Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Small"
                            OnClick="@(() => ApplyPresetAsync(30))"
                            data-testid="analytics-preset-30">Last 30 days</Button>
                    <Button Variant="ButtonVariant.Outline"
                            Size="ButtonSize.Small"
                            OnClick="@(() => ApplyPresetAsync(90))"
                            data-testid="analytics-preset-90">Last 90 days</Button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(RangeError))
            {
                <p class="mt-3 text-sm text-destructive" data-testid="analytics-range-error">@RangeError</p>
            }
            else
            {
                <p class="mt-3 text-sm text-muted-foreground" data-testid="analytics-range-caption">
                    Showing @RangeCaption
                </p>
            }
        </CardContent>
    </Card>

    @* ---- Stat tiles ------------------------------------------------------ *@
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-testid="analytics-stat-tiles">
        @foreach (var tile in StatTiles)
        {
            <Card>
                <CardHeader Class="flex flex-row items-center justify-between space-y-0 pb-2">
                    <CardTitle Class="text-sm font-medium">@tile.Title</CardTitle>
                    <LucideIcon Name="@tile.Icon" Size="16" Class="text-muted-foreground" />
                </CardHeader>
                <CardContent>
                    <div class="text-2xl font-bold" data-testid="@tile.TestId">@tile.Value</div>
                    <p class="text-xs text-muted-foreground">@tile.Caption</p>
                </CardContent>
            </Card>
        }
    </div>

    @* ---- Views trend ----------------------------------------------------- *@
    <Card data-testid="analytics-trend-card">
        <CardHeader>
            <CardTitle>Views trend</CardTitle>
            <CardDescription>Daily views · @RangeCaption</CardDescription>
        </CardHeader>
        <CardContent>
            @if (IsLoading)
            {
                <Skeleton Class="h-36 w-full" data-testid="analytics-trend-loading" />
            }
            else if (!HasTrafficInRange)
            {
                <Empty Title="No traffic recorded for this range"
                       Description="Widen the date range, or check back once readers have visited."
                       data-testid="analytics-trend-empty">
                    <Icon><LucideIcon Name="bar-chart-3" Size="48" /></Icon>
                </Empty>
            }
            else
            {
                <div class="overflow-x-auto">
                    <BarChart TItem="ViewTrendPoint"
                              Items="@TrendPoints"
                              Height="280px"
                              ShowLegend="false"
                              EnableAnimations="false"
                              data-testid="analytics-trend-chart">
                        <ApexPointSeries TItem="ViewTrendPoint"
                                         Items="@TrendPoints"
                                         Name="Views"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => (decimal?)point.TotalViews)" />
                    </BarChart>
                </div>

                @* Text equivalent of the plot — the figures must never be colour-only. *@
                <p class="mt-3 text-sm text-muted-foreground" data-testid="analytics-trend-summary">
                    @TrendPoints.Count days plotted · @TrendTotalViews.ToString("N0") views ·
                    busiest day @BusiestDayLabel (@BusiestDayViews.ToString("N0") views)
                </p>
            }
        </CardContent>
    </Card>

    @*
        Popular posts takes the full content width: five columns do not survive a
        half-width card, and a clipped Rating column is worse than a taller page.
        Narrow viewports scroll the table inside its own overflow-x container.
    *@
    <div class="space-y-6">

        @* ---- Popular posts ----------------------------------------------- *@
        <Card data-testid="analytics-popular-card">
            <CardHeader>
                <CardTitle>Popular posts</CardTitle>
                <CardDescription>Ranked by views · @RangeCaption</CardDescription>
            </CardHeader>
            <CardContent>
                @if (IsLoading)
                {
                    <Skeleton Class="h-36 w-full" data-testid="analytics-popular-loading" />
                }
                else if (PopularPosts.Count == 0)
                {
                    <Empty Title="No posts were read in this range"
                           Description="Nothing was viewed between these dates."
                           data-testid="analytics-popular-empty">
                        <Icon><LucideIcon Name="file-text" Size="48" /></Icon>
                    </Empty>
                }
                else
                {
                    <div class="overflow-x-auto">
                    <div class="min-w-[720px]">
                    <DataTable TData="PopularPost"
                               Data="@PopularPosts"
                               InitialPageSize="10"
                               AriaLabel="Popular posts"
                               data-testid="analytics-popular-grid">
                        <Columns>
                            <DataTableColumn TData="PopularPost" TValue="string" Property="@(p => p.Title)" Header="Post" Sortable>
                                <CellTemplate Context="row">
                                    <span class="font-medium text-foreground" data-testid="popular-row-title">@row.Title</span>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="PopularPost" TValue="int" Property="@(p => p.TotalViews)" Header="Views" Sortable Width="90px">
                                <CellTemplate Context="row">
                                    <span data-testid="popular-row-views">@row.TotalViews.ToString("N0")</span>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="PopularPost" TValue="int" Property="@(p => p.UniqueViews)" Header="Unique" Sortable Width="90px">
                                <CellTemplate Context="row">
                                    <span data-testid="popular-row-unique">@row.UniqueViews.ToString("N0")</span>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="PopularPost" TValue="int" Property="@(p => p.CommentCount)" Header="Comments" Sortable Width="110px">
                                <CellTemplate Context="row">
                                    <span data-testid="popular-row-comments">@row.CommentCount.ToString("N0")</span>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="PopularPost" TValue="double" Property="@(p => p.AverageRating)" Header="Rating" Sortable Width="100px">
                                <CellTemplate Context="row">
                                    <span data-testid="popular-row-rating">@FormatRating(row.AverageRating)</span>
                                </CellTemplate>
                            </DataTableColumn>
                        </Columns>
                    </DataTable>
                    </div>
                    </div>
                }
            </CardContent>
        </Card>

        @* ---- Engagement by category -------------------------------------- *@
        <Card data-testid="analytics-category-card">
            <CardHeader>
                <CardTitle>Engagement by category</CardTitle>
                <CardDescription>Views share · @RangeCaption</CardDescription>
            </CardHeader>
            <CardContent>
                @if (IsLoading)
                {
                    <Skeleton Class="h-36 w-full" data-testid="analytics-category-loading" />
                }
                else if (CategoryEngagements.Count == 0)
                {
                    <Empty Title="No category traffic in this range"
                           Description="Views are attributed to the category of the post that was read."
                           data-testid="analytics-category-empty">
                        <Icon><LucideIcon Name="folder" Size="48" /></Icon>
                    </Empty>
                }
                else
                {
                    <div class="space-y-3" data-testid="analytics-category-list">
                        @foreach (var category in CategoryEngagements)
                        {
                            <div class="space-y-2">
                                @* Label AND value on every bar: identity is never colour-alone. *@
                                <div class="flex items-center justify-between text-sm">
                                    <span class="font-medium text-foreground" data-testid="category-row-name">@category.CategoryName</span>
                                    <span class="text-muted-foreground" data-testid="category-row-views">@category.TotalViews.ToString("N0")</span>
                                </div>
                                <Progress Value="@CategorySharePercent(category)"
                                          Class="h-2"
                                          aria-label="@($"{category.CategoryName}: {category.TotalViews} views")" />
                            </div>
                        }
                    </div>
                }
            </CardContent>
        </Card>
    </div>
</div>

@*
    Settings.razor
    Purpose: Site-wide configuration console.

    REQ-UI-048 — rebuilt on TrBlazeUI.
    REQ-UI-032 / BRD-68 — the Theme tab carries the site-theme selector offering the
    three shipped themes, with preview swatches and the active theme outlined.
    BRD-69 — values persist through ISiteSettingsService (PostgreSQL settings table)
    and apply without an app restart.

    Layout: admin shell, Tabs section switcher, card grid, sticky save bar.
*@

@page "/settings"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout
@using BlogModels.Interfaces
@using BlogModels.Models
@inject ThemeService ThemeService
@inject ISiteSettingsService SiteSettingsService
@inject ToastService ToastService
@inject ICacheService CacheService

<PageTitle>Settings - TechieBlog</PageTitle>

<div class="flex flex-col gap-6 pb-24" data-testid="settings-page">

    <div>
        <h1 class="m-0 text-2xl font-semibold tracking-tight">Settings</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            Configure how TechieBlog looks and behaves. Changes apply without a restart.
        </p>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center py-16" data-testid="settings-loading">
            <Spinner Size="SpinnerSize.Large" />
        </div>
    }
    else
    {
        @*
            Each trigger's test hook sits on <TabsTrigger> itself. Up to TrBlazeUI 2.0.1 that
            threw InvalidOperationException and rendered the whole page as an empty error
            boundary, so the ids had to ride on a <span> inside the trigger (TR-032/TR-046);
            2.0.2 splats on all 344 components and the spans are gone.
        *@
        <Tabs DefaultValue="general">
            @*
                h-auto + flex-wrap: six triggers do not fit on one line at a 390px viewport, and
                the library's default fixed-height single-line TabsList pushed Email and Storage
                off-canvas. Wrapping keeps every tab reachable on a phone.
            *@
            <TabsList Class="h-auto flex-wrap">
                <TabsTrigger Value="general" data-testid="tab-general">General</TabsTrigger>
                <TabsTrigger Value="blog" data-testid="tab-blog">Blog</TabsTrigger>
                <TabsTrigger Value="theme" data-testid="tab-theme">Theme</TabsTrigger>
                <TabsTrigger Value="seo" data-testid="tab-seo">SEO &amp; Social</TabsTrigger>
                <TabsTrigger Value="email" data-testid="tab-email">Email</TabsTrigger>
                <TabsTrigger Value="storage" data-testid="tab-storage">Storage</TabsTrigger>
            </TabsList>

            @* ---------------- General ---------------- *@
            <TabsContent Value="general">
                <Card>
                    <CardHeader>
                        <CardTitle>General</CardTitle>
                        <CardDescription>Identity and contact details for the site.</CardDescription>
                    </CardHeader>
                    <CardContent Class="flex flex-col gap-4">
                        <Field>
                            <FieldLabel For="site-title">Site title</FieldLabel>
                            <FieldContent>
                                <Input Id="site-title" @bind-Value="settings.SiteTitle"
                                       Placeholder="TechieBlog" data-testid="site-title" />
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel For="site-tagline">Site tagline</FieldLabel>
                            <FieldContent>
                                <Input Id="site-tagline" @bind-Value="settings.SiteTagline"
                                       Placeholder="A blog about technology" data-testid="site-tagline" />
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel For="admin-email">Admin email</FieldLabel>
                            <FieldContent>
                                <Input Id="admin-email" Type="InputType.Email" @bind-Value="settings.AdminEmail"
                                       Placeholder="admin@example.com" data-testid="admin-email" />
                                <FieldDescription>Where system notifications are delivered.</FieldDescription>
                            </FieldContent>
                        </Field>
                    </CardContent>
                </Card>

                @*
                    UAT-001. The public pages read through a ten-minute in-memory cache that lives in
                    THIS process. Every write made through the web application evicts it automatically,
                    so this button is not needed for ordinary editing. It exists for the case that has
                    no write path to hook: the database being changed from OUTSIDE this process — the
                    BlogApp desktop client connected straight to the same database, a psql session, a
                    restore. Those leave the site serving posts that no longer exist, or hiding posts
                    that do, until the entries age out on their own.
                *@
                <Card Class="mt-6">
                    <CardHeader>
                        <CardTitle>Maintenance</CardTitle>
                        <CardDescription>Tools for when the site and the database disagree.</CardDescription>
                    </CardHeader>
                    <CardContent Class="flex flex-col gap-4">
                        <Field>
                            <FieldLabel>Cached content</FieldLabel>
                            <FieldContent>
                                <div class="flex flex-wrap items-center gap-3">
                                    <Button Variant="ButtonVariant.Outline"
                                            OnClick="@ClearContentCache"
                                            Disabled="@isClearingCache"
                                            data-testid="clear-cache">
                                        <LucideIcon Name="refresh-cw" Size="16" />
                                        Clear cached content
                                    </Button>
                                </div>
                                <FieldDescription>
                                    Post listings, the featured article, categories, tags and series are
                                    held for up to 10 minutes to keep the public pages fast. Editing
                                    through this site refreshes them for you. Use this only after the
                                    database was changed from somewhere else — the desktop app, a
                                    restore, or a direct SQL session — to make the public pages match
                                    it immediately instead of waiting for the cache to expire.
                                </FieldDescription>
                            </FieldContent>
                        </Field>
                    </CardContent>
                </Card>
            </TabsContent>

            @* ---------------- Blog ---------------- *@
            <TabsContent Value="blog">
                <div class="grid gap-6 lg:grid-cols-2">
                    <Card>
                        <CardHeader>
                            <CardTitle>Reading</CardTitle>
                            <CardDescription>How posts are paged for readers.</CardDescription>
                        </CardHeader>
                        <CardContent Class="flex flex-col gap-4">
                            <Field>
                                <FieldLabel For="posts-per-page">Posts per page</FieldLabel>
                                <FieldContent>
                                    <Input Id="posts-per-page" Type="InputType.Number"
                                           Value="@settings.PostsPerPage.ToString()"
                                           ValueChanged="@(v => settings.PostsPerPage = ParseInt(v, 10))"
                                           data-testid="posts-per-page" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="pagination-words">Article pagination word count</FieldLabel>
                                <FieldContent>
                                    <Input Id="pagination-words" Type="InputType.Number"
                                           Value="@settings.PaginationWordCount.ToString()"
                                           ValueChanged="@(v => settings.PaginationWordCount = ParseInt(v, 500))"
                                           data-testid="pagination-word-count" />
                                    <FieldDescription>
                                        Split articles longer than this into pages. Set to 0 to disable.
                                    </FieldDescription>
                                </FieldContent>
                            </Field>
                        </CardContent>
                    </Card>

                    <Card>
                        <CardHeader>
                            <CardTitle>Comments</CardTitle>
                            <CardDescription>Reader participation rules.</CardDescription>
                        </CardHeader>
                        <CardContent Class="flex flex-col gap-4">
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <p class="m-0 text-sm font-medium">Allow comments</p>
                                    <p class="m-0 text-xs text-muted-foreground">Readers may comment on posts.</p>
                                </div>
                                <Switch @bind-Checked="settings.AreCommentsAllowed" data-testid="allow-comments" />
                            </div>
                            <Separator />
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <p class="m-0 text-sm font-medium">Moderate comments</p>
                                    <p class="m-0 text-xs text-muted-foreground">Hold comments for approval first.</p>
                                </div>
                                <Switch @bind-Checked="settings.AreCommentsModerated" data-testid="moderate-comments" />
                            </div>
                            <Separator />
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <p class="m-0 text-sm font-medium">Allow registration</p>
                                    <p class="m-0 text-xs text-muted-foreground">Visitors may create their own account.</p>
                                </div>
                                <Switch @bind-Checked="settings.IsRegistrationAllowed" data-testid="allow-registration" />
                            </div>
                        </CardContent>
                    </Card>
                </div>
            </TabsContent>

            @* ---------------- Theme (REQ-UI-032) ---------------- *@
            <TabsContent Value="theme">
                <Card data-testid="theme-settings">
                    <CardHeader>
                        <CardTitle>Site theme</CardTitle>
                        <CardDescription>
                            Choose the palette applied to the public site and the admin console.
                        </CardDescription>
                    </CardHeader>
                    <CardContent Class="flex flex-col gap-6">

                        <Field>
                            <FieldLabel For="site-theme">Theme</FieldLabel>
                            <FieldContent>
                                <Select TValue="string"
                                        Value="@settings.SiteTheme"
                                        ValueChanged="@OnThemeSelected"
                                        Class="w-full sm:w-[320px]">
                                    <SelectTrigger data-testid="site-theme-select">
                                        <SelectValue Placeholder="Select a theme" />
                                    </SelectTrigger>
                                    <SelectContent>
                                        @foreach (var theme in availableThemes)
                                        {
                                            <SelectItem TValue="string" Value="@theme.Id" Text="@theme.Name">
                                                @theme.Name
                                            </SelectItem>
                                        }
                                    </SelectContent>
                                </Select>
                            </FieldContent>
                        </Field>

                        @* Preview swatches - the active theme is outlined. *@
                        <div class="grid gap-4 sm:grid-cols-3" data-testid="theme-swatches">
                            @foreach (var theme in availableThemes)
                            {
                                var isActive = theme.Id == settings.SiteTheme;
                                <button type="button"
                                        @onclick="@(() => OnThemeSelected(theme.Id))"
                                        class="@SwatchClass(isActive)"
                                        data-testid="@($"theme-swatch-{theme.Id}")"
                                        aria-pressed="@isActive">
                                    <span class="flex items-center justify-between gap-2">
                                        <span class="text-sm font-medium">@theme.Name</span>
                                        @if (isActive)
                                        {
                                            <LucideIcon Name="check" Size="16" Class="text-primary" />
                                        }
                                    </span>
                                    <span class="mt-3 flex gap-1.5" data-site-theme="@theme.Id">
                                        <span class="h-6 w-6 rounded-full border border-border bg-primary"></span>
                                        <span class="h-6 w-6 rounded-full border border-border bg-secondary"></span>
                                        <span class="h-6 w-6 rounded-full border border-border bg-muted"></span>
                                        <span class="h-6 w-6 rounded-full border border-border bg-destructive"></span>
                                    </span>
                                    <span class="mt-3 block text-left text-xs text-muted-foreground">
                                        @theme.Description
                                    </span>
                                    @if (theme.IsDefault)
                                    {
                                        <Badge Variant="BadgeVariant.Secondary" Class="mt-3">Default</Badge>
                                    }
                                </button>
                            }
                        </div>

                        <Separator />

                        <div class="flex items-center justify-between gap-4">
                            <div>
                                <p class="m-0 text-sm font-medium">Default to dark mode</p>
                                <p class="m-0 text-xs text-muted-foreground">
                                    New visitors start in dark mode unless they choose otherwise.
                                </p>
                            </div>
                            <Switch @bind-Checked="settings.IsDarkModeDefault" data-testid="dark-mode-default" />
                        </div>
                    </CardContent>
                </Card>
            </TabsContent>

            @* ---------------- SEO & Social ---------------- *@
            <TabsContent Value="seo">
                <div class="grid gap-6 lg:grid-cols-2">
                    <Card>
                        <CardHeader>
                            <CardTitle>SEO</CardTitle>
                            <CardDescription>Defaults used when a page supplies no metadata.</CardDescription>
                        </CardHeader>
                        <CardContent Class="flex flex-col gap-4">
                            <Field>
                                <FieldLabel For="meta-description">Meta description</FieldLabel>
                                <FieldContent>
                                    <Textarea Id="meta-description" @bind-Value="settings.MetaDescription"
                                              Placeholder="Default meta description for the site..."
                                              data-testid="meta-description" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="meta-keywords">Meta keywords</FieldLabel>
                                <FieldContent>
                                    <Input Id="meta-keywords" @bind-Value="settings.MetaKeywords"
                                           Placeholder="technology, programming, web development"
                                           data-testid="meta-keywords" />
                                </FieldContent>
                            </Field>
                        </CardContent>
                    </Card>

                    <Card>
                        <CardHeader>
                            <CardTitle>Social links</CardTitle>
                            <CardDescription>Shown in the site footer and resume.</CardDescription>
                        </CardHeader>
                        <CardContent Class="flex flex-col gap-4">
                            <Field>
                                <FieldLabel For="twitter-url">X / Twitter URL</FieldLabel>
                                <FieldContent>
                                    <Input Id="twitter-url" Type="InputType.Url" @bind-Value="settings.TwitterUrl"
                                           Placeholder="https://x.com/yourhandle" data-testid="twitter-url" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="linkedin-url">LinkedIn URL</FieldLabel>
                                <FieldContent>
                                    <Input Id="linkedin-url" Type="InputType.Url" @bind-Value="settings.LinkedInUrl"
                                           Placeholder="https://linkedin.com/in/yourprofile" data-testid="linkedin-url" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="github-url">GitHub URL</FieldLabel>
                                <FieldContent>
                                    <Input Id="github-url" Type="InputType.Url" @bind-Value="settings.GitHubUrl"
                                           Placeholder="https://github.com/yourusername" data-testid="github-url" />
                                </FieldContent>
                            </Field>
                        </CardContent>
                    </Card>
                </div>
            </TabsContent>

            @* ---------------- Email ---------------- *@
            <TabsContent Value="email">
                <Card>
                    <CardHeader>
                        <CardTitle>Outgoing email (SMTP)</CardTitle>
                        <CardDescription>
                            Used for password resets, subscriber confirmations and newsletters.
                        </CardDescription>
                    </CardHeader>
                    <CardContent Class="grid gap-4 sm:grid-cols-2">
                        <Field>
                            <FieldLabel For="smtp-host">Host</FieldLabel>
                            <FieldContent>
                                <Input Id="smtp-host" @bind-Value="settings.Smtp.Host"
                                       Placeholder="smtp.example.com" data-testid="smtp-host" />
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel For="smtp-port">Port</FieldLabel>
                            <FieldContent>
                                <Input Id="smtp-port" Type="InputType.Number"
                                       Value="@settings.Smtp.Port.ToString()"
                                       ValueChanged="@(v => settings.Smtp.Port = ParseInt(v, 587))"
                                       data-testid="smtp-port" />
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel For="smtp-user">Username</FieldLabel>
                            <FieldContent>
                                <Input Id="smtp-user" @bind-Value="settings.Smtp.UserName" data-testid="smtp-username" />
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel For="smtp-password">Password</FieldLabel>
                            <FieldContent>
                                <Input Id="smtp-password" Type="InputType.Password"
                                       @bind-Value="settings.Smtp.Password" data-testid="smtp-password" />
                                <FieldDescription>Stored encrypted.</FieldDescription>
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel For="smtp-from-address">From address</FieldLabel>
                            <FieldContent>
                                <Input Id="smtp-from-address" Type="InputType.Email"
                                       @bind-Value="settings.Smtp.FromAddress" data-testid="smtp-from-address" />
                            </FieldContent>
                        </Field>
                        <Field>
                            <FieldLabel For="smtp-from-name">From name</FieldLabel>
                            <FieldContent>
                                <Input Id="smtp-from-name" @bind-Value="settings.Smtp.FromName"
                                       data-testid="smtp-from-name" />
                            </FieldContent>
                        </Field>
                        <div class="flex items-center gap-2 sm:col-span-2">
                            <Checkbox Id="smtp-ssl" @bind-Checked="settings.Smtp.IsSslEnabled" data-testid="smtp-ssl" />
                            <Label For="smtp-ssl" Class="text-sm font-normal">Use SSL/TLS</Label>
                        </div>
                    </CardContent>
                </Card>
            </TabsContent>

            @* ---------------- Storage ---------------- *@
            <TabsContent Value="storage">
                <Card data-testid="storage-settings">
                    <CardHeader>
                        <CardTitle>Uploaded media storage</CardTitle>
                        <CardDescription>
                            Where post images and other uploads are written. Only the selected
                            provider's fields are used.
                        </CardDescription>
                    </CardHeader>
                    <CardContent Class="flex flex-col gap-4">
                        <Field>
                            <FieldLabel For="storage-provider">Provider</FieldLabel>
                            <FieldContent>
                                <Select TValue="string"
                                        Value="@settings.Storage.ProviderName"
                                        ValueChanged="@(v => settings.Storage.ProviderName = v)"
                                        Class="w-full sm:w-[320px]">
                                    <SelectTrigger data-testid="storage-provider">
                                        <SelectValue Placeholder="Select a provider" />
                                    </SelectTrigger>
                                    <SelectContent>
                                        @foreach (var provider in storageProviders)
                                        {
                                            <SelectItem TValue="string" Value="@provider" Text="@provider">
                                                @provider
                                            </SelectItem>
                                        }
                                    </SelectContent>
                                </Select>
                            </FieldContent>
                        </Field>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <Field>
                                <FieldLabel For="storage-local-root">Local root path</FieldLabel>
                                <FieldContent>
                                    <Input Id="storage-local-root" @bind-Value="settings.Storage.LocalRootPath"
                                           Placeholder="wwwroot/uploads" data-testid="storage-local-root" />
                                    <FieldDescription>Blank uses the host's web root.</FieldDescription>
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="storage-network-root">Network root path</FieldLabel>
                                <FieldContent>
                                    <Input Id="storage-network-root" @bind-Value="settings.Storage.NetworkRootPath"
                                           Placeholder="\\\\server\\share\\techieblog" data-testid="storage-network-root" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="storage-cloud-url">Cloud service URL</FieldLabel>
                                <FieldContent>
                                    <Input Id="storage-cloud-url" Type="InputType.Url"
                                           @bind-Value="settings.Storage.CloudServiceUrl"
                                           Placeholder="https://s3.example.com" data-testid="storage-cloud-url" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="storage-cloud-container">Cloud container</FieldLabel>
                                <FieldContent>
                                    <Input Id="storage-cloud-container"
                                           @bind-Value="settings.Storage.CloudContainerName"
                                           Placeholder="techieblog-media" data-testid="storage-cloud-container" />
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="storage-cloud-key">Cloud access key</FieldLabel>
                                <FieldContent>
                                    <Input Id="storage-cloud-key" Type="InputType.Password"
                                           @bind-Value="settings.Storage.CloudAccessKey"
                                           data-testid="storage-cloud-key" />
                                    <FieldDescription>Stored encrypted.</FieldDescription>
                                </FieldContent>
                            </Field>
                            <Field>
                                <FieldLabel For="storage-public-base">Public base URL</FieldLabel>
                                <FieldContent>
                                    <Input Id="storage-public-base" @bind-Value="settings.Storage.PublicBaseUrl"
                                           Placeholder="/uploads" data-testid="storage-public-base" />
                                    <FieldDescription>URL prefix that maps to the storage root.</FieldDescription>
                                </FieldContent>
                            </Field>
                        </div>
                    </CardContent>
                </Card>
            </TabsContent>
        </Tabs>
    }
</div>

@* Sticky save bar *@
@if (!isLoading)
{
    <div class="sticky bottom-0 z-10 -mx-4 mt-6 flex items-center justify-end gap-3 border-t border-border bg-background/95 px-4 py-3 backdrop-blur md:-mx-6 md:px-6">
        <Button OnClick="SaveSettings" Disabled="@isSaving" data-testid="save-settings">
            @if (isSaving)
            {
                <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save Settings</span>
            }
        </Button>
    </div>
}

@code {
    private SiteSettings settings = new();
    private List<ThemeInfo> availableThemes = new();
    private bool isLoading = true;
    private bool isSaving;

    /// <summary>True while the maintenance cache flush is running (UAT-001).</summary>
    private bool isClearingCache;

    private static readonly string[] storageProviders =
    {
        StorageProviderNames.Local,
        StorageProviderNames.Network,
        StorageProviderNames.Cloud
    };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        availableThemes = ThemeService.GetAvailableThemes();

        try
        {
            // Editable COPY, never the shared cached aggregate (REQ-FN-061). Every control on this
            // page binds straight to `settings`, so binding it to the singleton's instance made each
            // keystroke a live, unsaved, site-wide configuration change visible to anonymous
            // visitors. The copy is discarded unless Save writes it.
            settings = await SiteSettingsService.GetEditableSettingsAsync();
        }
        catch (Exception)
        {
            settings = new SiteSettings();
            ToastService.Error("Could not load saved settings. Showing defaults.", "Settings");
        }

        settings.SiteTheme = ThemeService.NormaliseTheme(settings.SiteTheme);
        isLoading = false;
    }

    /// <summary>
    /// Applies a newly chosen site theme immediately and records it on the model.
    /// </summary>
    /// <remarks>
    /// The theme is applied live through <see cref="ThemeService"/> so the admin sees the
    /// result at once; it is not durable until Save Settings writes it through
    /// <see cref="ISiteSettingsService"/>.
    /// <para>Both halves of that preview are scoped to this administrator (REQ-FN-061).
    /// <c>settings</c> is the page's own copy from <c>GetEditableSettingsAsync</c>, and
    /// <see cref="ThemeService"/> is registered <c>Scoped</c>, so it is per-circuit. Neither reaches
    /// another user. Before the fix <c>settings</c> WAS the singleton's cached aggregate, so this one
    /// assignment re-themed the live site for everyone — including anonymous visitors — with nothing
    /// written to the database and no way to undo it short of a restart.</para>
    /// </remarks>
    /// <param name="themeId">Identifier of the selected theme.</param>
    private void OnThemeSelected(string themeId)
    {
        if (string.IsNullOrWhiteSpace(themeId))
        {
            return;
        }

        settings.SiteTheme = themeId;

        // Preview only — writing to LocalStorage here would turn the administrator into a
        // visitor with a personal override and hide the site default from them (REQ-UI-032).
        ThemeService.PreviewTheme(themeId);
    }

    /// <summary>
    /// Persists every setting through the site-settings service.
    /// </summary>
    private async Task SaveSettings()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;

        try
        {
            var result = await SiteSettingsService.SaveSettingsAsync(settings);

            if (result.IsSuccess)
            {
                // Rebind to what the store actually returned, so the screen shows the persisted
                // truth rather than the values that were merely submitted. The service returns a
                // detached copy (REQ-FN-061), so continuing to edit after a save stays page-local.
                settings = result.Data ?? settings;
                settings.SiteTheme = ThemeService.NormaliseTheme(settings.SiteTheme);
                ToastService.Success("Settings saved.", "Settings");
            }
            else
            {
                ToastService.Error(result.ErrorMessage, "Could not save settings");
            }
        }
        catch (Exception)
        {
            ToastService.Error("An unexpected error occurred while saving.", "Could not save settings");
        }
        finally
        {
            isSaving = false;
        }
    }

    /// <summary>
    /// Drops every cached content, taxonomy and settings entry so the public pages re-read the
    /// database on the next request (UAT-001).
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> Evicts all three tags rather than trying to be surgical. The
    /// administrator reaching for this button has just changed the database from outside the
    /// application and cannot be expected to know which of "content", "taxonomy" or "settings" their
    /// change landed under — and getting that guess wrong would leave exactly the stale page they
    /// came here to fix. The cost of over-evicting is a handful of queries on the next request.</para>
    /// <para><b>This clears one server.</b> The cache is per-process, so behind a multi-instance
    /// deployment this refreshes the instance that served the click. TechieBlog ships single-instance;
    /// a scaled deployment would need a shared or broadcast invalidation instead.</para>
    /// <para><b>Side Effects:</b> Expires every entry under the content, taxonomy and settings tags.
    /// Nothing is written to the database.</para>
    /// </remarks>
    private async Task ClearContentCache()
    {
        if (isClearingCache)
        {
            return;
        }

        isClearingCache = true;

        try
        {
            CacheService.EvictTag(CacheTags.Content);
            CacheService.EvictTag(CacheTags.Taxonomy);
            CacheService.EvictTag(CacheTags.Settings);

            // The settings tag was just dropped, so the aggregate this screen is bound to is now
            // uncached too. Re-read the editable copy (REQ-FN-061 — never the shared instance), or the
            // page would keep showing values it can no longer prove.
            settings = await SiteSettingsService.GetEditableSettingsAsync();
            settings.SiteTheme = ThemeService.NormaliseTheme(settings.SiteTheme);

            ToastService.Success(
                "Cached content cleared. The public pages now read straight from the database.",
                "Maintenance");
        }
        catch (Exception)
        {
            ToastService.Error("Could not clear the cache.", "Maintenance");
        }
        finally
        {
            isClearingCache = false;
        }
    }

    /// <summary>
    /// Builds the CSS classes for a theme preview swatch.
    /// </summary>
    /// <param name="isActive">True when the swatch represents the selected theme.</param>
    /// <returns>The utility class string for the swatch button.</returns>
    private static string SwatchClass(bool isActive)
    {
        var baseClasses = "flex flex-col rounded-lg border bg-card p-4 text-left transition-colors hover:bg-accent/50";
        return isActive
            ? $"{baseClasses} border-primary ring-2 ring-primary/30"
            : $"{baseClasses} border-border";
    }

    /// <summary>
    /// Parses a numeric input value, falling back when the text is not a number.
    /// </summary>
    /// <param name="value">Raw text from the input.</param>
    /// <param name="fallback">Value to use when parsing fails.</param>
    /// <returns>The parsed integer, or <paramref name="fallback"/>.</returns>
    private static int ParseInt(string value, int fallback)
    {
        return int.TryParse(value, out var parsed) ? parsed : fallback;
    }
}

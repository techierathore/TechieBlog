@*
    ManageCategory.razor
    Purpose: Create and edit categories for blog posts.
    Provides form for category management with validation.

    Usage: Navigate to /admin/category or /admin/category/{PageId}
    Dependencies: TrBlazeUI (REQ-UI-048)
    Authorization: AdminOnly policy required
*@
@page "/admin/category"
@page "/admin/category/{PageId:long}"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout

@* [REQ-NFR-007] WCAG 2.4.2 Page Titled (Level A) — without this the page inherits the
   shell title and every admin screen announces itself as just the site name. *@
<PageTitle>Category - TechieBlog</PageTitle>

<ContentPanel PanelTitle="@PageHeader">
    <RightSection></RightSection>
    <PanelContent>
        <div class="max-w-lg">
            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
                       Class="mb-4"
                       data-testid="category-status-message">
                    <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
                    <AlertDescription>@StatusMessage</AlertDescription>
                </Alert>
            }

            @if (PageObj == null)
            {
                <div class="flex items-center gap-3 py-6" data-testid="category-loading">
                    <Spinner />
                    <span class="text-muted-foreground">Loading...</span>
                </div>
            }
            else
            {
                <EditForm Model="@PageObj" OnValidSubmit="@SaveData">
                    <DataAnnotationsValidator />
                    <div class="flex flex-col gap-4">

                        <Field>
                            <FieldLabel For="category-name">Category Name</FieldLabel>
                            <FieldContent>
                                <Input Id="category-name"
                                       @bind-Value="PageObj.CategoryName"
                                       Placeholder="Enter category name"
                                       Required="true"
                                       data-testid="category-name-input" />
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="category-slug">Slug (URL-friendly name)</FieldLabel>
                            <FieldContent>
                                <Input Id="category-slug"
                                       @bind-Value="PageObj.Slug"
                                       Placeholder="auto-generated from name"
                                       data-testid="category-slug-input" />
                                <FieldDescription>Leave blank to auto-generate from category name</FieldDescription>
                            </FieldContent>
                        </Field>

                        <Field>
                            <FieldLabel For="category-description">Description</FieldLabel>
                            <FieldContent>
                                <Textarea Id="category-description"
                                          @bind-Value="PageObj.Description"
                                          Placeholder="Optional description for this category"
                                          data-testid="category-description-input" />
                            </FieldContent>
                        </Field>

                        <div class="flex flex-wrap items-center gap-2 pt-2">
                            <Button Type="ButtonType.Submit" data-testid="save-category">
                                <LucideIcon Name="save" Size="16" />
                                Save
                            </Button>
                            <Button Href="/admin/categories"
                                    Variant="ButtonVariant.Outline"
                                    data-testid="cancel-category">
                                Cancel
                            </Button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>
    </PanelContent>
</ContentPanel>

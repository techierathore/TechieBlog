@*
    TagsList.razor
    Purpose: Displays a list of tags for blog posts.
    Provides editing and delete capabilities for tag management.

    Usage: Navigate to /TagsList or /admin/tags
    Dependencies: TrBlazeUI.Components (REQ-UI-048)
    Authorization: AdminOnly policy required
*@
@page "/TagsList"
@page "/admin/tags"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout
@inject BlogEngine.Services.TagSvc TagService
@inject NavigationManager Navigation

<div class="mx-auto max-w-[1200px] space-y-6">

    @* ---- Page header --------------------------------------------------- *@
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-foreground">Tags Management</h1>
            <p class="text-sm text-muted-foreground">Label your posts so readers can find related writing.</p>
        </div>
        <Button Href="/ManageTag" data-testid="new-tag">
            <LucideIcon Name="plus" Size="16" />
            Add New Tag
        </Button>
    </div>

    @* ---- Status message ------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
               data-testid="tags-status-message">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* ---- Filter row ---------------------------------------------------- *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2">
            <LucideIcon Name="search" Size="16" Class="text-muted-foreground" />
            <Input Type="InputType.Search"
                   @bind-Value="SearchTerm"
                   @bind-Value:after="ApplyFilter"
                   Placeholder="Search tags..."
                   Class="min-w-[200px]"
                   AriaLabel="Search tags"
                   data-testid="tags-search" />
        </div>
        <span class="text-sm text-muted-foreground" data-testid="tags-count">
            @(FilteredList?.Count ?? 0) tags
        </span>
    </div>

    @* ---- Tags table ------------------------------------------------------ *@
    @if (TagList == null)
    {
        <div class="flex flex-col items-center gap-2 py-8" data-testid="tags-loading">
            <Spinner />
            <span class="text-sm text-muted-foreground">Loading...</span>
        </div>
    }
    else if (FilteredList == null || !FilteredList.Any())
    {
        <Empty Title="@EmptyTitle" Description="@EmptyDescription" data-testid="tags-empty">
            <Icon><LucideIcon Name="tag" Size="48" /></Icon>
            <ChildContent>
                @if (!string.IsNullOrEmpty(SearchTerm))
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="ClearSearch" data-testid="tags-clear-search">
                        Clear Search
                    </Button>
                }
                else
                {
                    <Button Href="/ManageTag" data-testid="tags-empty-new">Add New Tag</Button>
                }
            </ChildContent>
        </Empty>
    }
    else
    {
        <DataTable TData="BlogTag"
                   Data="@FilteredList"
                   InitialPageSize="20"
                   AriaLabel="Tags"
                   data-testid="tags-grid">
            <Columns>
                <DataTableColumn TData="BlogTag" TValue="string" Property="@(t => t.TagName)" Header="Tag Name" Sortable Filterable>
                    <CellTemplate Context="row">
                        <span class="font-semibold text-foreground" data-testid="tag-row-name">@row.TagName</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogTag" TValue="string" Property="@(t => t.Slug)" Header="Slug" Sortable>
                    <CellTemplate Context="row">
                        <span class="text-xs text-muted-foreground" data-testid="tag-row-slug">/@row.Slug</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogTag" TValue="int" Property="@(t => t.PostCount)" Header="Posts" Sortable Width="100px">
                    <CellTemplate Context="row">
                        <Badge Variant="BadgeVariant.Secondary" data-testid="tag-row-postcount">@row.PostCount</Badge>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="BlogTag" TValue="long" Property="@(t => t.TagId)" Header="Actions" Width="120px">
                    <CellTemplate Context="row">
                        <div class="flex flex-nowrap items-center gap-1">
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Href="@($"/ManageTag/{row.TagId}")"
                                    AriaLabel="Edit tag"
                                    data-testid="tag-edit">
                                <LucideIcon Name="pencil" Size="16" />
                            </Button>
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    Class="text-destructive"
                                    OnClick="@(() => ConfirmDelete(row))"
                                    AriaLabel="Delete tag"
                                    data-testid="tag-delete">
                                <LucideIcon Name="trash-2" Size="16" />
                            </Button>
                        </div>
                    </CellTemplate>
                </DataTableColumn>
            </Columns>
        </DataTable>
    }
</div>

@* ---- Delete confirmation ------------------------------------------------ *@
<Dialog Open="@(!HideDeleteDialog)" OpenChanged="@OnDeleteDialogOpenChanged">
    <DialogContent data-testid="tag-delete-dialog">
        <DialogHeader>
            <DialogTitle>Confirm Delete</DialogTitle>
            <DialogDescription>This action cannot be undone.</DialogDescription>
        </DialogHeader>
        <p class="text-sm text-foreground">
            Are you sure you want to delete the tag
            "<strong data-testid="tag-delete-name">@TagToDelete?.TagName</strong>"?
        </p>
        <Alert Variant="AlertVariant.Warning" data-testid="tag-delete-warning">
            <LucideIcon Name="triangle-alert" Size="16" />
            <AlertDescription>This will remove the tag from all associated posts.</AlertDescription>
        </Alert>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="CancelDelete" data-testid="tag-delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive" OnClick="DeleteTagAsync" data-testid="tag-delete-confirm">
                Delete
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@code {
    private List<BlogTag> TagList;
    private List<BlogTag> FilteredList;
    private BlogTag TagToDelete;
    private bool HideDeleteDialog = true;
    private string StatusMessage = string.Empty;
    private bool IsError = false;
    private string SearchTerm = string.Empty;

    private string EmptyTitle => string.IsNullOrEmpty(SearchTerm)
        ? "No tags yet"
        : "No tags match your search";

    private string EmptyDescription => string.IsNullOrEmpty(SearchTerm)
        ? "Create your first tag to start labelling posts."
        : "Try a different search term.";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadTagsAsync();
    }

    /// <summary>Keeps the legacy hide-flag in sync with the dialog open state.</summary>
    /// <param name="isOpen">True when the dialog is open.</param>
    private void OnDeleteDialogOpenChanged(bool isOpen)
    {
        HideDeleteDialog = !isOpen;
        if (!isOpen)
        {
            TagToDelete = null;
        }
    }

    private async Task LoadTagsAsync()
    {
        try
        {
            TagList = (await TagService.GetAllWithCountsAsync()).ToList();
            ApplyFilter();
        }
        catch
        {
            TagList = new List<BlogTag>();
            FilteredList = new List<BlogTag>();
            StatusMessage = "Failed to load tags.";
            IsError = true;
        }
    }

    private void ApplyFilter()
    {
        if (TagList == null)
        {
            FilteredList = new List<BlogTag>();
            return;
        }

        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            FilteredList = TagList.ToList();
        }
        else
        {
            var searchLower = SearchTerm.ToLower();
            FilteredList = TagList.Where(t =>
                (t.TagName?.ToLower().Contains(searchLower) ?? false) ||
                (t.Slug?.ToLower().Contains(searchLower) ?? false)).ToList();
        }
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
        ApplyFilter();
    }

    private void ConfirmDelete(BlogTag tag)
    {
        TagToDelete = tag;
        HideDeleteDialog = false;
    }

    private void CancelDelete()
    {
        TagToDelete = null;
        HideDeleteDialog = true;
    }

    private async Task DeleteTagAsync()
    {
        if (TagToDelete == null) return;

        var result = await TagService.DeleteTagAsync(TagToDelete.TagId);
        if (result.IsSuccess)
        {
            StatusMessage = $"Tag '{TagToDelete.TagName}' deleted successfully.";
            IsError = false;
            await LoadTagsAsync();
        }
        else
        {
            StatusMessage = result.ErrorMessage;
            IsError = true;
        }

        TagToDelete = null;
        HideDeleteDialog = true;
    }
}

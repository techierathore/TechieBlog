@*
    UsersList.razor
    Purpose: Displays a list of users for administration.
    Provides user management capabilities including role assignment.

    Usage: Navigate to /users
    Dependencies: Microsoft.FluentUI.AspNetCore.Components
    Authorization: AdminOnly policy required
*@
@page "/users"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout

<div class="users-list-page">
    @* Page Header *@
    <div class="page-header">
        <h1>Users</h1>
        <FluentAnchor Href="/AddUser" Appearance="Appearance.Accent">+ Add New User</FluentAnchor>
    </div>

    @* Status Messages *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <FluentMessageBar Intent="@(IsError ? MessageIntent.Error : MessageIntent.Success)"
                          Style="margin-bottom: 16px;">
            @StatusMessage
        </FluentMessageBar>
    }

    @* Filters Row *@
    <div class="filters-row">
        @* Role Tabs *@
        <div class="status-tabs">
            <span class="tabs__item @(RoleFilter == "all" ? "tabs__item--active" : "")"
                  @onclick='() => SetFilter("all")'>
                All (@(ObjectList?.Count ?? 0))
            </span>
            <span class="tabs__item @(RoleFilter == "admin" ? "tabs__item--active" : "")"
                  @onclick='() => SetFilter("admin")'>
                Admins (@AdminCount)
            </span>
            <span class="tabs__item @(RoleFilter == "editor" ? "tabs__item--active" : "")"
                  @onclick='() => SetFilter("editor")'>
                Editors (@EditorCount)
            </span>
            <span class="tabs__item @(RoleFilter == "reader" ? "tabs__item--active" : "")"
                  @onclick='() => SetFilter("reader")'>
                Readers (@ReaderCount)
            </span>
        </div>

        <span style="flex: 1;"></span>

        @* Search Box *@
        <div class="search-box">
            <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Neutral" />
            <FluentTextField @bind-Value="SearchTerm"
                             @bind-Value:after="ApplyFilter"
                             Placeholder="Search users..."
                             Style="min-width: 200px;" />
        </div>
    </div>

    @* Users Table *@
    <div class="users-table-container">
        @if (ObjectList == null)
        {
            <div style="padding: 32px; text-align: center;">
                <FluentProgressRing />
                <span style="display: block; margin-top: 8px;">Loading...</span>
            </div>
        }
        else if (FilteredList == null || FilteredList.Count == 0)
        {
            <div style="padding: 32px; text-align: center; color: var(--color-neutral-light);">
                @if (RoleFilter == "all" && string.IsNullOrEmpty(SearchTerm))
                {
                    <p>No users found.</p>
                }
                else
                {
                    <p>No users match your filters.</p>
                    <FluentButton Appearance="Appearance.Outline" OnClick="ClearFilters">Clear Filters</FluentButton>
                }
            </div>
        }
        else
        {
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th style="width: 120px;">Role</th>
                        <th style="width: 100px;">Status</th>
                        <th style="width: 120px;">Joined</th>
                        <th style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in FilteredList)
                    {
                        <tr>
                            <td>
                                <div class="user-name">@user.FirstName @user.LastName</div>
                                <div class="user-username">@user.EmailId</div>
                            </td>
                            <td>@user.EmailId</td>
                            <td>
                                <span class="badge @GetRoleBadgeClass(user.UserRole)">@user.UserRole</span>
                            </td>
                            <td>
                                @if (user.IsConfirmed)
                                {
                                    <span class="badge badge--success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge--warning">Inactive</span>
                                }
                            </td>
                            <td>@user.CreatedOn.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="action-buttons">
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  OnClick="@(() => ShowEditRoleDialog(user))"
                                                  Title="Change Role">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.PersonEdit())" />
                                    </FluentButton>
                                    @if (user.IsConfirmed)
                                    {
                                        <FluentButton Appearance="Appearance.Stealth"
                                                      OnClick="@(() => ToggleUserStatus(user))"
                                                      Title="Deactivate"
                                                      Disabled="@IsProcessing">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.PersonProhibited())" Color="Color.Warning" />
                                        </FluentButton>
                                    }
                                    else
                                    {
                                        <FluentButton Appearance="Appearance.Stealth"
                                                      OnClick="@(() => ToggleUserStatus(user))"
                                                      Title="Activate"
                                                      Disabled="@IsProcessing">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.PersonAvailable())" Color="Color.Success" />
                                        </FluentButton>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @* Pagination Footer *@
    @if (FilteredList != null && FilteredList.Count > 0)
    {
        <div class="table-footer">
            <div class="pagination-info">
                Showing @FilteredList.Count of @(ObjectList?.Count ?? 0) users
            </div>
        </div>
    }

    @* Edit Role Dialog *@
    @if (ShowRoleDialog)
    {
        <FluentDialog Hidden="false" Modal="true" TrapFocus="true">
            <FluentDialogHeader>
                <FluentLabel Typo="Typography.PaneHeader">Change User Role</FluentLabel>
            </FluentDialogHeader>
            <FluentDialogBody>
                <p>Change role for <strong>@UserToEdit?.FirstName @UserToEdit?.LastName</strong></p>
                <FluentSelect TOption="string" @bind-Value="SelectedRole" Style="width: 100%; margin-top: 16px;">
                    <FluentOption TOption="string" Value="Admin">Admin</FluentOption>
                    <FluentOption TOption="string" Value="Editor">Editor</FluentOption>
                    <FluentOption TOption="string" Value="Author">Author</FluentOption>
                    <FluentOption TOption="string" Value="Contributor">Contributor</FluentOption>
                    <FluentOption TOption="string" Value="Reader">Reader</FluentOption>
                </FluentSelect>
            </FluentDialogBody>
            <FluentDialogFooter>
                <FluentButton Appearance="Appearance.Neutral" OnClick="@CancelRoleEdit">
                    Cancel
                </FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="@SaveRoleChange">
                    Save
                </FluentButton>
            </FluentDialogFooter>
        </FluentDialog>
    }
</div>

<style>
    .users-list-page {
        max-width: 1400px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-lg, 24px);
    }

    .page-header h1 {
        margin: 0;
    }

    .filters-row {
        display: flex;
        gap: var(--spacing-md, 16px);
        margin-bottom: var(--spacing-lg, 24px);
        flex-wrap: wrap;
        align-items: center;
    }

    .status-tabs {
        display: flex;
        border-bottom: 1px solid var(--color-border, #E1E1E1);
    }

    .tabs__item {
        padding: var(--spacing-sm, 8px) var(--spacing-md, 16px);
        font-size: var(--font-size-small, 0.875rem);
        color: var(--color-neutral-light, #605E5C);
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        cursor: pointer;
        transition: all var(--transition-fast, 150ms ease);
    }

    .tabs__item:hover {
        color: var(--color-neutral, #323130);
    }

    .tabs__item--active {
        color: var(--color-primary, #0078D4);
        border-bottom-color: var(--color-primary, #0078D4);
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm, 8px);
    }

    .users-table-container {
        border: 1px solid var(--color-border, #E1E1E1);
        border-radius: var(--border-radius-lg, 8px);
        overflow: hidden;
        background-color: var(--color-background, #fff);
    }

    .data-grid {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--font-size-small, 0.875rem);
    }

    .data-grid th,
    .data-grid td {
        padding: var(--spacing-sm, 8px) var(--spacing-md, 16px);
        text-align: left;
        border-bottom: 1px solid var(--color-border, #E1E1E1);
    }

    .data-grid th {
        font-weight: var(--font-weight-semibold, 600);
        background-color: var(--color-surface, #F5F5F5);
        color: var(--color-neutral-light, #605E5C);
    }

    .data-grid tr:hover td {
        background-color: var(--color-surface, #F5F5F5);
    }

    .user-name {
        font-weight: var(--font-weight-semibold, 600);
        color: var(--color-neutral, #323130);
    }

    .user-username {
        font-size: var(--font-size-xs, 0.75rem);
        color: var(--color-neutral-light, #605E5C);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 2px var(--spacing-sm, 8px);
        font-size: var(--font-size-xs, 0.75rem);
        font-weight: var(--font-weight-semibold, 600);
        border-radius: var(--border-radius, 4px);
        background-color: var(--color-surface, #F5F5F5);
        color: var(--color-neutral-light, #605E5C);
    }

    .badge--success {
        background-color: var(--color-success, #107C10);
        color: white;
    }

    .badge--warning {
        background-color: var(--color-warning, #FFB900);
        color: var(--color-neutral, #323130);
    }

    .badge--admin {
        background-color: var(--color-error, #D13438);
        color: white;
    }

    .badge--editor {
        background-color: var(--color-primary, #0078D4);
        color: white;
    }

    .badge--author {
        background-color: var(--color-accent, #8764B8);
        color: white;
    }

    .action-buttons {
        display: flex;
        gap: 2px;
        flex-wrap: nowrap;
    }

    .table-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: var(--spacing-md, 16px);
    }

    .pagination-info {
        font-size: var(--font-size-small, 0.875rem);
        color: var(--color-neutral-light, #605E5C);
    }
</style>

@*
    UsersList.razor
    Purpose: Displays a list of users for administration.
    Provides user management capabilities including role assignment.

    Usage: Navigate to /users
    Dependencies: TrBlazeUI.Components (REQ-UI-048)
    Authorization: AdminOnly policy required
*@
@page "/users"
@attribute [Authorize(Policy = "AdminOnly")]
@layout BlogUI.Layouts.AdminLayout
@using BlogModels.Models

<div class="mx-auto max-w-[1400px] space-y-6">

    @* ---- Page header --------------------------------------------------- *@
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-foreground">Users</h1>
            <p class="text-sm text-muted-foreground">Accounts, roles and activation status.</p>
        </div>
        <Button Href="/AddUser" data-testid="new-user">
            <LucideIcon Name="plus" Size="16" />
            Add New User
        </Button>
    </div>

    @* ---- Status message ------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <Alert Variant="@(IsError ? AlertVariant.Danger : AlertVariant.Success)"
               data-testid="users-status-message">
            <LucideIcon Name="@(IsError ? "circle-alert" : "circle-check")" Size="16" />
            <AlertDescription>@StatusMessage</AlertDescription>
        </Alert>
    }

    @* ---- Filter row ---------------------------------------------------- *@
    <div class="flex flex-wrap items-center justify-between gap-4">
        @*
            TrBlazeUI's TabsList and TabsTrigger declare no CaptureUnmatchedValues, so a
            data-testid on either throws at render and the ErrorBoundary swallowed the whole
            page behind an HTTP 200 — this page was unreachable. Tabs itself does splat, so the
            container hook lives there and each trigger's hook lives on a span this page owns.
            Library gap TR-030/TR-046; do not put test hooks back on the
            TabsList/TabsTrigger elements.
        *@
        <Tabs Value="@RoleFilter"
              ValueChanged="@((string value) => SetFilter(value))"
              data-testid="users-role-tabs">
            <TabsList>
                <TabsTrigger Value="all"><span data-testid="users-tab-all">All (@(ObjectList?.Count ?? 0))</span></TabsTrigger>
                <TabsTrigger Value="admin"><span data-testid="users-tab-admin">Admins (@AdminCount)</span></TabsTrigger>
                <TabsTrigger Value="editor"><span data-testid="users-tab-editor">Editors (@EditorCount)</span></TabsTrigger>
                <TabsTrigger Value="reader"><span data-testid="users-tab-reader">Readers (@ReaderCount)</span></TabsTrigger>
            </TabsList>
        </Tabs>

        <div class="flex items-center gap-2">
            <LucideIcon Name="search" Size="16" Class="text-muted-foreground" />
            <Input Type="InputType.Search"
                   @bind-Value="SearchTerm"
                   @bind-Value:after="ApplyFilter"
                   Placeholder="Search users..."
                   Class="min-w-[200px]"
                   AriaLabel="Search users"
                   data-testid="users-search" />
        </div>
    </div>

    @* ---- Users table ---------------------------------------------------- *@
    @if (ObjectList == null)
    {
        <div class="flex flex-col items-center gap-2 py-8" data-testid="users-loading">
            <Spinner />
            <span class="text-sm text-muted-foreground">Loading...</span>
        </div>
    }
    else if (FilteredList == null || FilteredList.Count == 0)
    {
        <Empty Title="@EmptyTitle" Description="@EmptyDescription" data-testid="users-empty">
            <Icon><LucideIcon Name="users" Size="48" /></Icon>
            <ChildContent>
                @if (HasActiveFilters)
                {
                    <Button Variant="ButtonVariant.Outline" OnClick="ClearFilters" data-testid="users-clear-filters">
                        Clear Filters
                    </Button>
                }
                else
                {
                    <Button Href="/AddUser" data-testid="users-empty-new">Add New User</Button>
                }
            </ChildContent>
        </Empty>
    }
    else
    {
        <DataTable TData="AppUser"
                   Data="@FilteredList"
                   InitialPageSize="20"
                   AriaLabel="Users"
                   data-testid="users-grid">
            <Columns>
                <DataTableColumn TData="AppUser" TValue="string" Property="@(u => u.FirstName)" Header="Name" Sortable Filterable>
                    <CellTemplate Context="row">
                        <div class="flex items-center gap-3">
                            <Avatar Size="AvatarSize.Small">
                                <AvatarFallback>@GetInitials(row)</AvatarFallback>
                            </Avatar>
                            <div class="flex flex-col">
                                <span class="font-semibold text-foreground" data-testid="user-row-name">@row.FirstName @row.LastName</span>
                                <span class="text-xs text-muted-foreground" data-testid="user-row-username">@row.EmailId</span>
                            </div>
                        </div>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="AppUser" TValue="string" Property="@(u => u.EmailId)" Header="Email" Sortable Filterable>
                    <CellTemplate Context="row">
                        <span data-testid="user-row-email">@row.EmailId</span>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="AppUser" TValue="string" Property="@(u => u.UserRole)" Header="Role" Sortable Width="130px">
                    <CellTemplate Context="row">
                        <Badge Variant="@GetRoleBadgeVariant(row.UserRole)" data-testid="user-row-role">@row.UserRole</Badge>
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="AppUser" TValue="bool" Property="@(u => u.IsConfirmed)" Header="Status" Sortable Width="110px">
                    <CellTemplate Context="row">
                        @if (row.IsConfirmed)
                        {
                            <Badge data-testid="user-row-status">Active</Badge>
                        }
                        else
                        {
                            <Badge Variant="BadgeVariant.Outline" data-testid="user-row-status">Inactive</Badge>
                        }
                    </CellTemplate>
                </DataTableColumn>

                <DataTableColumn TData="AppUser" TValue="DateTime" Property="@(u => u.CreatedOn)" Header="Joined" Sortable Width="140px">
                    <CellTemplate Context="row">
                        <span data-testid="user-row-joined">@row.CreatedOn.ToString("MMM dd, yyyy")</span>
                    </CellTemplate>
                </DataTableColumn>

                @*
                    Three actions, and the two destructive ones carry their refusal reason in the
                    title attribute rather than only disabling the button — a greyed-out control with
                    no explanation is the reason this screen was reported as having "no option to
                    delete" in the first place. The guards live in the code-behind
                    (DeleteBlockReason / StatusBlockReason) and are re-checked at click time.
                *@
                <DataTableColumn TData="AppUser" TValue="long" Property="@(u => u.UserId)" Header="Actions" Width="170px">
                    <CellTemplate Context="row">
                        <div class="flex flex-nowrap items-center gap-1">
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    OnClick="@(() => ShowEditUserDialog(row))"
                                    Disabled="@IsProcessing"
                                    AriaLabel="Edit user"
                                    title="Edit name, email and role"
                                    data-testid="user-edit">
                                <LucideIcon Name="pencil" Size="16" />
                            </Button>

                            @{
                                var statusBlock = StatusBlockReason(row);
                            }
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    OnClick="@(() => ToggleUserStatus(row))"
                                    Disabled="@(IsProcessing || statusBlock != null)"
                                    AriaLabel="@(row.IsConfirmed ? "Deactivate user" : "Activate user")"
                                    title="@(statusBlock ?? (row.IsConfirmed ? "Deactivate this account" : "Activate this account"))"
                                    data-testid="@(row.IsConfirmed ? "user-deactivate" : "user-activate")">
                                <LucideIcon Name="@(row.IsConfirmed ? "user-x" : "user-check")" Size="16" />
                            </Button>

                            @{
                                var deleteBlock = DeleteBlockReason(row);
                            }
                            <Button Size="ButtonSize.IconSmall"
                                    Variant="ButtonVariant.Ghost"
                                    OnClick="@(() => ShowDeleteUserDialog(row))"
                                    Disabled="@(IsProcessing || deleteBlock != null)"
                                    AriaLabel="Delete user"
                                    title="@(deleteBlock ?? "Delete this account")"
                                    data-testid="user-delete">
                                <LucideIcon Name="trash-2" Size="16" Class="text-destructive" />
                            </Button>
                        </div>
                    </CellTemplate>
                </DataTableColumn>
            </Columns>
        </DataTable>

        <div class="flex justify-end">
            <span class="text-sm text-muted-foreground" data-testid="users-count">
                Showing @FilteredList.Count of @(ObjectList?.Count ?? 0) users
            </span>
        </div>
    }
</div>

@* ---- Edit user dialog ---------------------------------------------------- *@
@*
    Replaces the former role-only dialog. Role was the single editable field on this screen, which
    is why a wrong name or a mistyped email address could only be fixed in the database.
*@
<Dialog @bind-Open="ShowEditDialog">
    <DialogContent data-testid="user-edit-dialog">
        <DialogHeader>
            <DialogTitle>Edit User</DialogTitle>
            <DialogDescription>Update the account's details and permission level.</DialogDescription>
        </DialogHeader>

        <div class="space-y-4">
            @if (EditValidationMessage != null)
            {
                <Alert Variant="AlertVariant.Danger" data-testid="user-edit-validation">
                    <LucideIcon Name="circle-alert" Size="16" />
                    <AlertDescription>@EditValidationMessage</AlertDescription>
                </Alert>
            }

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <Label For="edit-first-name">First name</Label>
                    <Input Id="edit-first-name"
                           @bind-Value="EditFirstName"
                           Placeholder="First name"
                           data-testid="user-edit-first-name" />
                </div>
                <div class="space-y-2">
                    <Label For="edit-last-name">Last name</Label>
                    <Input Id="edit-last-name"
                           @bind-Value="EditLastName"
                           Placeholder="Last name"
                           data-testid="user-edit-last-name" />
                </div>
            </div>

            <div class="space-y-2">
                <Label For="edit-email">Email</Label>
                <Input Id="edit-email"
                       Type="InputType.Email"
                       @bind-Value="EditEmail"
                       Placeholder="name@example.com"
                       data-testid="user-edit-email" />
            </div>

            <div class="space-y-2">
                <Label>Role</Label>
                <Select TValue="string" @bind-Value="SelectedRole" Class="w-full">
                    <SelectTrigger data-testid="user-role-select">
                        <SelectValue Placeholder="Select a role" />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectItem TValue="string" Value="@("Admin")" Text="Admin">Admin</SelectItem>
                        <SelectItem TValue="string" Value="@("Editor")" Text="Editor">Editor</SelectItem>
                        <SelectItem TValue="string" Value="@("Author")" Text="Author">Author</SelectItem>
                        <SelectItem TValue="string" Value="@("Contributor")" Text="Contributor">Contributor</SelectItem>
                        <SelectItem TValue="string" Value="@("Reader")" Text="Reader">Reader</SelectItem>
                    </SelectContent>
                </Select>
            </div>
        </div>

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CancelUserEdit" data-testid="user-edit-cancel">
                Cancel
            </Button>
            <Button OnClick="@SaveUserChanges" Disabled="@IsProcessing" data-testid="user-edit-save">
                Save
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@* ---- Delete confirmation dialog ------------------------------------------ *@
@*
    Spells out what a delete does and does NOT do. Deleting a user here is a soft delete: the
    account stops existing for every list and every sign-in, but the row survives so that posts and
    comments it is referenced by stay attributed instead of being cascaded away or blocking the
    delete outright.
*@
<Dialog @bind-Open="ShowDeleteDialog">
    <DialogContent data-testid="user-delete-dialog">
        <DialogHeader>
            <DialogTitle>Delete User</DialogTitle>
            <DialogDescription>This removes the account's access to the site.</DialogDescription>
        </DialogHeader>

        <div class="space-y-3">
            <p class="text-sm text-foreground">
                Delete
                <strong data-testid="user-delete-target">@UserToDelete?.FirstName @UserToDelete?.LastName</strong>
                (@UserToDelete?.EmailId)?
            </p>
            <Alert data-testid="user-delete-note">
                <LucideIcon Name="info" Size="16" />
                <AlertDescription>
                    The account can no longer sign in and disappears from this list. Any posts and
                    comments it wrote stay published and still show the author's name.
                </AlertDescription>
            </Alert>
        </div>

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CancelDelete" data-testid="user-delete-cancel">
                Cancel
            </Button>
            <Button Variant="ButtonVariant.Destructive"
                    OnClick="@ConfirmDelete"
                    Disabled="@IsProcessing"
                    data-testid="user-delete-confirm">
                Delete user
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

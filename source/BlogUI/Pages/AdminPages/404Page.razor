@*
    404Page.razor
    Purpose: Error page displayed when a route is not found.
    Provides user-friendly error message and navigation back to main site.

    Usage: Displayed automatically for unknown routes
    Dependencies: Microsoft.FluentUI.AspNetCore.Components
*@
@page "/404"
@layout BlogUI.Layouts.AuthLayout

<FluentStack Orientation="Orientation.Vertical"
             HorizontalAlignment="HorizontalAlignment.Center"
             VerticalAlignment="VerticalAlignment.Center"
             Style="min-height: 50vh; text-align: center;">
    <h1 style="font-size: 6rem; font-weight: bold; margin: 0;">404</h1>
    <h2>Page not found.</h2>
    <p style="margin: 24px 0;">The page you are looking for might have been removed.</p>
    <FluentAnchor Href="dashboard-default" Appearance="Appearance.Accent">
        Return to website
    </FluentAnchor>
</FluentStack>

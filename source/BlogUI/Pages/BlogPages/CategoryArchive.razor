@*
    CategoryArchive.razor
    Purpose: Category archive page showing posts filtered by category.
    Displays category header, filtered post grid, and pagination.

    REQ-UI-048 — migrated from Microsoft Fluent UI to TrBlazeUI.

    Dependencies: BlogBreadcrumb, PostCard, BlogPagination components
    Layout: Uses MainLayout (with sidebar for category navigation)
*@

@page "/category/{Slug}"
@page "/categories"
@page "/categories/{Slug}"
@layout MainLayout
@inject BlogEngine.Services.CategorySvc CategoryService
@inject BlogEngine.Services.BlogSvc BlogService
@inject NavigationManager Navigation

@* REQ-NFR-007 / WCAG 2.4.2 Page Titled. *@
<PageTitle>@(category == null ? "Categories · TechieBlog" : $"{category.CategoryName} · TechieBlog")</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center gap-3 py-12" data-testid="category-loading">
        <Spinner />
        <span class="text-muted-foreground">Loading...</span>
    </div>
}
else if (notFound)
{
    <Empty Title="Category not found"
           Description="The category you're looking for doesn't exist."
           Class="py-12"
           data-testid="category-not-found">
        <Icon><LucideIcon Name="folder" Size="48" /></Icon>
        <ChildContent>
            <Button Href="/categories" data-testid="category-not-found-all">View all categories</Button>
        </ChildContent>
    </Empty>
}
else if (showCategoryList)
{
    @* All Categories View *@
    <BlogBreadcrumb Items="@breadcrumbItems" />

    <header class="my-6 flex flex-col gap-2">
        <TypographyH1>All Categories</TypographyH1>
        <p class="text-muted-foreground">Browse all blog post categories.</p>
    </header>

    @if (allCategories.Count == 0)
    {
        <Empty Title="No categories yet"
               Description="Categories appear here once posts are filed under them."
               Class="py-12"
               data-testid="categories-empty">
            <Icon><LucideIcon Name="folder" Size="48" /></Icon>
        </Empty>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="categories-grid">
            @foreach (var cat in allCategories)
            {
                <Card Class="h-full" data-testid="category-card">
                    <CardContent Class="flex flex-col gap-2 p-4">
                        <h3 class="text-lg font-semibold leading-snug">
                            <a href="/category/@cat.Slug"
                               class="text-foreground no-underline hover:text-primary hover:underline"
                               data-testid="category-card-title">@cat.CategoryName</a>
                        </h3>
                        <p class="text-sm text-muted-foreground" data-testid="category-card-description">
                            @(string.IsNullOrEmpty(cat.Description) ? "Browse posts in this category." : cat.Description)
                        </p>
                        <div>
                            <Badge Variant="BadgeVariant.Secondary" data-testid="category-card-count">@cat.PostCount posts</Badge>
                        </div>
                    </CardContent>
                </Card>
            }
        </div>
    }
}
else
{
    @* Category Detail View *@
    <BlogBreadcrumb Items="@breadcrumbItems" />

    <header class="my-6 flex flex-col gap-2">
        <TypographyH1>@category.CategoryName</TypographyH1>
        <p class="text-muted-foreground" data-testid="category-description">
            @(string.IsNullOrEmpty(category.Description) ? "Browse posts in this category." : category.Description)
        </p>
        <div>
            <Badge Variant="BadgeVariant.Secondary" data-testid="category-post-count">@totalPosts posts</Badge>
        </div>
    </header>

    @if (posts.Count == 0)
    {
        <Empty Title="No posts in this category yet"
               Description="New articles land here as soon as they are published."
               Class="py-12"
               data-testid="category-posts-empty">
            <Icon><LucideIcon Name="inbox" Size="48" /></Icon>
            <ChildContent>
                <Button Href="/categories" Variant="ButtonVariant.Outline">Browse other categories</Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="posts-grid">
            @foreach (var post in posts)
            {
                <PostCard Category="@category.CategoryName"
                          Title="@post.Title"
                          Excerpt="@(string.IsNullOrEmpty(post.Abstract) ? GetExcerpt(post.PostContent) : post.Abstract)"
                          PostUrl="@($"/post/{post.Slug}")"
                          AuthorName="@(string.IsNullOrEmpty(post.BlogWriter) ? "Unknown" : post.BlogWriter)"
                          Date="@post.CreatedOn.ToString("MMM dd")"
                          ReadTime="@GetReadingTime(post.PostContent)" />
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="mt-8">
                <BlogPagination CurrentPage="@currentPage" TotalPages="@totalPages" OnPageChanged="HandlePageChanged" />
            </div>
        }
    }
}

@code {
    /// <summary>
    /// Category slug from URL route parameter.
    /// </summary>
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private List<BlogBreadcrumbItem> breadcrumbItems = new();
    private Category category;
    private List<Category> allCategories = new();
    private List<BlogModels.BlogPost> posts = new();
    private bool isLoading = true;
    private bool notFound = false;
    private bool showCategoryList = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalPosts = 0;
    private const int PageSize = 9;

    protected override async Task OnParametersSetAsync()
    {
        await LoadCategory();
    }

    private async Task LoadCategory()
    {
        isLoading = true;
        notFound = false;
        showCategoryList = false;

        try
        {
            if (string.IsNullOrWhiteSpace(Slug))
            {
                // Show all categories
                showCategoryList = true;
                allCategories = CategoryService.GetAllWithCounts().ToList();

                breadcrumbItems = new List<BlogBreadcrumbItem>
                {
                    new BlogBreadcrumbItem { Label = "Home", Url = "/" },
                    new BlogBreadcrumbItem { Label = "Categories", Url = "" }
                };
            }
            else
            {
                // Show specific category
                category = CategoryService.GetCategoryBySlug(Slug);

                if (category == null)
                {
                    notFound = true;
                }
                else
                {
                    breadcrumbItems = new List<BlogBreadcrumbItem>
                    {
                        new BlogBreadcrumbItem { Label = "Home", Url = "/" },
                        new BlogBreadcrumbItem { Label = "Categories", Url = "/categories" },
                        new BlogBreadcrumbItem { Label = category.CategoryName, Url = "" }
                    };

                    totalPosts = BlogService.GetPostCountByCategory(category.CategoryId);
                    totalPages = Math.Max(1, (int)Math.Ceiling(totalPosts / (double)PageSize));

                    var offset = (currentPage - 1) * PageSize;
                    posts = BlogService.GetPostsByCategory(category.CategoryId, PageSize, offset).ToList();
                }
            }
        }
        catch
        {
            notFound = true;
        }

        isLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Reloads the archive for the requested page.
    /// </summary>
    /// <param name="page">1-based page number.</param>
    private async Task HandlePageChanged(int page)
    {
        currentPage = page;
        await LoadCategory();
    }

    /// <summary>
    /// Gets a short excerpt from content.
    /// </summary>
    private string GetExcerpt(string content, int maxLength = 150)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;

        var text = content
            .Replace("#", "")
            .Replace("*", "")
            .Replace("_", "")
            .Replace("`", "")
            .Trim();

        if (text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength).TrimEnd() + "...";
    }

    /// <summary>
    /// Gets reading time from content.
    /// </summary>
    private string GetReadingTime(string content)
    {
        return BlogEngine.Common.ReadingTimeCalculator.Calculate(content);
    }
}

@*
    TagArchive.razor
    Purpose: Tag archive page showing posts filtered by tag.
    Displays tag header with hashtag, filtered post grid, and pagination.

    REQ-UI-048 — migrated from Microsoft Fluent UI to TrBlazeUI. The weighted tag
    cloud now scales through Tailwind text-size buckets instead of inline styles.

    Dependencies: BlogBreadcrumb, PostCard, BlogPagination components, TagSvc
    Layout: Uses MainLayout (with sidebar for tag navigation)
*@

@page "/tag/{Slug}"
@page "/tags"
@page "/tags/{Slug}"
@layout MainLayout
@inject BlogEngine.Services.TagSvc TagService
@inject BlogEngine.Services.CategorySvc CategorySvc
@inject NavigationManager Navigation

@* REQ-NFR-007 / WCAG 2.4.2 Page Titled. *@
<PageTitle>@(tagInfo == null ? "Tags · TechieBlog" : $"#{tagInfo.TagName} · TechieBlog")</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center gap-3 py-12" data-testid="tag-loading">
        <Spinner />
        <span class="text-muted-foreground">Loading...</span>
    </div>
}
else if (notFound)
{
    <Empty Title="Tag not found"
           Description="The tag you're looking for doesn't exist."
           Class="py-12"
           data-testid="tag-not-found">
        <Icon><LucideIcon Name="tag" Size="48" /></Icon>
        <ChildContent>
            <Button Href="/tags" data-testid="tag-not-found-all">View all tags</Button>
        </ChildContent>
    </Empty>
}
else if (showTagList)
{
    @* All Tags View *@
    <BlogBreadcrumb Items="@breadcrumbItems" />

    <header class="my-6 flex flex-col gap-2">
        <TypographyH1>All Tags</TypographyH1>
        <p class="text-muted-foreground">Browse all blog post tags.</p>
    </header>

    @if (allTags.Count == 0)
    {
        <Empty Title="Nothing tagged yet"
               Description="Tags appear here once posts carry them."
               Class="py-12"
               data-testid="tags-empty">
            <Icon><LucideIcon Name="tag" Size="48" /></Icon>
        </Empty>
    }
    else
    {
        <div class="my-6 flex flex-wrap items-center gap-3" data-testid="tags-cloud">
            @foreach (var tag in allTags)
            {
                <a href="/tag/@tag.Slug"
                   class="@($"inline-flex items-center gap-1 rounded-md border border-border px-3 py-1 text-foreground no-underline hover:bg-accent hover:text-accent-foreground {GetTagSizeClass(tag.PostCount)}")"
                   data-testid="@($"tag-chip-{tag.Slug}")">
                    #@tag.TagName
                    <Badge Variant="BadgeVariant.Secondary">@tag.PostCount</Badge>
                </a>
            }
        </div>
    }
}
else
{
    @* Tag Detail View *@
    <BlogBreadcrumb Items="@breadcrumbItems" />

    <header class="my-6 flex flex-col gap-2">
        <TypographyH1>#@tagInfo.TagName</TypographyH1>
        <p class="text-muted-foreground" data-testid="tag-description">Posts tagged with "@tagInfo.TagName"</p>
        <div>
            <Badge Variant="BadgeVariant.Secondary" data-testid="tag-post-count">@totalPosts posts</Badge>
        </div>
    </header>

    @if (posts.Count == 0)
    {
        <Empty Title="Nothing tagged yet"
               Description="No posts currently carry this tag."
               Class="py-12"
               data-testid="tag-posts-empty">
            <Icon><LucideIcon Name="inbox" Size="48" /></Icon>
            <ChildContent>
                <Button Href="/tags" Variant="ButtonVariant.Outline">Browse other tags</Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="posts-grid">
            @foreach (var post in posts)
            {
                @* [REQ-UI-045] 2026-08-09 — see the matching note in CategoryArchive.razor: the
                   featured image was never passed, so this listing showed placeholders while the
                   home page showed real covers for the same posts. *@
                <PostCard Category="@GetCategoryName(post)"
                          Title="@post.Title"
                          Excerpt="@(string.IsNullOrEmpty(post.Abstract) ? GetExcerpt(post.PostContent) : post.Abstract)"
                          PostUrl="@($"/post/{post.Slug}")"
                          AuthorName="@(string.IsNullOrEmpty(post.BlogWriter) ? "Unknown" : post.BlogWriter)"
                          Date="@post.CreatedOn.ToString("MMM dd")"
                          ReadTime="@GetReadingTime(post.PostContent)"
                          ImageUrl="@post.FeaturedImage"
                          ImagePlaceholder="@post.Title" />
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="mt-8">
                <BlogPagination CurrentPage="@currentPage" TotalPages="@totalPages" OnPageChanged="HandlePageChanged" />
            </div>
        }
    }
}

@code {
    /// <summary>
    /// Tag slug from URL route parameter. Empty renders the full tag cloud.
    /// </summary>
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private List<BlogBreadcrumbItem> breadcrumbItems = new();
    private BlogTag tagInfo;
    private List<BlogTag> allTags = new();
    private List<BlogModels.BlogPost> posts = new();
    private Dictionary<long, BlogModels.Category> categoryCache = new();
    private bool isLoading = true;
    private bool notFound = false;
    private bool showTagList = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalPosts = 0;
    private const int PageSize = 9;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTag();
    }

    private async Task LoadTag()
    {
        isLoading = true;
        notFound = false;
        showTagList = false;

        try
        {
            // Load categories into cache for name lookup
            if (categoryCache.Count == 0)
            {
                var allCategories = CategorySvc.GetAllCategories();
                categoryCache = allCategories.ToDictionary(c => c.CategoryId, c => c);
            }

            if (string.IsNullOrWhiteSpace(Slug))
            {
                // Show all tags
                showTagList = true;
                allTags = TagService.GetAllWithCounts().ToList();

                breadcrumbItems = new List<BlogBreadcrumbItem>
                {
                    new BlogBreadcrumbItem { Label = "Home", Url = "/" },
                    new BlogBreadcrumbItem { Label = "Tags", Url = "" }
                };
            }
            else
            {
                // Show specific tag
                tagInfo = TagService.GetTagBySlug(Slug);

                if (tagInfo == null)
                {
                    notFound = true;
                }
                else
                {
                    breadcrumbItems = new List<BlogBreadcrumbItem>
                    {
                        new BlogBreadcrumbItem { Label = "Home", Url = "/" },
                        new BlogBreadcrumbItem { Label = "Tags", Url = "/tags" },
                        new BlogBreadcrumbItem { Label = tagInfo.TagName, Url = "" }
                    };

                    totalPosts = TagService.GetPostCountByTag(tagInfo.TagId);
                    totalPages = Math.Max(1, (int)Math.Ceiling(totalPosts / (double)PageSize));

                    var offset = (currentPage - 1) * PageSize;
                    posts = TagService.GetPostsByTag(tagInfo.TagId, PageSize, offset).ToList();
                }
            }
        }
        catch
        {
            notFound = true;
        }

        isLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Reloads the archive for the requested page.
    /// </summary>
    /// <param name="page">1-based page number.</param>
    private async Task HandlePageChanged(int page)
    {
        currentPage = page;
        await LoadTag();
    }

    /// <summary>
    /// Resolves a post's category name from the cached category lookup.
    /// </summary>
    private string GetCategoryName(BlogModels.BlogPost post)
    {
        if (post.CategoryId > 0 && categoryCache.TryGetValue(post.CategoryId, out var category))
        {
            return category.CategoryName ?? "Uncategorized";
        }
        return "Uncategorized";
    }

    /// <summary>
    /// Gets a short excerpt from content.
    /// </summary>
    private string GetExcerpt(string content, int maxLength = 150)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;

        var text = content
            .Replace("#", "")
            .Replace("*", "")
            .Replace("_", "")
            .Replace("`", "")
            .Trim();

        if (text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength).TrimEnd() + "...";
    }

    /// <summary>
    /// Gets reading time from content.
    /// </summary>
    private string GetReadingTime(string content)
    {
        return BlogEngine.Common.ReadingTimeCalculator.Calculate(content);
    }

    /// <summary>
    /// Picks a Tailwind text-size class so busier tags read larger in the cloud.
    /// </summary>
    /// <param name="count">Number of posts carrying the tag.</param>
    /// <returns>A Tailwind font-size utility class.</returns>
    private string GetTagSizeClass(int count)
    {
        if (allTags.Count == 0)
        {
            return "text-base";
        }

        var minCount = allTags.Min(t => t.PostCount);
        var maxCount = allTags.Max(t => t.PostCount);

        if (maxCount == minCount)
        {
            return "text-base";
        }

        var ratio = (double)(count - minCount) / (maxCount - minCount);

        if (ratio >= 0.75) return "text-xl";
        if (ratio >= 0.5) return "text-lg";
        if (ratio >= 0.25) return "text-base";
        return "text-sm";
    }
}

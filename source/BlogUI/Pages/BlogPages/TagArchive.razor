@*
    TagArchive.razor
    Purpose: Tag archive page showing posts filtered by tag.
    Displays tag header with hashtag, filtered post grid, and pagination.

    Dependencies: Breadcrumb, PostCard, Pagination components, TagSvc
    Layout: Uses MainLayout (with sidebar for tag navigation)
*@

@page "/tag/{Slug}"
@page "/tags"
@page "/tags/{Slug}"
@layout MainLayout
@inject BlogEngine.Services.TagSvc TagService
@inject NavigationManager Navigation

@if (isLoading)
{
    <div class="loading-container" style="display: flex; justify-content: center; padding: 48px;">
        <FluentProgressRing />
        <span style="margin-left: 12px;">Loading...</span>
    </div>
}
else if (notFound)
{
    <div class="not-found" style="text-align: center; padding: 48px;">
        <FluentIcon Value="@(new Icons.Regular.Size48.Tag())" />
        <h1>Tag Not Found</h1>
        <p>The tag you're looking for doesn't exist.</p>
        <FluentAnchor Href="/tags" Appearance="Appearance.Accent">
            View All Tags
        </FluentAnchor>
    </div>
}
else if (showTagList)
{
    @* All Tags View *@
    <Breadcrumb Items="@breadcrumbItems" />

    <div class="tag-header">
        <h1>All Tags</h1>
        <p class="tag-header__description">Browse all blog post tags.</p>
    </div>

    <div class="tags-cloud" style="margin: 24px 0;">
        @foreach (var tag in allTags)
        {
            var fontSize = CalculateFontSize(tag.PostCount);
            <a href="/tag/@tag.Slug" class="tag" style="font-size: @(fontSize)rem; margin: 4px 8px; display: inline-block;">
                #@tag.TagName
                <FluentBadge Appearance="Appearance.Neutral" Style="margin-left: 4px;">@tag.PostCount</FluentBadge>
            </a>
        }
    </div>
}
else
{
    @* Tag Detail View *@
    <Breadcrumb Items="@breadcrumbItems" />

    <div class="tag-header">
        <div class="tag-header__title">
            <span class="tag-header__hash">#</span>
            <h1>@tagInfo.TagName</h1>
        </div>
        <p class="tag-header__description">Posts tagged with "@tagInfo.TagName"</p>
        <FluentBadge Appearance="Appearance.Neutral">@totalPosts posts</FluentBadge>
    </div>

    @if (posts.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info" Style="margin: 24px 0;">
            No posts found with this tag.
        </FluentMessageBar>
    }
    else
    {
        <div class="post-grid">
            @foreach (var post in posts)
            {
                <PostCard Category="@GetCategoryName(post)"
                          Title="@post.Title"
                          Excerpt="@(string.IsNullOrEmpty(post.Abstract) ? GetExcerpt(post.PostContent) : post.Abstract)"
                          PostUrl="@($"/post/{post.Slug}")"
                          AuthorName="@(string.IsNullOrEmpty(post.BlogWriter) ? "Unknown" : post.BlogWriter)"
                          Date="@post.CreatedOn.ToString("MMM dd")"
                          ReadTime="@GetReadingTime(post.PostContent)" />
            }
        </div>

        @if (totalPages > 1)
        {
            <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" OnPageChanged="HandlePageChanged" />
        }
    }
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private List<Breadcrumb.BreadcrumbItem> breadcrumbItems = new();
    private BlogTag tagInfo;
    private List<BlogTag> allTags = new();
    private List<BlogModels.BlogPost> posts = new();
    private bool isLoading = true;
    private bool notFound = false;
    private bool showTagList = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalPosts = 0;
    private const int PageSize = 9;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTag();
    }

    private async Task LoadTag()
    {
        isLoading = true;
        notFound = false;
        showTagList = false;

        try
        {
            if (string.IsNullOrWhiteSpace(Slug))
            {
                // Show all tags
                showTagList = true;
                allTags = TagService.GetAllWithCounts().ToList();

                breadcrumbItems = new List<Breadcrumb.BreadcrumbItem>
                {
                    new Breadcrumb.BreadcrumbItem { Label = "Home", Url = "/" },
                    new Breadcrumb.BreadcrumbItem { Label = "Tags", Url = "" }
                };
            }
            else
            {
                // Show specific tag
                tagInfo = TagService.GetTagBySlug(Slug);

                if (tagInfo == null)
                {
                    notFound = true;
                }
                else
                {
                    breadcrumbItems = new List<Breadcrumb.BreadcrumbItem>
                    {
                        new Breadcrumb.BreadcrumbItem { Label = "Home", Url = "/" },
                        new Breadcrumb.BreadcrumbItem { Label = "Tags", Url = "/tags" },
                        new Breadcrumb.BreadcrumbItem { Label = tagInfo.TagName, Url = "" }
                    };

                    totalPosts = TagService.GetPostCountByTag(tagInfo.TagId);
                    totalPages = Math.Max(1, (int)Math.Ceiling(totalPosts / (double)PageSize));

                    var offset = (currentPage - 1) * PageSize;
                    posts = TagService.GetPostsByTag(tagInfo.TagId, PageSize, offset).ToList();
                }
            }
        }
        catch
        {
            notFound = true;
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task HandlePageChanged(int page)
    {
        currentPage = page;
        await LoadTag();
    }

    private string GetCategoryName(BlogModels.BlogPost post)
    {
        // Placeholder - would need CategorySvc to get actual name
        return "Blog";
    }

    private string GetExcerpt(string content, int maxLength = 150)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;

        var text = content
            .Replace("#", "")
            .Replace("*", "")
            .Replace("_", "")
            .Replace("`", "")
            .Trim();

        if (text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength).TrimEnd() + "...";
    }

    private string GetReadingTime(string content)
    {
        return BlogEngine.Common.ReadingTimeCalculator.Calculate(content);
    }

    private double CalculateFontSize(int count)
    {
        // Calculate font size based on post count (range: 0.9rem to 1.6rem)
        if (allTags.Count == 0) return 1.0;

        var minCount = allTags.Min(t => t.PostCount);
        var maxCount = allTags.Max(t => t.PostCount);

        if (maxCount == minCount) return 1.0;

        var ratio = (double)(count - minCount) / (maxCount - minCount);
        return 0.9 + (ratio * 0.7);
    }
}

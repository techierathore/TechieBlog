@*
    AuthorProfile.razor
    Purpose: Author profile page showing author bio, stats, and posts.
    Displays author header, stats grid, posts grid, and sidebar with series/topics.
    Converted from mockups/07-author-profile.html.

    Dependencies: PostCard, Pagination components
    Layout: Uses MainLayout (with sidebar for author's series and topics)
*@

@page "/author/{Slug}"
@layout MainLayout

@* Author Header *@
<div class="author-header">
    <div class="author-header__avatar"></div>
    <div class="author-header__content">
        <h1 class="author-header__name">@author.Name</h1>
        <p class="author-header__bio">@author.Bio</p>
        <div class="author-header__meta">
            <span><strong>@author.PostCount</strong> posts</span>
            <span><strong>@author.TotalViews.ToString("N0")</strong> total views</span>
            <span>Member since <strong>@author.MemberSince</strong></span>
        </div>
        <div class="author-header__social">
            @if (!string.IsNullOrEmpty(author.TwitterUrl))
            {
                <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size20.Person())" title="Twitter" OnClick="@(() => OpenSocialLink(author.TwitterUrl))">
                    X
                </FluentButton>
            }
            @if (!string.IsNullOrEmpty(author.GitHubUrl))
            {
                <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size20.Code())" title="GitHub" OnClick="@(() => OpenSocialLink(author.GitHubUrl))">
                    GitHub
                </FluentButton>
            }
            @if (!string.IsNullOrEmpty(author.LinkedInUrl))
            {
                <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size20.PersonBoard())" title="LinkedIn" OnClick="@(() => OpenSocialLink(author.LinkedInUrl))">
                    LinkedIn
                </FluentButton>
            }
        </div>
    </div>
</div>

@* Author Stats *@
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card__value">@author.PostCount</div>
        <div class="stat-card__label">Posts</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__value">@author.SeriesCount</div>
        <div class="stat-card__label">Series</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__value">@author.AvgRating.ToString("F1")</div>
        <div class="stat-card__label">Avg Rating</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__value">@author.CommentCount</div>
        <div class="stat-card__label">Comments</div>
    </div>
</div>

@* Posts by Author *@
<section class="author-posts">
    <div class="author-posts__header">
        <h2>Posts by @author.FirstName</h2>
        <FluentSelect TOption="string" @bind-Value="sortBy" Style="width: auto;">
            <FluentOption TOption="string" Value="recent">Most Recent</FluentOption>
            <FluentOption TOption="string" Value="popular">Most Popular</FluentOption>
            <FluentOption TOption="string" Value="rating">Highest Rated</FluentOption>
        </FluentSelect>
    </div>

    <div class="post-grid">
        @foreach (var post in posts)
        {
            <PostCard Category="@post.Category"
                      Title="@post.Title"
                      Excerpt="@post.Excerpt"
                      PostUrl="@($"/post/{post.Slug}")"
                      Date="@post.Date"
                      ReadTime="@post.ReadTime"
                      ShowRating="@(post.Rating > 0)"
                      Rating="@post.Rating" />
        }
    </div>

    @* Pagination *@
    <Pagination CurrentPage="1" TotalPages="4" OnPageChanged="HandlePageChanged" />
</section>


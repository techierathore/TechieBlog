@*
    About.razor
    Purpose: About page for TechieBlog.
    Displays information about the blog, its mission, the stack it is built on and contact links.

    REQ-UI-048 — migrated from Microsoft Fluent UI to TrBlazeUI; the page-level
    <style> block and its hardcoded colours were replaced by semantic Tailwind tokens,
    so dark mode now comes for free (REQ-UI-033).

    Usage: Navigate to /about
    Layout: MainLayout (public site layout)
*@
@page "/about"
@layout MainLayout

<SiteBrandTitle Page="About" Separator=" · " />

@* UAT-027: `.prose-container` — the READING tier of the site width system (layout.css),
   capped at 820px. Was an inert `max-w-[760px]` (arbitrary-value utility; this build has
   no Tailwind JIT, so it never applied). About is reading content (prose sections), so it
   takes the reading cap rather than growing to the fluid `.site-container` width. *@
<div class="prose-container py-8" data-testid="about-page">

    <header class="mb-8 flex items-center gap-4">
        <Avatar Size="AvatarSize.ExtraLarge">
            <AvatarFallback>TB</AvatarFallback>
        </Avatar>
        <TypographyH1 Class="page-title page-title-centered">About TechieBlog</TypographyH1>
    </header>

    <Card data-testid="about-card">
        <CardContent Class="flex flex-col gap-8 p-6">

            <section class="flex flex-col gap-3">
                <TypographyH2>Welcome</TypographyH2>
                <p class="leading-7 text-muted-foreground">
                    TechieBlog is a platform dedicated to sharing knowledge about technology,
                    programming, and software development. We aim to provide valuable insights,
                    tutorials, and discussions on the latest trends in the tech industry.
                </p>
            </section>

            <section class="flex flex-col gap-3">
                <TypographyH2>Our Mission</TypographyH2>
                <p class="leading-7 text-muted-foreground">
                    Our mission is to make technology accessible to everyone. Whether you're
                    a seasoned developer or just starting your journey in tech, we strive to
                    create content that is informative, engaging, and practical.
                </p>
            </section>

            <section class="flex flex-col gap-3">
                <TypographyH2>What We Cover</TypographyH2>
                <ul class="list-disc pl-6 leading-8 text-muted-foreground">
                    <li>Web Development (Frontend &amp; Backend)</li>
                    <li>.NET, C#, and Microsoft Technologies</li>
                    <li>Cloud Computing and DevOps</li>
                    <li>Software Architecture and Best Practices</li>
                    <li>Database Technologies</li>
                    <li>And much more!</li>
                </ul>
            </section>

            <section class="flex flex-col gap-3">
                <TypographyH2>Built With</TypographyH2>
                <div class="flex flex-wrap gap-2" data-testid="about-stack">
                    @foreach (var tech in StackChips)
                    {
                        <Badge Variant="BadgeVariant.Secondary">@tech</Badge>
                    }
                </div>
            </section>

            <section class="flex flex-col gap-3">
                <TypographyH2>Connect With Us</TypographyH2>
                <p class="leading-7 text-muted-foreground">
                    We love hearing from our readers! Feel free to reach out through comments
                    on our posts or connect with us on social media.
                </p>
                <div class="flex flex-wrap gap-3" data-testid="about-links">
                    <Button Href="https://github.com"
                            Target="_blank"
                            Variant="ButtonVariant.Outline"
                            data-testid="about-github">
                        <LucideIcon Name="code" Size="16" />
                        GitHub
                    </Button>
                    <Button Href="https://twitter.com"
                            Target="_blank"
                            Variant="ButtonVariant.Outline"
                            data-testid="about-twitter">
                        <LucideIcon Name="message-square" Size="16" />
                        Twitter
                    </Button>
                    <Button Href="https://linkedin.com"
                            Target="_blank"
                            Variant="ButtonVariant.Outline"
                            data-testid="about-linkedin">
                        <LucideIcon Name="users" Size="16" />
                        LinkedIn
                    </Button>
                    <Button Href="/resume" Variant="ButtonVariant.Outline" data-testid="about-resume">
                        <LucideIcon Name="file-text" Size="16" />
                        View my resume
                    </Button>
                </div>
            </section>

        </CardContent>
    </Card>
</div>

@code {
    /// <summary>
    /// Technology chips shown in the "Built With" section.
    /// </summary>
    private static readonly string[] StackChips =
    {
        ".NET 10",
        "Blazor Server",
        "TrBlazeUI",
        "PostgreSQL",
        "Dapper + DbUp",
        "Serilog",
        "Playwright"
    };
}

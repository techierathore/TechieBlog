@*
    SeriesView.razor
    Purpose: Series listing and series detail pages.
    Displays series header, numbered post list with status badges, and other series.

    REQ-UI-048 — migrated from Microsoft Fluent UI to TrBlazeUI.

    REQ-FN-015 — the part list is PUBLISHED-ONLY for anonymous and non-staff
    visitors. Unpublished parts are attached only when the signed-in user holds a
    content-manager role (Admin / Editor / Author), and then they are labelled as
    a staff-only preview. The page used to render every draft part's title,
    abstract and featured image to anyone as a "Coming Soon" row.

    Dependencies: BlogBreadcrumb component, SeriesSvc, AuthenticationState
    Layout: Uses FullWidthLayout (no sidebar - content focused)
*@

@page "/series"
@page "/series/{Slug}"
@layout FullWidthLayout

@inject BlogEngine.Services.SeriesSvc SeriesService

@* REQ-NFR-007 / WCAG 2.4.2 Page Titled. *@
<PageTitle>@(series == null ? "Series · TechieBlog" : $"{series.Name} · TechieBlog")</PageTitle>

<div class="mx-auto w-full max-w-[860px]">

    @* Breadcrumb Navigation *@
    <BlogBreadcrumb Items="@breadcrumbItems" />

    @if (string.IsNullOrEmpty(Slug))
    {
        @* All Series Listing *@
        <header class="my-6 flex flex-col gap-2">
            <TypographyH1 Class="page-title">Article Series</TypographyH1>
            <p class="text-muted-foreground">Browse all multi-part blog series.</p>
        </header>

        @if (allSeries == null)
        {
            <div class="flex items-center justify-center gap-3 py-12" data-testid="series-loading">
                <Spinner />
                <span class="text-muted-foreground">Loading series...</span>
            </div>
        }
        else if (!allSeries.Any())
        {
            <Empty Title="No series published yet"
                   Description="Multi-part series will show up here once published."
                   Class="py-12"
                   data-testid="series-empty">
                <Icon><LucideIcon Name="layers" Size="48" /></Icon>
            </Empty>
        }
        else
        {
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="series-grid">
                @foreach (var item in allSeries)
                {
                    <Card Class="h-full" data-testid="series-card">
                        <CardContent Class="flex flex-col gap-2 p-4">
                            <div>
                                <Badge Variant="BadgeVariant.Secondary" data-testid="series-card-parts">@item.PostCount Parts</Badge>
                            </div>
                            <h3 class="text-lg font-semibold leading-snug">
                                <a href="/series/@item.Slug"
                                   class="text-foreground no-underline hover:text-primary hover:underline"
                                   data-testid="series-card-title">@item.Name</a>
                            </h3>
                            <p class="text-sm text-muted-foreground">@item.Description</p>
                            <span class="text-xs text-muted-foreground" data-testid="series-card-status">@item.Status</span>
                        </CardContent>
                    </Card>
                }
            </div>
        }
    }
    else if (series == null)
    {
        <div class="flex items-center justify-center gap-3 py-12" data-testid="series-loading">
            <Spinner />
            <span class="text-muted-foreground">Loading series...</span>
        </div>
    }
    else if (series.SeriesId == 0)
    {
        <Empty Title="Series not found"
               Description="The series you're looking for doesn't exist or has been removed."
               Class="py-12"
               data-testid="series-not-found">
            <Icon><LucideIcon Name="layers" Size="48" /></Icon>
            <ChildContent>
                <Button Href="/series" data-testid="series-not-found-all">Browse all series</Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        @* Series Header *@
        <header class="my-6 flex flex-col gap-3" data-testid="series-header">
            <div>
                <Badge>Series</Badge>
            </div>
            <TypographyH1 Class="page-title">@series.Name</TypographyH1>
            <p class="text-muted-foreground" data-testid="series-description">@series.Description</p>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
                <span data-testid="series-part-count"><strong class="text-foreground">@series.PostCount</strong> Parts</span>
                <span class="text-muted-foreground" data-testid="series-author">By @series.AuthorName</span>
                <span data-testid="series-started">Started @series.CreatedOn.ToString("MMM yyyy")</span>
                <span data-testid="series-status"><strong class="text-foreground">@series.Status</strong></span>
            </div>
        </header>

        @* Series Posts List *@
        <section class="my-8">
            <TypographyH2 Class="mb-4">Posts in this Series</TypographyH2>

            @* REQ-FN-015: drafts reach this list only for staff, and the header badge still counts
               published parts, so say plainly why the two numbers differ. *@
            @if (canSeeDrafts && series.Posts != null && series.Posts.Any(p => !p.Published))
            {
                <p class="mb-4 text-sm text-muted-foreground" data-testid="series-draft-notice">
                    Unpublished parts are shown because you are signed in as a content manager. Readers
                    see only the @series.PostCount published part(s) counted above.
                </p>
            }

            @if (series.Posts != null && series.Posts.Any())
            {
                <div class="flex flex-col gap-4" data-testid="series-posts">
                    @foreach (var post in series.Posts.OrderBy(p => p.SeriesPartNumber))
                    {
                        var isLatest = post == series.Posts.Where(p => p.Published).OrderByDescending(p => p.PublishedOn).FirstOrDefault();

                        <Card Class="@(isLatest ? "ring-2 ring-primary" : string.Empty)" data-testid="series-post">
                            <CardContent Class="flex items-start gap-4 p-4">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground"
                                     data-testid="series-post-number">
                                    @post.SeriesPartNumber
                                </div>

                                <div class="flex flex-1 flex-col gap-1">
                                    <h3 class="text-lg font-semibold leading-snug">
                                        @if (post.Published)
                                        {
                                            <a href="/post/@post.Slug"
                                               class="text-foreground no-underline hover:text-primary hover:underline"
                                               data-testid="series-post-title">@post.Title</a>
                                        }
                                        else
                                        {
                                            <span data-testid="series-post-title">@post.Title</span>
                                        }
                                    </h3>
                                    <p class="text-sm text-muted-foreground">@post.Abstract</p>
                                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                        @if (post.Published)
                                        {
                                            <span data-testid="series-post-date">@post.PublishedOn?.ToString("MMM dd, yyyy")</span>
                                            <span data-testid="series-post-readtime">@BlogEngine.Common.ReadingTimeCalculator.Calculate(post.PostContent ?? "")</span>
                                            @if (isLatest)
                                            {
                                                <Badge data-testid="series-post-status">Latest</Badge>
                                            }
                                            else
                                            {
                                                <Badge Variant="BadgeVariant.Outline" data-testid="series-post-status">Published</Badge>
                                            }
                                        }
                                        else
                                        {
                                            @* Only a content manager ever reaches this branch — REQ-FN-015. *@
                                            <Badge Variant="BadgeVariant.Secondary" data-testid="series-post-status">Draft — not public</Badge>
                                        }
                                    </div>
                                </div>

                                <div class="hidden h-20 w-32 shrink-0 overflow-hidden rounded-md bg-muted sm:block">
                                    @if (!string.IsNullOrEmpty(post.FeaturedImage))
                                    {
                                        <img src="@post.FeaturedImage" alt="@post.Title" class="h-full w-full object-cover" />
                                    }
                                    else
                                    {
                                        <div class="flex h-full w-full items-center justify-center text-xs text-muted-foreground">Image</div>
                                    }
                                </div>
                            </CardContent>
                        </Card>
                    }
                </div>
            }
            else
            {
                <Empty Title="Parts coming soon"
                       Description="No posts in this series yet. Check back soon."
                       Size="EmptySize.Small"
                       data-testid="series-posts-empty">
                    <Icon><LucideIcon Name="inbox" Size="40" /></Icon>
                </Empty>
            }
        </section>

        @* Other Series *@
        @if (otherSeries != null && otherSeries.Any())
        {
            <section class="my-8" data-testid="other-series">
                <TypographyH2 Class="mb-4">Other Series</TypographyH2>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var other in otherSeries)
                    {
                        <Card Class="h-full" data-testid="other-series-card">
                            <CardContent Class="flex flex-col gap-2 p-4">
                                <div>
                                    <Badge Variant="BadgeVariant.Secondary">@other.PostCount Parts</Badge>
                                </div>
                                <h3 class="text-lg font-semibold leading-snug">
                                    <a href="/series/@other.Slug"
                                       class="text-foreground no-underline hover:text-primary hover:underline"
                                       data-testid="other-series-title">@other.Name</a>
                                </h3>
                                <p class="text-sm text-muted-foreground">@other.Description</p>
                                <span class="text-xs text-muted-foreground">@other.Status</span>
                            </CardContent>
                        </Card>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    /// <summary>
    /// Series slug from URL route parameter. Empty renders the series listing.
    /// </summary>
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    /// <summary>
    /// The signed-in visitor, supplied by the router's cascading authentication state.
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<BlogBreadcrumbItem> breadcrumbItems = new();
    private BlogModels.BlogSeries series;
    private List<BlogModels.BlogSeries> otherSeries = new();
    private List<BlogModels.BlogSeries> allSeries = new();
    private bool canSeeDrafts;

    /// <summary>
    /// Resolves the visitor's role before loading, so the part list is chosen from what this
    /// visitor is allowed to see rather than filtered after the fact (REQ-FN-015).
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        canSeeDrafts = await IsContentManagerAsync();
        await LoadDataAsync();
    }

    /// <summary>
    /// Reports whether the signed-in visitor holds a content-manager role and may therefore see
    /// unpublished parts of a series.
    /// </summary>
    /// <remarks>
    /// An anonymous visitor, a signed-out circuit and any reader-level account all answer
    /// <c>false</c>, so the page falls back to the published-only read. A failure to resolve the
    /// authentication state answers <c>false</c> as well — the safe direction.
    /// </remarks>
    /// <returns><c>true</c> when the visitor is an Admin, Editor or Author.</returns>
    private async Task<bool> IsContentManagerAsync()
    {
        if (AuthStateTask is null)
            return false;

        try
        {
            var user = (await AuthStateTask).User;
            if (user?.Identity?.IsAuthenticated != true)
                return false;

            return AppRoles.ContentManagers.Any(role => user.IsInRole(role));
        }
        catch
        {
            return false;
        }
    }

    private async Task LoadDataAsync()
    {
        // Setup breadcrumb
        breadcrumbItems = new List<BlogBreadcrumbItem>
        {
            new BlogBreadcrumbItem { Label = "Home", Url = "/" },
            new BlogBreadcrumbItem { Label = "Series", Url = "/series" },
        };

        // Load all series
        allSeries = (await SeriesService.GetAllWithCountsAsync())?.ToList() ?? new List<BlogModels.BlogSeries>();

        if (!string.IsNullOrEmpty(Slug))
        {
            // Load specific series with its posts. REQ-FN-015: only a content manager gets the
            // draft parts; every other visitor gets the published-only list.
            series = await SeriesService.GetSeriesBySlugAsync(Slug, canSeeDrafts);

            if (series != null && series.SeriesId > 0)
            {
                breadcrumbItems.Add(new BlogBreadcrumbItem { Label = series.Name, Url = "" });

                // Get other series (excluding current)
                otherSeries = allSeries.Where(s => s.Slug != Slug).Take(3).ToList();
            }
            else
            {
                // Series not found
                series = new BlogModels.BlogSeries();
            }
        }
    }
}

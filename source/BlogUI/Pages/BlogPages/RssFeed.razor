@*
    RssFeed.razor
    Purpose: RSS feed landing page — subscription URL, how-to steps, reader suggestions
    and a preview of recent posts.

    REQ-UI-048 — migrated from Microsoft Fluent UI to TrBlazeUI; the page-level
    <style> block and its hardcoded colours were replaced by semantic Tailwind tokens.

    Usage: Navigate to /rss
    Dependencies: BlogSvc
    Layout: MainLayout (public site layout)
*@
@page "/rss"
@layout MainLayout
@inject BlogEngine.Services.BlogSvc BlogService
@inject NavigationManager Navigation

@* [REQ-NFR-007] WCAG 2.4.2 Page Titled (Level A) — the 2026-08-07 pass added titles to eight
   public routes but missed this one, so /rss announced itself as just the site name. *@
<PageTitle>RSS feed - TechieBlog</PageTitle>

<div class="mx-auto w-full max-w-[800px] py-8" data-testid="rss-page">

    <header class="mb-8 flex items-center gap-4">
        <LucideIcon Name="rss" Size="40" />
        <TypographyH1>RSS Feed</TypographyH1>
    </header>

    <section class="mb-8 flex flex-col gap-4">
        <TypographyH2>Subscribe to TechieBlog</TypographyH2>
        <p class="leading-7 text-muted-foreground">
            Stay updated with our latest posts by subscribing to our RSS feed.
            Use your favorite RSS reader to get notified when new content is published.
        </p>

        <div class="flex flex-col gap-3 rounded-lg bg-muted p-4 sm:flex-row sm:items-center">
            @* [REQ-NFR-007] 2026-08-09 — WCAG 4.1.2 / 3.3.2. This box had NO accessible name at
               all: axe reported `label` (CRITICAL) on /rss at both viewports, and a screen reader
               announced the site's subscription address as an unnamed edit field. It is the only
               Input in the app with neither a visible <Label> nor a Placeholder — every other one
               passes axe's `non-empty-placeholder` check, which is exactly why this single control
               slipped through three earlier audits. A visually-hidden label is used rather than a
               placeholder because the field is READONLY and already full of text: a placeholder
               would never be seen by anyone, sighted or not. *@
            <Label For="rss-url-input" Class="sr-only">RSS feed URL</Label>
            <Input Id="rss-url-input" Value="@rssUrl" readonly Class="flex-1" data-testid="rss-url" />
            <Button OnClick="CopyFeedUrl" data-testid="rss-copy">
                <LucideIcon Name="copy" Size="16" />
                Copy
            </Button>
            @* [REQ-UI-046] The feed is a real endpoint (Program.cs maps /feed.xml), so it can be
               opened. Before 2026-08-09 this page advertised a URL that returned 404, and there
               was no way to tell from the page itself — a link that a reader can follow is the
               cheapest possible proof that the advertised address is live. *@
            <Button Href="@rssUrl" Variant="ButtonVariant.Outline" data-testid="rss-open">
                <LucideIcon Name="external-link" Size="16" />
                Open feed
            </Button>
        </div>

        @if (showCopyMessage)
        {
            <Alert Variant="AlertVariant.Success" data-testid="rss-copy-confirmation">
                <LucideIcon Name="circle-check" Size="16" />
                <AlertTitle>Copied</AlertTitle>
                <AlertDescription>Feed URL copied to clipboard!</AlertDescription>
            </Alert>
        }
    </section>

    <section class="mb-8 flex flex-col gap-4">
        <TypographyH2>How to Subscribe</TypographyH2>
        <ol class="list-decimal pl-6 leading-8 text-muted-foreground">
            <li>Copy the RSS feed URL above</li>
            <li>Open your preferred RSS reader application</li>
            <li>Add a new feed and paste the URL</li>
            <li>Start receiving updates automatically!</li>
        </ol>
    </section>

    <section class="mb-8 flex flex-col gap-4">
        <TypographyH2>Recommended RSS Readers</TypographyH2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-testid="rss-readers">
            @foreach (var reader in RecommendedReaders)
            {
                <Card>
                    <CardContent Class="flex flex-col gap-1 p-4">
                        <span class="font-semibold">@reader.Name</span>
                        <span class="text-sm text-muted-foreground">@reader.Platforms</span>
                    </CardContent>
                </Card>
            }
        </div>
    </section>

    <section class="mb-8 flex flex-col gap-4">
        <TypographyH2>Recent Posts Preview</TypographyH2>
        @if (recentPosts != null && recentPosts.Any())
        {
            <ul class="flex list-none flex-col p-0" data-testid="rss-recent-posts">
                @foreach (var post in recentPosts)
                {
                    <li class="flex items-center justify-between gap-4 border-b border-border py-2">
                        <a href="/post/@post.Slug"
                           class="text-primary no-underline hover:underline"
                           data-testid="rss-recent-post-title">@post.Title</a>
                        <span class="text-sm text-muted-foreground">@post.CreatedOn.ToString("MMM dd, yyyy")</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <Empty Title="No posts available yet"
                   Description="Published posts will appear in the feed preview."
                   Size="EmptySize.Small"
                   data-testid="rss-posts-empty">
                <Icon><LucideIcon Name="inbox" Size="40" /></Icon>
            </Empty>
        }
    </section>
</div>

@code {
    private string rssUrl = "";
    private bool showCopyMessage = false;
    private List<BlogModels.BlogPost> recentPosts;

    /// <summary>
    /// Reader suggestions rendered as cards.
    /// </summary>
    private static readonly (string Name, string Platforms)[] RecommendedReaders =
    {
        ("Feedly", "Web, iOS, Android"),
        ("Inoreader", "Web, iOS, Android"),
        ("NewsBlur", "Web, iOS, Android"),
        ("The Old Reader", "Web-based")
    };

    protected override void OnInitialized()
    {
        rssUrl = $"{Navigation.BaseUri}feed.xml";
        LoadRecentPosts();
    }

    private void LoadRecentPosts()
    {
        try
        {
            recentPosts = BlogService.GetPublishedPosts(5, 0).ToList();
        }
        catch
        {
            recentPosts = new List<BlogModels.BlogPost>();
        }
    }

    private async Task CopyFeedUrl()
    {
        // Note: Clipboard API requires JavaScript interop
        // For now, we'll just show a message
        showCopyMessage = true;
        StateHasChanged();

        await Task.Delay(3000);
        showCopyMessage = false;
        StateHasChanged();
    }
}

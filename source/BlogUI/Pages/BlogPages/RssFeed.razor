@*
    RssFeed.razor
    Purpose: RSS Feed page for TechieBlog.
    Provides RSS feed subscription information and preview.

    Usage: Navigate to /rss
    Dependencies: Microsoft.FluentUI.AspNetCore.Components, BlogSvc
    Layout: MainLayout (public site layout)
*@
@page "/rss"
@layout MainLayout
@inject BlogEngine.Services.BlogSvc BlogService
@inject NavigationManager Navigation

<div class="rss-page">
    <article class="rss-content">
        <div class="rss-header">
            <FluentIcon Value="@(new Icons.Regular.Size48.Document())" Color="Color.Accent" />
            <h1>RSS Feed</h1>
        </div>

        <section class="rss-section">
            <h2>Subscribe to TechieBlog</h2>
            <p>
                Stay updated with our latest posts by subscribing to our RSS feed.
                Use your favorite RSS reader to get notified when new content is published.
            </p>

            <div class="rss-url-box">
                <FluentTextField Value="@rssUrl" ReadOnly="true" Style="flex: 1;" />
                <FluentButton Appearance="Appearance.Accent" OnClick="CopyFeedUrl">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Copy())" Style="margin-right: 4px;" />
                    Copy
                </FluentButton>
            </div>

            @if (showCopyMessage)
            {
                <FluentMessageBar Intent="MessageIntent.Success" Style="margin-top: 16px;">
                    Feed URL copied to clipboard!
                </FluentMessageBar>
            }
        </section>

        <section class="rss-section">
            <h2>How to Subscribe</h2>
            <ol class="steps-list">
                <li>Copy the RSS feed URL above</li>
                <li>Open your preferred RSS reader application</li>
                <li>Add a new feed and paste the URL</li>
                <li>Start receiving updates automatically!</li>
            </ol>
        </section>

        <section class="rss-section">
            <h2>Recommended RSS Readers</h2>
            <div class="reader-list">
                <div class="reader-item">
                    <strong>Feedly</strong>
                    <span>Web, iOS, Android</span>
                </div>
                <div class="reader-item">
                    <strong>Inoreader</strong>
                    <span>Web, iOS, Android</span>
                </div>
                <div class="reader-item">
                    <strong>NewsBlur</strong>
                    <span>Web, iOS, Android</span>
                </div>
                <div class="reader-item">
                    <strong>The Old Reader</strong>
                    <span>Web-based</span>
                </div>
            </div>
        </section>

        <section class="rss-section">
            <h2>Recent Posts Preview</h2>
            @if (recentPosts != null && recentPosts.Any())
            {
                <ul class="recent-posts-list">
                    @foreach (var post in recentPosts)
                    {
                        <li>
                            <a href="/post/@post.Slug">@post.Title</a>
                            <span class="post-date">@post.CreatedOn.ToString("MMM dd, yyyy")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>No posts available yet.</p>
            }
        </section>
    </article>
</div>

@code {
    private string rssUrl = "";
    private bool showCopyMessage = false;
    private List<BlogModels.BlogPost> recentPosts;

    protected override void OnInitialized()
    {
        rssUrl = $"{Navigation.BaseUri}feed.xml";
        LoadRecentPosts();
    }

    private void LoadRecentPosts()
    {
        try
        {
            recentPosts = BlogService.GetPublishedPosts(5, 0).ToList();
        }
        catch
        {
            recentPosts = new List<BlogModels.BlogPost>();
        }
    }

    private async Task CopyFeedUrl()
    {
        // Note: Clipboard API requires JavaScript interop
        // For now, we'll just show a message
        showCopyMessage = true;
        StateHasChanged();

        await Task.Delay(3000);
        showCopyMessage = false;
        StateHasChanged();
    }
}

<style>
    .rss-page {
        max-width: 800px;
        margin: 0 auto;
        padding: var(--spacing-lg, 24px);
    }

    .rss-header {
        display: flex;
        align-items: center;
        gap: var(--spacing-md, 16px);
        margin-bottom: var(--spacing-xl, 32px);
    }

    .rss-header h1 {
        font-size: var(--font-size-h1, 2.5rem);
        margin: 0;
        color: var(--color-primary, #0078D4);
    }

    .rss-section {
        margin-bottom: var(--spacing-xl, 32px);
    }

    .rss-section h2 {
        font-size: var(--font-size-h2, 1.75rem);
        margin-bottom: var(--spacing-md, 16px);
        color: var(--color-neutral, #323130);
    }

    .rss-section p {
        line-height: 1.7;
        color: var(--color-neutral-light, #605E5C);
        margin-bottom: var(--spacing-md, 16px);
    }

    .rss-url-box {
        display: flex;
        gap: var(--spacing-sm, 8px);
        padding: var(--spacing-md, 16px);
        background-color: var(--color-surface, #F5F5F5);
        border-radius: var(--border-radius-lg, 8px);
    }

    .steps-list {
        line-height: 2;
        padding-left: var(--spacing-lg, 24px);
        color: var(--color-neutral-light, #605E5C);
    }

    .reader-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--spacing-md, 16px);
    }

    .reader-item {
        display: flex;
        flex-direction: column;
        padding: var(--spacing-md, 16px);
        background-color: var(--color-surface, #F5F5F5);
        border-radius: var(--border-radius, 4px);
        border: 1px solid var(--color-border, #E1E1E1);
    }

    .reader-item strong {
        color: var(--color-neutral, #323130);
        margin-bottom: var(--spacing-xs, 4px);
    }

    .reader-item span {
        font-size: var(--font-size-small, 0.875rem);
        color: var(--color-neutral-light, #605E5C);
    }

    .recent-posts-list {
        list-style: none;
        padding: 0;
    }

    .recent-posts-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-sm, 8px) 0;
        border-bottom: 1px solid var(--color-border, #E1E1E1);
    }

    .recent-posts-list a {
        color: var(--color-primary, #0078D4);
        text-decoration: none;
    }

    .recent-posts-list a:hover {
        text-decoration: underline;
    }

    .post-date {
        font-size: var(--font-size-small, 0.875rem);
        color: var(--color-neutral-light, #605E5C);
    }

    /* Dark mode support */
    :global([data-theme="dark"]) .rss-header h1,
    :global([data-theme="dark"]) .rss-section h2 {
        color: var(--color-primary-light, #2899F5);
    }

    :global([data-theme="dark"]) .rss-section p,
    :global([data-theme="dark"]) .steps-list {
        color: var(--color-neutral-light-dark, #A19F9D);
    }

    :global([data-theme="dark"]) .rss-url-box,
    :global([data-theme="dark"]) .reader-item {
        background-color: var(--color-surface-dark, #1B1B1B);
    }
</style>

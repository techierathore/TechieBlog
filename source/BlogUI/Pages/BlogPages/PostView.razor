@*
    PostView.razor
    Purpose: Individual blog post detail page for TechieBlog.
    Displays full article content with author info, ratings, tags, and comments section.

    Dependencies: Breadcrumb, StarRating, PostCard components, FullWidthLayout, BlogSvc
    Layout: Uses FullWidthLayout (no sidebar - content focused)
*@

@page "/post/{Slug}"
@page "/post/{Slug}/{PageNumber:int}"
@layout FullWidthLayout
@inject BlogEngine.Services.BlogSvc BlogService
@inject BlogEngine.Services.SeriesSvc SeriesService
@inject BlogEngine.Services.FavoriteSvc FavoriteService
@inject BlogEngine.Common.MarkdownRenderer MarkdownRenderer
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@if (isLoading)
{
    <div class="loading-container" style="display: flex; justify-content: center; padding: 48px;">
        <FluentProgressRing />
        <span style="margin-left: 12px;">Loading post...</span>
    </div>
}
else if (notFound)
{
    <div class="not-found" style="text-align: center; padding: 48px;">
        <FluentIcon Value="@(new Icons.Regular.Size48.ShieldError())" Color="Color.Error" />
        <h1>Post Not Found</h1>
        <p>The post you're looking for doesn't exist or has been removed.</p>
        <FluentAnchor Href="/" Appearance="Appearance.Accent">
            Return to Home
        </FluentAnchor>
    </div>
}
else if (blogPost != null)
{
    @* Breadcrumb Navigation *@
    <Breadcrumb Items="@breadcrumbItems" />

    @* Article *@
    <article>
        @* Article Header *@
        <header class="article__header">
            <div class="article__header-top">
                <span class="article__category">@GetCategory(blogPost.Tags)</span>
                <FavoriteToggle PostId="@blogPost.PostID"
                               IsFavorited="@isFavorited"
                               IsLoggedIn="@isAuthenticated"
                               UserId="@currentUserId"
                               ShowCount="true"
                               FavoriteCount="@favoriteCount"
                               OnToggle="@HandleFavoriteToggle" />
            </div>
            <h1 class="article__title">@blogPost.Title</h1>
            <div class="article__meta">
                <div class="card__author">
                    <div class="card__avatar"></div>
                    <span>@(string.IsNullOrEmpty(blogPost.BlogWriter) ? "Unknown Author" : blogPost.BlogWriter)</span>
                </div>
                <span>@blogPost.CreatedOn.ToString("MMMM dd, yyyy")</span>
                <span>@GetReadingTime(blogPost.PostContent)</span>
            </div>
        </header>

        <style>
            .article__header-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 8px;
            }

            /* Article Pagination Styles */
            .article-pagination {
                margin: var(--spacing-xl, 32px) 0;
                padding: var(--spacing-lg, 24px);
                background: var(--neutral-layer-2, #f5f5f5);
                border-radius: var(--border-radius-lg, 8px);
                border: 1px solid var(--neutral-stroke-rest, #e0e0e0);
            }

            .article-pagination__info {
                text-align: center;
                font-size: var(--font-size-small, 0.875rem);
                color: var(--neutral-foreground-hint, #666);
                margin-bottom: var(--spacing-md, 16px);
            }

            .article-pagination__controls {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: var(--spacing-md, 16px);
            }

            .pagination-btn {
                display: inline-flex;
                align-items: center;
                gap: var(--spacing-xs, 4px);
                padding: var(--spacing-sm, 8px) var(--spacing-md, 16px);
                background: var(--accent-fill-rest, #0078D4);
                color: white;
                border-radius: var(--border-radius, 4px);
                text-decoration: none;
                font-size: var(--font-size-small, 0.875rem);
                font-weight: 500;
                transition: background 150ms ease;
            }

            .pagination-btn:hover {
                background: var(--accent-fill-hover, #106ebe);
            }

            .pagination-btn--disabled {
                background: var(--neutral-stroke-rest, #e0e0e0);
                color: var(--neutral-foreground-hint, #999);
                pointer-events: none;
            }

            .pagination-pages {
                display: flex;
                gap: var(--spacing-xs, 4px);
            }

            .pagination-page {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border-radius: var(--border-radius, 4px);
                text-decoration: none;
                font-size: var(--font-size-small, 0.875rem);
                color: var(--neutral-foreground-rest, #333);
                background: var(--neutral-layer-3, #fff);
                border: 1px solid var(--neutral-stroke-rest, #e0e0e0);
                transition: all 150ms ease;
            }

            .pagination-page:hover {
                background: var(--accent-fill-rest, #0078D4);
                color: white;
                border-color: var(--accent-fill-rest, #0078D4);
            }

            .pagination-page--active {
                background: var(--accent-fill-rest, #0078D4);
                color: white;
                border-color: var(--accent-fill-rest, #0078D4);
            }

            @@media (max-width: 480px) {
                .article-pagination__controls {
                    flex-direction: column;
                    gap: var(--spacing-sm, 8px);
                }

                .pagination-btn {
                    width: 100%;
                    justify-content: center;
                }
            }
        </style>

        @* Article Content *@
        <div class="article__content">
            @if (!string.IsNullOrEmpty(blogPost.Abstract))
            {
                <p class="article__excerpt"><em>@blogPost.Abstract</em></p>
            }
            @* Render paginated content *@
            @((MarkupString)GetPaginatedContent())
        </div>

        @* Pagination Controls *@
        @if (totalPages > 1)
        {
            <nav class="article-pagination" aria-label="Article pagination">
                <div class="article-pagination__info">
                    Page @currentPage of @totalPages
                </div>
                <div class="article-pagination__controls">
                    @if (currentPage > 1)
                    {
                        <a href="/post/@Slug/@(currentPage - 1)" class="pagination-btn pagination-btn--prev">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ChevronLeft())" />
                            Previous
                        </a>
                    }
                    else
                    {
                        <span class="pagination-btn pagination-btn--prev pagination-btn--disabled">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ChevronLeft())" />
                            Previous
                        </span>
                    }

                    <div class="pagination-pages">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            var pageNum = i;
                            @if (pageNum == currentPage)
                            {
                                <span class="pagination-page pagination-page--active">@pageNum</span>
                            }
                            else
                            {
                                <a href="/post/@Slug/@pageNum" class="pagination-page">@pageNum</a>
                            }
                        }
                    </div>

                    @if (currentPage < totalPages)
                    {
                        <a href="/post/@Slug/@(currentPage + 1)" class="pagination-btn pagination-btn--next">
                            Next
                            <FluentIcon Value="@(new Icons.Regular.Size16.ChevronRight())" />
                        </a>
                    }
                    else
                    {
                        <span class="pagination-btn pagination-btn--next pagination-btn--disabled">
                            Next
                            <FluentIcon Value="@(new Icons.Regular.Size16.ChevronRight())" />
                        </span>
                    }
                </div>
            </nav>
        }

        @* Series Navigation - shown when post is part of a series *@
        @if (seriesNavigation != null)
        {
            <div class="series-navigation" style="margin: 32px 0; padding: 24px; background: var(--neutral-layer-2); border-radius: 8px; border: 1px solid var(--neutral-stroke-rest);">
                <div style="margin-bottom: 16px;">
                    <FluentBadge Appearance="Appearance.Accent">Series</FluentBadge>
                    <h3 style="margin: 8px 0 4px 0;">
                        <a href="/series/@seriesNavigation.SeriesSlug" style="color: inherit; text-decoration: none;">
                            @seriesNavigation.SeriesName
                        </a>
                    </h3>
                    <span style="color: var(--neutral-foreground-hint); font-size: 0.9rem;">
                        Part @seriesNavigation.CurrentPart of @seriesNavigation.TotalParts
                    </span>
                </div>
                <div style="display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
                    @if (seriesNavigation.PreviousPost != null)
                    {
                        <a href="/post/@seriesNavigation.PreviousPost.Slug" style="flex: 1; min-width: 200px; padding: 12px; background: var(--neutral-layer-3); border-radius: 4px; text-decoration: none; color: inherit;">
                            <div style="font-size: 0.8rem; color: var(--neutral-foreground-hint); margin-bottom: 4px;">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowLeft())" Style="vertical-align: middle;" />
                                Previous Part
                            </div>
                            <div style="font-weight: 500;">@seriesNavigation.PreviousPost.Title</div>
                        </a>
                    }
                    else
                    {
                        <div style="flex: 1; min-width: 200px;"></div>
                    }
                    @if (seriesNavigation.NextPost != null)
                    {
                        <a href="/post/@seriesNavigation.NextPost.Slug" style="flex: 1; min-width: 200px; padding: 12px; background: var(--neutral-layer-3); border-radius: 4px; text-decoration: none; color: inherit; text-align: right;">
                            <div style="font-size: 0.8rem; color: var(--neutral-foreground-hint); margin-bottom: 4px;">
                                Next Part
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowRight())" Style="vertical-align: middle;" />
                            </div>
                            <div style="font-weight: 500;">@seriesNavigation.NextPost.Title</div>
                        </a>
                    }
                    else if (seriesNavigation.TotalParts > seriesNavigation.CurrentPart)
                    {
                        <div style="flex: 1; min-width: 200px; padding: 12px; background: var(--neutral-layer-3); border-radius: 4px; text-align: right; opacity: 0.7;">
                            <div style="font-size: 0.8rem; color: var(--neutral-foreground-hint); margin-bottom: 4px;">
                                Next Part
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowRight())" Style="vertical-align: middle;" />
                            </div>
                            <div style="font-weight: 500; font-style: italic;">Coming Soon</div>
                        </div>
                    }
                </div>
            </div>
        }

        @* Tags *@
        @if (!string.IsNullOrWhiteSpace(blogPost.Tags))
        {
            <div class="article__tags">
                <strong>Tags:</strong>
                <div class="tags-cloud tags-cloud--inline">
                    @foreach (var tag in GetTags(blogPost.Tags))
                    {
                        <a href="/tag/@GetSlug(tag)" class="tag">@tag</a>
                    }
                </div>
            </div>
        }

        @* Author Card *@
        <div class="author-card">
            <div class="author-card__avatar"></div>
            <div class="author-card__content">
                <h3 class="author-card__name">@blogPost.BlogWriter</h3>
                <p class="author-card__bio">
                    Author of this post.
                </p>
            </div>
        </div>

        @* Related Posts *@
        @if (relatedPosts != null && relatedPosts.Count > 0)
        {
            <section class="related-posts">
                <h2>More Posts</h2>
                <div class="post-grid post-grid--three">
                    @foreach (var related in relatedPosts)
                    {
                        <article class="card card--compact">
                            <div class="card__image placeholder-image">Image</div>
                            <div class="card__body">
                                <span class="card__category">@GetCategory(related.Tags)</span>
                                <h3 class="card__title">
                                    <a href="/post/@related.Slug">@related.Title</a>
                                </h3>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @* Comments Section *@
        <section class="comments-section">
            <h2>Comments</h2>
            <div class="comments__form">
                <p class="comments__login-prompt">
                    <a href="/admin/login">Login</a> to leave a comment
                </p>
                <FluentTextArea Placeholder="Write your comment..." Style="width: 100%;" Disabled="true" />
                <FluentButton Appearance="Appearance.Accent" Disabled="true" Style="margin-top: var(--spacing-sm);">
                    Post Comment
                </FluentButton>
            </div>
        </section>
    </article>
}

@code {
    /// <summary>
    /// Post slug from URL route parameter.
    /// </summary>
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    /// <summary>
    /// Optional page number for paginated articles.
    /// </summary>
    [Parameter]
    public int PageNumber { get; set; } = 1;

    private List<Breadcrumb.BreadcrumbItem> breadcrumbItems = new();
    private BlogModels.BlogPost blogPost;
    private List<BlogModels.BlogPost> relatedPosts = new();
    private BlogModels.SeriesNavigation seriesNavigation;
    private bool isLoading = true;
    private bool notFound = false;

    // Favorite state (FIX-014)
    private bool isAuthenticated = false;
    private long currentUserId = 0;
    private bool isFavorited = false;
    private int favoriteCount = 0;

    // Pagination state
    private int paginationWordCount = 500;
    private int currentPage = 1;
    private int totalPages = 1;
    private List<string> contentPages = new();
    private const string PaginationWordCountKey = "techieblog_pagination_word_count";

    protected override async Task OnParametersSetAsync()
    {
        currentPage = PageNumber > 0 ? PageNumber : 1;
        await LoadPost();
    }

    private async Task LoadPost()
    {
        isLoading = true;
        notFound = false;

        try
        {
            // Load pagination setting from local storage
            await LoadPaginationSetting();

            blogPost = BlogService.GetPostBySlug(Slug);

            if (blogPost == null || !blogPost.Published)
            {
                notFound = true;
            }
            else
            {
                // Paginate content if enabled
                PaginateContent(blogPost.PostContent);

                // Validate current page
                if (currentPage > totalPages)
                {
                    currentPage = totalPages;
                }

                // Setup breadcrumb
                breadcrumbItems = new List<Breadcrumb.BreadcrumbItem>
                {
                    new Breadcrumb.BreadcrumbItem { Label = "Home", Url = "/" },
                    new Breadcrumb.BreadcrumbItem { Label = GetCategory(blogPost.Tags), Url = $"/category/{GetSlug(GetCategory(blogPost.Tags))}" },
                    new Breadcrumb.BreadcrumbItem { Label = blogPost.Title, Url = "" }
                };

                // Load related posts (other recent posts)
                var allPosts = BlogService.GetPublishedPosts(4, 0);
                relatedPosts = allPosts
                    .Where(p => p.PostID != blogPost.PostID)
                    .Take(3)
                    .ToList();

                // Load series navigation if post is part of a series
                if (blogPost.SeriesId.HasValue)
                {
                    seriesNavigation = SeriesService.GetSeriesNavigation(blogPost.PostID);
                }
                else
                {
                    seriesNavigation = null;
                }

                // Load favorite state (FIX-014)
                await LoadFavoriteState();
            }
        }
        catch
        {
            notFound = true;
        }

        isLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Loads the pagination word count setting from local storage.
    /// </summary>
    private async Task LoadPaginationSetting()
    {
        try
        {
            var storedWordCount = await LocalStorage.GetItemAsync<int?>(PaginationWordCountKey);
            if (storedWordCount.HasValue && storedWordCount.Value > 0)
            {
                paginationWordCount = storedWordCount.Value;
            }
        }
        catch
        {
            // Use default if local storage fails
            paginationWordCount = 500;
        }
    }

    /// <summary>
    /// Splits content into pages based on word count threshold.
    /// </summary>
    private void PaginateContent(string content)
    {
        contentPages.Clear();

        if (string.IsNullOrWhiteSpace(content) || paginationWordCount <= 0)
        {
            contentPages.Add(content ?? string.Empty);
            totalPages = 1;
            return;
        }

        // Count total words
        var words = content.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries);
        var totalWordCount = words.Length;

        if (totalWordCount <= paginationWordCount)
        {
            contentPages.Add(content);
            totalPages = 1;
            return;
        }

        // Split content by paragraphs to avoid breaking mid-sentence
        var paragraphs = content.Split(new[] { "\n\n", "\r\n\r\n" }, StringSplitOptions.None);
        var currentPageContent = new System.Text.StringBuilder();
        var currentWordCount = 0;

        foreach (var paragraph in paragraphs)
        {
            var paragraphWords = paragraph.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;

            // If adding this paragraph would exceed the limit, start a new page
            if (currentWordCount > 0 && currentWordCount + paragraphWords > paginationWordCount)
            {
                contentPages.Add(currentPageContent.ToString().Trim());
                currentPageContent.Clear();
                currentWordCount = 0;
            }

            currentPageContent.AppendLine(paragraph);
            currentPageContent.AppendLine();
            currentWordCount += paragraphWords;
        }

        // Add the last page if there's content
        if (currentPageContent.Length > 0)
        {
            contentPages.Add(currentPageContent.ToString().Trim());
        }

        totalPages = contentPages.Count;
        if (totalPages == 0)
        {
            contentPages.Add(content);
            totalPages = 1;
        }
    }

    /// <summary>
    /// Gets the content for the current page.
    /// </summary>
    private string GetPaginatedContent()
    {
        if (contentPages.Count == 0)
        {
            return RenderContent(blogPost?.PostContent ?? string.Empty);
        }

        var pageIndex = currentPage - 1;
        if (pageIndex < 0) pageIndex = 0;
        if (pageIndex >= contentPages.Count) pageIndex = contentPages.Count - 1;

        return RenderContent(contentPages[pageIndex]);
    }

    /// <summary>
    /// Loads the current user's favorite state for this post.
    /// </summary>
    private async Task LoadFavoriteState()
    {
        try
        {
            // Get authentication state
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            if (user.Identity?.IsAuthenticated == true)
            {
                isAuthenticated = true;
                var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.PrimarySid)?.Value;
                if (long.TryParse(userIdClaim, out var userId))
                {
                    currentUserId = userId;
                    isFavorited = FavoriteService.IsFavorited(blogPost.PostID, userId);
                }
            }
            else
            {
                isAuthenticated = false;
            }

            // Get favorite count for the post
            favoriteCount = FavoriteService.GetFavoriteCount(blogPost.PostID);
        }
        catch
        {
            isAuthenticated = false;
            isFavorited = false;
            favoriteCount = 0;
        }
    }

    /// <summary>
    /// Handles favorite toggle from the FavoriteToggle component.
    /// </summary>
    private void HandleFavoriteToggle(bool newState)
    {
        isFavorited = newState;
        // Count is updated by the component
    }

    /// <summary>
    /// Gets the first tag as category, or "General".
    /// </summary>
    private string GetCategory(string tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return "General";

        var firstTag = tags.Split(',').FirstOrDefault()?.Trim();
        return string.IsNullOrEmpty(firstTag) ? "General" : firstTag;
    }

    /// <summary>
    /// Gets all tags as a list.
    /// </summary>
    private List<string> GetTags(string tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return new List<string>();

        return tags.Split(',')
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrEmpty(t))
            .ToList();
    }

    /// <summary>
    /// Creates a URL-friendly slug from text.
    /// </summary>
    private string GetSlug(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        return text.ToLowerInvariant()
            .Replace(" ", "-")
            .Replace("#", "sharp");
    }

    /// <summary>
    /// Gets reading time from content.
    /// </summary>
    private string GetReadingTime(string content)
    {
        return BlogEngine.Common.ReadingTimeCalculator.Calculate(content);
    }

    /// <summary>
    /// Renders Markdown content to HTML using Markdig.
    /// </summary>
    private string RenderContent(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "<p>No content available.</p>";

        return MarkdownRenderer.ToHtml(content);
    }
}

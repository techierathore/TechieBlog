@*
    PostView.razor
    Purpose: Individual blog post detail page for TechieBlog.
    Displays breadcrumb, title, byline, cover image, rendered markdown body,
    optional in-post pagination, series navigation, tags and comments.

    REQ-UI-048 — migrated from Microsoft Fluent UI to TrBlazeUI.
    REQ-UI-028 — the favourite toggle is retired; no favourites UI or state remains.
    REQ-UI-041/042 — the author byline is plain text; public author profiles are retired.
    REQ-UI-027 — anonymous, email-keyed star rating (PostRatingPanel).
    REQ-UI-029 — anonymous comment thread + comment form (CommentThread, CommentForm).
    REQ-UI-056 — both public write surfaces carry a CaptchaWidget.
    REQ-FN-034 — this page is the ONLY writer of the PostViews table: it calls
                 IPostViewTracker.TrackCurrentVisitAsync while its markup is being
                 produced for the HTTP response. See TrackVisitAndReadCountsAsync
                 for why that cannot double-count on a prerendered Blazor page.
    REQ-NFR-034 — that call now QUEUES the view instead of writing it, and the byline
                 figures come from the maintained PostViewCount rollup instead of an
                 aggregate over PostViews. No write and no table scan on the render path.
    REQ-FN-035 — the byline carries the post's own total/unique view counts, the
                 public face of the per-post engagement statistics.
    REQ-UI-007 — markdown tables get their own horizontal scroll container so a wide
                 table can never make the whole page scroll sideways on a phone. Since
                 TrBlazeUI 2.0.2 that container comes from the library's <Prose> component
                 (TR-059 resolved), which gives table/pre/img/iframe their own overflow
                 context; the WrapTablesInScrollContainer string transform this page used
                 to apply to Markdig's output is gone. ConstrainWidth is false because the
                 <article> above already caps the measure at 820px.

    Dependencies: BlogBreadcrumb, PostRatingPanel, CommentThread, CommentForm components;
    FullWidthLayout, BlogSvc, SeriesSvc, CommentSvc, MarkdownRenderer,
    IPostViewTracker, IAnalyticsService
    Layout: Uses FullWidthLayout (no sidebar - content focused)
*@

@page "/post/{Slug}"
@page "/post/{Slug}/{PageNumber:int}"
@layout FullWidthLayout
@inject BlogEngine.Services.BlogSvc BlogService
@inject BlogEngine.Services.SeriesSvc SeriesService
@inject BlogEngine.Services.CommentSvc CommentService
@inject BlogEngine.Common.MarkdownRenderer MarkdownRenderer
@inject BlogModels.Interfaces.IPostViewTracker PostViewTracker
@inject BlogModels.Interfaces.IAnalyticsService AnalyticsService
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@* REQ-UI-058 — the ambient request, used ONLY to turn an unresolvable slug into a real 404. *@
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@* REQ-NFR-007 / WCAG 2.4.2 Page Titled — every route needs a unique, descriptive title. *@
<PageTitle>@(blogPost == null ? "Post · TechieBlog" : $"{blogPost.Title} · TechieBlog")</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center gap-3 py-12" data-testid="post-loading">
        <Spinner />
        <span class="text-muted-foreground">Loading post...</span>
    </div>
}
else if (notFound)
{
    <Empty Title="Post not found"
           Description="The post you're looking for doesn't exist or has been removed."
           Class="py-12"
           data-testid="post-not-found">
        <Icon><LucideIcon Name="circle-alert" Size="48" /></Icon>
        <ChildContent>
            <Button Href="/" data-testid="post-not-found-home">Return to home</Button>
        </ChildContent>
    </Empty>
}
else if (blogPost != null)
{
    <article class="mx-auto w-full max-w-[820px]">

        @* Breadcrumb Navigation *@
        <BlogBreadcrumb Items="@breadcrumbItems" />

        @* Article Header *@
        <header class="mt-6 flex flex-col gap-4">
            <div>
                <a href="/category/@GetSlug(GetCategory(blogPost.Tags))" class="no-underline" data-testid="post-category">
                    <Badge Variant="BadgeVariant.Secondary">@GetCategory(blogPost.Tags)</Badge>
                </a>
            </div>

            <h1 class="text-balance text-4xl font-bold tracking-tight text-foreground" data-testid="post-title">@blogPost.Title</h1>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
                <span class="text-muted-foreground" data-testid="post-author">
                    @(string.IsNullOrEmpty(blogPost.BlogWriter) ? "Unknown Author" : blogPost.BlogWriter)
                </span>
                @* [REQ-FN-057] Date is the PUBLICATION date, not the creation date. This page must
                   agree with its own listing card: Home, HomeLatestArticles, CategoryArchive,
                   SearchResults and the RSS feed all resolve the date as PublishedOn ?? CreatedOn,
                   so dating the detail page by CreatedOn made /post/{slug} contradict the card the
                   reader clicked to reach it. *@
                <span data-testid="post-date">@((blogPost.PublishedOn ?? blogPost.CreatedOn).ToString("MMMM dd, yyyy"))</span>
                <span data-testid="post-readtime">@GetReadingTime(blogPost.PostContent)</span>
                @* REQ-FN-035 — per-post engagement, read straight from the recorded views *@
                <span class="inline-flex items-center gap-1" data-testid="post-views">
                    <LucideIcon Name="eye" Size="14" />
                    <span data-testid="post-views-total">@viewCounts.TotalViews.ToString("N0")</span>
                    <span>@(viewCounts.TotalViews == 1 ? "view" : "views")</span>
                    <span class="text-xs" data-testid="post-views-unique">(@viewCounts.UniqueViews.ToString("N0") unique)</span>
                </span>
            </div>
        </header>

        @* Cover Image *@
        @if (!string.IsNullOrEmpty(blogPost.FeaturedImage))
        {
            <div class="mt-6 aspect-video w-full overflow-hidden rounded-lg bg-muted">
                <img src="@blogPost.FeaturedImage"
                     alt="@blogPost.Title"
                     class="h-full w-full object-cover"
                     data-testid="post-cover-image" />
            </div>
        }

        @* Article Content *@
        <div class="mt-8">
            @if (!string.IsNullOrEmpty(blogPost.Abstract))
            {
                <p class="mb-6 border-l-2 border-border pl-4 italic text-muted-foreground" data-testid="post-abstract">
                    @blogPost.Abstract
                </p>
            }
            @* Render paginated content. <Prose> supplies the reflow rules (REQ-UI-007 / TR-059);
               `markdown-content` in wwwroot/css/base.css keeps this site's own typography. *@
            <Prose ConstrainWidth="false" Class="markdown-content" data-testid="post-content">
                @((MarkupString)GetPaginatedContent())
            </Prose>
        </div>

        @* In-post Pagination Controls — server-side, one URL per page *@
        @if (totalPages > 1)
        {
            <nav class="my-8 rounded-lg border border-border bg-muted p-6" aria-label="Article pagination" data-testid="post-paginator">
                <div class="mb-4 text-center text-sm text-muted-foreground" data-testid="post-paginator-info">
                    Page @currentPage of @totalPages
                </div>
                <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
                    @if (currentPage > 1)
                    {
                        <a href="/post/@Slug/@(currentPage - 1)"
                           class="inline-flex w-full items-center justify-center gap-1 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground no-underline hover:opacity-90 sm:w-auto"
                           data-testid="post-paginator-previous">
                            <LucideIcon Name="chevron-left" Size="16" />
                            Previous
                        </a>
                    }
                    else
                    {
                        <span class="pointer-events-none inline-flex w-full items-center justify-center gap-1 rounded-md bg-muted px-4 py-2 text-sm font-medium text-muted-foreground sm:w-auto"
                              data-testid="post-paginator-previous-disabled">
                            <LucideIcon Name="chevron-left" Size="16" />
                            Previous
                        </span>
                    }

                    <div class="flex flex-wrap items-center justify-center gap-1">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            var pageNum = i;
                            @if (pageNum == currentPage)
                            {
                                <span class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-primary bg-primary text-sm text-primary-foreground"
                                      data-testid="@($"post-paginator-page-{pageNum}-active")">@pageNum</span>
                            }
                            else
                            {
                                <a href="/post/@Slug/@pageNum"
                                   class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border bg-card text-sm text-foreground no-underline hover:bg-accent hover:text-accent-foreground"
                                   data-testid="@($"post-paginator-page-{pageNum}")">@pageNum</a>
                            }
                        }
                    </div>

                    @if (currentPage < totalPages)
                    {
                        <a href="/post/@Slug/@(currentPage + 1)"
                           class="inline-flex w-full items-center justify-center gap-1 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground no-underline hover:opacity-90 sm:w-auto"
                           data-testid="post-paginator-next">
                            Next
                            <LucideIcon Name="chevron-right" Size="16" />
                        </a>
                    }
                    else
                    {
                        <span class="pointer-events-none inline-flex w-full items-center justify-center gap-1 rounded-md bg-muted px-4 py-2 text-sm font-medium text-muted-foreground sm:w-auto"
                              data-testid="post-paginator-next-disabled">
                            Next
                            <LucideIcon Name="chevron-right" Size="16" />
                        </span>
                    }
                </div>
            </nav>
        }

        @* Series Navigation - shown when post is part of a series *@
        @if (seriesNavigation != null)
        {
            <Card Class="my-8" data-testid="series-navigation">
                <CardHeader>
                    <div>
                        <Badge Variant="BadgeVariant.Secondary">Series</Badge>
                    </div>
                    <CardTitle>
                        <a href="/series/@seriesNavigation.SeriesSlug"
                           class="text-foreground no-underline hover:text-primary hover:underline"
                           data-testid="series-navigation-name">@seriesNavigation.SeriesName</a>
                    </CardTitle>
                    <CardDescription data-testid="series-navigation-part">
                        Part @seriesNavigation.CurrentPart of @seriesNavigation.TotalParts
                    </CardDescription>
                </CardHeader>
                <CardContent Class="flex flex-col gap-4 sm:flex-row">
                    @if (seriesNavigation.PreviousPost != null)
                    {
                        <a href="/post/@seriesNavigation.PreviousPost.Slug"
                           class="flex-1 rounded-md border border-border bg-muted p-3 text-foreground no-underline hover:bg-accent hover:text-accent-foreground"
                           data-testid="series-previous-post">
                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideIcon Name="arrow-left" Size="14" />
                                Previous Part
                            </span>
                            <span class="mt-1 block font-medium">@seriesNavigation.PreviousPost.Title</span>
                        </a>
                    }
                    else
                    {
                        <div class="flex-1"></div>
                    }

                    @if (seriesNavigation.NextPost != null)
                    {
                        <a href="/post/@seriesNavigation.NextPost.Slug"
                           class="flex-1 rounded-md border border-border bg-muted p-3 text-right text-foreground no-underline hover:bg-accent hover:text-accent-foreground"
                           data-testid="series-next-post">
                            <span class="flex items-center justify-end gap-1 text-xs text-muted-foreground">
                                Next Part
                                <LucideIcon Name="arrow-right" Size="14" />
                            </span>
                            <span class="mt-1 block font-medium">@seriesNavigation.NextPost.Title</span>
                        </a>
                    }
                    else if (seriesNavigation.TotalParts > seriesNavigation.CurrentPart)
                    {
                        <div class="flex-1 rounded-md border border-border bg-muted p-3 text-right opacity-70"
                             data-testid="series-next-post-pending">
                            <span class="flex items-center justify-end gap-1 text-xs text-muted-foreground">
                                Next Part
                                <LucideIcon Name="arrow-right" Size="14" />
                            </span>
                            <span class="mt-1 block font-medium italic">Coming Soon</span>
                        </div>
                    }
                </CardContent>
            </Card>
        }

        @* Tags *@
        @if (!string.IsNullOrWhiteSpace(blogPost.Tags))
        {
            <div class="my-8 flex flex-wrap items-center gap-2" data-testid="post-tags">
                <span class="text-sm font-semibold">Tags:</span>
                @foreach (var tag in GetTags(blogPost.Tags))
                {
                    <a href="/tag/@GetSlug(tag)" class="no-underline" data-testid="@($"post-tag-{GetSlug(tag)}")">
                        <Badge Variant="BadgeVariant.Outline">@tag</Badge>
                    </a>
                }
            </div>
        }

        @* Rate this article — anonymous, email-keyed, captcha-gated (REQ-UI-027 / REQ-UI-056) *@
        <PostRatingPanel PostId="@blogPost.PostID" />

        @* Author byline card — plain text, no profile link (REQ-UI-041/042) *@
        <Card Class="my-8" data-testid="post-author-card">
            <CardContent Class="flex items-center gap-4 p-6">
                <Avatar Size="AvatarSize.Large">
                    <AvatarFallback>@GetInitials(blogPost.BlogWriter)</AvatarFallback>
                </Avatar>
                <div class="flex flex-col">
                    <span class="font-semibold" data-testid="post-author-name">@blogPost.BlogWriter</span>
                    <span class="text-sm text-muted-foreground">Author of this post.</span>
                </div>
            </CardContent>
        </Card>

        @* Related Posts *@
        @if (relatedPosts != null && relatedPosts.Count > 0)
        {
            <section class="my-8" data-testid="related-posts">
                <TypographyH2 Class="mb-4">More Posts</TypographyH2>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var related in relatedPosts)
                    {
                        <Card Class="h-full" data-testid="related-post-card">
                            <CardContent Class="flex flex-col gap-2 p-4">
                                <div>
                                    <Badge Variant="BadgeVariant.Secondary">@GetCategory(related.Tags)</Badge>
                                </div>
                                <h3 class="text-base font-semibold leading-snug">
                                    <a href="/post/@related.Slug"
                                       class="text-foreground no-underline hover:text-primary hover:underline"
                                       data-testid="related-post-title">@related.Title</a>
                                </h3>
                            </CardContent>
                        </Card>
                    }
                </div>
            </section>
        }

        @* Comments Section — anonymous name + email, no sign-in prompt (REQ-UI-029) *@
        <section class="my-8" data-testid="comments-section">
            <TypographyH2 Class="mb-4">
                Comments
                <span class="text-base font-medium text-muted-foreground" data-testid="comments-count">(@GetCommentTotal())</span>
            </TypographyH2>

            <CommentThread Comments="@comments" />

            <CommentForm PostId="@blogPost.PostID" OnSubmitted="LoadCommentsAsync" />
        </section>
    </article>
}

@code {
    /// <summary>
    /// Post slug from URL route parameter.
    /// </summary>
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    /// <summary>
    /// Optional page number for paginated articles.
    /// </summary>
    [Parameter]
    public int PageNumber { get; set; } = 1;

    private List<BlogBreadcrumbItem> breadcrumbItems = new();
    private BlogModels.BlogPost blogPost;
    private List<BlogModels.BlogPost> relatedPosts = new();
    private BlogModels.SeriesNavigation seriesNavigation;
    private List<BlogModels.BlogComment> comments = new();
    private BlogModels.PostViewCounts viewCounts = new();
    private bool isLoading = true;
    private bool notFound = false;

    /// <summary>
    /// The post this component instance has already counted a view for, so an in-page navigation
    /// (a paginated article, a re-render) cannot ask the tracker again for the same article.
    /// </summary>
    private long trackedPostId;

    // Pagination state
    private int paginationWordCount = 500;
    private int currentPage = 1;
    private int totalPages = 1;
    private List<string> contentPages = new();
    private const string PaginationWordCountKey = "techieblog_pagination_word_count";

    protected override async Task OnParametersSetAsync()
    {
        currentPage = PageNumber > 0 ? PageNumber : 1;
        await LoadPost();
    }

    private async Task LoadPost()
    {
        isLoading = true;
        notFound = false;

        try
        {
            // Load pagination setting from local storage
            await LoadPaginationSetting();

            blogPost = await BlogService.GetPostBySlugAsync(Slug);

            if (blogPost == null || !blogPost.Published)
            {
                notFound = true;
            }
            else
            {
                // Paginate content if enabled
                PaginateContent(blogPost.PostContent);

                // Validate current page
                if (currentPage > totalPages)
                {
                    currentPage = totalPages;
                }

                // Setup breadcrumb
                breadcrumbItems = new List<BlogBreadcrumbItem>
                {
                    new BlogBreadcrumbItem { Label = "Home", Url = "/" },
                    new BlogBreadcrumbItem { Label = GetCategory(blogPost.Tags), Url = $"/category/{GetSlug(GetCategory(blogPost.Tags))}" },
                    new BlogBreadcrumbItem { Label = blogPost.Title, Url = "" }
                };

                // Load related posts (other recent posts)
                var allPosts = await BlogService.GetPublishedPostsAsync(4, 0);
                relatedPosts = allPosts
                    .Where(p => p.PostID != blogPost.PostID)
                    .Take(3)
                    .ToList();

                // Load series navigation if post is part of a series
                if (blogPost.SeriesId.HasValue)
                {
                    seriesNavigation = await SeriesService.GetSeriesNavigationAsync(blogPost.PostID);
                }
                else
                {
                    seriesNavigation = null;
                }

                await LoadCommentsAsync();
            }
        }
        catch
        {
            notFound = true;
        }

        if (notFound)
        {
            // REQ-UI-058 — this route MATCHED, so nothing downstream will 404 for us: without
            // these two calls an unknown slug answered HTTP 200 while rendering the not-found panel
            // below, and a search engine indexes that as a live page. NavigationManager.NotFound()
            // is the framework's own signal: on the static pass it sets HTTP 404, and the Router's
            // NotFoundPage (Routes.razor) renders the site's 404 screen in the same pass, so the
            // visitor gets a real status AND a real page. Apply() then switches off the status-code
            // page middleware, which would otherwise re-execute a request that has already
            // rendered and fail with 'RemoteNavigationManager already initialized' (measured
            // 2026-08-10). Both are no-ops on the interactive pass, where there is no request.
            Navigation.NotFound();
            BlogUI.Common.NotFoundResponse.Apply(HttpContextAccessor?.HttpContext);
        }
        else if (blogPost != null)
        {
            await TrackVisitAndReadCountsAsync();
        }

        isLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Counts this visit against the post and reads back the figures shown in the byline.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> This is the call site REQ-FN-034 was missing — without it the
    /// tracker, the repository and every analytics panel downstream are dead code. Counting is
    /// attempted on every render pass and is nevertheless safe from the prerender double-count trap
    /// twice over: the tracker can only attribute a view while an HTTP request is in flight, which
    /// on an interactively rendered Blazor page is the prerender pass alone, and the repository's
    /// conditional insert would refuse a second row for the same visitor and post anyway. The local
    /// guard adds a third, cheaper stop for the re-renders inside one instance — moving between the
    /// pages of a paginated article is still one view of one article.</para>
    /// <para><b>[REQ-NFR-034] Neither call touches PostViews any more.</b> This method used to be
    /// two database round trips on the critical path of every article render: an INSERT the reader
    /// waited for, and a <c>COUNT(*)</c> + <c>COUNT(DISTINCT VisitorHash)</c> aggregate whose plan
    /// was a sequential scan of a table that grows forever. Now the tracker queues the view and
    /// returns without any I/O, and the count is a primary-key lookup of one maintained rollup row.
    /// The read is the only database call left here, and its cost no longer depends on how popular
    /// the post is.</para>
    /// <para><b>What that changes on screen:</b> the byline shows the count as it stood when the
    /// reader arrived, because the write is still in the queue when the figure is read. On an
    /// interactively rendered page the second (circuit) pass re-reads it and usually picks the new
    /// visit up; either way the number is right within a moment and no reader waits on a write to
    /// see the article.</para>
    /// <para><b>Flow:</b> queue the visit unless this instance already counted this post → read the
    /// post's total and unique views for the byline.</para>
    /// <para><b>Side Effects:</b> May queue one view for background writing; replaces
    /// <c>viewCounts</c>. Neither call throws — analytics never costs a reader the article — so no
    /// guard is needed around them.</para>
    /// </remarks>
    /// <returns>A task that completes when the byline figures are current.</returns>
    private async Task TrackVisitAndReadCountsAsync()
    {
        if (trackedPostId != blogPost.PostID)
        {
            trackedPostId = blogPost.PostID;
            await PostViewTracker.TrackCurrentVisitAsync(blogPost.PostID);
        }

        viewCounts = await AnalyticsService.GetPostViewCountsAsync(blogPost.PostID);
    }

    /// <summary>
    /// Loads the publicly visible comment thread for the current post.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> <c>CommentSvc.GetCommentsByPostIdAsync</c> reads through a
    /// repository query that filters on the Approved moderation status, so a comment that has
    /// not been email-confirmed AND approved can never reach this page. This is also the
    /// callback the comment form fires after a successful submission — the newly written
    /// comment deliberately does NOT appear.</para>
    /// <para><b>Flow:</b> await the approved thread, re-render.</para>
    /// <para><b>Side Effects:</b> Replaces <c>comments</c>.</para>
    /// <para><b>[REQ-NFR-026] stage 3:</b> the async twin is awaited rather than the blocking
    /// member being called. This is a public article route, so every synchronous read here parked
    /// a thread-pool thread for the whole round trip.</para>
    /// </remarks>
    /// <returns>A task that completes when the thread has been read and rendered.</returns>
    private async Task LoadCommentsAsync()
    {
        if (blogPost == null)
        {
            comments = new List<BlogModels.BlogComment>();
            return;
        }

        var thread = await CommentService.GetCommentsByPostIdAsync(blogPost.PostID);
        comments = thread?.ToList() ?? new List<BlogModels.BlogComment>();
        StateHasChanged();
    }

    /// <summary>
    /// Counts every visible comment, replies included, for the section heading.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> The heading counts what a reader can actually see, so
    /// replies count towards the total.</para>
    /// <para><b>Side Effects:</b> None.</para>
    /// </remarks>
    /// <returns>The number of approved comments and replies.</returns>
    private int GetCommentTotal()
    {
        if (comments == null)
            return 0;

        return comments.Count + comments.Sum(c => c.Replies?.Count ?? 0);
    }

    /// <summary>
    /// Loads the pagination word count setting from local storage.
    /// </summary>
    private async Task LoadPaginationSetting()
    {
        try
        {
            var storedWordCount = await LocalStorage.GetItemAsync<int?>(PaginationWordCountKey);
            if (storedWordCount.HasValue && storedWordCount.Value > 0)
            {
                paginationWordCount = storedWordCount.Value;
            }
        }
        catch
        {
            // Use default if local storage fails
            paginationWordCount = 500;
        }
    }

    /// <summary>
    /// Splits content into pages based on word count threshold.
    /// </summary>
    private void PaginateContent(string content)
    {
        contentPages.Clear();

        if (string.IsNullOrWhiteSpace(content) || paginationWordCount <= 0)
        {
            contentPages.Add(content ?? string.Empty);
            totalPages = 1;
            return;
        }

        // Count total words
        var words = content.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries);
        var totalWordCount = words.Length;

        if (totalWordCount <= paginationWordCount)
        {
            contentPages.Add(content);
            totalPages = 1;
            return;
        }

        // Split content by paragraphs to avoid breaking mid-sentence
        var paragraphs = content.Split(new[] { "\n\n", "\r\n\r\n" }, StringSplitOptions.None);
        var currentPageContent = new System.Text.StringBuilder();
        var currentWordCount = 0;

        foreach (var paragraph in paragraphs)
        {
            var paragraphWords = paragraph.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;

            // If adding this paragraph would exceed the limit, start a new page
            if (currentWordCount > 0 && currentWordCount + paragraphWords > paginationWordCount)
            {
                contentPages.Add(currentPageContent.ToString().Trim());
                currentPageContent.Clear();
                currentWordCount = 0;
            }

            currentPageContent.AppendLine(paragraph);
            currentPageContent.AppendLine();
            currentWordCount += paragraphWords;
        }

        // Add the last page if there's content
        if (currentPageContent.Length > 0)
        {
            contentPages.Add(currentPageContent.ToString().Trim());
        }

        totalPages = contentPages.Count;
        if (totalPages == 0)
        {
            contentPages.Add(content);
            totalPages = 1;
        }
    }

    /// <summary>
    /// Gets the content for the current page.
    /// </summary>
    private string GetPaginatedContent()
    {
        if (contentPages.Count == 0)
        {
            return RenderContent(blogPost?.PostContent ?? string.Empty);
        }

        var pageIndex = currentPage - 1;
        if (pageIndex < 0) pageIndex = 0;
        if (pageIndex >= contentPages.Count) pageIndex = contentPages.Count - 1;

        return RenderContent(contentPages[pageIndex]);
    }

    /// <summary>
    /// Gets the first tag as category, or "General".
    /// </summary>
    private string GetCategory(string tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return "General";

        var firstTag = tags.Split(',').FirstOrDefault()?.Trim();
        return string.IsNullOrEmpty(firstTag) ? "General" : firstTag;
    }

    /// <summary>
    /// Gets all tags as a list.
    /// </summary>
    private List<string> GetTags(string tags)
    {
        if (string.IsNullOrWhiteSpace(tags))
            return new List<string>();

        return tags.Split(',')
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrEmpty(t))
            .ToList();
    }

    /// <summary>
    /// Creates a URL-friendly slug from text.
    /// </summary>
    private string GetSlug(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        return text.ToLowerInvariant()
            .Replace(" ", "-")
            .Replace("#", "sharp");
    }

    /// <summary>
    /// Builds up to two uppercase initials for the author avatar fallback.
    /// </summary>
    /// <param name="name">Author display name.</param>
    /// <returns>Initials, or a question mark when the name is empty.</returns>
    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = parts.Take(2).Select(p => char.ToUpperInvariant(p[0]));
        return string.Concat(initials);
    }

    /// <summary>
    /// Gets reading time from content.
    /// </summary>
    private string GetReadingTime(string content)
    {
        return BlogEngine.Common.ReadingTimeCalculator.Calculate(content);
    }

    /// <summary>
    /// Renders Markdown content to HTML using Markdig.
    /// </summary>
    /// <remarks>
    /// <para><b>[REQ-UI-007 / TR-059] The output is no longer post-processed.</b> A table cannot
    /// shrink below the width of its widest row, so a three-column markdown table is around 420px
    /// wide and used to push the whole 390px page sideways by 46px. This method therefore used to
    /// rewrite Markdig's HTML string, wrapping every <c>&lt;table&gt;</c> in a scroll container,
    /// because the markdown body arrives as one opaque blob and a stylesheet rule alone could not
    /// introduce the extra scrolling box a table needs. TrBlazeUI 2.0.2 ships <c>Prose</c>, whose
    /// <c>[data-slot="prose"]</c> rules give tables, <c>&lt;pre&gt;</c> blocks, images and iframes
    /// their own overflow context, so the markup the reader sees is now Markdig's own.</para>
    /// </remarks>
    private string RenderContent(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "<p>No content available.</p>";

        return MarkdownRenderer.ToHtml(content);
    }
}

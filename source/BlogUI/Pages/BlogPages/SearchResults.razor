@*
    SearchResults.razor
    Purpose: Search results page with search box, filters, and result cards.
    Displays search input, category/date/sort filters, and matching posts.

    REQ-UI-048 — migrated from Microsoft Fluent UI to TrBlazeUI.
    REQ-UI-041/042 — author names render as plain text.

    Dependencies: StarRating, BlogPagination components
    Layout: Uses MainLayout (with sidebar for popular searches)
*@

@page "/search"
@layout MainLayout
@inject NavigationManager Navigation
@inject BlogEngine.Services.BlogSvc BlogSvc
@inject BlogEngine.Services.CategorySvc CategorySvc

<PageTitle>@(string.IsNullOrWhiteSpace(searchQuery) ? "Search · TechieBlog" : $"Search: {searchQuery} · TechieBlog")</PageTitle>

@* Search Header *@
<header class="my-6 flex flex-col gap-4">
    <TypographyH1>Search</TypographyH1>

    <Card>
        <CardContent Class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center">
            <Input Type="InputType.Search"
                   Placeholder="Search posts..."
                   Class="flex-1"
                   @bind-Value="searchQuery"
                   @onkeydown="HandleSearchKeyDown"
                   data-testid="search-input" />
            <Button OnClick="DoSearch" data-testid="search-submit">
                <LucideIcon Name="search" Size="16" />
                Search
            </Button>
        </CardContent>
    </Card>

    @* Search Filters *@
    <div class="flex flex-wrap items-center gap-3" data-testid="search-filters">
        <Select TValue="string" @bind-Value="categoryFilter" Class="w-52">
            <SelectTrigger data-testid="category-filter">
                <SelectValue Placeholder="All Categories" />
            </SelectTrigger>
            <SelectContent>
                <SelectItem TValue="string" Value="@("")" Text="All Categories">All Categories</SelectItem>
                @foreach (var category in categories)
                {
                    <SelectItem TValue="string" Value="@category.Slug" Text="@category.CategoryName">@category.CategoryName</SelectItem>
                }
            </SelectContent>
        </Select>

        <Select TValue="string" @bind-Value="dateFilter" Class="w-44">
            <SelectTrigger data-testid="date-filter">
                <SelectValue Placeholder="Any Date" />
            </SelectTrigger>
            <SelectContent>
                <SelectItem TValue="string" Value="@("")" Text="Any Date">Any Date</SelectItem>
                <SelectItem TValue="string" Value="@("week")" Text="Past Week">Past Week</SelectItem>
                <SelectItem TValue="string" Value="@("month")" Text="Past Month">Past Month</SelectItem>
                <SelectItem TValue="string" Value="@("year")" Text="Past Year">Past Year</SelectItem>
            </SelectContent>
        </Select>

        <Select TValue="string" @bind-Value="sortBy" Class="w-52">
            <SelectTrigger data-testid="sort-filter">
                <SelectValue Placeholder="Sort by Relevance" />
            </SelectTrigger>
            <SelectContent>
                <SelectItem TValue="string" Value="@("relevance")" Text="Sort by Relevance">Sort by Relevance</SelectItem>
                <SelectItem TValue="string" Value="@("date")" Text="Sort by Date">Sort by Date</SelectItem>
                <SelectItem TValue="string" Value="@("views")" Text="Sort by Views">Sort by Views</SelectItem>
            </SelectContent>
        </Select>
    </div>
</header>

@if (hasSearched)
{
    @if (searchResults.Count == 0)
    {
        <Empty Title="@($"No results for \"{displayQuery}\"")"
               Description="Try a different term or clear the filters."
               Class="py-12"
               data-testid="search-empty">
            <Icon><LucideIcon Name="search" Size="48" /></Icon>
            <ChildContent>
                <Button Variant="ButtonVariant.Outline" OnClick="ClearFilters" data-testid="search-clear-filters">Clear filters</Button>
            </ChildContent>
        </Empty>
    }
    else
    {
        @* Results Count *@
        <p class="mb-4 text-sm text-muted-foreground" data-testid="search-results-count">
            Showing <strong class="text-foreground">@searchResults.Count results</strong> for "<strong class="text-foreground">@displayQuery</strong>"
        </p>

        @* Search Results *@
        <div class="flex flex-col gap-4" data-testid="search-results">
            @foreach (var result in searchResults)
            {
                <Card data-testid="search-result">
                    <CardContent Class="flex flex-col gap-4 p-4 sm:flex-row">
                        <div class="h-28 w-full shrink-0 overflow-hidden rounded-md bg-muted sm:w-40">
                            <div class="flex h-full w-full items-center justify-center text-xs text-muted-foreground">Image</div>
                        </div>
                        <div class="flex flex-1 flex-col gap-2">
                            <div>
                                <Badge Variant="BadgeVariant.Secondary" data-testid="search-result-category">@result.Category</Badge>
                            </div>
                            <h3 class="text-lg font-semibold leading-snug">
                                <a href="/post/@result.Slug"
                                   class="text-foreground no-underline hover:text-primary hover:underline"
                                   data-testid="search-result-title">@result.Title</a>
                            </h3>
                            <p class="text-sm text-muted-foreground" data-testid="search-result-excerpt">
                                @((MarkupString)result.ExcerptWithHighlights)
                            </p>
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
                                <span class="text-muted-foreground" data-testid="search-result-author">@result.Author</span>
                                <span data-testid="search-result-date">@result.Date</span>
                                <span data-testid="search-result-readtime">@result.ReadTime</span>
                                @if (result.Rating > 0)
                                {
                                    <StarRating Value="@result.Rating" />
                                }
                            </div>
                        </div>
                    </CardContent>
                </Card>
            }
        </div>

        @* Pagination *@
        @if (TotalPages > 1)
        {
            <div class="mt-8">
                <BlogPagination CurrentPage="@currentPage" TotalPages="@TotalPages" OnPageChanged="HandlePageChanged" />
            </div>
        }
    }
}
else
{
    <p class="py-8 text-center text-muted-foreground" data-testid="search-hint">
        Enter a search term to find blog posts.
    </p>
}

@code {
    /// <summary>
    /// Search query parameter from URL.
    /// </summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    private string searchQuery = string.Empty;
    private string displayQuery = string.Empty;
    private string categoryFilter = string.Empty;
    private string dateFilter = string.Empty;
    private string sortBy = "relevance";
    private bool hasSearched = false;
    private List<SearchResult> searchResults = new();
    private List<BlogModels.Category> categories = new();
    private int totalResults = 0;
    private int currentPage = 1;
    private const int PageSize = 10;

    /// <summary>
    /// Initialize component and perform search if query provided.
    /// </summary>
    protected override void OnInitialized()
    {
        // Load categories for the filter dropdown
        categories = CategorySvc.GetAllCategories().ToList();

        if (!string.IsNullOrEmpty(Query))
        {
            searchQuery = Query;
            PerformSearch();
        }
    }

    /// <summary>
    /// Handle Enter key press to trigger search.
    /// </summary>
    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            DoSearch();
        }
    }

    /// <summary>
    /// Navigate to search results with query.
    /// </summary>
    private void DoSearch()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            currentPage = 1;
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}");
            PerformSearch();
        }
    }

    /// <summary>
    /// Resets the category, date and sort filters and re-runs the current query.
    /// </summary>
    private void ClearFilters()
    {
        categoryFilter = string.Empty;
        dateFilter = string.Empty;
        sortBy = "relevance";

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            PerformSearch();
        }
    }

    /// <summary>
    /// Perform search against the database.
    /// </summary>
    private void PerformSearch()
    {
        hasSearched = true;
        displayQuery = searchQuery;

        // Get total count for pagination
        totalResults = BlogSvc.GetSearchResultCount(searchQuery);

        // Get paginated results from database
        int offset = (currentPage - 1) * PageSize;
        var posts = BlogSvc.SearchPosts(searchQuery, PageSize, offset);

        // Convert BlogPost to SearchResult with highlighted excerpts
        searchResults = posts.Select(post => new SearchResult
        {
            Category = "Blog", // Category name would require a join - simplified for now
            Title = post.Title ?? string.Empty,
            ExcerptWithHighlights = HighlightSearchTerms(post.Abstract ?? string.Empty, searchQuery),
            Slug = post.Slug ?? string.Empty,
            Author = post.BlogWriter ?? "Unknown",
            Date = post.CreatedOn.ToString("MMM dd, yyyy"),
            ReadTime = EstimateReadTime(post.PostContent),
            Rating = 0
        }).ToList();
    }

    /// <summary>
    /// Highlights search terms in the excerpt with mark tags, HTML-encoding everything else.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> The result is rendered through a <c>MarkupString</c>, so the
    /// post abstract — which is author-supplied and may contain raw HTML — must be HTML-encoded
    /// before the <c>&lt;mark&gt;</c> tags are woven in. Matches are located against the raw
    /// excerpt and each segment is encoded on its way into the output, so the only live markup
    /// that can appear is the <c>&lt;mark&gt;</c> pair this method emits itself
    /// (REQ-NFR-006 / BRD-83).</para>
    /// <para><b>Side Effects:</b> None.</para>
    /// </remarks>
    /// <param name="text">The raw post abstract.</param>
    /// <param name="query">The visitor's search query.</param>
    /// <returns>Encoded HTML safe to render as a <c>MarkupString</c>.</returns>
    private string HighlightSearchTerms(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        // Truncate text to reasonable excerpt length
        var excerpt = text.Length > 200 ? text.Substring(0, 200) + "..." : text;

        var words = (query ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(word => word.Length >= 2)
            .Select(System.Text.RegularExpressions.Regex.Escape)
            .ToArray();

        if (words.Length == 0)
            return System.Net.WebUtility.HtmlEncode(excerpt);

        var matches = System.Text.RegularExpressions.Regex.Matches(
            excerpt,
            string.Join("|", words),
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        var builder = new System.Text.StringBuilder();
        var cursor = 0;

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            if (match.Index < cursor)
                continue;

            builder.Append(System.Net.WebUtility.HtmlEncode(excerpt.Substring(cursor, match.Index - cursor)));
            builder.Append("<mark>");
            builder.Append(System.Net.WebUtility.HtmlEncode(match.Value));
            builder.Append("</mark>");
            cursor = match.Index + match.Length;
        }

        builder.Append(System.Net.WebUtility.HtmlEncode(excerpt.Substring(cursor)));

        return builder.ToString();
    }

    /// <summary>
    /// Estimates read time based on content length.
    /// </summary>
    private string EstimateReadTime(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "1 min read";

        // Average reading speed: 200 words per minute
        var wordCount = content.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
        var minutes = Math.Max(1, (int)Math.Ceiling(wordCount / 200.0));
        return $"{minutes} min read";
    }

    /// <summary>
    /// Handle page change for pagination.
    /// </summary>
    private void HandlePageChanged(int page)
    {
        currentPage = page;
        PerformSearch();
    }

    /// <summary>
    /// Calculate total pages for pagination.
    /// </summary>
    private int TotalPages => (int)Math.Ceiling((double)totalResults / PageSize);

    private class SearchResult
    {
        public string Category { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string ExcerptWithHighlights { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string Author { get; set; } = string.Empty;
        public string Date { get; set; } = string.Empty;
        public string ReadTime { get; set; } = string.Empty;
        public int Rating { get; set; }
    }
}

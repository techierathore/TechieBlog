@*
    AuthorsPage.razor
    Purpose: Public page listing all authors who have published articles.
    Shows each author with their article count in a list format.

    Dependencies: AuthorListItem component, BlogUserRepo, BlogSvc
    Layout: Uses MainLayout (public pages)
*@

@page "/authors"
@layout MainLayout

<div class="authors-page">
    <h1>Our Authors</h1>
    <p class="page-description">
        Meet the talented writers who share their knowledge and insights on our blog.
    </p>

    @if (isLoading)
    {
        <div class="loading-container" style="display: flex; justify-content: center; padding: 48px;">
            <FluentProgressRing />
            <span style="margin-left: 12px;">Loading authors...</span>
        </div>
    }
    else if (authors == null || authors.Count == 0)
    {
        <div class="empty-state" style="text-align: center; padding: 48px;">
            <FluentIcon Value="@(new Icons.Regular.Size48.People())" />
            <h2>No Authors Yet</h2>
            <p>Check back soon for content from our authors!</p>
        </div>
    }
    else
    {
        <div class="authors-list">
            @foreach (var author in authors)
            {
                <BlogUI.Components.Author.AuthorListItem
                    Author="@author"
                    ArticleCount="@GetArticleCount(author.UserId)" />
            }
        </div>
    }
</div>

@*
    Home.razor
    Purpose: Public landing page for TechieBlog — a portfolio-style home built
    entirely from the site owner's resume data (BRD-30 revised, REQ-UI-049).

    Section order follows docs/mockups/01-home.html:
        hero -> headline stats -> about summary -> featured post -> latest
        articles -> contact

    The hero and contact blocks REUSE the resume components (<ResumeHero>,
    <ResumeContact>) rather than duplicating their markup; the three home-only
    sections live in Components/Home. The portfolio redesign replaced the old
    recent-post grid layout (REQ-UI-006) but NOT the featured post itself:
    REQ-FN-020 / BRD-31 require the newest published article to lead the page,
    so the featured block sits above the latest-articles grid.

    BRD-93 / REQ-UI-050 — this page exposes no login link and no user menu.
    REQ-UI-048 — TrBlazeUI throughout.

    Dependencies: ResumeHero, ResumeContact, HomeStats, HomeAbout,
                  HomeLatestArticles, IBlogUserRepo, IUserStatsRepo, BlogSvc
    Layout: FullWidthLayout (portfolio landing — no blog sidebar)
    Route: /
*@

@page "/"
@layout FullWidthLayout
@using BlogModels.Models
@using BlogUI.Components.Home
@using BlogUI.Components.Resume

<PageTitle>TechieBlog — notes on .NET, Blazor and shipping software</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center gap-3 py-16" data-testid="home-loading">
        <Spinner Size="SpinnerSize.Large" />
        <span class="text-muted-foreground">Loading...</span>
    </div>
}
else if (siteOwner is null)
{
    <Empty Title="Site not configured yet"
           Description="No site owner has been set up, so the landing page has nothing to show."
           data-testid="home-unconfigured">
        <Icon><LucideIcon Name="user-x" Size="48" /></Icon>
        <ChildContent>
            <Button Href="/search" Variant="ButtonVariant.Outline" data-testid="home-unconfigured-search">Browse articles</Button>
        </ChildContent>
    </Empty>
}
else
{
    <div class="flex flex-col gap-8" data-testid="home-page">

        @* Hero — photo, "Hi, I'm {name}", title, tagline, CTAs and social links. *@
        <ResumeHero User="@siteOwner" />

        @* Headline statistics from the owner's UserStats rows. *@
        <HomeStats Stats="@ownerStats" />

        @* Short about summary; the full story stays on /resume. *@
        <HomeAbout Summary="@siteOwner.ProfileDescription" />

        @* REQ-FN-020 / BRD-31 — the featured post: the newest published article, given its own
           full-width block above the grid so the landing page always leads with one piece of
           writing. Selection is BlogSvc.GetFeaturedPost(); nothing is curated by hand. *@
        @if (featuredPost is not null)
        {
            <section class="py-4" data-testid="home-featured">
                <div class="mb-3 flex items-center gap-2">
                    <Badge data-testid="home-featured-badge">Featured</Badge>
                    <span class="text-sm text-muted-foreground">Latest from the blog</span>
                </div>

                <Card data-testid="home-featured-post">
                    <CardContent Class="flex flex-col gap-3 p-6">
                        <h2 class="text-2xl font-bold leading-snug">
                            <a href="/post/@featuredPost.Slug"
                               class="text-foreground no-underline hover:text-primary hover:underline"
                               data-testid="home-featured-title">@featuredPost.Title</a>
                        </h2>
                        <p class="text-muted-foreground" data-testid="home-featured-excerpt">@FeaturedExcerpt</p>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
                            <span data-testid="home-featured-author">
                                By @(string.IsNullOrWhiteSpace(featuredPost.BlogWriter) ? "Unknown" : featuredPost.BlogWriter)
                            </span>
                            @* [REQ-FN-057] Dated by PublishedOn, falling back to CreatedOn only for a
                               legacy row that never recorded one. The featured projection selects
                               PublishedOn precisely so this card can show when the post went live
                               rather than when its draft was started — reading CreatedOn here made
                               widening that projection pointless on the one surface it was widened for. *@
                            <span data-testid="home-featured-date">@((featuredPost.PublishedOn ?? featuredPost.CreatedOn).ToString("MMM dd, yyyy"))</span>
                            <span data-testid="home-featured-readtime">
                                @BlogEngine.Common.ReadingTimeCalculator.Calculate(featuredPost.PostContent ?? string.Empty)
                            </span>
                        </div>
                    </CardContent>
                </Card>
            </section>
        }

        @* Most recent published posts, linking to the real articles. *@
        <HomeLatestArticles Posts="@latestPosts" IsLoading="false" />

        @* Contact block — location plus the LinkedIn call to action (no email, no phone). *@
        <ResumeContact User="@siteOwner" />
    </div>
}

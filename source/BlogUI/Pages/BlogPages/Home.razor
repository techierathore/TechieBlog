@*
    Home.razor
    Purpose: Public landing page for TechieBlog — a portfolio-style home built
    entirely from the site owner's resume data (BRD-30 revised, REQ-UI-049).

    Section order follows docs/mockups/01-home.html:
        hero -> headline stats -> about summary -> latest articles -> contact

    The hero and contact blocks REUSE the resume components (<ResumeHero>,
    <ResumeContact>) rather than duplicating their markup; the three home-only
    sections live in Components/Home. Supersedes the featured-post + recent-grid
    home (REQ-UI-006).

    BRD-93 / REQ-UI-050 — this page exposes no login link and no user menu.
    REQ-UI-048 — TrBlazeUI throughout.

    Dependencies: ResumeHero, ResumeContact, HomeStats, HomeAbout,
                  HomeLatestArticles, IBlogUserRepo, IUserStatsRepo, BlogSvc
    Layout: FullWidthLayout (portfolio landing — no blog sidebar)
    Route: /
*@

@page "/"
@layout FullWidthLayout
@using BlogModels.Models
@using BlogUI.Components.Home
@using BlogUI.Components.Resume

<PageTitle>TechieBlog — notes on .NET, Blazor and shipping software</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center gap-3 py-16" data-testid="home-loading">
        <Spinner Size="SpinnerSize.Large" />
        <span class="text-muted-foreground">Loading...</span>
    </div>
}
else if (siteOwner is null)
{
    <Empty Title="Site not configured yet"
           Description="No site owner has been set up, so the landing page has nothing to show."
           data-testid="home-unconfigured">
        <Icon><LucideIcon Name="user-x" Size="48" /></Icon>
        <ChildContent>
            <Button Href="/search" Variant="ButtonVariant.Outline" data-testid="home-unconfigured-search">Browse articles</Button>
        </ChildContent>
    </Empty>
}
else
{
    <div class="flex flex-col gap-8" data-testid="home-page">

        @* Hero — photo, "Hi, I'm {name}", title, tagline, CTAs and social links. *@
        <ResumeHero User="@siteOwner" />

        @* Headline statistics from the owner's UserStats rows. *@
        <HomeStats Stats="@ownerStats" />

        @* Short about summary; the full story stays on /resume. *@
        <HomeAbout Summary="@siteOwner.ProfileDescription" />

        @* Most recent published posts, linking to the real articles. *@
        <HomeLatestArticles Posts="@latestPosts" IsLoading="false" />

        @* Contact block — email, phone, location, LinkedIn. *@
        <ResumeContact User="@siteOwner" />
    </div>
}

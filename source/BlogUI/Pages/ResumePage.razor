@*
    ResumePage.razor
    Purpose: Public resume page displaying the site owner's professional profile —
    sticky in-page section nav, hero, experience timeline, skills, awards, contact.

    REQ-UI-036 / REQ-UI-048 — TrBlazeUI (Button / Card / Separator / Spinner / Empty).
    TrBlazeUI 2.0.1 has no scrollspy component (gap TR-003), so the section nav is a
    plain anchor chip row built from ghost buttons.

    Dependencies: IBlogUserRepo, the Resume section components, wwwroot/css/resume.css
    Layout: FullWidthLayout (no blog sidebar)
    Route: /resume
*@

@page "/resume"
@layout FullWidthLayout
@using BlogModels.Models
@using BlogUI.Components.Resume

@* REQ-NFR-007 / WCAG 2.4.2 Page Titled. *@
<PageTitle>Resume · TechieBlog</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center gap-3 py-20" data-testid="resume-loading">
        <Spinner Size="SpinnerSize.Large" />
        <span class="text-muted-foreground">Loading resume...</span>
    </div>
}
else if (siteOwner is null)
{
    <Empty Title="Resume not available"
           Description="The site owner's resume information is not currently available."
           data-testid="resume-unavailable">
        <Icon><LucideIcon Name="user-x" Size="48" /></Icon>
        <ChildContent>
            <Button Href="/" data-testid="resume-home-link">Return Home</Button>
        </ChildContent>
    </Empty>
}
else if (!siteOwner.ResumeEnabled)
{
    <Empty Title="Resume not published"
           Description="The resume feature is currently disabled."
           data-testid="resume-disabled">
        <Icon><LucideIcon Name="file-text" Size="48" /></Icon>
        <ChildContent>
            <Button Href="/" data-testid="resume-home-link">Return Home</Button>
        </ChildContent>
    </Empty>
}
else
{
    <div class="resume-page" data-testid="resume-page">

        @* Sticky in-page section nav (anchor chip row — TR-003 fallback) *@
        <nav class="resume-nav" aria-label="Resume sections" data-testid="resume-section-nav">
            <Button Href="#about" Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" data-testid="nav-about">About</Button>
            <Button Href="#experience" Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" data-testid="nav-experience">Experience</Button>
            <Button Href="#skills" Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" data-testid="nav-skills">Skills</Button>
            <Button Href="#awards" Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" data-testid="nav-awards">Awards</Button>
            <Button Href="#contact" Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" data-testid="nav-contact">Contact</Button>
        </nav>

        <ResumeHero User="@siteOwner" />

        <Separator />

        <ResumeStats User="@siteOwner" UserId="@siteOwner.UserId" />

        <ResumeExperience UserId="@siteOwner.UserId" />

        <ResumeSkills UserId="@siteOwner.UserId" />

        <ResumeAwards UserId="@siteOwner.UserId" />

        <ResumeContact User="@siteOwner" />
    </div>
}

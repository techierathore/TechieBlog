@*
    Footer.razor
    Purpose: Site-wide footer for the public TechieBlog pages.

    REQ-UI-048 — rebuilt on TrBlazeUI utility classes.
    REQ-UI-041/042 — the "Authors" link is gone with the author-browsing screens.
    BRD-93 — no sign-in affordance here either.
*@

<footer class="mt-16 border-t border-border bg-background" data-testid="public-footer">
    <div class="mx-auto flex w-full max-w-7xl flex-col items-center gap-4 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:justify-between sm:px-6">

        <p class="m-0">&copy; @DateTime.Now.Year TechieBlog. All rights reserved.</p>

        <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
            <a href="/about" class="text-muted-foreground no-underline hover:text-foreground" data-testid="footer-about">About</a>
            <a href="/resume" class="text-muted-foreground no-underline hover:text-foreground" data-testid="footer-resume">Resume</a>
            <a href="/categories" class="text-muted-foreground no-underline hover:text-foreground" data-testid="footer-categories">Categories</a>
            <a href="/series" class="text-muted-foreground no-underline hover:text-foreground" data-testid="footer-series">Series</a>
            <a href="/rss" class="inline-flex items-center gap-1.5 text-muted-foreground no-underline hover:text-foreground" data-testid="footer-rss">
                <LucideIcon Name="rss" Size="14" />
                <span>RSS</span>
            </a>
        </nav>
    </div>
</footer>

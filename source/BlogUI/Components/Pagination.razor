@*
    Pagination.razor
    Purpose: Pagination navigation component for multi-page content.
    Displays previous/next buttons and page number buttons.

    Dependencies: None
    Usage: Used in archive pages, search results, author profiles
*@

<nav class="pagination">
    <button class="pagination__btn" disabled="@(CurrentPage <= 1)" @onclick="GoToPrevious">
        &laquo;
    </button>

    @for (int i = 1; i <= TotalPages; i++)
    {
        var pageNum = i;
        <button class="pagination__btn @(pageNum == CurrentPage ? "pagination__btn--active" : "")"
                @onclick="@(() => GoToPage(pageNum))">
            @pageNum
        </button>
    }

    <button class="pagination__btn" disabled="@(CurrentPage >= TotalPages)" @onclick="GoToNext">
        &raquo;
    </button>
</nav>

@code {
    /// <summary>
    /// Current active page number.
    /// </summary>
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    /// <summary>
    /// Total number of pages.
    /// </summary>
    [Parameter]
    public int TotalPages { get; set; } = 1;

    /// <summary>
    /// Callback when page changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>
    /// Navigate to previous page.
    /// </summary>
    private async Task GoToPrevious()
    {
        if (CurrentPage > 1)
        {
            await GoToPage(CurrentPage - 1);
        }
    }

    /// <summary>
    /// Navigate to next page.
    /// </summary>
    private async Task GoToNext()
    {
        if (CurrentPage < TotalPages)
        {
            await GoToPage(CurrentPage + 1);
        }
    }

    /// <summary>
    /// Navigate to specific page.
    /// </summary>
    private async Task GoToPage(int page)
    {
        if (page != CurrentPage && page >= 1 && page <= TotalPages)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }
}

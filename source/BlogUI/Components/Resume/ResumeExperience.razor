@*
    ResumeExperience.razor
    Purpose: Work experience shown as a reverse-chronological vertical timeline —
    company logo, role, company link, date range and a markdown description.

    REQ-UI-036 / REQ-UI-048 — TrBlazeUI (Card / Badge / Spinner / LucideIcon).
    TrBlazeUI 2.0.1 has no Timeline component (gap TR-004), so the rail and dots
    come from the token-driven .resume-timeline rules in wwwroot/css/resume.css.

    Dependencies: IUserEventRepo for data access, MarkdownRenderer for descriptions.
*@

@using BlogModels
@inject IUserEventRepo EventRepo
@inject BlogEngine.Common.MarkdownRenderer MarkdownRenderer

@if (isLoading)
{
    <div class="flex items-center gap-2 text-muted-foreground" data-testid="experience-loading">
        <Spinner Size="SpinnerSize.Small" />
        <span class="text-sm">Loading experience...</span>
    </div>
}
else if (experiences is not null && experiences.Count > 0)
{
    <Card id="experience" Class="resume-section" data-testid="experience-section">
        <CardHeader>
            <CardTitle Class="text-2xl">Experience</CardTitle>
        </CardHeader>
        <CardContent>
            <div class="resume-timeline" data-testid="experience-list">
                @foreach (var experience in experiences)
                {
                    <div class="resume-timeline-item" data-testid="experience-item">
                        <div class="flex items-start gap-3">
                            @if (!string.IsNullOrWhiteSpace(experience.LogoIconPath))
                            {
                                <img src="@experience.LogoIconPath"
                                     alt="@experience.EventTitle logo"
                                     class="resume-logo" />
                            }
                            else
                            {
                                <span class="resume-logo flex items-center justify-center text-sm font-semibold text-muted-foreground">
                                    @GetInitials(experience.EventTitle)
                                </span>
                            }

                            <div class="min-w-0 flex-1">
                                <div class="font-semibold text-foreground" data-testid="experience-role">
                                    @experience.SessionTitle
                                    @if (!string.IsNullOrWhiteSpace(experience.EventTitle))
                                    {
                                        <span class="text-muted-foreground"> @@ </span>
                                        @* REQ-NFR-007 / WCAG 1.4.1: this company link sits inside the role
                                           line's text block, so it must not be identified by colour alone —
                                           it stays underlined rather than underlining only on hover. *@
                                        @if (!string.IsNullOrWhiteSpace(experience.EventUrl))
                                        {
                                            <a href="@experience.EventUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="text-primary underline"
                                               data-testid="experience-company">@experience.EventTitle</a>
                                        }
                                        else
                                        {
                                            <span class="text-primary" data-testid="experience-company">@experience.EventTitle</span>
                                        }
                                    }
                                </div>
                                <div class="text-sm text-muted-foreground" data-testid="experience-dates">
                                    @FormatDateRange(experience.StartDate, experience.EventDate, experience.IsCurrent)
                                </div>
                            </div>

                            @if (experience.IsCurrent)
                            {
                                <Badge Variant="BadgeVariant.Secondary" data-testid="experience-current">Current</Badge>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(experience.Description))
                        {
                            <div class="markdown-content mt-4 text-sm" data-testid="experience-description">
                                @((MarkupString)RenderDescription(experience.Description))
                            </div>
                        }
                    </div>
                }
            </div>
        </CardContent>
    </Card>
}

@code {
    /// <summary>
    /// The user ID to load experience for.
    /// </summary>
    [Parameter]
    public long UserId { get; set; }

    private List<UserEvent>? experiences;
    private bool isLoading = true;

    /// <summary>
    /// Loads experience events for the specified user.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadExperienceAsync();
    }

    /// <summary>
    /// Reloads experience when the UserId parameter changes.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await LoadExperienceAsync();
    }

    /// <summary>
    /// Fetches all experience events for the user and orders them by EventDate DESC.
    /// </summary>
    private async Task LoadExperienceAsync()
    {
        isLoading = true;

        try
        {
            // Run synchronous repo call on a background thread
            var allEvents = await Task.Run(() => EventRepo.GetAllById(UserId));

            // Filter for Experience type and order by EventDate descending (newest first)
            experiences = allEvents
                .Where(e => e.EventType?.Equals("Experience", StringComparison.OrdinalIgnoreCase) == true)
                .OrderByDescending(e => e.EventDate)
                .ToList();
        }
        catch (Exception)
        {
            experiences = new List<UserEvent>();
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    /// Formats the date range for display.
    /// Shows "StartDate - Present" if IsCurrent is true, otherwise "StartDate - EventDate".
    /// </summary>
    private string FormatDateRange(DateTime? startDate, DateTime eventDate, bool isCurrent)
    {
        var start = startDate.HasValue ? startDate.Value.ToString("MMM yyyy") : "";
        var end = isCurrent ? "Present" : eventDate.ToString("MMM yyyy");

        if (string.IsNullOrEmpty(start))
        {
            return end;
        }

        return $"{start} - {end}";
    }

    /// <summary>
    /// Gets the initials from a company name, used when no company logo is available.
    /// </summary>
    private string GetInitials(string companyName)
    {
        if (string.IsNullOrWhiteSpace(companyName))
        {
            return "?";
        }

        var words = companyName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2)
        {
            return $"{words[0][0]}{words[1][0]}".ToUpper();
        }

        return companyName.Length >= 2 ? companyName.Substring(0, 2).ToUpper() : companyName.ToUpper();
    }

    /// <summary>
    /// Renders the description as markdown to HTML.
    /// </summary>
    private string RenderDescription(string description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return string.Empty;
        }

        return MarkdownRenderer.ToHtml(description);
    }
}

@*
    ResumeHero.razor
    Purpose: Introduction block for the public Resume page — real profile
    photograph, name, title, tagline, call-to-action buttons and social links.

    REQ-UI-036 / REQ-UI-048 — TrBlazeUI (Avatar / Button / LucideIcon).
    Layout primitives (.resume-hero, .resume-photo) live in wwwroot/css/resume.css.
*@

@using BlogModels.Models

@* The "#about" anchor belongs to ResumeStats (the About block); the hero is the page header. *@
<section id="hero" class="resume-section resume-hero" data-testid="resume-hero">

    @* Profile photograph — a real image; the fallback is a person glyph, never initials. *@
    @if (!string.IsNullOrWhiteSpace(User?.ProfileImagePath))
    {
        <img src="@User.ProfileImagePath"
             alt="@User.FullName"
             class="resume-photo"
             data-testid="resume-photo" />
    }
    else
    {
        <Avatar Size="AvatarSize.ExtraLarge" Class="resume-photo" data-testid="resume-photo">
            <AvatarFallback>
                <LucideIcon Name="user" Size="48" />
            </AvatarFallback>
        </Avatar>
    }

    @*
        The greeting and the name are ONE heading, with the name in the primary colour — this is the
        signature of the hero in both mockups that use it (docs/mockups/01-home.html and 10-resume.html
        are byte-identical here: `<h1>Hi, I'm <span class="accent">Name</span></h1>`, styled
        `.hero h1{font-size:clamp(30px,5vw,46px);font-weight:800}` with `.accent{color:var(--primary)}`).

        It previously rendered as a separate small <p> above a plain 36px black <h1>, which lost both
        the two-tone treatment and most of the scale. Keeping them in one <h1> is also the correct
        document outline: "Hi, I'm" is not a heading of its own, and a screen reader announcing an
        orphan paragraph followed by a bare name reads worse than the single phrase.

        `data-testid="resume-greeting"` is retained on the inner span so existing selectors that
        assert the greeting still resolve.
    *@
    @*
        Sized by a real CSS rule (.resume-name in resume.css), NOT a Tailwind arbitrary value.
        This project consumes TrBlazeUI's PREBUILT stylesheet and runs no Tailwind JIT pass, so a
        class like `text-[clamp(30px,5vw,46px)]` is never generated — it renders as an unknown class,
        contributes nothing, and the heading silently collapses to the inherited font size. That is
        exactly what happened on the first attempt at this fix. Only utilities that already exist in
        the shipped CSS can be used here; anything bespoke belongs in a stylesheet.
    *@
    <h1 class="resume-name text-foreground" data-testid="resume-name">
        <span data-testid="resume-greeting">Hi, I'm</span>
        <span class="text-primary">@User?.FullName</span>
    </h1>

    @if (!string.IsNullOrWhiteSpace(User?.Title))
    {
        <p class="text-xl text-muted-foreground" data-testid="resume-title">@User.Title</p>
    }

    @if (!string.IsNullOrWhiteSpace(User?.Tagline))
    {
        <p class="resume-tagline text-muted-foreground" data-testid="resume-tagline">@User.Tagline</p>
    }

    @* Call to action *@
    <div class="resume-actions flex flex-wrap items-center justify-center gap-3" data-testid="resume-actions">
        @* The contact section publishes LinkedIn, not an email address, so the icon must not
           promise a mailbox that is deliberately no longer there (owner decision, 2026-08-10). *@
        <Button Href="#contact" data-testid="get-in-touch">
            <LucideIcon Name="linkedin" Size="16" />
            Get In Touch
        </Button>

        @if (!string.IsNullOrWhiteSpace(User?.CVFilePath))
        {
            <Button Href="@User.CVFilePath"
                    Variant="ButtonVariant.Outline"
                    download="download"
                    data-testid="download-cv">
                <LucideIcon Name="download" Size="16" />
                Download CV
            </Button>
        }
    </div>

    @* Social links *@
    @if (HasSocialLinks())
    {
        <div class="resume-social flex flex-wrap items-center justify-center gap-2" data-testid="resume-social-links">
            @if (!string.IsNullOrWhiteSpace(User?.LinkedInUrl))
            {
                <Button Href="@User.LinkedInUrl"
                        Target="_blank"
                        rel="noopener noreferrer"
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Icon"
                        AriaLabel="LinkedIn profile"
                        data-testid="social-linkedin">
                    <LucideIcon Name="linkedin" Size="20" />
                </Button>
            }

            @if (!string.IsNullOrWhiteSpace(User?.GitHubUrl))
            {
                <Button Href="@User.GitHubUrl"
                        Target="_blank"
                        rel="noopener noreferrer"
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Icon"
                        AriaLabel="GitHub profile"
                        data-testid="social-github">
                    <LucideIcon Name="github" Size="20" />
                </Button>
            }

            @if (!string.IsNullOrWhiteSpace(User?.TwitterUrl))
            {
                <Button Href="@User.TwitterUrl"
                        Target="_blank"
                        rel="noopener noreferrer"
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Icon"
                        AriaLabel="X (Twitter) profile"
                        data-testid="social-twitter">
                    <LucideIcon Name="twitter" Size="20" />
                </Button>
            }

            @if (!string.IsNullOrWhiteSpace(User?.InstagramUrl))
            {
                <Button Href="@User.InstagramUrl"
                        Target="_blank"
                        rel="noopener noreferrer"
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Icon"
                        AriaLabel="Instagram profile"
                        data-testid="social-instagram">
                    <LucideIcon Name="instagram" Size="20" />
                </Button>
            }
        </div>
    }
</section>

@code {
    /// <summary>
    /// The site owner's user data to display in the hero section.
    /// </summary>
    [Parameter]
    public AppUser User { get; set; }

    /// <summary>
    /// Indicates whether the user has at least one social profile URL configured.
    /// </summary>
    private bool HasSocialLinks()
    {
        if (User is null)
        {
            return false;
        }

        return !string.IsNullOrWhiteSpace(User.LinkedInUrl)
            || !string.IsNullOrWhiteSpace(User.GitHubUrl)
            || !string.IsNullOrWhiteSpace(User.TwitterUrl)
            || !string.IsNullOrWhiteSpace(User.InstagramUrl);
    }
}

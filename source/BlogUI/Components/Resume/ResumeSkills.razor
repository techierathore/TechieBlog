@*
    ResumeSkills.razor
    Purpose: Skills section of the public Resume page — one block per category,
    each skill rendered as a badge chip, ordered by DisplayOrder.

    REQ-UI-036 / REQ-UI-048 — TrBlazeUI (Card / Badge / Spinner).
    Grid primitive (.resume-autogrid) lives in wwwroot/css/resume.css.

    Dependencies: IUserSkillsRepo for data access.
*@

@using BlogModels.Models
@using BlogModels.Interfaces

@if (isLoading)
{
    <div class="flex items-center gap-2 text-muted-foreground" data-testid="skills-loading">
        <Spinner Size="SpinnerSize.Small" />
        <span class="text-sm">Loading skills...</span>
    </div>
}
else if (skillsByCategory is not null && skillsByCategory.Count > 0)
{
    <Card id="skills" Class="resume-section" data-testid="skills-section">
        <CardHeader>
            <CardTitle Class="text-2xl">Skills &amp; Expertise</CardTitle>
        </CardHeader>
        <CardContent>
            <div class="resume-autogrid" data-testid="skills-grid">
                @foreach (var categoryGroup in skillsByCategory)
                {
                    <div class="rounded-lg border border-border bg-card p-4" data-testid="skill-category">
                        <h3 class="mb-3 text-sm font-semibold text-primary" data-testid="skill-category-name">@categoryGroup.Key</h3>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var skill in categoryGroup.Value)
                            {
                                <Badge Variant="BadgeVariant.Secondary" data-testid="skill-badge">@skill.SkillName</Badge>
                            }
                        </div>
                    </div>
                }
            </div>
        </CardContent>
    </Card>
}

@code {
    /// <summary>
    /// The user ID to load skills for.
    /// </summary>
    [Parameter]
    public long UserId { get; set; }

    /// <summary>
    /// Repository for accessing user skills data.
    /// </summary>
    [Inject]
    public IUserSkillsRepo SkillsRepo { get; set; } = default!;

    private Dictionary<string, List<UserSkill>>? skillsByCategory;
    private bool isLoading = true;

    /// <summary>
    /// Loads skills for the specified user and groups them by category.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadSkillsAsync();
    }

    /// <summary>
    /// Reloads skills when the UserId parameter changes.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await LoadSkillsAsync();
    }

    /// <summary>
    /// Fetches all skills for the user and organizes them by category.
    /// Each category's skills are ordered by DisplayOrder.
    /// </summary>
    private async Task LoadSkillsAsync()
    {
        isLoading = true;

        try
        {
            // Run synchronous repo call on a background thread
            var skills = await Task.Run(() => SkillsRepo.GetByUserId(UserId));

            // Group by Category and order each group by DisplayOrder
            skillsByCategory = skills
                .GroupBy(s => s.Category)
                .OrderBy(g => g.Key)
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderBy(s => s.DisplayOrder).ToList()
                );
        }
        catch (Exception)
        {
            skillsByCategory = new Dictionary<string, List<UserSkill>>();
        }
        finally
        {
            isLoading = false;
        }
    }
}

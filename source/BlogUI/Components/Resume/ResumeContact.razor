@*
    ResumeContact.razor
    Purpose: Contact section of the public Resume page — email, phone, location
    and the LinkedIn profile link.

    REQ-UI-036 / REQ-UI-048 — TrBlazeUI (Card / Button / LucideIcon).
    Grid primitive (.resume-autogrid) lives in wwwroot/css/resume.css.
*@

@using BlogModels.Models

@if (HasContactDetails())
{
    <Card id="contact" Class="resume-section" data-testid="contact-section">
        <CardHeader>
            <CardTitle Class="text-2xl">Contact</CardTitle>
            <CardDescription>Reach out — I read every message.</CardDescription>
        </CardHeader>
        <CardContent>
            <div class="resume-autogrid" data-testid="contact-grid">

                @if (!string.IsNullOrWhiteSpace(User?.EmailId))
                {
                    <div class="flex items-center gap-3 rounded-lg border border-border bg-card p-4" data-testid="contact-email">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-muted text-primary">
                            <LucideIcon Name="mail" Size="20" />
                        </span>
                        <div class="min-w-0">
                            <div class="text-xs text-muted-foreground">Email</div>
                            <a href="mailto:@User.EmailId"
                               class="text-sm font-medium text-primary hover:underline"
                               data-testid="contact-email-value">@User.EmailId</a>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(User?.PhoneNumber))
                {
                    <div class="flex items-center gap-3 rounded-lg border border-border bg-card p-4" data-testid="contact-phone">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-muted text-primary">
                            <LucideIcon Name="phone" Size="20" />
                        </span>
                        <div class="min-w-0">
                            <div class="text-xs text-muted-foreground">Phone</div>
                            <a href="tel:@User.PhoneNumber"
                               class="text-sm font-medium text-primary hover:underline"
                               data-testid="contact-phone-value">@User.PhoneNumber</a>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(User?.Location))
                {
                    <div class="flex items-center gap-3 rounded-lg border border-border bg-card p-4" data-testid="contact-location">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-muted text-primary">
                            <LucideIcon Name="map-pin" Size="20" />
                        </span>
                        <div class="min-w-0">
                            <div class="text-xs text-muted-foreground">Location</div>
                            <div class="text-sm font-medium text-foreground" data-testid="contact-location-value">@User.Location</div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(User?.LinkedInUrl))
                {
                    <div class="flex items-center gap-3 rounded-lg border border-border bg-card p-4" data-testid="contact-linkedin">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-muted text-primary">
                            <LucideIcon Name="linkedin" Size="20" />
                        </span>
                        <div class="min-w-0">
                            <div class="text-xs text-muted-foreground">LinkedIn</div>
                            <a href="@User.LinkedInUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="text-sm font-medium text-primary hover:underline"
                               data-testid="contact-linkedin-value">LinkedIn profile</a>
                        </div>
                    </div>
                }
            </div>
        </CardContent>
        <CardFooter>
            @if (!string.IsNullOrWhiteSpace(User?.EmailId))
            {
                <Button Href="@($"mailto:{User.EmailId}")" data-testid="send-email">
                    <LucideIcon Name="mail" Size="16" />
                    Send an email
                </Button>
            }
        </CardFooter>
    </Card>
}

@code {
    /// <summary>
    /// The user object containing contact information.
    /// </summary>
    [Parameter]
    public AppUser? User { get; set; }

    /// <summary>
    /// Indicates whether at least one contact detail is available to display.
    /// Sections with no data are hidden entirely on the public resume page.
    /// </summary>
    private bool HasContactDetails()
    {
        if (User is null)
        {
            return false;
        }

        return !string.IsNullOrWhiteSpace(User.EmailId)
            || !string.IsNullOrWhiteSpace(User.PhoneNumber)
            || !string.IsNullOrWhiteSpace(User.Location)
            || !string.IsNullOrWhiteSpace(User.LinkedInUrl);
    }
}

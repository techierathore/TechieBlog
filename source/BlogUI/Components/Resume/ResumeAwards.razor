@*
    ResumeAwards.razor
    Purpose: Awards and recognition section of the public Resume page —
    badge image, award title (optionally an external link), year and description.

    REQ-UI-036 / REQ-UI-048 — TrBlazeUI (Card / Badge / LucideIcon).
    List primitive (.resume-stack) lives in wwwroot/css/resume.css.

    Dependencies: BlogModels.Interfaces.IUserAwardsRepo
*@

@inject BlogModels.Interfaces.IUserAwardsRepo AwardsRepo

@if (awards is not null && awards.Any())
{
    <Card id="awards" Class="resume-section" data-testid="awards-section">
        <CardHeader>
            <CardTitle Class="text-2xl">Awards &amp; Recognition</CardTitle>
        </CardHeader>
        <CardContent>
            <div class="resume-stack" data-testid="awards-list">
                @foreach (var award in awards)
                {
                    <div class="resume-award flex items-start gap-4 rounded-lg border border-border bg-card p-4" data-testid="award-item">
                        @if (!string.IsNullOrWhiteSpace(award.BadgeImagePath))
                        {
                            <img src="@award.BadgeImagePath"
                                 alt="@award.AwardTitle"
                                 class="resume-badge-image" />
                        }
                        else
                        {
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-muted text-primary">
                                <LucideIcon Name="award" Size="20" />
                            </span>
                        }

                        <div class="min-w-0 flex-1">
                            @if (!string.IsNullOrWhiteSpace(award.AwardUrl))
                            {
                                <a href="@award.AwardUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="flex items-center gap-1 font-semibold text-primary hover:underline"
                                   data-testid="award-title">
                                    @award.AwardTitle
                                    <LucideIcon Name="external-link" Size="14" />
                                </a>
                            }
                            else
                            {
                                <div class="font-semibold text-foreground" data-testid="award-title">@award.AwardTitle</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(award.AwardYear))
                            {
                                <div class="mt-1" data-testid="award-year">
                                    <Badge Variant="BadgeVariant.Outline">@award.AwardYear</Badge>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(award.AwardDescription))
                            {
                                <p class="mt-2 text-sm text-muted-foreground" data-testid="award-description">@award.AwardDescription</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </CardContent>
    </Card>
}

@code {
    /// <summary>
    /// The user ID to load awards for.
    /// </summary>
    [Parameter]
    public long UserId { get; set; }

    private IEnumerable<BlogModels.Models.UserAward>? awards;

    /// <summary>
    /// Loads the awards for the current user whenever the UserId parameter changes.
    /// </summary>
    /// <returns>A task that completes when the awards have been read.</returns>
    protected override async Task OnParametersSetAsync()
    {
        if (UserId > 0)
        {
            awards = await AwardsRepo.GetByUserIdAsync(UserId);
        }
    }
}

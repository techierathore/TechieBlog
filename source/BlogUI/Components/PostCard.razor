@*
    PostCard.razor
    Purpose: Reusable card component for displaying blog post previews.
    Shows post image, category badge, title, excerpt, author name, date and optional rating.

    REQ-UI-048 — rebuilt over TrBlazeUI Card/Badge with Tailwind utilities.
    REQ-UI-041/042 — the author byline is plain text; public author profiles are retired.
    REQ-UI-028 — no favourite toggle.

    REQ-UI-049 / UAT-025 (2026-08-24) — "Articles without banner look ugly". The no-image state used
    to render the post title as the ONLY content of the empty image box, so a banner-less card showed
    the same title twice (once stranded inside the grey box, once below it in the real heading), and
    the box itself read as a broken image. Replaced with a designed fallback — a subtle theme-token
    gradient (`.post-card-fallback` in wwwroot/css/utilities.css; a pre-built Tailwind bundle ships no
    from-*/to-* gradient-stop utilities for custom tokens, so the gradient colours are a hand-written
    rule) plus a centred, low-opacity `image-off` glyph — and the `ImagePlaceholder` text parameter
    was retired entirely (see the parameter's own history note below). The same fallback also catches
    a `FeaturedImage` URL that 404s (the stranded-uploads class, UAT-022): the plain inline `onerror`
    DOM attribute below is not a Blazor event handler, so it survives every render; it hides the
    broken `<img>` and reveals the sibling fallback via `nextElementSibling`, and nulls itself out
    first so it can never re-fire in a loop.

    Dependencies: TrBlazeUI Card/Badge, LucideIcon, StarRating component
    Usage: Used in Home page post grids, archive pages and search results
*@

<Card Class="flex h-full flex-col overflow-hidden" data-testid="post-card">
    <div class="aspect-video w-full overflow-hidden bg-muted">
        @if (!string.IsNullOrEmpty(ImageUrl))
        {
            <img src="@ImageUrl"
                 alt="@Title"
                 loading="lazy"
                 class="h-full w-full object-cover"
                 data-testid="post-card-image"
                 onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.classList.remove('hidden');" />
        }
        <div class="post-card-fallback flex h-full w-full items-center justify-center @(string.IsNullOrEmpty(ImageUrl) ? null : "hidden")"
             data-testid="post-card-image-placeholder">
            <LucideIcon Name="image-off" Size="40" Class="text-muted-foreground opacity-40" />
        </div>
    </div>

    <CardContent Class="flex flex-1 flex-col gap-2 p-4">
        <div>
            <Badge Variant="BadgeVariant.Secondary" data-testid="post-card-category">@Category</Badge>
        </div>

        <h3 class="text-lg font-semibold leading-snug">
            <a href="@PostUrl"
               class="text-foreground no-underline hover:text-primary hover:underline"
               data-testid="post-card-title">@Title</a>
        </h3>

        <p class="text-sm text-muted-foreground" data-testid="post-card-excerpt">@Excerpt</p>

        <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-3 text-xs text-muted-foreground">
            <span class="text-muted-foreground" data-testid="post-card-author">@AuthorName</span>
            <span data-testid="post-card-date">@Date</span>
            @if (!string.IsNullOrEmpty(ReadTime))
            {
                <span data-testid="post-card-readtime">@ReadTime</span>
            }
            @if (ShowRating && Rating > 0)
            {
                <StarRating Value="@Rating" RatingCount="@RatingCount" />
            }
        </div>
    </CardContent>
</Card>

@code {
    /// <summary>
    /// The category name displayed above the title.
    /// </summary>
    [Parameter]
    public string Category { get; set; } = "Uncategorized";

    /// <summary>
    /// The post title.
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "[Post Title]";

    /// <summary>
    /// Short excerpt/description of the post.
    /// </summary>
    [Parameter]
    public string Excerpt { get; set; } = "[Post excerpt placeholder]";

    /// <summary>
    /// URL to navigate when clicking the post title.
    /// </summary>
    [Parameter]
    public string PostUrl { get; set; } = "/post/placeholder";

    /// <summary>
    /// Author's display name. Rendered as plain text — public author profiles are retired.
    /// </summary>
    [Parameter]
    public string AuthorName { get; set; } = "[Author]";

    /// <summary>
    /// Display date (formatted string).
    /// </summary>
    [Parameter]
    public string Date { get; set; } = "Dec 15";

    /// <summary>
    /// Estimated read time (e.g., "8 min read").
    /// </summary>
    [Parameter]
    public string? ReadTime { get; set; }

    /// <summary>
    /// Whether to display the star rating.
    /// </summary>
    [Parameter]
    public bool ShowRating { get; set; } = false;

    /// <summary>
    /// Star rating value (1-5).
    /// </summary>
    [Parameter]
    public int Rating { get; set; } = 0;

    /// <summary>
    /// Number of ratings (displayed in parentheses).
    /// </summary>
    [Parameter]
    public int RatingCount { get; set; } = 0;

    /// <summary>
    /// Optional URL for the post's featured image.
    /// </summary>
    /// <remarks>
    /// REQ-UI-049 / UAT-025 (2026-08-24): the sibling text parameter <c>ImagePlaceholder</c> was
    /// retired here — every caller was passing the post title through it, which rendered the title
    /// a second time as the sole content of an empty image box. The no-image state is now always the
    /// same designed gradient-plus-glyph fallback (see the component's own top-of-file remarks), so
    /// there is nothing left for a per-call placeholder string to configure. Empty or null collapses
    /// to that fallback; any non-empty value renders the image.
    /// </remarks>
    [Parameter]
    public string? ImageUrl { get; set; }
}

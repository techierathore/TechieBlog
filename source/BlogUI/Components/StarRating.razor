@*
    StarRating.razor
    Purpose: Displays a 5-star rating with filled/empty stars.
    Optionally shows rating count in parentheses.

    Dependencies: None
    Usage: Used in PostCard, PostView, SearchResults for displaying post ratings
*@

<div class="star-rating">
    @for (int i = 1; i <= 5; i++)
    {
        var starIndex = i;
        <span class="star-rating__star @(starIndex <= Value ? "star-rating__star--filled" : "")">&#9733;</span>
    }
    @if (RatingCount > 0)
    {
        <span class="star-rating__count">(@RatingCount)</span>
    }
</div>

@code {
    /// <summary>
    /// The rating value (1-5 stars filled).
    /// </summary>
    [Parameter]
    public int Value { get; set; } = 0;

    /// <summary>
    /// Optional count of ratings to display in parentheses.
    /// </summary>
    [Parameter]
    public int RatingCount { get; set; } = 0;
}

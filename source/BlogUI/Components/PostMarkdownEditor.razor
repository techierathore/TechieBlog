@*
    PostMarkdownEditor.razor
    Purpose: Markdown editor composite with a formatting toolbar and a live split preview.
    Provides edit, split and preview view modes.

    Usage: <PostMarkdownEditor @bind-Value="content" />
    Dependencies: BlogEngine.Common.MarkdownRenderer, TrBlazeUI Toolbar/Tabs (REQ-UI-048)
    Note: preview typography comes from wwwroot/css/base.css `.markdown-content`.

    [REQ-UI-016] 2026-08-09 — the body input is a RAW <textarea>, deliberately, and must stay
    one. TrBlazeUI's <Textarea> is a CONTROLLED input: its markup is
    `<textarea value="@Value" @oninput="HandleInput">` and HandleInput assigns `Value` before
    raising ValueChanged. Under Blazor Server every keystroke therefore round-trips, and the
    render that comes back writes a value into the DOM that is already one or more keystrokes
    behind whatever the user typed in the meantime — the textarea LOST and REORDERED keystrokes
    ('## Live heading' arrived as '## ivehading'). The fix is an UNCONTROLLED input: the DOM
    value is seeded exactly once as the element's child content (`editorSeed`) and the server
    never writes it again, so no re-render can clobber what the user typed. `editorSeed` moves
    only for a PROGRAMMATIC change (toolbar insert, view-mode switch, an externally supplied
    value before the first edit), and each move bumps `editorRevision`, whose @key forces Blazor
    to re-create the element so the new text actually reaches the DOM.
    Library gap TR-057. Do NOT "restore" <Textarea> here.
*@
@namespace BlogUI.Components
@implements IDisposable
@inject BlogEngine.Common.MarkdownRenderer Renderer

<div class="overflow-hidden rounded-md border border-border bg-card" data-testid="markdown-editor">

    <Toolbar Variant="ToolbarVariant.Compact"
             AriaLabel="Markdown formatting"
             Class="flex-wrap border-b border-border"
             data-testid="markdown-toolbar">

        <ToolbarGroup AriaLabel="Text style">
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Bold"
                           Title="Bold"
                           OnClick="@(() => InsertMarkdown("**", "**", "bold text"))"
                           data-testid="md-bold">
                <LucideIcon Name="bold" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Italic"
                           Title="Italic"
                           OnClick="@(() => InsertMarkdown("*", "*", "italic text"))"
                           data-testid="md-italic">
                <LucideIcon Name="italic" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Strikethrough"
                           Title="Strikethrough"
                           OnClick="@(() => InsertMarkdown("~~", "~~", "strikethrough"))"
                           data-testid="md-strikethrough">
                <LucideIcon Name="strikethrough" Size="16" />
            </ToolbarButton>
        </ToolbarGroup>

        <ToolbarSeparator />

        <ToolbarGroup AriaLabel="Headings">
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Heading 1"
                           Title="Heading 1"
                           OnClick="@(() => InsertMarkdown("# ", "", "Heading 1"))"
                           data-testid="md-heading-1">
                <LucideIcon Name="heading-1" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Heading 2"
                           Title="Heading 2"
                           OnClick="@(() => InsertMarkdown("## ", "", "Heading 2"))"
                           data-testid="md-heading-2">
                <LucideIcon Name="heading-2" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Heading 3"
                           Title="Heading 3"
                           OnClick="@(() => InsertMarkdown("### ", "", "Heading 3"))"
                           data-testid="md-heading-3">
                <LucideIcon Name="heading-3" Size="16" />
            </ToolbarButton>
        </ToolbarGroup>

        <ToolbarSeparator />

        <ToolbarGroup AriaLabel="Insert">
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Insert link"
                           Title="Insert link"
                           OnClick="@(() => InsertMarkdown("[", "](url)", "link text"))"
                           data-testid="md-link">
                <LucideIcon Name="link" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Insert image"
                           Title="Insert image"
                           OnClick="@(() => InsertMarkdown("![alt text](", ")", "image-url"))"
                           data-testid="md-image">
                <LucideIcon Name="image" Size="16" />
            </ToolbarButton>
        </ToolbarGroup>

        <ToolbarSeparator />

        <ToolbarGroup AriaLabel="Code and quotes">
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Inline code"
                           Title="Inline code"
                           OnClick="@(() => InsertMarkdown("`", "`", "code"))"
                           data-testid="md-code">
                <LucideIcon Name="code" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Code block"
                           Title="Code block"
                           OnClick="@(() => InsertMarkdown("```\n", "\n```", "code block"))"
                           data-testid="md-code-block">
                <LucideIcon Name="square-code" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Blockquote"
                           Title="Blockquote"
                           OnClick="@(() => InsertMarkdown("> ", "", "quote"))"
                           data-testid="md-quote">
                <LucideIcon Name="quote" Size="16" />
            </ToolbarButton>
        </ToolbarGroup>

        <ToolbarSeparator />

        <ToolbarGroup AriaLabel="Lists">
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Bullet list"
                           Title="Bullet list"
                           OnClick="@(() => InsertMarkdown("- ", "", "list item"))"
                           data-testid="md-bullet-list">
                <LucideIcon Name="list" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Numbered list"
                           Title="Numbered list"
                           OnClick="@(() => InsertMarkdown("1. ", "", "list item"))"
                           data-testid="md-numbered-list">
                <LucideIcon Name="list-ordered" Size="16" />
            </ToolbarButton>
            <ToolbarButton Variant="ToolbarButtonVariant.Ghost"
                           AriaLabel="Horizontal rule"
                           Title="Horizontal rule"
                           OnClick="@(() => InsertMarkdown("---\n", "", ""))"
                           data-testid="md-horizontal-rule">
                <LucideIcon Name="minus" Size="16" />
            </ToolbarButton>
        </ToolbarGroup>

        <div class="flex-1"></div>

        <Tabs Value="@ViewMode" ValueChanged="@SetViewMode" data-testid="markdown-view-mode">
            <TabsList Class="h-8">
                <TabsTrigger Value="edit"><span data-testid="markdown-view-edit">Edit</span></TabsTrigger>
                <TabsTrigger Value="split"><span data-testid="markdown-view-split">Split</span></TabsTrigger>
                <TabsTrigger Value="preview"><span data-testid="markdown-view-preview">Preview</span></TabsTrigger>
            </TabsList>
        </Tabs>
    </Toolbar>

    <div class="flex min-h-[400px] items-stretch">
        @if (ViewMode != "preview")
        {
            <div class="flex min-w-0 flex-1">
                @* Uncontrolled by design — see the file header (REQ-UI-016 / TR-057). *@
                <textarea @key="editorRevision"
                          class="@EditorCssClass"
                          placeholder="@InputPlaceholder"
                          aria-label="Post content in Markdown"
                          data-slot="textarea-control"
                          data-testid="markdown-input"
                          @oninput="OnContentChanged">@editorSeed</textarea>
            </div>
        }
        @if (ViewMode != "edit")
        {
            <div class="min-w-0 flex-1 overflow-y-auto bg-card p-4 @(ViewMode == "split" ? "border-l border-border" : string.Empty)"
                 data-testid="markdown-preview">
                @if (string.IsNullOrWhiteSpace(markdownSource))
                {
                    <div class="flex h-full flex-col items-center justify-center gap-2 text-center text-muted-foreground"
                         data-testid="markdown-preview-empty">
                        <LucideIcon Name="file-text" Size="24" />
                        <p class="text-sm">Preview will appear here as you type...</p>
                    </div>
                }
                else
                {
                    <div class="markdown-content" data-testid="markdown-preview-content">
                        @((MarkupString)renderedHtml)
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Markdown source text. Two-way bindable via <c>@bind-Value</c>.
    /// </summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Raised whenever the markdown source changes.
    /// </summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Active view mode: "edit", "split" or "preview".
    /// </summary>
    [Parameter]
    public string ViewMode { get; set; } = "split";

    /// <summary>Placeholder shown in the markdown input while it is empty.</summary>
    private const string InputPlaceholder =
        "Write your content in Markdown...\n\n**Bold**  *Italic*  `code`\n# Heading 1\n- Bullet list\n[Link text](url)\n> Blockquote";

    /// <summary>
    /// Quiet period, in milliseconds, before a keystroke burst re-renders the preview.
    /// </summary>
    /// <remarks>
    /// Only the PREVIEW is debounced. The parent is notified on every keystroke so that a save
    /// pressed immediately after typing can never persist stale content.
    /// </remarks>
    private const int PreviewDebounceMs = 250;

    /// <summary>
    /// Classes the TrBlazeUI Textarea used to produce for this editor, resolved by hand.
    /// </summary>
    /// <remarks>
    /// These are the library's shadcn textarea base classes with the conflicts this editor
    /// overrode already collapsed (min-h, rounded, border, padding, background, type size), so
    /// the uncontrolled element is pixel-identical to the controlled one it replaced.
    /// </remarks>
    private const string EditorCssClass =
        "flex field-sizing-content min-h-[400px] w-full flex-1 resize-none rounded-none border-0 " +
        "bg-card px-4 py-3 font-mono text-sm shadow-xs placeholder:text-muted-foreground " +
        "outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 " +
        "disabled:cursor-not-allowed disabled:opacity-50 transition-[color,box-shadow]";

    /// <summary>Rendered HTML for the current markdown source.</summary>
    private string renderedHtml = string.Empty;

    /// <summary>Authoritative markdown source held by this component.</summary>
    private string markdownSource = string.Empty;

    /// <summary>
    /// Text the textarea element is seeded with. Changes only for programmatic edits — never
    /// for user keystrokes — which is what stops a re-render from clobbering the DOM value.
    /// </summary>
    private string editorSeed = string.Empty;

    /// <summary>
    /// Incremented with every <see cref="editorSeed"/> move; keys the textarea so Blazor
    /// re-creates the element and the new seed reaches the DOM.
    /// </summary>
    private int editorRevision;

    /// <summary>True once the user has typed, after which supplied values are echoes.</summary>
    private bool hasLocalEdits;

    /// <summary>Cancels the in-flight preview debounce when another keystroke arrives.</summary>
    private CancellationTokenSource? previewDebounce;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        markdownSource = Value ?? string.Empty;
        editorSeed = markdownSource;
        UpdatePreview();
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Once the user has typed, every value arriving from the parent is an echo of a
        // keystroke this component already sent — adopting it is exactly the clobber that
        // lost keystrokes. Only a pre-edit value (the post loaded into the editor) is adopted.
        if (hasLocalEdits || string.Equals(Value ?? string.Empty, markdownSource, StringComparison.Ordinal))
        {
            return;
        }

        markdownSource = Value ?? string.Empty;
        ReseedEditor();
        UpdatePreview();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        previewDebounce?.Cancel();
        previewDebounce?.Dispose();
        previewDebounce = null;
    }

    /// <summary>Re-renders the preview HTML from the current markdown source.</summary>
    private void UpdatePreview()
    {
        renderedHtml = Renderer.ToHtml(markdownSource);
    }

    /// <summary>
    /// Pushes <see cref="markdownSource"/> into the textarea by re-creating the element.
    /// </summary>
    private void ReseedEditor()
    {
        editorSeed = markdownSource;
        editorRevision++;
    }

    /// <summary>Handles input from the markdown textarea and notifies the parent.</summary>
    private async Task OnContentChanged(ChangeEventArgs args)
    {
        hasLocalEdits = true;
        markdownSource = args.Value?.ToString() ?? string.Empty;

        // Immediate, so the post body is current the instant a save button is pressed.
        await ValueChanged.InvokeAsync(markdownSource);

        SchedulePreviewRefresh();
    }

    /// <summary>
    /// Re-renders the preview once typing pauses, instead of on every keystroke.
    /// </summary>
    private void SchedulePreviewRefresh()
    {
        previewDebounce?.Cancel();
        previewDebounce?.Dispose();

        var debounce = new CancellationTokenSource();
        previewDebounce = debounce;
        _ = RefreshPreviewAfterQuietPeriodAsync(debounce.Token);
    }

    /// <summary>
    /// Waits out the debounce window and then re-renders the preview.
    /// </summary>
    /// <param name="cancellationToken">Cancelled when a further keystroke arrives.</param>
    private async Task RefreshPreviewAfterQuietPeriodAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(PreviewDebounceMs, cancellationToken);
            UpdatePreview();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke owns the preview now.
        }
        catch (ObjectDisposedException)
        {
            // The circuit went away while the debounce was pending.
        }
    }

    /// <summary>Switches the editor between edit, split and preview modes.</summary>
    private void SetViewMode(string mode)
    {
        if (string.IsNullOrEmpty(mode) || mode == ViewMode)
        {
            return;
        }

        ViewMode = mode;

        // The textarea is torn out of the tree in preview mode, so it has to be re-seeded with
        // the current source when it comes back — otherwise it would return to its stale seed.
        ReseedEditor();
        UpdatePreview();
    }

    /// <summary>
    /// Appends a markdown snippet to the end of the source and notifies the parent.
    /// </summary>
    private async Task InsertMarkdown(string before, string after, string placeholder)
    {
        // Simple insertion - appends to end.
        // In a full implementation, would use JS interop to insert at cursor.
        markdownSource = string.IsNullOrEmpty(markdownSource)
            ? before + placeholder + after
            : markdownSource + "\n" + before + placeholder + after;

        // A programmatic edit is the one case where the DOM value MUST be rewritten.
        ReseedEditor();
        UpdatePreview();
        await ValueChanged.InvokeAsync(markdownSource);
    }
}

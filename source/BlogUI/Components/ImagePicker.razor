@*
    ImagePicker.razor
    Purpose: Reusable image picker component with gallery dialog and upload functionality.
    Displays the current selection, allows choosing from the media library or uploading a new file.

    Usage: <ImagePicker Category="profiles" @bind-SelectedImagePath="user.ProfileImagePath" UserId="@currentUserId" />
    Dependencies: BlogEngine.Services.BlogImageService, TrBlazeUI (REQ-UI-048)
*@
@namespace BlogUI.Components

<div class="flex flex-col gap-3" data-testid="image-picker">

    @* Current selection preview *@
    <div class="flex h-36 w-36 items-center justify-center overflow-hidden rounded-lg border-2 border-dashed border-border bg-muted">
        @if (!string.IsNullOrEmpty(SelectedImagePath))
        {
            <div class="relative h-full w-full">
                <img src="@SelectedImagePath"
                     alt="Selected image"
                     class="h-full w-full object-cover"
                     data-testid="selected-image" />
                @*
                    REQ-UI-040 / TR-019 instance: the shipped trblazeui.css carries no `.top-1` rule
                    (only top-0 / top-1.5 / top-1\/2 / top-2 / top-3.5 / top-4), so the previous
                    `top-1` left this button with a STATIC vertical position. It fell below the
                    h-full image, out of the overflow-hidden frame, and landed on the action row at
                    390px. `top-2` is present in the bundle.
                *@
                <Button Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.IconSmall"
                        Class="absolute right-2 top-2 rounded-full bg-background/80"
                        AriaLabel="Clear selection"
                        OnClick="@ClearSelection"
                        data-testid="clear-image">
                    <LucideIcon Name="x" Size="16" />
                </Button>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center gap-2 p-4 text-center text-muted-foreground"
                 data-testid="image-placeholder">
                <LucideIcon Name="image" Size="24" />
                <span class="text-sm">No image selected</span>
            </div>
        }
    </div>

    @* Actions *@
    <div class="flex flex-wrap gap-2">
        <Button Variant="ButtonVariant.Outline"
                Size="ButtonSize.Small"
                OnClick="@OpenGallery"
                data-testid="choose-from-library">
            <LucideIcon Name="image" Size="16" />
            Choose from Library
        </Button>
        <Button Variant="ButtonVariant.Outline"
                Size="ButtonSize.Small"
                OnClick="@OpenUpload"
                data-testid="upload-new-image">
            <LucideIcon Name="upload" Size="16" />
            Upload New
        </Button>
    </div>

    @* Category constraints *@
    <span class="text-xs text-muted-foreground" data-testid="image-constraints">
        @GetCategoryConstraintsText()
    </span>
</div>

@* Gallery dialog - closed on load, opened by "Choose from Library". *@
<Dialog Open="@ShowGalleryModal" OpenChanged="@OnGalleryOpenChanged">
    <DialogContent Class="max-w-3xl" data-testid="image-gallery-dialog">
        <DialogHeader>
            <DialogTitle>Choose Image from Library</DialogTitle>
            <DialogDescription>Pick an existing file from the @Category library.</DialogDescription>
        </DialogHeader>

        @if (IsLoadingGallery)
        {
            <div class="flex items-center justify-center gap-3 py-12" data-testid="gallery-loading">
                <Spinner />
                <span class="text-muted-foreground">Loading images...</span>
            </div>
        }
        else if (GalleryImages is null || !GalleryImages.Any())
        {
            <Empty Title="No images yet"
                   Description="@($"Nothing has been uploaded to the {Category} category. Upload a new image to get started.")"
                   data-testid="gallery-empty">
                <Icon><LucideIcon Name="image" Size="48" /></Icon>
            </Empty>
        }
        else
        {
            <div class="grid max-h-96 grid-cols-2 gap-3 overflow-y-auto p-1 sm:grid-cols-3 md:grid-cols-4"
                 data-testid="gallery-grid">
                @foreach (var image in GalleryImages)
                {
                    var path = image.ImagePath;
                    <Button Variant="ButtonVariant.Ghost"
                            Class="@GetGalleryTileClass(path)"
                            AriaLabel="@(image.AltText ?? image.ImageName)"
                            OnClick="@(() => SelectImage(path))"
                            data-testid="gallery-image">
                        <img src="@path"
                             alt="@(image.AltText ?? image.ImageName)"
                             class="h-full w-full object-cover" />
                    </Button>
                }
            </div>
        }

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="@CloseGallery" data-testid="gallery-cancel">
                Cancel
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@* Upload dialog - closed on load, opened by "Upload New". *@
<Dialog Open="@ShowUploadModal" OpenChanged="@OnUploadOpenChanged">
    <DialogContent Class="max-w-lg" data-testid="image-upload-dialog">
        <DialogHeader>
            <DialogTitle>Upload New Image</DialogTitle>
            <DialogDescription>@GetCategoryConstraintsText()</DialogDescription>
        </DialogHeader>

        <div class="flex flex-col gap-4">
            @* [REQ-FN-025] MaxFileSize must be supplied: the component otherwise advertises and
               enforces its own 10 MB default, contradicting the constraint line above it. *@
            <div data-testid="upload-image">
                <FileUpload Files="@PendingFiles"
                            FilesChanged="@OnFilesChanged"
                            Accept="@GetAcceptedFileTypes()"
                            MaxFileSize="@GetMaxUploadSize()"
                            OnValidationError="@OnDropzoneValidationError"
                            Multiple="false"
                            Disabled="@IsUploading" />
            </div>

            @if (SelectedFile is not null)
            {
                <p class="rounded-md bg-muted p-3 text-sm" data-testid="upload-selected-file">
                    <strong>Selected:</strong> @SelectedFile.Name (@FormatFileSize(SelectedFile.Size))
                </p>
            }

            @if (!string.IsNullOrEmpty(UploadError))
            {
                <Alert Variant="AlertVariant.Danger" data-testid="upload-error">
                    <LucideIcon Name="circle-alert" Size="16" />
                    <AlertTitle>Upload failed</AlertTitle>
                    <AlertDescription>@UploadError</AlertDescription>
                </Alert>
            }

            @if (IsUploading)
            {
                <div class="flex items-center gap-3" data-testid="upload-progress">
                    <Spinner Size="SpinnerSize.Small" />
                    <span class="text-sm text-muted-foreground">Uploading...</span>
                </div>
            }
        </div>

        <DialogFooter>
            <Button Variant="ButtonVariant.Outline"
                    OnClick="@CloseUpload"
                    Disabled="@IsUploading"
                    data-testid="upload-cancel">
                Cancel
            </Button>
            <Button OnClick="@UploadFile"
                    Disabled="@(SelectedFile is null || IsUploading)"
                    data-testid="upload-confirm">
                <LucideIcon Name="upload" Size="16" />
                @(IsUploading ? "Uploading..." : "Upload")
            </Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

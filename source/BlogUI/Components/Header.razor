@*
    Header.razor
    Purpose: Sticky top-bar shell for every public TechieBlog page.

    REQ-UI-048 / BRD-92 — rebuilt on TrBlazeUI.
    BRD-93 / REQ-UI-050 — the public chrome carries NO login link and NO user
    menu. Do not reintroduce them.

    Composition note (TR-016): TrBlazeUI ships no responsive top-bar shell as a
    single component, so this one composes NavigationMenu (desktop) + Sheet (mobile
    drawer) + a ghost ThemeToggle, exactly as recorded in
    docs/TechieBlog-TrBlazeUI-Feedback.md.

    UAT-021 / UAT-022: the brand mark reads the configured site title and logo
    (BlogEngine.Common.SiteIdentityExtensions), falling back to "TechieBlog" and the
    built-in glyph. This layout persists for the life of the circuit — client-side
    navigation does not recreate it — so it subscribes to SiteSettingsService.SettingsChanged
    to pick up a save made on /settings without a restart or a hard refresh.
*@
@implements IDisposable
@using BlogModels.Interfaces
@using BlogModels.Models
@using BlogEngine.Common
@inject NavigationManager Navigation
@inject ISiteSettingsService SiteSettingsService

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80"
        data-testid="public-header">
    @* REQ-UI-005 (2026-08-09): the bar must fit a 320px viewport with NO horizontal scroll.
       The previous `gap-4 px-4` plus a dedicated flex-1 spacer element cost 32px of padding
       and TWO 16px gaps, which pushed the actions cluster to x=325 on a 320px screen. Below
       `sm` the padding shrinks to px-3, the container gap halves, and the spacer is replaced by
       `ml-auto` on the actions (one fewer flex child, so one fewer gap); the brand can also
       shrink and truncate instead of forcing its intrinsic width. The desktop spacing is
       unchanged in effect because the nav already carries its own `ml-2`.

       The three icon buttons are the fixed cost here: utilities.css raises every square icon
       control to the 44px target-size token (REQ-NFR-007), so the actions cluster cannot be
       made narrower — the room has to come from the padding, the gaps and the brand. *@
    <div class="mx-auto flex h-16 w-full max-w-7xl items-center gap-2 px-3 sm:px-6">

        @* Brand *@
        <a href="/"
           class="flex min-w-0 items-center gap-2 font-semibold text-foreground no-underline"
           data-testid="brand-link">
            @if (!string.IsNullOrEmpty(identity.SiteLogoPath))
            {
                <span class="flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-primary text-primary-foreground">
                    <img src="@identity.SiteLogoPath"
                         alt="@($"{identity.SiteTitle} logo")"
                         class="h-full w-full object-contain"
                         data-testid="site-logo" />
                </span>
            }
            else
            {
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                    <LucideIcon Name="code" Size="16" />
                </span>
            }
            <span class="truncate text-base">@identity.SiteTitle</span>
        </a>

        @* Desktop navigation — TrBlazeUI's own NavigationMenu.

           [REQ-UI-005 / REQ-NFR-007] 2026-08-11: this block was a hand-rolled
           <nav><ul><li> + NavLink because TrBlazeUI 2.0.1's NavigationMenuLink rendered every
           entry as <a role="menuitem" tabindex="-1"> — an incomplete roving-tabindex menubar
           that left 0 of 6 links reachable by Tab (WCAG 2.1.1) and produced orphan `menuitem`
           roles that failed axe's `aria-required-parent`. TR-044 is fixed in 2.0.2: a
           top-level NavigationMenuLink is an ordinary link, and `menuitem` semantics apply
           only inside NavigationMenuContent, which is a real role="menu".

           `aria-label="Primary"` and the six data-testids are carried onto the library
           components (they splat since TR-048), so the stable element ids the verification
           suite navigates by are unchanged. `Match` drives the current-page styling that
           NavLink's ActiveClass used to — NavigationMenuLink owns its own active class. *@
        <NavigationMenu Class="ml-2 hidden md:flex" aria-label="Primary" data-testid="primary-nav">
            <NavigationMenuList>
                @foreach (var link in NavLinks)
                {
                    <NavigationMenuItem>
                        <NavigationMenuLink Href="@link.Href"
                                            Match="@link.Match"
                                            Class="inline-flex items-center rounded-md px-3 py-2 text-sm font-medium text-foreground no-underline hover:bg-accent hover:text-accent-foreground"
                                            data-testid="@link.TestId">
                            @link.Label
                        </NavigationMenuLink>
                    </NavigationMenuItem>
                }
            </NavigationMenuList>
        </NavigationMenu>

        @* Actions: search, theme, mobile drawer trigger.
           `ml-auto` does the spacer's job without adding a flex child (see the note above). *@
        <div class="ml-auto flex shrink-0 items-center gap-0.5">
            <Button Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Icon"
                    OnClick="NavigateToSearch"
                    AriaLabel="Search"
                    title="Search"
                    data-testid="header-search">
                <LucideIcon Name="search" Size="18" />
            </Button>

            <ThemeToggle />

            <Sheet @bind-Open="isDrawerOpen">
                <SheetTrigger AsChild>
                    <Button Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Icon"
                            Class="md:hidden"
                            AriaLabel="Open menu"
                            data-testid="mobile-nav-trigger">
                        <LucideIcon Name="menu" Size="20" />
                    </Button>
                </SheetTrigger>
                @* SheetSide lives in TrBlazeUI.Primitives.Sheet, which is deliberately not
                   imported globally (its primitive types would shadow the styled Sheet family). *@
                <SheetContent Side="TrBlazeUI.Primitives.Sheet.SheetSide.Right" Class="w-[280px]" data-testid="mobile-nav-drawer">
                    <SheetHeader>
                        <SheetTitle>@identity.SiteTitle</SheetTitle>
                        <SheetDescription>Browse the site</SheetDescription>
                    </SheetHeader>
                    <nav class="mt-4 flex flex-col gap-1">
                        @foreach (var link in NavLinks)
                        {
                            <NavLink href="@link.Href"
                                     Match="@link.Match"
                                     class="flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium text-foreground no-underline hover:bg-accent hover:text-accent-foreground"
                                     @onclick="CloseDrawer"
                                     data-testid="@($"{link.TestId}-mobile")">
                                <LucideIcon Name="@link.Icon" Size="18" />
                                <span>@link.Label</span>
                            </NavLink>
                        }
                    </nav>
                </SheetContent>
            </Sheet>
        </div>
    </div>
</header>

@code {
    private bool isDrawerOpen;

    /// <summary>
    /// The site's public identity (title, logo). Defaults to the built-in fallback so the very
    /// first render — before <see cref="OnInitializedAsync"/> completes — shows real content
    /// rather than a blank brand mark.
    /// </summary>
    private SiteIdentity identity = new("TechieBlog", string.Empty);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        identity = await SiteSettingsService.GetSiteIdentityAsync();

        // This layout persists for the life of the circuit — client-side navigation does not
        // recreate it — so without this subscription an administrator who saves a new title on
        // /settings would not see their own header update until a hard refresh (UAT-021 §2).
        SiteSettingsService.SettingsChanged += OnSettingsChanged;
    }

    /// <summary>
    /// Refreshes the rendered identity when a save is published elsewhere in the app.
    /// </summary>
    /// <remarks>
    /// <see cref="ISiteSettingsService.SettingsChanged"/> is raised on the saving circuit's
    /// thread, which is not necessarily this component's renderer, so the update is marshalled
    /// through <see cref="ComponentBase.InvokeAsync(Func{Task})"/>.
    /// </remarks>
    private void OnSettingsChanged(object? sender, SiteSettings settings)
    {
        _ = InvokeAsync(async () =>
        {
            identity = await SiteSettingsService.GetSiteIdentityAsync();
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public void Dispose()
    {
        // The settings service is a singleton (REQ-NFR — see its own remarks); an unsubscribed
        // handler here would keep every disposed circuit's Header alive for the life of the
        // process.
        SiteSettingsService.SettingsChanged -= OnSettingsChanged;
    }

    /// <summary>
    /// Describes one entry in the public navigation, shared by the desktop
    /// NavigationMenu and the mobile Sheet drawer so the two cannot drift.
    /// </summary>
    /// <param name="Label">Visible link text.</param>
    /// <param name="Href">Destination route.</param>
    /// <param name="Icon">Lucide icon name used in the mobile drawer.</param>
    /// <param name="TestId">Stable data-testid for the desktop entry.</param>
    /// <param name="Match">Route matching mode for active styling.</param>
    private sealed record NavEntry(
        string Label,
        string Href,
        string Icon,
        string TestId,
        NavLinkMatch Match = NavLinkMatch.Prefix);

    private static readonly NavEntry[] NavLinks =
    {
        new("Home", "/", "house", "nav-home", NavLinkMatch.All),
        new("Categories", "/categories", "folder", "nav-categories"),
        new("Series", "/series", "book-open", "nav-series"),
        new("Newsletter", "/newsletters", "mail", "nav-newsletter"),
        new("Resume", "/resume", "file-text", "nav-resume"),
        new("Speaking", "/speaker-profile", "mic", "nav-speaker-profile")
        // "About" deliberately NOT listed (owner, 2026-08-22): the footer already links it, and a
        // second copy in the primary nav spends prime navigation space on a page nobody arrives
        // looking for. The ROUTE is untouched — /about still resolves, the footer link still works,
        // and the home page's About section still deep-links to it.
    };

    /// <summary>
    /// Closes the mobile drawer after a navigation link is chosen.
    /// </summary>
    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }

    /// <summary>
    /// Navigates to the site search page.
    /// </summary>
    private void NavigateToSearch()
    {
        Navigation.NavigateTo("/search");
    }
}

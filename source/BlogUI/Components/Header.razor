@*
    Header.razor
    Purpose: Sticky top-bar shell for every public TechieBlog page.

    REQ-UI-048 / BRD-92 — rebuilt on TrBlazeUI.
    BRD-93 / REQ-UI-050 — the public chrome carries NO login link and NO user
    menu. Do not reintroduce them.

    Composition note (gap TR-016): TrBlazeUI ships no responsive top-bar shell,
    so this component composes one from NavigationMenu (desktop) + Sheet (mobile
    drawer) + a ghost ThemeToggle, exactly as recorded in
    docs/TechieBlog-TrBlazeUI-Feedback.md.
*@

@inject NavigationManager Navigation

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80"
        data-testid="public-header">
    @* REQ-UI-005 (2026-08-09): the bar must fit a 320px viewport with NO horizontal scroll.
       The previous `gap-4 px-4` plus a dedicated flex-1 spacer element cost 32px of padding
       and TWO 16px gaps, which pushed the actions cluster to x=325 on a 320px screen. Below
       `sm` the padding shrinks to px-3, the container gap halves, and the spacer is replaced by
       `ml-auto` on the actions (one fewer flex child, so one fewer gap); the brand can also
       shrink and truncate instead of forcing its intrinsic width. The desktop spacing is
       unchanged in effect because the nav already carries its own `ml-2`.

       The three icon buttons are the fixed cost here: utilities.css raises every square icon
       control to the 44px target-size token (REQ-NFR-007), so the actions cluster cannot be
       made narrower — the room has to come from the padding, the gaps and the brand. *@
    <div class="mx-auto flex h-16 w-full max-w-7xl items-center gap-2 px-3 sm:px-6">

        @* Brand *@
        <a href="/"
           class="flex min-w-0 items-center gap-2 font-semibold text-foreground no-underline"
           data-testid="brand-link">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                <LucideIcon Name="code" Size="16" />
            </span>
            <span class="truncate text-base">TechieBlog</span>
        </a>

        @* Desktop navigation *@
        @* Desktop navigation — plain semantic markup, NOT TrBlazeUI's NavigationMenu.

           REQ-NFR-007 / gap TR-032: NavigationMenuLink renders every entry as
           <a role="menuitem" tabindex="-1">. That is a roving-tabindex menubar pattern the
           library never completes — no item is ever given tabindex="0" and no arrow-key handler
           is wired — so the ENTIRE primary navigation was unreachable by keyboard (WCAG 2.1.1),
           and the orphan `menuitem` roles also failed axe's `aria-required-parent` (4.1.2).
           A site navigation is a list of links, not a menubar, so it is built from <nav>/<ul>/
           NavLink here. Styling matches the mobile drawer entries below. *@
        <nav class="ml-2 hidden md:flex" aria-label="Primary" data-testid="primary-nav">
            <ul class="flex list-none items-center gap-1 p-0">
                @foreach (var link in NavLinks)
                {
                    <li>
                        <NavLink href="@link.Href"
                                 Match="@link.Match"
                                 class="inline-flex items-center rounded-md px-3 py-2 text-sm font-medium text-foreground no-underline hover:bg-accent hover:text-accent-foreground"
                                 ActiveClass="bg-accent text-accent-foreground"
                                 data-testid="@link.TestId">
                            @link.Label
                        </NavLink>
                    </li>
                }
            </ul>
        </nav>

        @* Actions: search, theme, mobile drawer trigger.
           `ml-auto` does the spacer's job without adding a flex child (see the note above). *@
        <div class="ml-auto flex shrink-0 items-center gap-0.5">
            <Button Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Icon"
                    OnClick="NavigateToSearch"
                    AriaLabel="Search"
                    title="Search"
                    data-testid="header-search">
                <LucideIcon Name="search" Size="18" />
            </Button>

            <ThemeToggle />

            <Sheet @bind-Open="isDrawerOpen">
                <SheetTrigger AsChild>
                    <Button Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Icon"
                            Class="md:hidden"
                            AriaLabel="Open menu"
                            data-testid="mobile-nav-trigger">
                        <LucideIcon Name="menu" Size="20" />
                    </Button>
                </SheetTrigger>
                @* SheetSide lives in TrBlazeUI.Primitives.Sheet, which is deliberately not
                   imported globally (its primitive types would shadow the styled Sheet family). *@
                <SheetContent Side="TrBlazeUI.Primitives.Sheet.SheetSide.Right" Class="w-[280px]" data-testid="mobile-nav-drawer">
                    <SheetHeader>
                        <SheetTitle>TechieBlog</SheetTitle>
                        <SheetDescription>Browse the site</SheetDescription>
                    </SheetHeader>
                    <nav class="mt-4 flex flex-col gap-1">
                        @foreach (var link in NavLinks)
                        {
                            <NavLink href="@link.Href"
                                     Match="@link.Match"
                                     class="flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium text-foreground no-underline hover:bg-accent hover:text-accent-foreground"
                                     @onclick="CloseDrawer"
                                     data-testid="@($"{link.TestId}-mobile")">
                                <LucideIcon Name="@link.Icon" Size="18" />
                                <span>@link.Label</span>
                            </NavLink>
                        }
                    </nav>
                </SheetContent>
            </Sheet>
        </div>
    </div>
</header>

@code {
    private bool isDrawerOpen;

    /// <summary>
    /// Describes one entry in the public navigation, shared by the desktop
    /// NavigationMenu and the mobile Sheet drawer so the two cannot drift.
    /// </summary>
    /// <param name="Label">Visible link text.</param>
    /// <param name="Href">Destination route.</param>
    /// <param name="Icon">Lucide icon name used in the mobile drawer.</param>
    /// <param name="TestId">Stable data-testid for the desktop entry.</param>
    /// <param name="Match">Route matching mode for active styling.</param>
    private sealed record NavEntry(
        string Label,
        string Href,
        string Icon,
        string TestId,
        NavLinkMatch Match = NavLinkMatch.Prefix);

    private static readonly NavEntry[] NavLinks =
    {
        new("Home", "/", "house", "nav-home", NavLinkMatch.All),
        new("Categories", "/categories", "folder", "nav-categories"),
        new("Series", "/series", "book-open", "nav-series"),
        new("Newsletter", "/newsletters", "mail", "nav-newsletter"),
        new("Resume", "/resume", "file-text", "nav-resume"),
        new("About", "/about", "info", "nav-about")
    };

    /// <summary>
    /// Closes the mobile drawer after a navigation link is chosen.
    /// </summary>
    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }

    /// <summary>
    /// Navigates to the site search page.
    /// </summary>
    private void NavigateToSearch()
    {
        Navigation.NavigateTo("/search");
    }
}

@*
    ContentPanel.razor
    Purpose: Reusable card shell for admin pages.
    Provides a consistent layout with a title header, optional right-hand action slot
    and a content area.

    Usage: Wrap page content in admin pages for consistent styling.
    Dependencies: TrBlazeUI Card (REQ-UI-048)
*@
<Card Class="my-4" data-testid="content-panel">
    <CardHeader Class="flex flex-row items-center justify-between gap-3 border-b border-border pb-4">
        <CardTitle Class="text-lg font-semibold" data-testid="content-panel-title">@PanelTitle</CardTitle>
        <div class="flex items-center gap-2">
            @RightSection
        </div>
    </CardHeader>
    <CardContent Class="pt-6">
        @PanelContent
    </CardContent>
</Card>

@code {
    /// <summary>
    /// Title displayed in the panel header.
    /// </summary>
    [Parameter]
    public string PanelTitle { get; set; }

    /// <summary>
    /// Content to render in the right section of the header (typically action buttons).
    /// </summary>
    [Parameter]
    public RenderFragment RightSection { get; set; }

    /// <summary>
    /// Main content to render in the panel body.
    /// </summary>
    [Parameter]
    public RenderFragment PanelContent { get; set; }
}

@*
    ForcePasswordChangeGuard.razor
    Purpose: Keeps a signed-in user whose account carries MustChangePassword on the
             change-password screen until they have actually changed it.

    REQ-NFR-023 / BRD-79. The flag existed and was stored, the change-password service
    method existed and validated correctly, but NOTHING enforced the flag — every seeded
    account signed straight through to its dashboard with the well-known bootstrap
    password still in place. This component is the enforcement.

    It renders nothing. It sits inside CascadingAuthenticationState in Routes.razor so it
    is alive for every route, and it re-checks on every navigation and on every
    authentication-state change.

    Dependencies: AuthenticationStateProvider, NavigationManager, RoleLandingRoutes.
*@

@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

@code {
    /// <summary>
    /// Value of the <c>MustChangePassword</c> claim that means the account is still flagged.
    /// </summary>
    private const string FlagSetValue = "true";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnforceAsync();
        }
    }

    /// <summary>
    /// Re-checks the flag after a navigation.
    /// </summary>
    /// <remarks>
    /// This is the half that makes "cannot navigate away" true: typing an admin URL, following a
    /// link or pressing the browser back button all raise this event, and each one lands back on
    /// the change screen while the flag is set.
    /// </remarks>
    /// <param name="sender">The navigation manager.</param>
    /// <param name="args">Details of the navigation.</param>
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        await EnforceAsync();
    }

    /// <summary>
    /// Re-checks the flag when the principal changes.
    /// </summary>
    /// <remarks>
    /// Fires on sign-in, so a flagged user is diverted the moment they authenticate, and again on
    /// the successful change, when the refreshed principal clears the flag and releases them.
    /// </remarks>
    /// <param name="task">The new authentication state.</param>
    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await EnforceAsync();
    }

    /// <summary>
    /// Sends a flagged user to the change-password screen.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> Only a signed-in principal carrying the flag is diverted, and
    /// never away from the change screen itself — redirecting the change screen to itself would
    /// loop. An anonymous visitor is left alone: the router's own <c>NotAuthorized</c> path already
    /// handles them, and this component must not interfere with the public site.</para>
    /// <para><b>Flow:</b> interactivity guard → read principal → claim check → route check →
    /// navigate.</para>
    /// <para><b>Side Effects:</b> Navigates.</para>
    /// <para><b>Prerender:</b> the authentication state is read from browser local storage through
    /// JS interop, so the prerender pass always sees an anonymous user. Enforcing there would be
    /// wrong in both directions — it cannot see the flag, and NavigateTo throws during prerender —
    /// so the check waits for the interactive render, exactly as RedirectToLogin does.</para>
    /// </remarks>
    /// <returns>A task that completes once the check has run.</returns>
    private async Task EnforceAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var mustChange = string.Equals(
            user.FindFirst(CustomAuthStateProvider.MustChangePasswordClaim)?.Value,
            FlagSetValue,
            StringComparison.OrdinalIgnoreCase);

        if (!mustChange || IsOnChangePasswordScreen())
        {
            return;
        }

        NavigationManager.NavigateTo(RoleLandingRoutes.ChangePassword);
    }

    /// <summary>
    /// Reports whether the browser is already on the change-password screen.
    /// </summary>
    /// <returns><c>true</c> when the current route is the change-password route.</returns>
    private bool IsOnChangePasswordScreen()
    {
        var relativePath = "/" + NavigationManager
            .ToBaseRelativePath(NavigationManager.Uri)
            .Split('?')[0]
            .TrimStart('/')
            .TrimEnd('/');

        return string.Equals(
            relativePath, RoleLandingRoutes.ChangePassword, StringComparison.OrdinalIgnoreCase);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}

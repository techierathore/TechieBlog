<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- REQ-NFR-027: JwtSigningKey / AppEncryptionKey are supplied from user secrets or the
         environment, never from source. Without this id `dotnet user-secrets` cannot target
         this project and the documented setup command fails. -->
    <UserSecretsId>techieblog-host-secrets</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <!-- REQ-NFR-012: named retry / circuit-breaker pipelines registered in Program.cs -->
    <PackageReference Include="Polly.Extensions" Version="8.7.0" />
    <PackageReference Include="TrBlazeUI.Components" Version="2.0.1" />
    <PackageReference Include="TrBlazeUI.Icons.Lucide" Version="2.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!--
      REQ-NFR-013: centralised logging for the containerised deployment. The sink is attached only
      when Seq:Url is configured (see SeqSettings), so local development needs no Seq server.
      Referenced by the HOST ONLY - the coding standards forbid a class library referencing Serilog,
      and BlogEngine/BlogUI/BlogModel log through ILogger<T> exactly as before.
    -->
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlogDb\BlogDb.csproj" />
    <ProjectReference Include="..\BlogEngine\BlogEngine.csproj" />
    <ProjectReference Include="..\BlogModel\BlogModels.csproj" />
    <ProjectReference Include="..\BlogUI\BlogUI.csproj" />
  </ItemGroup>
</Project>
@*
    App.razor
    Purpose: HTML document shell for the TechieBlog Blazor Server application.

    REQ-UI-048 — migrated from Microsoft Fluent UI Blazor to TrBlazeUI.
    REQ-UI-033 / BRD-66 — dark mode is the `dark` CLASS on <html> (was data-theme).
    BRD-67 (rev)        — the site theme is the `data-site-theme` ATTRIBUTE on <html>.
    REQ-UI-032 / REQ-FN-039 / BRD-68 — the ADMIN-selected site theme is rendered
                          server-side into <html> so an anonymous first-time visitor
                          receives it on the very first paint. The inline script below
                          then lets a returning visitor's OWN LocalStorage preference
                          override it — site default underneath, visitor choice on top.

    CSS load order is significant and must not be reordered:
        1. theme.css    — TechieBlog OKLCH token sets for the three site themes
        2. trblazeui.css — the component library (declares its own defaults via
                           zero-specificity :where() selectors, so theme.css wins)
        3. base.css     — app-level element defaults layered on top
*@
@using BlogModels.Interfaces
@inject ISiteSettingsService SiteSettingsService

<!DOCTYPE html>
<html lang="en" data-site-theme="@siteTheme" class="@(isDarkModeDefault ? "dark" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @*
        NO <title> HERE — deliberately. Blazor's <HeadOutlet> below emits one from each page's
        <PageTitle> (the shared SiteBrandTitle component), and it does so during PRERENDER, so the
        title is already present in the first byte of HTML. A shell <title> in addition meant the
        document carried TWO, and since the browser takes the first, the tab showed the bare site
        name until hydration replaced it — a visible flicker on every page load, and invalid HTML.
        All 44 routable pages under BlogUI/Pages supply a title; adding a new routable page without
        one would leave it untitled, so give every page a <SiteBrandTitle>.
        `siteTitle` is still read below for the RSS auto-discovery tag.
    *@
    <meta name="description" content="@metaDescription" />
    @* Omitted entirely when unset, rather than emitted empty — a blank keywords tag is noise in the
       markup and says nothing. Settings stored this value from the start but nothing rendered it,
       so editing SEO keywords changed the database and no page (found 2026-08-23). *@
    @if (!string.IsNullOrWhiteSpace(metaKeywords))
    {
        <meta name="keywords" content="@metaKeywords" />
    }
    <base href="/" />

    @*
        RSS auto-discovery (REQ-UI-046, BRD-63). This tag is the entire mechanism by which a
        browser, a reader extension or an aggregator finds the feed from any page of the site —
        without it the feed exists but is undiscoverable, which is how it was verified as missing
        on 2026-08-09. It belongs in the shared document head, not on /rss, precisely so that
        landing on ANY page is enough. The href must stay in step with RssFeedSvc.FeedPath, the
        route Program.cs maps.

        Written through MarkupString rather than as literal Razor markup: see RssDiscoveryTag.
    *@
    @RssDiscoveryTag
    <ResourcePreloader />
    <ImportMap />

    @* 1. Design tokens — three site themes x light/dark *@
    <link href="_content/BlogUI/css/theme.css" rel="stylesheet" />

    @* 2. TrBlazeUI component library *@
    <link href="_content/TrBlazeUI.Components/trblazeui.css" rel="stylesheet" />

    @* 2b. Utilities the library's tree-shaken Tailwind bundle omits (gap TR-019) *@
    <link href="_content/BlogUI/css/utilities.css" rel="stylesheet" />

    @* 3. App-level element defaults and long-form article styling *@
    <link href="_content/BlogUI/css/base.css" rel="stylesheet" />

    @* Legacy page-level stylesheets (token-driven via the bridge in theme.css) *@
    <link href="_content/BlogUI/css/layout.css" rel="stylesheet" />
    <link href="_content/BlogUI/css/resume.css" rel="stylesheet" />

    @* Post detail page — full-bleed title band + TOC rail (UAT-027). Loaded after
       layout.css because it builds on the .site-container / .prose-container tiers. *@
    <link href="_content/BlogUI/css/post.css" rel="stylesheet" />

    <HeadOutlet @rendermode="InteractiveServer" />

    @*
        Flash-of-unstyled-content prevention.

        The <html> element above already carries the ADMIN-selected site defaults, rendered
        server-side, so an anonymous visitor is correct before this script runs. All this script
        does is let a returning visitor's OWN stored preference override those defaults before
        paint (BRD-66). Absent a stored preference it deliberately changes nothing, which is what
        makes the admin's choice the real site default.

        Note: the previous build fell back to the operating system's prefers-color-scheme when no
        preference was stored. That is now the ADMIN's "Default to dark mode" switch instead —
        otherwise the switch would have no observable effect for anyone on a dark-themed OS.
    *@
    <script>
        (function () {
            try {
                var root = document.documentElement;

                var theme = localStorage.getItem('techieblog-theme');
                if (theme) {
                    theme = theme.replace(/^"|"$/g, '');
                    // Legacy alias retained so existing visitors keep their default.
                    if (theme === 'fluent-modern') { theme = 'trblaze-modern'; }
                    root.setAttribute('data-site-theme', theme);
                }

                var darkMode = localStorage.getItem('techieblog-dark-mode');
                if (darkMode !== null) {
                    root.classList.toggle('dark', darkMode === 'true' || darkMode === true);
                }
            } catch (e) { }
        })();
    </script>
</head>
<body>
    <BlogUI.Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <span class="dismiss">&times;</span>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>

    @* Theme management + small app-level JS helpers. *@
    <script>
        // Applies the site theme attribute and the dark-mode class to <html>.
        // Called by BlogUI's ThemeProvider whenever ThemeService raises a change.
        function setThemeAttributes(siteTheme, isDarkMode) {
            var root = document.documentElement;
            if (siteTheme) {
                root.setAttribute('data-site-theme', siteTheme);
            }
            root.classList.toggle('dark', isDarkMode === true || isDarkMode === 'dark' || isDarkMode === 'true');
        }

        // CSV download used by the admin export actions.
        function downloadCsv(fileName, csvContent) {
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = fileName;
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // ---------------------------------------------------------------------------------
        // [REQ-NFR-007] 2026-08-11 — THE ACCESSIBILITY MutationObserverS ARE GONE.
        //
        // Two observers used to live here and rewrite the library's own ARIA after every
        // render batch. Both existed only because TrBlazeUI 2.0.1 emitted claims its markup
        // did not keep, and neither exposed a parameter to stop it:
        //
        //   * TR-052 — `data-a11y-decorative`: re-applied tabindex="-1" inside aria-hidden
        //     wrappers, because `Rating` painted role="radiogroup" tabindex="0" even when
        //     read-only. 2.0.2 gives `Rating` a `Focusable` parameter AND drops the tab stop
        //     entirely for `ReadOnly`, so the only two wrappers that opted in (StarRating,
        //     PostRatingPanel) no longer need to hide the control at all.
        //   * TR-054 / TR-063 / TR-064 — the `Tabs` repairs: dangling `aria-controls`,
        //     orphan role="tab" outside a tablist, and aria-selected="" (an empty token,
        //     which ARIA resolves to "not exposed"). 2.0.2 emits `aria-controls` only when a
        //     panel exists and keeps that panel mounted, renders `MarkdownEditor`'s
        //     Write/Preview pair through a real `TabsList`, and serialises aria-selected as
        //     a literal "true"/"false".
        //
        // Removal was gated on measurement, not on the release notes: axe (wcag2a/2aa/21a/
        // 21aa) over 9 public + 15 admin routes reported 0 violation nodes with the
        // observers in place AND 0 with them deleted, and the four DOM properties the
        // observers used to repair were counted directly on every one of those routes —
        // 0 dangling aria-controls, 0 orphan role="tab", 0 empty aria-selected, 0 focusable
        // nodes inside an aria-hidden subtree. Evidence: tests/.artifacts/cluster-g/
        // axe-before.json vs axe-after.json.
        //
        // If a future upgrade regresses any of those four, fix it in the component markup or
        // report it upstream — do not bring an observer back without the measurement above.
        // ---------------------------------------------------------------------------------
    </script>
</body>
</html>

@code {
    private const string FallbackTheme = "trblaze-modern";
    private const string LegacyTheme = "fluent-modern";

    private static readonly string[] ShippedThemes = { "trblaze-modern", "developer", "minimal" };

    private string siteTheme = FallbackTheme;
    private string siteTitle = "Techie Blog";
    private string metaDescription = string.Empty;
    private string metaKeywords = string.Empty;

    // Dark is the shipped site default (owner decision, 2026-08-10), so a settings read that
    // fails still renders class="dark" on <html> and the first paint is dark rather than a flash
    // of light. Kept in step with SiteSettings.IsDarkModeDefault and ThemeService.ShippedDarkMode.
    private bool isDarkModeDefault = true;

    /// <summary>
    /// The RSS auto-discovery tag, emitted as raw markup (REQ-UI-046).
    /// </summary>
    /// <remarks>
    /// <para><b>Why not plain Razor markup.</b> Razor renders every attribute value through
    /// <c>HtmlEncoder.Default</c>, which deliberately escapes <c>+</c> to <c>&amp;#x2B;</c> — a
    /// hardening rule aimed at attribute-injection and legacy UTF-7 sniffing. A browser parses the
    /// escaped form back to <c>application/rss+xml</c> and honours it, but the tag no longer
    /// contains that literal string, so every feed-discovery scraper and verifier that looks for it
    /// by text reports the site as having no feed. Writing the element as markup keeps the media
    /// type byte-for-byte what the specification says it is.</para>
    /// <para><b>Safety:</b> the only dynamic part is the site title, which an administrator can set
    /// to arbitrary text, so it is HTML-encoded explicitly here. Nothing else in the string comes
    /// from data — do not add an interpolated value without encoding it the same way.</para>
    /// </remarks>
    private MarkupString RssDiscoveryTag => (MarkupString)
        ("<link rel=\"alternate\" type=\"application/rss+xml\" title=\""
         + System.Net.WebUtility.HtmlEncode($"{siteTitle} - RSS feed")
         + "\" href=\"/feed.xml\" />");

    /// <summary>
    /// Loads the administrator-selected site defaults before the document shell is rendered.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> Rendering the site theme, title and meta description into the
    /// server response is what makes them site-wide rather than per-browser (REQ-UI-032,
    /// REQ-FN-039, BRD-68) — an anonymous visitor with an empty LocalStorage sees the admin's
    /// choice on the first paint, with no flash and no interop round trip.</para>
    /// <para><b>Flow:</b> Read the cached settings aggregate, normalise the theme identifier, keep
    /// the shipped fallbacks if anything goes wrong.</para>
    /// <para><b>Side Effects:</b> None. The settings service caches, so this is a database read
    /// only on the first request after a save.</para>
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SiteSettingsService.GetSettingsAsync();
            siteTheme = NormaliseTheme(settings.SiteTheme);
            isDarkModeDefault = settings.IsDarkModeDefault;
            siteTitle = string.IsNullOrWhiteSpace(settings.SiteTitle) ? siteTitle : settings.SiteTitle;
            metaDescription = settings.MetaDescription ?? string.Empty;
            metaKeywords = settings.MetaKeywords ?? string.Empty;
        }
        catch (Exception)
        {
            // A settings read must never stop the document shell from rendering; the shipped
            // defaults above already describe a working site.
        }
    }

    /// <summary>
    /// Maps a stored theme identifier onto one this build ships a stylesheet for.
    /// </summary>
    /// <param name="themeId">Identifier read from the settings store.</param>
    /// <returns>A shipped theme identifier, never null or empty.</returns>
    private static string NormaliseTheme(string themeId)
    {
        if (string.IsNullOrWhiteSpace(themeId) || themeId == LegacyTheme)
        {
            return FallbackTheme;
        }

        return ShippedThemes.Contains(themeId) ? themeId : FallbackTheme;
    }
}

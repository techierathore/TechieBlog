@*
    App.razor
    Purpose: HTML document shell for the TechieBlog Blazor Server application.

    REQ-UI-048 — migrated from Microsoft Fluent UI Blazor to TrBlazeUI.
    REQ-UI-033 / BRD-66 — dark mode is the `dark` CLASS on <html> (was data-theme).
    BRD-67 (rev)        — the site theme is the `data-site-theme` ATTRIBUTE on <html>.
    REQ-UI-032 / REQ-FN-039 / BRD-68 — the ADMIN-selected site theme is rendered
                          server-side into <html> so an anonymous first-time visitor
                          receives it on the very first paint. The inline script below
                          then lets a returning visitor's OWN LocalStorage preference
                          override it — site default underneath, visitor choice on top.

    CSS load order is significant and must not be reordered:
        1. theme.css    — TechieBlog OKLCH token sets for the three site themes
        2. trblazeui.css — the component library (declares its own defaults via
                           zero-specificity :where() selectors, so theme.css wins)
        3. base.css     — app-level element defaults layered on top
*@
@using BlogModels.Interfaces
@inject ISiteSettingsService SiteSettingsService

<!DOCTYPE html>
<html lang="en" data-site-theme="@siteTheme" class="@(isDarkModeDefault ? "dark" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@siteTitle</title>
    <meta name="description" content="@metaDescription" />
    <base href="/" />

    @*
        RSS auto-discovery (REQ-UI-046, BRD-63). This tag is the entire mechanism by which a
        browser, a reader extension or an aggregator finds the feed from any page of the site —
        without it the feed exists but is undiscoverable, which is how it was verified as missing
        on 2026-08-09. It belongs in the shared document head, not on /rss, precisely so that
        landing on ANY page is enough. The href must stay in step with RssFeedSvc.FeedPath, the
        route Program.cs maps.

        Written through MarkupString rather than as literal Razor markup: see RssDiscoveryTag.
    *@
    @RssDiscoveryTag
    <ResourcePreloader />
    <ImportMap />

    @* 1. Design tokens — three site themes x light/dark *@
    <link href="_content/BlogUI/css/theme.css" rel="stylesheet" />

    @* 2. TrBlazeUI component library *@
    <link href="_content/TrBlazeUI.Components/trblazeui.css" rel="stylesheet" />

    @* 2b. Utilities the library's tree-shaken Tailwind bundle omits (gap TR-019) *@
    <link href="_content/BlogUI/css/utilities.css" rel="stylesheet" />

    @* 3. App-level element defaults and long-form article styling *@
    <link href="_content/BlogUI/css/base.css" rel="stylesheet" />

    @* Legacy page-level stylesheets (token-driven via the bridge in theme.css) *@
    <link href="_content/BlogUI/css/layout.css" rel="stylesheet" />
    <link href="_content/BlogUI/css/resume.css" rel="stylesheet" />

    <HeadOutlet @rendermode="InteractiveServer" />

    @*
        Flash-of-unstyled-content prevention.

        The <html> element above already carries the ADMIN-selected site defaults, rendered
        server-side, so an anonymous visitor is correct before this script runs. All this script
        does is let a returning visitor's OWN stored preference override those defaults before
        paint (BRD-66). Absent a stored preference it deliberately changes nothing, which is what
        makes the admin's choice the real site default.

        Note: the previous build fell back to the operating system's prefers-color-scheme when no
        preference was stored. That is now the ADMIN's "Default to dark mode" switch instead —
        otherwise the switch would have no observable effect for anyone on a dark-themed OS.
    *@
    <script>
        (function () {
            try {
                var root = document.documentElement;

                var theme = localStorage.getItem('techieblog-theme');
                if (theme) {
                    theme = theme.replace(/^"|"$/g, '');
                    // Legacy alias retained so existing visitors keep their default.
                    if (theme === 'fluent-modern') { theme = 'trblaze-modern'; }
                    root.setAttribute('data-site-theme', theme);
                }

                var darkMode = localStorage.getItem('techieblog-dark-mode');
                if (darkMode !== null) {
                    root.classList.toggle('dark', darkMode === 'true' || darkMode === true);
                }
            } catch (e) { }
        })();
    </script>
</head>
<body>
    <BlogUI.Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <span class="dismiss">&times;</span>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>

    @* Theme management + small app-level JS helpers. *@
    <script>
        // Applies the site theme attribute and the dark-mode class to <html>.
        // Called by BlogUI's ThemeProvider whenever ThemeService raises a change.
        function setThemeAttributes(siteTheme, isDarkMode) {
            var root = document.documentElement;
            if (siteTheme) {
                root.setAttribute('data-site-theme', siteTheme);
            }
            root.classList.toggle('dark', isDarkMode === true || isDarkMode === 'dark' || isDarkMode === 'true');
        }

        // CSV download used by the admin export actions.
        function downloadCsv(fileName, csvContent) {
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = fileName;
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // ---------------------------------------------------------------------------------
        // [REQ-NFR-007] WCAG 4.1.2 / 2.1.1 — decorative subtrees must not be tabbable.
        //
        // A library widget presented as decoration (aria-hidden="true", with the real
        // semantics carried by a sibling control) must not ALSO sit in the tab order: a
        // keyboard user lands on something the accessibility tree says is not there, so the
        // stop is silent and unnamed. TrBlazeUI's Rating emits role="radiogroup" tabindex="0"
        // and exposes no parameter that turns it off (gap TR-031 / TR-052), so the tab stop
        // has to be removed from outside the component.
        //
        // Wrappers opt IN with data-a11y-decorative — nothing else on the page is touched.
        // Mouse operability is unaffected: click does not require a tab stop. The observer
        // re-applies after every Blazor re-render, which is why an attribute set at first
        // render would not have been enough.
        // ---------------------------------------------------------------------------------
        (function () {
            var focusableSelector =
                'a[href],area[href],button,input,select,textarea,iframe,[tabindex],[contenteditable="true"]';
            var scheduled = false;

            function neutralise(root) {
                if (root.matches(focusableSelector) && root.getAttribute('tabindex') !== '-1') {
                    root.setAttribute('tabindex', '-1');
                }
                root.querySelectorAll(focusableSelector).forEach(function (el) {
                    if (el.getAttribute('tabindex') !== '-1') {
                        el.setAttribute('tabindex', '-1');
                    }
                });
            }

            function sweep() {
                scheduled = false;
                document.querySelectorAll('[data-a11y-decorative]').forEach(neutralise);
            }

            function schedule() {
                if (scheduled) return;
                scheduled = true;
                requestAnimationFrame(sweep);
            }

            schedule();
            new MutationObserver(schedule).observe(document.documentElement, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['tabindex', 'data-a11y-decorative']
            });
        })();

        // ---------------------------------------------------------------------------------
        // [REQ-NFR-007] WCAG 4.1.2 — TrBlazeUI `Tabs` repairs (library gaps TR-054, TR-063).
        //
        // Same shape and the same justification as the TR-052 observer above: the component
        // states something about itself that is not true, the component exposes no parameter
        // to stop it, so the untrue part is corrected from outside. Nothing here invents a
        // meaning the DOM does not already carry — every rule either DELETES an unbacked
        // claim or transcribes a state the library itself already rendered.
        //
        //  (a) aria-controls -> a missing id (TR-054, 44 axe `aria-valid-attr-value` nodes).
        //      Only the ACTIVE `TabsContent` is rendered and there is no ForceMount/
        //      KeepMounted parameter, so every inactive `TabsTrigger` points at an element
        //      that is not in the document. Three of the five admin screens drive the tabs
        //      themselves and render NO `TabsContent` at all, so on those every trigger
        //      dangles. An absent aria-controls is strictly better for a screen reader than
        //      one that resolves to nothing: "move to the controlled element" simply is not
        //      offered, instead of being offered and failing.
        //
        //  (b) role="tab" with no role="tablist" ancestor (TR-054b, 4 nodes,
        //      `aria-required-parent`). Measured 2026-08-09: these are the Write/Preview
        //      buttons inside the LIBRARY's own `MarkdownEditor`, whose list wrapper is a
        //      bare <div> — not, as first supposed, the composer's nested Tabs. Injecting
        //      role="tablist" onto that wrapper was rejected: arrow keys and Home/End were
        //      measured on those two buttons and do NOT move focus, so a tablist would
        //      promise assistive technology a roving-focus contract the widget does not
        //      honour. Dropping the role leaves two correctly-named, fully operable buttons
        //      and removes a promise nothing keeps.
        //
        //  (c) aria-selected (TR-063). The library writes aria-selected="" — an EMPTY token
        //      value, which ARIA resolves to the attribute default, i.e. "not exposed" — on
        //      the active tab, and omits the attribute entirely on the inactive ones.
        //      Chrome's accessibility tree was read over CDP on /settings: SIX tabs, ZERO
        //      carrying a `selected` property. axe cannot see this (its aria-valid-attr-value
        //      rule skips empty values), but a screen-reader user cannot tell which tab is
        //      current. The correct value is not guessed: it is transcribed 1:1 from the
        //      library's own data-state="active|inactive" on the same element.
        //
        // (a) and (b) are REVERSIBLE. The removed value is parked on a data- attribute and
        // put back the moment the DOM makes it true again — so a render batch that lands a
        // trigger before its panel, or a tab before its list, self-heals instead of being
        // permanently stripped.
        // ---------------------------------------------------------------------------------
        (function () {
            var scheduled = false;

            function repairDanglingControls() {
                document.querySelectorAll('[aria-controls]').forEach(function (el) {
                    var id = el.getAttribute('aria-controls');
                    if (id && !document.getElementById(id)) {
                        el.setAttribute('data-a11y-controls-removed', id);
                        el.removeAttribute('aria-controls');
                    }
                });
                document.querySelectorAll('[data-a11y-controls-removed]').forEach(function (el) {
                    var id = el.getAttribute('data-a11y-controls-removed');
                    if (id && document.getElementById(id)) {
                        el.setAttribute('aria-controls', id);
                        el.removeAttribute('data-a11y-controls-removed');
                    }
                });
            }

            function repairOrphanTabs() {
                document.querySelectorAll('[role="tab"]').forEach(function (el) {
                    if (!el.closest('[role="tablist"]')) {
                        el.setAttribute('data-a11y-role-removed', 'tab');
                        el.removeAttribute('role');
                        // aria-selected belongs to the tab role and is not allowed on the
                        // plain button that is left behind (axe `aria-allowed-attr`,
                        // critical — measured, this exact node appeared the first time the
                        // role was dropped without it). repairSelectedState puts it back
                        // from data-state if the element ever regains the role.
                        el.removeAttribute('aria-selected');
                    }
                });
                document.querySelectorAll('[data-a11y-role-removed]').forEach(function (el) {
                    if (el.closest('[role="tablist"]')) {
                        el.setAttribute('role', el.getAttribute('data-a11y-role-removed'));
                        el.removeAttribute('data-a11y-role-removed');
                    }
                });
            }

            function repairSelectedState() {
                document.querySelectorAll('[role="tab"][data-state]').forEach(function (el) {
                    var selected = el.getAttribute('data-state') === 'active' ? 'true' : 'false';
                    if (el.getAttribute('aria-selected') !== selected) {
                        el.setAttribute('aria-selected', selected);
                    }
                });
            }

            function sweep() {
                scheduled = false;
                // Order matters: drop the unbacked role first so a button that is no longer
                // claiming to be a tab does not then get a tab's selected state.
                repairOrphanTabs();
                repairDanglingControls();
                repairSelectedState();
            }

            function schedule() {
                if (scheduled) return;
                scheduled = true;
                requestAnimationFrame(sweep);
            }

            schedule();
            new MutationObserver(schedule).observe(document.documentElement, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['aria-controls', 'aria-selected', 'role', 'data-state', 'id']
            });
        })();
    </script>
</body>
</html>

@code {
    private const string FallbackTheme = "trblaze-modern";
    private const string LegacyTheme = "fluent-modern";

    private static readonly string[] ShippedThemes = { "trblaze-modern", "developer", "minimal" };

    private string siteTheme = FallbackTheme;
    private string siteTitle = "Techie Blog";
    private string metaDescription = string.Empty;
    private bool isDarkModeDefault;

    /// <summary>
    /// The RSS auto-discovery tag, emitted as raw markup (REQ-UI-046).
    /// </summary>
    /// <remarks>
    /// <para><b>Why not plain Razor markup.</b> Razor renders every attribute value through
    /// <c>HtmlEncoder.Default</c>, which deliberately escapes <c>+</c> to <c>&amp;#x2B;</c> — a
    /// hardening rule aimed at attribute-injection and legacy UTF-7 sniffing. A browser parses the
    /// escaped form back to <c>application/rss+xml</c> and honours it, but the tag no longer
    /// contains that literal string, so every feed-discovery scraper and verifier that looks for it
    /// by text reports the site as having no feed. Writing the element as markup keeps the media
    /// type byte-for-byte what the specification says it is.</para>
    /// <para><b>Safety:</b> the only dynamic part is the site title, which an administrator can set
    /// to arbitrary text, so it is HTML-encoded explicitly here. Nothing else in the string comes
    /// from data — do not add an interpolated value without encoding it the same way.</para>
    /// </remarks>
    private MarkupString RssDiscoveryTag => (MarkupString)
        ("<link rel=\"alternate\" type=\"application/rss+xml\" title=\""
         + System.Net.WebUtility.HtmlEncode($"{siteTitle} - RSS feed")
         + "\" href=\"/feed.xml\" />");

    /// <summary>
    /// Loads the administrator-selected site defaults before the document shell is rendered.
    /// </summary>
    /// <remarks>
    /// <para><b>Business Logic:</b> Rendering the site theme, title and meta description into the
    /// server response is what makes them site-wide rather than per-browser (REQ-UI-032,
    /// REQ-FN-039, BRD-68) — an anonymous visitor with an empty LocalStorage sees the admin's
    /// choice on the first paint, with no flash and no interop round trip.</para>
    /// <para><b>Flow:</b> Read the cached settings aggregate, normalise the theme identifier, keep
    /// the shipped fallbacks if anything goes wrong.</para>
    /// <para><b>Side Effects:</b> None. The settings service caches, so this is a database read
    /// only on the first request after a save.</para>
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SiteSettingsService.GetSettingsAsync();
            siteTheme = NormaliseTheme(settings.SiteTheme);
            isDarkModeDefault = settings.IsDarkModeDefault;
            siteTitle = string.IsNullOrWhiteSpace(settings.SiteTitle) ? siteTitle : settings.SiteTitle;
            metaDescription = settings.MetaDescription ?? string.Empty;
        }
        catch (Exception)
        {
            // A settings read must never stop the document shell from rendering; the shipped
            // defaults above already describe a working site.
        }
    }

    /// <summary>
    /// Maps a stored theme identifier onto one this build ships a stylesheet for.
    /// </summary>
    /// <param name="themeId">Identifier read from the settings store.</param>
    /// <returns>A shipped theme identifier, never null or empty.</returns>
    private static string NormaliseTheme(string themeId)
    {
        if (string.IsNullOrWhiteSpace(themeId) || themeId == LegacyTheme)
        {
            return FallbackTheme;
        }

        return ShippedThemes.Contains(themeId) ? themeId : FallbackTheme;
    }
}
